+		/* If dicreasing voltage, then frequency scaling comes first */
+		err = stm32mp2_pll1_set_rate(opp.hz[opp_idx]);
+		if (err != 0) {
+			/* Back to base state */
+			ca35ss_set_state_base();
+			return STM32_SMC_FAILED;
+		}
 
