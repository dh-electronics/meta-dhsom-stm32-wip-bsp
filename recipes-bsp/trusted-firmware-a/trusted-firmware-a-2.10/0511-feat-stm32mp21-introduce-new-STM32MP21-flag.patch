@@ -372,7 +372,7 @@ static void boot_spi_nand(boot_api_context_t *boot_context)
 #if STM32MP13 || STM32MP15
 	io_result = stm32_qspi_init();
 #endif
-#if STM32MP25
+#if STM32MP21 || STM32MP25
 	io_result = stm32_ospi_init();
 #endif
 	assert(io_result == 0);
