 	.validate_ns_entrypoint = stm32_validate_ns_entrypoint,
 	.get_sys_suspend_power_state = stm32_get_sys_suspend_power_state,
@@ -1433,6 +1459,8 @@ static void stm32_pm_init(void *fdt)
 
