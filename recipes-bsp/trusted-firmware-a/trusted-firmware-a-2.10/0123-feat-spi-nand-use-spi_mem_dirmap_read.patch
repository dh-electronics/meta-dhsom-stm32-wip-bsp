From daeb415c3248920b150ab4bc128a2d7a6d03ff78 Mon Sep 17 00:00:00 2001
From: Christophe Kerello <christophe.kerello@foss.st.com>
Date: Tue, 15 Jun 2021 12:07:13 +0200
Subject: [PATCH 123/954] feat(spi-nand): use spi_mem_dirmap_read

Use spi_mem_dirmap_read instead of spi_mem_exec_op when reading data
from the memory.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 44a5029c42a61907d8ff4cea14c3739e23d49a35 feat(spi-nand): use spi_mem_dirmap_read]
Change-Id: Icdf0ba36788110f4e915945d9c0e329f4a046a54
Signed-off-by: Christophe Kerello <christophe.kerello@foss.st.com>
---
 drivers/mtd/nand/spi_nand.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/mtd/nand/spi_nand.c b/drivers/mtd/nand/spi_nand.c
index 744383aa3c..8c81434996 100644
--- a/drivers/mtd/nand/spi_nand.c
+++ b/drivers/mtd/nand/spi_nand.c
@@ -192,7 +192,7 @@ static int spi_nand_read_from_cache(unsigned int page, unsigned int offset,
 	spinand_dev.spi_read_cache_op.data.buf = buffer;
 	spinand_dev.spi_read_cache_op.data.nbytes = len;
 
-	return spi_mem_exec_op(&spinand_dev.spi_read_cache_op);
+	return spi_mem_dirmap_read(&spinand_dev.spi_read_cache_op);
 }
 
 static int spi_nand_read_page(unsigned int page, unsigned int offset,
-- 
2.53.0

