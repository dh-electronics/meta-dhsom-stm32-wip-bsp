+ */
+
+#include <dt-bindings/clock/stm32mp25-clksrc.h>
+#include "stm32mp25xx-dhcos-som-ca35tdcid-rcc.dtsi"
+#include "stm32mp25xx-dhcos-som-lpddr4-1x32Gbits-1x32bits-1200MHz.dtsi"
+#include "stm32mp25-pinctrl.dtsi"
+#include "stm32mp25xxak-pinctrl.dtsi"
+
+pmic_i2c: &i2c4 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pmic_i2c_pins_a>;
+};
+
+&pinctrl {
+	/omit-if-no-ref/
+	pmic_i2c_pins_a: i2c4-1 {
+		pins1 {
+			pinmux = <STM32_PINMUX('A', 12, AF8)>, /* I2C4_SCL */
+				 <STM32_PINMUX('D', 10, AF6)>; /* I2C4_SDA */
+			bias-disable;
+			drive-open-drain;
+			slew-rate = <0>;
+		};
+	};
+};
+
+#include "stm32mp2xxx-dhcos-som.dtsi"
+
+/ {
+	model = "DH electronics STM32MP25xx DHCOS SoM";
+	compatible = "dh,stm32mp251a-dhcos-som", "st,stm32mp251";
