diff --git a/drivers/st/ddr/stm32mp2_ram.c b/drivers/st/ddr/stm32mp2_ram.c
index 6cac99c619..facc94a450 100644
--- a/drivers/st/ddr/stm32mp2_ram.c
+++ b/drivers/st/ddr/stm32mp2_ram.c
@@ -68,6 +68,10 @@ static int ddr_dt_get_ui_param(void *fdt, int node, struct stm32mp_ddr_config *c
 	return 0;
 }
 
+#include <drivers/clk.h>
+#include <drivers/st/stm32_gpio.h>
+#include <dt-bindings/gpio/stm32-gpio.h>
+
 static int stm32mp2_ddr_setup(void)
 {
 	struct stm32mp_ddr_priv *priv = &ddr_priv_data;
@@ -104,6 +108,49 @@ static int stm32mp2_ddr_setup(void)
 		return ret;
 	}
 
+#if 1
+#if STM32MP25
+	int gpiof15, gpiog10, gpiog9;
+
+	set_gpio_config(GPIO_BANK_F, 15, GPIOF_DIR_IN, 0);
+	set_gpio_config(GPIO_BANK_G, 10, GPIOF_DIR_IN, 0);
+	set_gpio_config(GPIO_BANK_G, 9, GPIOF_DIR_IN, 0);
+
+	gpiof15 = get_gpio_level(GPIO_BANK_F, 15);
+	gpiog10 = get_gpio_level(GPIO_BANK_G, 10);
+	gpiog9 = get_gpio_level(GPIO_BANK_G, 9);
+
+	NOTICE("BL2: DRAM straps [2:0]=3'b%d%d%d\n", gpiof15, gpiog10, gpiog9);
+
+	if (gpiof15 == 0 && gpiog10 == 0 && gpiog9 == 1) {
+		/* 1 GiB variant */
+		NOTICE("BL2: DRAM size is 1 GiB\n");
+		config.info.size = 0x40000000ULL;
+		config.c_timing.rfshtmg = 0x81240036;
+		config.c_timing.dramtmg14 = 0x71;
+		config.c_map.addrmap6 = 0xF070707;
+		config.c_map.addrmap7 = 0xF0F;
+	} else if (gpiof15 == 0 && gpiog10 == 1 && gpiog9 == 1) {
+		/* 2 GiB variant */
+		NOTICE("BL2: DRAM size is 2 GiB\n");
+		config.info.size = 0x80000000ULL;
+		config.c_timing.rfshtmg = 0x81240054;
+		config.c_timing.dramtmg14 = 0xAD;
+		config.c_map.addrmap7 = 0xF0F;
+	} else {
+		/* 4 GiB variant */
+		NOTICE("BL2: DRAM size is 4 GiB\n");
+		config.info.size = 0x100000000ULL;
+		config.c_timing.rfshtmg = 0x81240072;
+		config.c_timing.dramtmg14 = 0xE9;
+		config.c_map.addrmap7 = 0xF07;
+	}
+#endif
+	/* Pass decoded DRAM size >> 16 via TAMP register */
+	clk_enable(TAMP_BKP_REG_CLK);
+	mmio_write_32(0x46010290, config.info.size >> 16ULL);
+#endif
+
 	ret = ddr_dt_get_ui_param(fdt, node, &config);
 	if (ret < 0) {
 		return ret;
