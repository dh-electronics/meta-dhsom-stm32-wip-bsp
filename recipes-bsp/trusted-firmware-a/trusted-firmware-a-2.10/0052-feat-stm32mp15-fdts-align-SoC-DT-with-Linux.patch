From 4c27475313184a2ccf3190f3427e2db6518c9898 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Tue, 9 Aug 2022 18:01:10 +0200
Subject: [PATCH 052/841] feat(stm32mp15-fdts): align SoC DT with Linux

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git d77cf16e3b2035d1c62539dc6b265f88e0b55eea feat(stm32mp15-fdts): align SoC DT with Linux]
Signed-off-by: Yann Gautier <yann.gautier@st.com>
Change-Id: Ifdace2987a10498666ca639684849d06bbf72226
---
 fdts/stm32mp151.dtsi | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/fdts/stm32mp151.dtsi b/fdts/stm32mp151.dtsi
index 7a22a1c78..c3a30761c 100644
--- a/fdts/stm32mp151.dtsi
+++ b/fdts/stm32mp151.dtsi
@@ -318,6 +318,8 @@
 			interrupts = <GIC_SPI 92 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&rcc QSPI_K>;
 			resets = <&rcc QSPI_R>;
+			#address-cells = <1>;
+			#size-cells = <0>;
 			status = "disabled";
 		};
 
@@ -488,7 +490,7 @@
 			pkh_otp: pkh_otp@60 {
 				reg = <0x60 0x20>;
 			};
-			mac_addr: mac_addr@e4 {
+			ethernet_mac_address: mac@e4 {
 				reg = <0xe4 0x8>;
 				st,non-secure-otp;
 			};
-- 
2.47.2

