 #if PSA_FWU_SUPPORT
+static int stm32_nvmem_cell_clrset(struct nvmem_cell *cell, uint32_t clear,
+				   uint32_t set)
+{
+	int ret = 0;
+	uint32_t reg_val = 0;
+
+	ret = nvmem_cell_read(cell, (uint8_t *)&reg_val, sizeof(reg_val), NULL);
+	if (ret != 0) {
+		return ret;
+	}
+
+	reg_val &= ~clear;
+	reg_val |= set;
+
+	ret = nvmem_cell_write(cell, (uint8_t *)&reg_val, sizeof(reg_val));
+	if (ret != 0) {
+		return ret;
+	}
+
+	return 0;
+}
