+#define DDRPHY_APBONLY0_MICROCONTMUXSEL_MICROCONTMUXSEL		BIT(0)
+
 /* DDRDBG registers offsets */
 #define DDRDBG_LP_DISABLE			U(0x0)
 #define DDRDBG_BYPASS_PCLKEN			U(0x4)
