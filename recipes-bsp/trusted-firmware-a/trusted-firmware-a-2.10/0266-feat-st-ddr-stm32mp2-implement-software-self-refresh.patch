+#define DDRPHY_INITENG0_P0_PHYINLPX		U(0x2400A0)
+#define DDRPHY_DRTUB0_UCCLKHCLKENABLES		U(0x300200)
 #define DDRPHY_APBONLY0_MICROCONTMUXSEL		U(0x340000)
 
+/* DDRPHY registers fields */
