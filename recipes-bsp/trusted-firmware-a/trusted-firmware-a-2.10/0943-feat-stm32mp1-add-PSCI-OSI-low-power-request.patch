index d22d4b9cd3..35a85c3099 100644
--- a/plat/st/stm32mp1/stm32mp1_critic_power_wrapper.S
+++ b/plat/st/stm32mp1/stm32mp1_critic_power_wrapper.S
@@ -78,6 +78,8 @@ func stm32_pwr_down_wfi_wrapper
 
 	bl	stm32_pwr_down_wfi_load
 
+	mov	r4, r0
+
 	# Load CPU_ID in r2 and WORD_SIZE in r3
 	bl	plat_my_core_pos
 	mov	r2, r0
@@ -100,6 +102,8 @@ func stm32_pwr_down_wfi_wrapper
 	ldr	r0, [r1]
 	stcopr	r0, MVBAR
 
+	mov	r0, r4
+
 	# Synchronize on memory access and instruction
 	# after resetting stack/IT handler
 	dsb
