From 66d226682b3fdf9aaa10451d32547ff19db68623 Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Thu, 11 Jan 2024 18:14:39 +0100
Subject: [PATCH 456/841] feat(stm32mp1): add intrusion alert upon tamper event
 detected

If, upon TF-A BL2 boot, a tamper event is detected, display an intrusion
alert featuring the associated tamper event.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 38f1188b923208ec509f882febbe4aed4a58b0fa feat(stm32mp1): add intrusion alert upon tamper event detected]
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Change-Id: I2d88ca0f96eb269baa418e879da2295457860ec1
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/350808
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
Tested-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 plat/st/stm32mp1/bl2_plat_setup.c | 22 ++++++++++++++++++++++
 plat/st/stm32mp1/stm32mp1_def.h   |  2 ++
 2 files changed, 24 insertions(+)

diff --git a/plat/st/stm32mp1/bl2_plat_setup.c b/plat/st/stm32mp1/bl2_plat_setup.c
index 4608475e3..e2e338f86 100644
--- a/plat/st/stm32mp1/bl2_plat_setup.c
+++ b/plat/st/stm32mp1/bl2_plat_setup.c
@@ -268,6 +268,26 @@ static void reset_backup_domain(void)
 	}
 }
 
+static void stm32_tamp_check_tamper_event(void)
+{
+	uint32_t sr = mmio_read_32(TAMP_BASE + TAMP_SR);
+
+	if (sr != 0U) {
+		ERROR("\n");
+		while (sr != 0U) {
+			unsigned int bit_off = __builtin_ctz(sr);
+			bool is_internal = bit_off >= TAMP_SR_INT_SHIFT;
+
+			ERROR("** INTRUSION ALERT: %s TAMPER %u DETECTED **\n",
+			      is_internal ? "INTERNAL" : "EXTERNAL",
+			      is_internal ? bit_off - TAMP_SR_INT_SHIFT + 1U : bit_off + 1U);
+
+			sr &= ~BIT(bit_off);
+		}
+		ERROR("\n");
+	}
+}
+
 void bl2_el3_plat_arch_setup(void)
 {
 	const char *board_model;
@@ -359,6 +379,8 @@ void bl2_el3_plat_arch_setup(void)
 	}
 
 skip_console_init:
+	stm32_tamp_check_tamper_event();
+
 #if !TRUSTED_BOARD_BOOT
 	if (stm32mp_check_closed_device() == STM32MP_CHIP_SEC_CLOSED) {
 		/* Closed chip mandates authentication */
diff --git a/plat/st/stm32mp1/stm32mp1_def.h b/plat/st/stm32mp1/stm32mp1_def.h
index eeb7dfa1b..f19d07382 100644
--- a/plat/st/stm32mp1/stm32mp1_def.h
+++ b/plat/st/stm32mp1/stm32mp1_def.h
@@ -588,6 +588,8 @@ enum ddr_type {
 #define TAMP_COUNTR			U(0x40)
 #define TAMP_ERCFGR			U(0x54)
 
+#define TAMP_SR_INT_SHIFT		U(16)
+
 /*******************************************************************************
  * STM32MP1 USB
  ******************************************************************************/
