From ec1db7caaa27e1964c1ca2b6012454bffee403f5 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@foss.st.com>
Date: Mon, 22 Nov 2021 15:07:51 +0100
Subject: [PATCH 130/954] feat(stm32mp25-fdts): add RNG node

IP aligned with STM32MP13, use same compatible.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git e16b5834b469f82152d5824b84bc4eafc45ed499 feat(stm32mp25-fdts): add RNG node]
Signed-off-by: Nicolas Le Bayon <nicolas.le.bayon@st.com>
Change-Id: I230c405a8e2baaf952d90646aaa54239fed9fdf4
---
 fdts/stm32mp251.dtsi | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/fdts/stm32mp251.dtsi b/fdts/stm32mp251.dtsi
index a6675a6be1..f83730c9fb 100644
--- a/fdts/stm32mp251.dtsi
+++ b/fdts/stm32mp251.dtsi
@@ -121,6 +121,14 @@
 			status = "disabled";
 		};
 
+		rng: rng@42020000 {
+			compatible = "st,stm32mp13-rng";
+			reg = <0x42020000 0x400>;
+			clocks = <&rcc CK_BUS_RNG>;
+			resets = <&rcc RNG_R>;
+			status = "disabled";
+		};
+
 		risaf2: risaf@420b0000 {
 			compatible = "st,stm32-risaf";
 			reg = <0x420b0000 0x1000>;
-- 
2.53.0

