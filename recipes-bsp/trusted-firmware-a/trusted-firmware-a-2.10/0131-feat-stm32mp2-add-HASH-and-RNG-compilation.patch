From 123d5f7018a19e74cac435f9972287202baefda8 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@foss.st.com>
Date: Wed, 20 Apr 2022 11:33:46 +0200
Subject: [PATCH 131/954] feat(stm32mp2): add HASH and RNG compilation

Add the drivers compilation in STM32MP2 platform.mk.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git c001693921cbda30908442ad8de7e43b3ec2dcb8 feat(stm32mp2): add HASH and RNG compilation]
Signed-off-by: Yann Gautier <yann.gautier@st.com>
---
 plat/st/stm32mp2/platform.mk | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/plat/st/stm32mp2/platform.mk b/plat/st/stm32mp2/platform.mk
index 72501ffdd3..7ef6da0a10 100644
--- a/plat/st/stm32mp2/platform.mk
+++ b/plat/st/stm32mp2/platform.mk
@@ -38,6 +38,9 @@ $(PLAT_PARTITION_MAX_ENTRIES)")
 endif
 endif
 
+STM32_HASH_VER		:=	4
+STM32_RNG_VER		:=	4
+
 # Download load address for serial boot devices
 DWL_BUFFER_BASE 	?=	0x87000000
 
@@ -65,6 +68,8 @@ $(eval $(call assert_booleans,\
 $(eval $(call assert_numerics,\
 	$(sort \
 		PLAT_PARTITION_MAX_ENTRIES \
+		STM32_HASH_VER \
+		STM32_RNG_VER \
 		STM32_TF_A_COPIES \
 )))
 
@@ -72,6 +77,8 @@ $(eval $(call add_defines,\
 	$(sort \
 		DWL_BUFFER_BASE \
 		PLAT_PARTITION_MAX_ENTRIES \
+		STM32_HASH_VER \
+		STM32_RNG_VER \
 		STM32_TF_A_COPIES \
 		STM32MP25 \
 )))
@@ -94,12 +101,14 @@ PLAT_BL_COMMON_SOURCES		+=	drivers/st/bsec/bsec3.c					\
 					plat/st/stm32mp2/stm32mp2_syscfg.c
 
 PLAT_BL_COMMON_SOURCES		+=	drivers/st/clk/clk-stm32-core.c				\
-					drivers/st/clk/stm32mp2_clk.c
+					drivers/st/clk/stm32mp2_clk.c				\
+					drivers/st/crypto/stm32_rng.c
 
 BL2_SOURCES			+=	plat/st/stm32mp2/plat_bl2_mem_params_desc.c		\
 					plat/st/stm32mp2/stm32mp2_fconf_firewall.c
 
-BL2_SOURCES			+=	plat/st/stm32mp2/bl2_plat_setup.c
+BL2_SOURCES			+=	drivers/st/crypto/stm32_hash.c				\
+					plat/st/stm32mp2/bl2_plat_setup.c
 
 BL2_SOURCES		+=	drivers/st/rif/stm32mp2_risaf.c
 
-- 
2.53.0

