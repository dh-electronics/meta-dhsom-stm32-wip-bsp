From aba0f0f4ca2929e5266f8c90dc06726e3dff04e7 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Wed, 24 Apr 2019 13:38:41 +0200
Subject: [PATCH 023/841] feat(st): protect access on PWR registers

In SMP context, we need to add spinlocks to protect against concurrent
accesses on PWR registers.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 1a52c03596e16d1827a8e26803560a57c3012e38 feat(st): protect access on PWR registers]
Change-Id: I27cb698ffa085eca7b61b042ce5ccaa1fd2daaf4
Signed-off-by: Yann Gautier <yann.gautier@st.com>
---
 plat/st/common/include/stm32mp_common.h |  4 ++++
 plat/st/common/stm32mp_common.c         | 16 ++++++++++++++++
 2 files changed, 20 insertions(+)

diff --git a/plat/st/common/include/stm32mp_common.h b/plat/st/common/include/stm32mp_common.h
index e334f2253..606da9743 100644
--- a/plat/st/common/include/stm32mp_common.h
+++ b/plat/st/common/include/stm32mp_common.h
@@ -44,6 +44,10 @@ void stm32mp_gic_init(void);
 /* Check MMU status to allow spinlock use */
 bool stm32mp_lock_available(void);
 
+/* SMP protection on PWR registers access */
+void stm32mp_pwr_regs_lock(void);
+void stm32mp_pwr_regs_unlock(void);
+
 int stm32_get_otp_index(const char *otp_name, uint32_t *otp_idx,
 			uint32_t *otp_len);
 int stm32_get_otp_value(const char *otp_name, uint32_t *otp_val);
diff --git a/plat/st/common/stm32mp_common.c b/plat/st/common/stm32mp_common.c
index 2163aaf16..fc32356fd 100644
--- a/plat/st/common/stm32mp_common.c
+++ b/plat/st/common/stm32mp_common.c
@@ -16,6 +16,7 @@
 #include <drivers/st/stm32mp_reset.h>
 #include <lib/mmio.h>
 #include <lib/smccc.h>
+#include <lib/spinlock.h>
 #include <lib/xlat_tables/xlat_tables_v2.h>
 #include <plat/common/platform.h>
 #include <services/arm_arch_svc.h>
@@ -56,6 +57,7 @@
 #define BOOT_INST_SHIFT			8
 
 static console_t console;
+static struct spinlock lock;
 
 uintptr_t plat_get_ns_image_entrypoint(void)
 {
@@ -120,6 +122,20 @@ bool stm32mp_lock_available(void)
 #endif
 }
 
+void stm32mp_pwr_regs_lock(void)
+{
+	if (stm32mp_lock_available()) {
+		spin_lock(&lock);
+	}
+}
+
+void stm32mp_pwr_regs_unlock(void)
+{
+	if (stm32mp_lock_available()) {
+		spin_unlock(&lock);
+	}
+}
+
 int stm32mp_map_ddr_non_cacheable(void)
 {
 	return  mmap_add_dynamic_region(STM32MP_DDR_BASE, STM32MP_DDR_BASE,
-- 
