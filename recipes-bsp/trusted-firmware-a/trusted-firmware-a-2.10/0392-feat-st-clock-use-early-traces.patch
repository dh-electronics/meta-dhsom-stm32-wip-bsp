 	timeout = timeout_init_us(CLKDIV_TIMEOUT);
 	while ((mmio_read_32(xbar_cfgr) & RCC_XBAR0CFGR_XBAR0STS) != 0U) {
 		if (timeout_elapsed(timeout)) {
