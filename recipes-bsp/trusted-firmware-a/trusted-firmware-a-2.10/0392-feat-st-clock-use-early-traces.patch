 		panic();
 	}
 
@@ -1999,7 +2000,7 @@ static int stm32_clk_configure(struct stm32_clk_priv *priv, uint32_t val)
 		break;
 
 	default:
-		ERROR("%s: cmd unknown ! : 0x%x\n", __func__, val);
