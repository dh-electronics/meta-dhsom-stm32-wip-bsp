 int stpmic2_regulator_set_prop(struct pmic_handle_s *pmic, uint8_t id,
 			       enum stpmic2_prop_id prop, uint32_t arg);
 
+int stpmic2_is_buck1_high_voltage(struct pmic_handle_s *pmic, bool *high);
 #endif /*STPMIC2_H*/
