+	[STPMIC2_GPO3] = DEFINE_GPOx("gpo3", GPO3),
+	[STPMIC2_GPO4] = DEFINE_GPOx("gpo4", GPO4),
+	[STPMIC2_GPO5] = DEFINE_GPOx("gpo5", GPO5),
+
