+				      buck_low_volt_table),
 	[STPMIC2_BUCK3] = DEFINE_BUCK("buck3", BUCK3, BUCKS_PD_CR1,
-				      buck1236_volt_table),
+				      buck_low_volt_table),
 	[STPMIC2_BUCK4] = DEFINE_BUCK("buck4", BUCK4, BUCKS_PD_CR1,
-				      buck457_volt_table),
+				      buck_high_volt_table),
