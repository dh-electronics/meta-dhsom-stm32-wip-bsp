 	.volt_table		= table, \
@@ -137,19 +145,21 @@ static const uint16_t refddr_volt_table[] = {
 /* Table of Regulators in PMIC SoC */
 static const struct regul_struct regul_table[STPMIC2_NB_REG] = {
 	[STPMIC2_BUCK1] = DEFINE_BUCK("buck1", BUCK1, BUCKS_PD_CR1,
-				      buck1236_volt_table),
