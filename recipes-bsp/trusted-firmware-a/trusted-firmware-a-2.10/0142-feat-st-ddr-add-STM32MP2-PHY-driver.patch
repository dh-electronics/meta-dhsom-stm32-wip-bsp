+
+		mr4[myps] = 0x0U;
+
+		mr11[myps] =
+			(uint8_t)((dqodt[myps] << 0) & 0x07U) |
+			(uint8_t)((caodt[myps] << 4) & 0x70U);
+
+		mr12[myps] =
