+
+			c_addr = byte << 12;
+			for (lane = 0; lane <= B_MAX; lane++) {
+				int b_addr;
+
+				b_addr = lane << 8;
+				mmio_write_16((uintptr_t)
+					      (DDRPHYC_BASE + 4 * (p_addr | TDBYTE | c_addr |
+								   b_addr |
+								   CSR_TXODTDRVSTREN_ADDR)),
+					      txodtdrvstren);
+			}
+		}
+	}
+}
