-	 * apb_wr(32'haaaa,16'hdddd);
-	 * and capture the aaaa and dddd values to load array
-	 */
-
-	first = 0;
-	while (fgets(instr, 255, incvfile_ptr) != NULL) {
-		p = strtok(instr, "(");
-		x = 0;
-		do {
-			p = strtok(NULL, "h,)");
-			if (p) {
-				if (x == 1) {
-					sscanf(p, "%x", &adr);
-				} else if (x == 3) {
-					sscanf(p, "%x", &dat);
-					if (first == 0) {
-						offset = adr;
-						first = 1;
-					}
-					mem[adr - offset] = dat; /* load array */
-				}
-			}
-			x++;
-		} while (p);
-	}
-	fclose(incvfile_ptr);
