From 4f1898bedd94f80a25e7574d4360c8adace4b67d Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Thu, 4 Jun 2026 16:22:46 +0200
Subject: [PATCH 473/572] fix(stm32mp2): wait ARM timer to increment after
 stopping STGEN isolation

We observe that ARM timer value stay stuck some time after stopping
STGEN isolation. Which will result in a completely wrong timeout_init_us()
return value.

To solve that, we will simply wait the timer to count again by comparing
its actual value with an old one.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 0bcd930ca17508e8f877c0b692b4173dd320af6f fix(stm32mp2): wait ARM timer to increment after stopping STGEN isolation]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: I0bf552d3fcadcb382c5b278d4439d0e9f312fbd4
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/574842
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
---
 plat/st/stm32mp2/stm32mp2_ca35ss.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/plat/st/stm32mp2/stm32mp2_ca35ss.c b/plat/st/stm32mp2/stm32mp2_ca35ss.c
index 9548839972..6f57c24800 100644
--- a/plat/st/stm32mp2/stm32mp2_ca35ss.c
+++ b/plat/st/stm32mp2/stm32mp2_ca35ss.c
@@ -104,6 +104,7 @@ void stm32mp_ca35_lpi_restore(void)
 {
 	uint64_t timeout = 0;
 	uint32_t counter = UINT32_MAX;
+	uint64_t reference = read_cntpct_el0();
 
 	/* Use write set registers to set bits */
 	mmio_write_32(A35SSC_BASE + CA35SS_SSC_LPI_STGEN_NTS(WS1),
@@ -118,6 +119,19 @@ void stm32mp_ca35_lpi_restore(void)
 		}
 	}
 
+	/*
+	 * With STGEN isolated, timer is not functional.
+	 * Wait for the ARM timer to be incremented at least once
+	 * to avoid that next timeout_init_us() reads a bad value.
+	 */
+	counter = UINT32_MAX;
+	while (read_cntpct_el0() == reference) {
+		counter--;
+		if (counter == 0U) {
+			panic();
+		}
+	}
+
 	if (clk_is_enabled(CK_SYSDBG)) {
 		mmio_write_32(A35SSC_BASE + CA35SS_SSC_LPI_TSGEN_NTS(WS1),
 			      CA35SS_SSC_LPI_TSGEN_CSYSREQ);
-- 
