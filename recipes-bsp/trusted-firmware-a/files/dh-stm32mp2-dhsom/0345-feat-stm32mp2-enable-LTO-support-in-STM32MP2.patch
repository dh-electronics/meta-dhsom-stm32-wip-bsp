From b06cfdb94a7246927eb12f1cb4f6c4bd1ffb7a7c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Fri, 13 Dec 2024 14:12:32 +0100
Subject: [PATCH 345/572] feat(stm32mp2): enable LTO support in STM32MP2
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Allow the usage of link time optimization in STM32MP2 platform and
enable it. When enabled, PIE must be disabled as bl2 and bl31 base
address must be asolute otherwise some ASM function will fail.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 9699b220b27e8db2d93f943036927137b8dcf666 feat(stm32mp2): enable LTO support in STM32MP2]
Change-Id: Ib5194ac10501e20c06dc646c1f6e2e24039c0637
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/423952
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 plat/st/stm32mp2/platform_defaults.mk | 8 ++++++++
 1 file changed, 8 insertions(+)
 create mode 100644 plat/st/stm32mp2/platform_defaults.mk

diff --git a/plat/st/stm32mp2/platform_defaults.mk b/plat/st/stm32mp2/platform_defaults.mk
new file mode 100644
index 0000000000..26e49b7e4c
--- /dev/null
+++ b/plat/st/stm32mp2/platform_defaults.mk
@@ -0,0 +1,8 @@
+#
+# Copyright (c) 2025, STMicroelectronics - All Rights Reserved
+#
+# SPDX-License-Identifier: BSD-3-Clause
+#
+
+# LTO is enabled on this platform due to memory constraints
+ENABLE_LTO			:= 1
-- 
2.53.0

