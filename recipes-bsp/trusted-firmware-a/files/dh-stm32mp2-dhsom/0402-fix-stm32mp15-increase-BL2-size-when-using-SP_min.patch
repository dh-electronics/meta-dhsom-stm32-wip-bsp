From 3086111d00228a354e6b68638b96d586aa0be3b7 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Tue, 20 Jan 2026 19:13:23 +0100
Subject: [PATCH 402/572] fix(stm32mp15): increase BL2 size when using SP_min

Increase STM32MP_BL2_RO_SIZE by 8kB and STM32MP_BL2_SIZE by 4kB.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 27dbdd3b48d44d42dfd3068b4c65315c91e2c550 fix(stm32mp15): increase BL2 size when using SP_min]
Change-Id: I1d5ccca032a868ea366426f5ad3a6f5974f27e7c
Signed-off-by: Yann Gautier <yann.gautier@st.com>
---
 plat/st/stm32mp1/stm32mp1_fip_def.h | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/plat/st/stm32mp1/stm32mp1_fip_def.h b/plat/st/stm32mp1/stm32mp1_fip_def.h
index b203984b2e..8e9d7ef656 100644
--- a/plat/st/stm32mp1/stm32mp1_fip_def.h
+++ b/plat/st/stm32mp1/stm32mp1_fip_def.h
@@ -1,5 +1,5 @@
 /*
- * Copyright (C) 2021-2024, STMicroelectronics - All Rights Reserved
+ * Copyright (C) 2021-2026, STMicroelectronics - All Rights Reserved
  *
  * SPDX-License-Identifier: BSD-3-Clause
  */
@@ -26,8 +26,13 @@
 #endif
 #endif /* STM32MP13 */
 #if STM32MP15
+#ifndef AARCH32_SP_OPTEE
+#define STM32MP_BL2_RO_SIZE		U(0x00012000)	/* 72 KB */
+#define STM32MP_BL2_SIZE		U(0x00018000)	/* 96 KB for BL2 */
+#else
 #define STM32MP_BL2_RO_SIZE		U(0x00010000)	/* 64 KB */
 #define STM32MP_BL2_SIZE		U(0x00017000)	/* 92 KB for BL2 */
+#endif
 #endif /* STM32MP15 */
 #endif /* TRUSTED_BOARD_BOOT && !STM32MP_USE_EXTERNAL_HEAP */
 
-- 
2.53.0

