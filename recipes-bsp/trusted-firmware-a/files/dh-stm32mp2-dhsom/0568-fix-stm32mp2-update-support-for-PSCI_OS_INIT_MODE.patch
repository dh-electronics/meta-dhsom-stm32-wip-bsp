 #define PWRSTATE_RUN \
-	stm32_make_pwrstate(RUN, RUN, RUN, RUN, RET, PSTATE_TYPE_STANDBY)
+	stm32_make_pwrstate(RUN, RUN, RUN, RUN, LP, PSTATE_TYPE_STANDBY)
 
-/* State-id - 0x00000011 Stop1 */
