From 16dd15ddfe6eacbb4b098dcca1692d00f6308242 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Tue, 26 Nov 2024 14:00:58 +0100
Subject: [PATCH 293/572] feat(st-clock): add ck_sys_dbg clock for STM32MP2

Add management of ck_sys_dbg clock.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git b3d68ddc2df2ce5d88c9c5b7105babc885022f7a feat(st-clock): add ck_sys_dbg clock for STM32MP2]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: Ieca03a649b0dfdb824ef0c9c67ec6a3d4eae1715
---
 drivers/st/clk/clk-stm32mp2.c | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/drivers/st/clk/clk-stm32mp2.c b/drivers/st/clk/clk-stm32mp2.c
index 2f548abe6f..40cda4ac46 100644
--- a/drivers/st/clk/clk-stm32mp2.c
+++ b/drivers/st/clk/clk-stm32mp2.c
@@ -261,6 +261,7 @@ enum clock {
 #endif /* !STM32MP21 */
 	_CK_STGEN,
 	_CK_SYSCPU1,
+	_CK_SYSDBG,
 	_CK_SYSRAM,
 	_CK_UART4,
 	_CK_UART5,
@@ -431,6 +432,7 @@ enum enum_gate_cfg {
 	GATE_IWDG1,
 	GATE_IWDG2,
 
+	GATE_DBG,
 	GATE_DDRCAPB,
 	GATE_DDR,
 
@@ -566,6 +568,7 @@ static const struct gate_cfg gates_mp2[LAST_GATE] = {
 	GATE_CFG(GATE_BSEC,		RCC_BSECCFGR,		1,	0),
 	GATE_CFG(GATE_IWDG1,		RCC_IWDG1CFGR,		1,	0),
 	GATE_CFG(GATE_IWDG2,		RCC_IWDG2CFGR,		1,	0),
+	GATE_CFG(GATE_DBG,		RCC_DBGCFGR,		8,	0),
 	GATE_CFG(GATE_DDRCAPB,		RCC_DDRCAPBCFGR,	1,	0),
 	GATE_CFG(GATE_DDR,		RCC_DDRCFGR,		1,	0),
 	GATE_CFG(GATE_USART2,		RCC_USART2CFGR,		1,	0),
@@ -1634,6 +1637,8 @@ static const struct clk_stm32 stm32mp2_clk[CK_LAST] = {
 	STM32_GATE(_CK_DDRCAPB, CK_BUS_DDRC, _CK_ICN_APB4, 0, GATE_DDRCAPB),
 	STM32_GATE(_CK_DDR, CK_BUS_DDRCFG, _CK_ICN_APB4, 0, GATE_DDR),
 
+	STM32_GATE(_CK_SYSDBG, CK_SYSDBG, _CK_ICN_APBDBG, 0, GATE_DBG),
+
 	STM32_GATE(_CK_USART2, CK_KER_USART2, _CK_FLEXGEN_08, 0, GATE_USART2),
 	STM32_GATE(_CK_UART4, CK_KER_UART4, _CK_FLEXGEN_08, 0, GATE_UART4),
 	STM32_GATE(_CK_USART3, CK_KER_USART3, _CK_FLEXGEN_09, 0, GATE_USART3),
