From c6977c63fe0bf328361b6b6b652c76fe553921b7 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Wed, 29 May 2024 19:40:59 +0200
Subject: [PATCH 128/572] feat(stm32mp2): enable watchdog driver

This patch enables watchdog support on STM32MP2.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git fefffbf89f3153efd06bcd0345eb321472e1b6e6 feat(stm32mp2): enable watchdog driver]
Signed-off-by: Christophe Roullier <christophe.roullier@st.com>
Change-Id: Ib953fc06498e9a68906c873600299ea87a5a2c61
---
 plat/st/stm32mp2/platform.mk    |  1 +
 plat/st/stm32mp2/stm32mp2_def.h | 11 +++++++++++
 2 files changed, 12 insertions(+)

diff --git a/plat/st/stm32mp2/platform.mk b/plat/st/stm32mp2/platform.mk
index a079309b77..4355b9e586 100644
--- a/plat/st/stm32mp2/platform.mk
+++ b/plat/st/stm32mp2/platform.mk
@@ -213,6 +213,7 @@ PLAT_BL_COMMON_SOURCES		+=	drivers/st/i2c/stm32_i2c.c
 PLAT_BL_COMMON_SOURCES		+=	plat/st/stm32mp2/stm32mp2_private.c
 
 PLAT_BL_COMMON_SOURCES		+=	drivers/st/bsec/bsec3.c					\
+					drivers/st/iwdg/stm32_iwdg.c				\
 					drivers/st/reset/stm32mp2_reset.c			\
 					plat/st/stm32mp2/stm32mp2_pwr.c				\
 					plat/st/stm32mp2/stm32mp2_syscfg.c
diff --git a/plat/st/stm32mp2/stm32mp2_def.h b/plat/st/stm32mp2/stm32mp2_def.h
index c49e7343e4..c0ad902970 100644
--- a/plat/st/stm32mp2/stm32mp2_def.h
+++ b/plat/st/stm32mp2/stm32mp2_def.h
@@ -504,6 +504,16 @@ static inline uintptr_t tamp_bkpr(uint32_t idx)
  ******************************************************************************/
 #define DDRPHYC_BASE				U(0x48C00000)
 
+/*******************************************************************************
+ * STM32MP2 IWDG
+ ******************************************************************************/
+#define IWDG_MAX_INSTANCE			U(2)
+#define IWDG1_INST				U(0)
+#define IWDG2_INST				U(1)
+
+#define IWDG1_BASE				U(0x44010000)
+#define IWDG2_BASE				U(0x44020000)
+
 /*******************************************************************************
  * Miscellaneous STM32MP2 peripherals base address
  ******************************************************************************/
@@ -611,6 +621,7 @@ static inline uintptr_t tamp_bkpr(uint32_t idx)
  ******************************************************************************/
 #define DT_BSEC_COMPAT				"st,stm32mp25-bsec"
 #define DT_DDR_COMPAT				"st,stm32mp2-ddr"
+#define DT_IWDG_COMPAT				"st,stm32mp1-iwdg"
 #if STM32MP21
 #define DT_PWR_COMPAT				"st,stm32mp21-pwr"
 #define DT_RCC_CLK_COMPAT			"st,stm32mp21-rcc"
-- 
2.53.0

