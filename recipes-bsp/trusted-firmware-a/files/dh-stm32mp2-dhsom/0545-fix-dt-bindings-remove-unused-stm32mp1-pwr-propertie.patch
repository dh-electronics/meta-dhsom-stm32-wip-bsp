From c4ef2be99134224a707060b200cce98ced575794 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Tue, 2 Jun 2026 13:11:51 +0200
Subject: [PATCH 545/572] fix(dt-bindings): remove unused stm32mp1 pwr
 properties for low power

Some properties are no more used in TF-A code, as PSCI is managed by
OP-TEE and are not present in device tree, so they can be removed in
binding file.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 22787b0ab2163892bef4fa47f3c822eb461e78ba fix(dt-bindings): remove unused stm32mp1 pwr properties for low power]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I76d251692f96b346be374f06d14fb455e0be8626
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/573647
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
---
 .../bindings/power/st,stm32mp1-pwr.txt        | 25 -------------------
 1 file changed, 25 deletions(-)

diff --git a/docs/devicetree/bindings/power/st,stm32mp1-pwr.txt b/docs/devicetree/bindings/power/st,stm32mp1-pwr.txt
index 0d98d67f87..a6e62513b1 100644
--- a/docs/devicetree/bindings/power/st,stm32mp1-pwr.txt
+++ b/docs/devicetree/bindings/power/st,stm32mp1-pwr.txt
@@ -11,34 +11,9 @@ Required properties:
 - reg: should be register base and length as documented in the
   datasheet
 
-Optional Properties:
-- Nodes corresponding to PSCI commands issued by kernel:
-  - system_suspend_supported_soc_modes: list of supported SoC modes in suspend
-  - system_off_soc_mode: SoC mode for shutdown
-  - st,retram-enabled-in-standby-ddr-sr: enable retram during standby-ddr-sr
-
-The list of SoC modes is in include/dt-bindings/power/stm32mp1-power.h:
-  - modes for system_suspend
-	1 -> STM32_PM_CSTOP_ALLOW_STOP
-	2 -> STM32_PM_CSTOP_ALLOW_LP_STOP
-	3 -> STM32_PM_CSTOP_ALLOW_LPLV_STOP
-	4 -> STM32_PM_CSTANDBY_ALLOW_LPLV_STOP2 (only for STM32MP13)
-	5 -> STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_SR
-  - modes for system_off
-	6 -> STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_OFF
-	7 -> STM32_PM_SHUTDOWN
-
 Example:
 
 pwr: pwr@50001000 {
 	compatible = "st,stm32mp1-pwr", "st,stm32-pwr", "syscon", "simple-mfd";
 	reg = <0x50001000 0x400>;
-
-	system_suspend_supported_soc_modes = <
-		STM32_PM_CSLEEP_RUN
-		STM32_PM_CSTOP_ALLOW_LP_STOP
-		STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_SR
-	>;
-
-	system_off_soc_mode = <STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_OFF>;
 };
-- 
2.53.0

