From 61311e774e855501de9db526ee1bde7e533fe22b Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Wed, 27 May 2026 14:49:52 +0200
Subject: [PATCH 486/572] fix(sdei): move SDEI_SUPPORT flag management in
 Makefile

SDEI_SUPPORT is set to 0 in make_helpers/defaults.mk, and can be set to
1 in platforms mk files. Its management with assert_booleans and
add_defines macros can then be done in Makfile.
For Aarch32 platforms, the bl31.mk file is not included, and the flag
is then not defined. It triggers warning when enabling -Wundef flag.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 57be1849977331e622fb1d52c1d2b662ea61babd fix(sdei): move SDEI_SUPPORT flag management in Makefile]
Change-Id: Icc034d711d70ae30e0ad78d177c8180d15f06d97
Signed-off-by: Yann Gautier <yann.gautier@st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/572126
Tested-by: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 Makefile     | 4 +++-
 bl31/bl31.mk | 4 +---
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/Makefile b/Makefile
index 237fad0859..fdbf5e045c 100644
--- a/Makefile
+++ b/Makefile
@@ -1,5 +1,5 @@
 #
-# Copyright (c) 2013-2025, Arm Limited and Contributors. All rights reserved.
+# Copyright (c) 2013-2026, Arm Limited and Contributors. All rights reserved.
 #
 # SPDX-License-Identifier: BSD-3-Clause
 #
@@ -653,6 +653,7 @@ $(eval $(call assert_booleans,\
 	PRESERVE_DSU_PMU_REGS \
 	HOB_LIST \
 	LFA_SUPPORT \
+	SDEI_SUPPORT \
 )))
 
 # Numeric_Flags
@@ -908,6 +909,7 @@ $(eval $(call add_defines,\
 	HOB_LIST \
 	HW_CONFIG_BASE \
 	LFA_SUPPORT \
+	SDEI_SUPPORT \
 )))
 
 ifeq (${PLATFORM_REPORT_CTX_MEM_USE}, 1)
diff --git a/bl31/bl31.mk b/bl31/bl31.mk
index d0f6c2d1b4..bb238d4097 100644
--- a/bl31/bl31.mk
+++ b/bl31/bl31.mk
@@ -1,5 +1,5 @@
 #
-# Copyright (c) 2013-2025, Arm Limited and Contributors. All rights reserved.
+# Copyright (c) 2013-2026, Arm Limited and Contributors. All rights reserved.
 #
 # SPDX-License-Identifier: BSD-3-Clause
 #
@@ -234,7 +234,6 @@ $(eval $(call assert_booleans,\
     $(sort \
 	CRASH_REPORTING \
 	EL3_EXCEPTION_HANDLING \
-	SDEI_SUPPORT \
 	USE_DSU_DRIVER \
 )))
 
@@ -248,6 +247,5 @@ $(eval $(call add_defines,\
     $(sort \
 	CRASH_REPORTING \
 	EL3_EXCEPTION_HANDLING \
-	SDEI_SUPPORT \
 	USE_DSU_DRIVER \
 )))
