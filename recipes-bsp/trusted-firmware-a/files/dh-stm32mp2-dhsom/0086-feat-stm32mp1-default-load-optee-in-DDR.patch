From f6469e46669964c575d665115b756afb26799950 Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@linaro.org>
Date: Thu, 30 Mar 2023 18:35:04 +0200
Subject: [PATCH 086/572] feat(stm32mp1): default load optee in DDR

Adds config switch STM32MP1_OPTEE_IN_SYSRAM. When enabled, OP-TEE is
loading in SYSRAM and executes with pager. When disabled, OP-TEE is
executed in DDR. The switch is default disabled.

bl2_el3_plat_prepare_exit() is also updated to flush BL2 data in RAM
when OP-TEE executes in DDR to ensure BL2 low power sequences are
consistent in SYSRAM for OP-TEE to call these resident services.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git ff48cbace48750e52977b8dd5da97a569188c2d0 feat(stm32mp1): default load optee in DDR]
Change-Id: Id923e02d55506cb9a6554716819d8c90d93e6f55
Signed-off-by: Etienne Carriere <etienne.carriere@linaro.org>
---
 fdts/stm32mp15-fw-config.dtsi       | 8 ++++++++
 plat/st/stm32mp1/platform.mk        | 7 +++++++
 plat/st/stm32mp1/stm32mp1_fip_def.h | 2 +-
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/fdts/stm32mp15-fw-config.dtsi b/fdts/stm32mp15-fw-config.dtsi
index 6f478d4981..247e91ae99 100644
--- a/fdts/stm32mp15-fw-config.dtsi
+++ b/fdts/stm32mp15-fw-config.dtsi
@@ -41,11 +41,19 @@
 		};
 
 #ifdef AARCH32_SP_OPTEE
+#if STM32MP1_OPTEE_IN_SYSRAM
 		tos_fw {
 			load-address = <0x0 STM32MP_OPTEE_BASE>;
 			max-size = <STM32MP_OPTEE_SIZE>;
 			id = <BL32_IMAGE_ID>;
 		};
+#else
+		tos_fw {
+			load-address = <0x0 DDR_SEC_BASE>;
+			max-size = <DDR_SEC_SIZE>;
+			id = <BL32_IMAGE_ID>;
+		};
+#endif /* STM32MP1_OPTEE_IN_SYSRAM */
 #else
 		tos_fw {
 			load-address = <0x0 STM32MP_BL32_BASE>;
diff --git a/plat/st/stm32mp1/platform.mk b/plat/st/stm32mp1/platform.mk
index f1e175ac48..1bc7b51e51 100644
--- a/plat/st/stm32mp1/platform.mk
+++ b/plat/st/stm32mp1/platform.mk
@@ -61,6 +61,9 @@ endif
 # STM32 image header version v2.0
 STM32_HEADER_VERSION_MAJOR:=	2
 STM32_HEADER_VERSION_MINOR:=	0
+
+# OP-TEE cannot be in SYSRAM on STM32MP13
+override STM32MP1_OPTEE_IN_SYSRAM :=	0
 endif
 
 ifeq ($(STM32MP15),1)
@@ -73,6 +76,8 @@ STM32_HEADER_VERSION_MAJOR:=	1
 STM32_HEADER_VERSION_MINOR:=	0
 STM32MP_CRYPTO_ROM_LIB :=	1
 
+STM32MP1_OPTEE_IN_SYSRAM ?=	0
+
 # Decryption support
 ifneq ($(DECRYPTION_SUPPORT),none)
 $(error "DECRYPTION_SUPPORT not supported on STM32MP15")
@@ -160,6 +165,7 @@ $(eval $(call assert_booleans,\
 		STM32MP_USE_EXTERNAL_HEAP \
 		STM32MP13 \
 		STM32MP15 \
+		STM32MP1_OPTEE_IN_SYSRAM \
 )))
 
 $(eval $(call assert_numerics,\
@@ -191,6 +197,7 @@ $(eval $(call add_defines,\
 		STM32MP_USE_EXTERNAL_HEAP \
 		STM32MP13 \
 		STM32MP15 \
+		STM32MP1_OPTEE_IN_SYSRAM \
 )))
 
 # Include paths and source files
diff --git a/plat/st/stm32mp1/stm32mp1_fip_def.h b/plat/st/stm32mp1/stm32mp1_fip_def.h
index 165f152326..19f95404d1 100644
--- a/plat/st/stm32mp1/stm32mp1_fip_def.h
+++ b/plat/st/stm32mp1/stm32mp1_fip_def.h
@@ -92,7 +92,7 @@
 #define STM32MP_DTB_BASE		STM32MP_BL32_DTB_BASE
 #endif
 
-#ifdef AARCH32_SP_OPTEE
+#if defined(AARCH32_SP_OPTEE) && STM32MP1_OPTEE_IN_SYSRAM
 #define STM32MP_OPTEE_BASE		STM32MP_SEC_SYSRAM_BASE
 
 #define STM32MP_OPTEE_SIZE		(STM32MP_BL2_DTB_BASE -  \
-- 
2.53.0

