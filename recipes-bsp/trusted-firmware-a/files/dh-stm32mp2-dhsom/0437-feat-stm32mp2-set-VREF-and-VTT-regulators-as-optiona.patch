From a2e792bb2a75800edde82c23760ff54f53cd2f02 Mon Sep 17 00:00:00 2001
From: Nicolas Le Bayon <nicolas.le.bayon@foss.st.com>
Date: Mon, 2 Feb 2026 15:01:30 +0100
Subject: [PATCH 437/572] feat(stm32mp2): set VREF and VTT regulators as
 optional

On DDR3 and DDR4, VREF is mandatory but it can be generated in two ways:
- by a dedicated regulator (for example VREFDDR on STPMIC2)
- by a resistor dividing bridge from VDD_DDR (VREF=VDD_DDR/2)
So at software level, VREF can be considered as optional.

As VTT can also be unused when there is only one memory device,
it should also have the same optional status.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git f8cf99497200d0054ee6aa560941d74493ccf6d1 feat(stm32mp2): set VREF and VTT regulators as optional]
Signed-off-by: Nicolas Le Bayon <nicolas.le.bayon@foss.st.com>
Change-Id: Id99076bd0dcd6bcbce5f389794955e264f7453fe
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/543926
Reviewed-by: Nicolas LE BAYON <nicolas.le.bayon@st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
Tested-by: Nicolas LE BAYON <nicolas.le.bayon@st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 plat/st/stm32mp2/plat_ddr.c | 37 ++++++++++++++++++++++---------------
 1 file changed, 22 insertions(+), 15 deletions(-)

diff --git a/plat/st/stm32mp2/plat_ddr.c b/plat/st/stm32mp2/plat_ddr.c
index 5cceef56fc..2defec457e 100644
--- a/plat/st/stm32mp2/plat_ddr.c
+++ b/plat/st/stm32mp2/plat_ddr.c
@@ -42,7 +42,7 @@ static int ddr_power_init(void *fdt, int node)
 	struct ddr3_supply supply;
 
 	ddr3_supply_read(fdt, node, &supply);
-	if ((supply.vdd == NULL) || (supply.vref == NULL) || (supply.vtt == NULL)) {
+	if (supply.vdd == NULL) {
 		return -ENOENT;
 	}
 
@@ -55,14 +55,18 @@ static int ddr_power_init(void *fdt, int node)
 		return status;
 	}
 
-	status = regulator_enable(supply.vref);
-	if (status != 0) {
-		return status;
+	if (supply.vref != NULL) {
+		status = regulator_enable(supply.vref);
+		if (status != 0) {
+			return status;
+		}
 	}
 
-	status = regulator_enable(supply.vtt);
-	if (status != 0) {
-		return status;
+	if (supply.vtt != NULL) {
+		status = regulator_enable(supply.vtt);
+		if (status != 0) {
+			return status;
+		}
 	}
 
 	return regulator_enable(supply.vdd);
@@ -113,8 +117,7 @@ static int ddr_power_init(void *fdt, int node)
 	struct ddr4_supply supply;
 
 	ddr4_supply_read(fdt, node, &supply);
-	if ((supply.vpp == NULL) || (supply.vdd == NULL) || (supply.vref == NULL) ||
-	    (supply.vtt == NULL)) {
+	if ((supply.vpp == NULL) || (supply.vdd == NULL)) {
 		return -ENOENT;
 	}
 
@@ -137,14 +140,18 @@ static int ddr_power_init(void *fdt, int node)
 		return status;
 	}
 
-	status = regulator_enable(supply.vref);
-	if (status != 0) {
-		return status;
+	if (supply.vref != NULL) {
+		status = regulator_enable(supply.vref);
+		if (status != 0) {
+			return status;
+		}
 	}
 
-	status = regulator_enable(supply.vtt);
-	if (status != 0) {
-		return status;
+	if (supply.vtt != NULL) {
+		status = regulator_enable(supply.vtt);
+		if (status != 0) {
+			return status;
+		}
 	}
 
 	return regulator_enable(supply.vdd);
-- 
