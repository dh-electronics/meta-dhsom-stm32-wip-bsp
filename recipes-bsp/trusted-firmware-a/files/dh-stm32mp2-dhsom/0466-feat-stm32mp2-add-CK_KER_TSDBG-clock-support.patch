From 06cc2a5dbbd8279ce781c39eeb2007a1eca7e8f9 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Tue, 28 Apr 2026 09:36:45 +0200
Subject: [PATCH 466/572] feat(stm32mp2): add CK_KER_TSDBG clock support

Add support for the CK_KER_TSDBG clock on STM32MP2.

This clock is required to properly handle ARM generic timer isolation
against STGEN when entering low-power modes.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git cfed1cb569e3f39a986b8b5826c8986d1bd99c61 feat(stm32mp2): add CK_KER_TSDBG clock support]
Change-Id: Iab8acf49be646e8396cd9b59cca1942dce3bc379
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/561828
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Maxime MERE <maxime.mere@foss.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
---
 drivers/st/clk/clk-stm32mp2.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/st/clk/clk-stm32mp2.c b/drivers/st/clk/clk-stm32mp2.c
index 86c6f60e2e..0dc834bb61 100644
--- a/drivers/st/clk/clk-stm32mp2.c
+++ b/drivers/st/clk/clk-stm32mp2.c
@@ -310,6 +310,7 @@ enum clock {
 	_CK_USBTC,
 #endif /* !STM32MP21 */
 	_CK_BUS_RISAF4,
+	_CK_TSDBG,
 
 	CK_LAST
 };
@@ -1695,6 +1696,7 @@ static const struct clk_stm32 stm32mp2_clk[CK_LAST] = {
 	STM32_GATE(_CK_USBTC, CK_KER_USBTC, _CK_FLEXGEN_35, 0, GATE_USBTC),
 	STM32_GATE(_CK_I2C8, CK_KER_I2C8, _CK_FLEXGEN_38, 0, GATE_I2C8),
 #endif /* !STM32MP21 */
+	STM32_GATE(_CK_TSDBG, CK_KER_TSDBG, _CK_FLEXGEN_43, 0, GATE_DBG),
 	STM32_GATE(_CK_OSPI1, CK_KER_OSPI1, _CK_FLEXGEN_48, 0, GATE_OSPI1),
 #if !STM32MP21
 	STM32_GATE(_CK_OSPI2, CK_KER_OSPI2, _CK_FLEXGEN_49, 0, GATE_OSPI2),
-- 
