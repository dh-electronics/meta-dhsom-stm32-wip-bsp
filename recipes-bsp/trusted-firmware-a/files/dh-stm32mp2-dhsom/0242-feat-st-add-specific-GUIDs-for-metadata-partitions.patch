From 2b73c935226a61136650772c6e20b27c35b5a052 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Mon, 12 Jan 2026 17:14:38 +0100
Subject: [PATCH 242/572] feat(st): add specific GUIDs for metadata partitions
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

metadata1 and metadata2 must be differentiated even though they share
the same partition type GUID. Add two fixed partition GUIDs to uniquely
identify each metadata partition.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git f48d0b4e7036180b1c4f5b5f618029b692183e20 feat(st): add specific GUIDs for metadata partitions]
Change-Id: Ie490651c65a593d401cd7055520018421f38ee9d
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/523844
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 plat/st/common/include/stm32mp_efi.h | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/plat/st/common/include/stm32mp_efi.h b/plat/st/common/include/stm32mp_efi.h
index af9165f1da..c1d48f74b9 100644
--- a/plat/st/common/include/stm32mp_efi.h
+++ b/plat/st/common/include/stm32mp_efi.h
@@ -13,4 +13,12 @@
 	EFI_GUID(0x19d5df83U, 0x11b0U, 0x457bU, \
 		 0xbeU, 0x2cU, 0x75U, 0x59U, 0xc1U, 0x31U, 0x42U, 0xa5U)
 
+#define FWU_METADATA1_PART_GUID \
+	EFI_GUID(0x5F91C128U, 0xE120U, 0x48D7U, \
+		 0xBBU, 0x64U, 0x9FU, 0xA9U, 0xAEU, 0xD4U, 0xC7U, 0xE3U)
+
+#define FWU_METADATA2_PART_GUID \
+	EFI_GUID(0xF469F981U, 0x5985U, 0x4206U, \
+		 0x8FU, 0xB3U, 0x83U, 0x99U, 0x56U, 0x03U, 0x5AU, 0x65U)
+
 #endif /* STM32MP_EFI_H */
