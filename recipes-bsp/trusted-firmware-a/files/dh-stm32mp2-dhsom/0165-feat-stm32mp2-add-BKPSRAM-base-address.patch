From a9399bfe469630a6bc2e402c8a9d1f80228c922f Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@foss.st.com>
Date: Tue, 31 May 2022 18:12:41 +0200
Subject: [PATCH 165/572] feat(stm32mp2): add BKPSRAM base address

Define STM32MP_BACKUP_RAM_BASE as the base address for BKPSRAM.
This is the same macro as STM32MP1.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 8e9cb3bdd178ccb77310be6dffda97623cc85a82 feat(stm32mp2): add BKPSRAM base address]
Signed-off-by: Yann Gautier <yann.gautier@foss.st.com>
Change-Id: I69d79f45b42899f1f0688d78a64f19c04aea448f
---
 plat/st/stm32mp2/stm32mp2_def.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/plat/st/stm32mp2/stm32mp2_def.h b/plat/st/stm32mp2/stm32mp2_def.h
index b4f2908b6c..96ee12d8fc 100644
--- a/plat/st/stm32mp2/stm32mp2_def.h
+++ b/plat/st/stm32mp2/stm32mp2_def.h
@@ -148,6 +148,7 @@
 #define RETRAM_BASE				U(0x0E080000)
 #endif /* STM32MP21 */
 #define RETRAM_SIZE				U(0x00020000)
+#define STM32MP_BACKUP_RAM_BASE			U(0x42000000)
 
 #if defined(IMAGE_BL2) && STM32MP_USB_PROGRAMMER && !STM32MP21
 #define STM32MP_USB_DWC3_SIZE			PAGE_SIZE
-- 
2.53.0

