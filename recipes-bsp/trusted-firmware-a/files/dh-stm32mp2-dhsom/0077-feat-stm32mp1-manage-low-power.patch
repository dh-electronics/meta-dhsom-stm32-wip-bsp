+#if STM32MP_SUPPORT_PM
+		if (bl_mem_params->ep_info.pc >= STM32MP_DDR_BASE) {
+			stm32_context_save_bl2_param();
+		}
+#endif /* STM32MP_SUPPORT_PM */
 		break;
 
 	case BL33_IMAGE_ID:
