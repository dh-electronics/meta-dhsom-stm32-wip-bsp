@@ -697,6 +698,9 @@ bool stm32mp_is_wakeup_from_standby(void)
 #endif
 
 	return true;
+#else /* STM32MP_SUPPORT_PM */
+	return false;
+#endif /* STM32MP_SUPPORT_PM */
 }
 
