From 41c3b2b246736e579c6d1f4389304c19ce4d47f7 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Fri, 22 May 2026 17:15:00 +0200
Subject: [PATCH 484/572] fix(el3-runtime): improve PLAT_PCPU_DATA_SIZE check

PLAT_PCPU_DATA_SIZE can optionally be defined in platform_def.h file.
To avoid a warning when enabling -Wundef flag, check its definition
and its value is above 0.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 69f228c2992252a9042f50cc4bbe016bee78eef1 fix(el3-runtime): improve PLAT_PCPU_DATA_SIZE check]
Change-Id: Ib4ecae1e13cd5b73dda2f9b41c7f93bd79ddefd6
Signed-off-by: Yann Gautier <yann.gautier@st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/572124
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
Tested-by: Yann GAUTIER <yann.gautier@foss.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 include/lib/el3_runtime/cpu_data.h | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/include/lib/el3_runtime/cpu_data.h b/include/lib/el3_runtime/cpu_data.h
index 6445e281f5..0817169220 100644
--- a/include/lib/el3_runtime/cpu_data.h
+++ b/include/lib/el3_runtime/cpu_data.h
@@ -1,5 +1,5 @@
 /*
- * Copyright (c) 2014-2025, Arm Limited and Contributors. All rights reserved.
+ * Copyright (c) 2014-2026, Arm Limited and Contributors. All rights reserved.
  *
  * SPDX-License-Identifier: BSD-3-Clause
  */
@@ -145,7 +145,7 @@ typedef struct cpu_data {
 #if ENABLE_RUNTIME_INSTRUMENTATION
 	uint64_t cpu_data_pmf_ts[CPU_DATA_PMF_TS_COUNT];
 #endif
-#if PLAT_PCPU_DATA_SIZE
+#if defined(PLAT_PCPU_DATA_SIZE) && (PLAT_PCPU_DATA_SIZE > 0)
 	uint8_t platform_cpu_data[PLAT_PCPU_DATA_SIZE];
 #endif
 #if EL3_EXCEPTION_HANDLING
@@ -176,7 +176,7 @@ CPU_DATA_ASSERT_OFFSET(CRASH_BUF, crash_buf);
 #if ENABLE_RUNTIME_INSTRUMENTATION
 CPU_DATA_ASSERT_OFFSET(CPU_DATA_PMF_TS, cpu_data_pmf_ts);
 #endif
-#if PLAT_PCPU_DATA_SIZE
+#if defined(PLAT_PCPU_DATA_SIZE) && (PLAT_PCPU_DATA_SIZE > 0)
 CPU_DATA_ASSERT_OFFSET(PLATFORM_CPU_DATA, platform_cpu_data);
 #endif
 #if EL3_EXCEPTION_HANDLING
-- 
