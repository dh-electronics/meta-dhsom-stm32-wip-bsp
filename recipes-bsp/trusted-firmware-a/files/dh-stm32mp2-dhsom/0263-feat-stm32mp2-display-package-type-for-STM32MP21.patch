From f4a4a2325821c07eea54669340a5d9363c125a60 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@foss.st.com>
Date: Wed, 3 Jul 2024 17:19:00 +0200
Subject: [PATCH 263/572] feat(stm32mp2): display package type for STM32MP21

The package type is read from OTP fuse. Display it with other SoC
information at boot.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git a82346d41fe7456ce5403183e0a4b3ce536e727e feat(stm32mp2): display package type for STM32MP21]
Change-Id: Ib75461f4eebd56be5e29c93d488c0a8f84d5575a
Signed-off-by: Yann Gautier <yann.gautier@foss.st.com>
---
 plat/st/stm32mp2/stm32mp2_def.h     |  7 +++++++
 plat/st/stm32mp2/stm32mp2_private.c | 17 +++++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/plat/st/stm32mp2/stm32mp2_def.h b/plat/st/stm32mp2/stm32mp2_def.h
index 694ea9a00f..8a2f9ff750 100644
--- a/plat/st/stm32mp2/stm32mp2_def.h
+++ b/plat/st/stm32mp2/stm32mp2_def.h
@@ -117,6 +117,13 @@
 /*******************************************************************************
  * PACKAGE ID
  ******************************************************************************/
+#if STM32MP21
+#define STM32MP21_PKG_CUSTOM			U(0)
+#define STM32MP21_PKG_AL_VFBGA361		U(1)
+#define STM32MP21_PKG_AN_VFBGA273		U(3)
+#define STM32MP21_PKG_AO_VFBGA225		U(4)
+#define STM32MP21_PKG_AM_TFBGA289		U(5)
+#endif /* STM32MP21 */
 #if STM32MP23
 #define STM32MP23_PKG_CUSTOM			U(0)
 #define STM32MP23_PKG_AL_VFBGA361		U(1)
diff --git a/plat/st/stm32mp2/stm32mp2_private.c b/plat/st/stm32mp2/stm32mp2_private.c
index 6de26efa55..7262155f7b 100644
--- a/plat/st/stm32mp2/stm32mp2_private.c
+++ b/plat/st/stm32mp2/stm32mp2_private.c
@@ -374,6 +374,23 @@ void stm32mp_get_soc_name(char name[STM32_SOC_NAME_SIZE])
 
 	/* Package */
 	switch (get_cpu_package()) {
+#if STM32MP21
+	case STM32MP21_PKG_CUSTOM:
+		pkg = "XX";
+		break;
+	case STM32MP21_PKG_AL_VFBGA361:
+		pkg = "AL";
+		break;
+	case STM32MP21_PKG_AN_VFBGA273:
+		pkg = "AN";
+		break;
+	case STM32MP21_PKG_AO_VFBGA225:
+		pkg = "AO";
+		break;
+	case STM32MP21_PKG_AM_TFBGA289:
+		pkg = "AM";
+		break;
+#endif /* STM32MP21 */
 #if STM32MP23
 	case STM32MP23_PKG_CUSTOM:
 		pkg = "XX";
-- 
2.53.0

