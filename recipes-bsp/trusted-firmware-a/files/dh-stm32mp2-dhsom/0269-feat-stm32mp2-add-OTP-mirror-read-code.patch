diff --git a/plat/st/common/stm32mp_common.c b/plat/st/common/stm32mp_common.c
index 4fb0e705d1..36ff9f70b8 100644
--- a/plat/st/common/stm32mp_common.c
+++ b/plat/st/common/stm32mp_common.c
@@ -203,6 +203,10 @@ int stm32_get_otp_value_from_idx(const uint32_t otp_idx, uint32_t *otp_val)
 
 	assert(otp_val != NULL);
 
+	if (otp_mirror_read(otp_val, otp_idx) == BSEC_OK) {
+		return 0;
+	}
+
 #if defined(IMAGE_BL2)
 	ret = stm32_otp_shadow_read(otp_val, otp_idx);
 #elif defined(IMAGE_BL31) || defined(IMAGE_BL32)
diff --git a/plat/st/stm32mp1/include/stm32mp1_private.h b/plat/st/stm32mp1/include/stm32mp1_private.h
index 54494ec134..b4d6594165 100644
--- a/plat/st/stm32mp1/include/stm32mp1_private.h
+++ b/plat/st/stm32mp1/include/stm32mp1_private.h
@@ -63,4 +63,9 @@ static inline uint32_t stm32_otp_read_sw_lock(uint32_t otp, bool *value)
 	return bsec_read_sw_lock(otp, value);
 }
 
+static inline uint32_t otp_mirror_read(uint32_t *val, uint32_t otp)
+{
+	return BSEC_ERROR;
+}
+
 #endif /* STM32MP1_PRIVATE_H */
diff --git a/plat/st/stm32mp2/include/stm32mp2_private.h b/plat/st/stm32mp2/include/stm32mp2_private.h
index c2d3562afe..cc7d1e81b1 100644
--- a/plat/st/stm32mp2/include/stm32mp2_private.h
+++ b/plat/st/stm32mp2/include/stm32mp2_private.h
@@ -103,6 +103,8 @@ uint32_t stm32_otp_read_sw_lock(uint32_t otp, bool *value);
 bool stm32_is_bsec_closed(void);
 #endif /* STM32MP_M33_TDCID */
 
+uint32_t otp_mirror_read(uint32_t *val, uint32_t otp);
+
 void stm32mp_ca35_set_vbar(uintptr_t vbar);
 
 #endif /* STM32MP2_PRIVATE_H */
diff --git a/plat/st/stm32mp2/platform.mk b/plat/st/stm32mp2/platform.mk
index b16119c92b..bc51e251fe 100644
--- a/plat/st/stm32mp2/platform.mk
+++ b/plat/st/stm32mp2/platform.mk
@@ -278,6 +278,7 @@ PLAT_BL_COMMON_SOURCES		+=	drivers/st/bsec/bsec3.c
 else
 PLAT_BL_COMMON_SOURCES		+=	plat/st/stm32mp2/stm32mp2_otp.c
 endif
+PLAT_BL_COMMON_SOURCES		+=	plat/st/stm32mp2/stm32mp2_otp_mirror.c
 
 PLAT_BL_COMMON_SOURCES		+=	drivers/st/iwdg/stm32_iwdg.c				\
 					drivers/st/reset/stm32mp2_reset.c			\
diff --git a/plat/st/stm32mp2/stm32mp2_otp_mirror.c b/plat/st/stm32mp2/stm32mp2_otp_mirror.c
new file mode 100644
index 0000000000..7a77392edf
--- /dev/null
+++ b/plat/st/stm32mp2/stm32mp2_otp_mirror.c
@@ -0,0 +1,40 @@
+/*
+ * Copyright (C) 2024, STMicroelectronics - All Rights Reserved
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include <platform_def.h>
+
+/* Magic use to indicated valid mirror = 'B' 'S' 'E' 'C' */
+#define OTP_MIRROR_MAGIC		0x42534543U
+
+#define OTP_MAX_SIZE			(STM32MP2_OTP_MAX_ID + 1U)
+
+struct otp_mirror {
+	uint32_t magic;
+	uint32_t state;
+	struct {
+		uint32_t value;
+		uint32_t status;
+	} otp[OTP_MAX_SIZE];
+};
+
+uint32_t otp_mirror_read(uint32_t *val, uint32_t otp)
+{
+	struct otp_mirror *mirror = (struct otp_mirror *)SRAM1_BASE;
+
+	/* Upper OTPs are not mirrored */
+	if (otp >= STM32MP2_UPPER_OTP_START) {
+		return BSEC_NOT_SUPPORTED;
+	}
+
+	/* OTP already mirrored */
+	if ((mirror->magic == OTP_MIRROR_MAGIC) && (mirror->state != BSEC_STATE_INVALID)) {
+		*val = mirror->otp[otp].value;
+
+		return BSEC_OK;
+	}
+
+	return BSEC_ERROR;
+}
