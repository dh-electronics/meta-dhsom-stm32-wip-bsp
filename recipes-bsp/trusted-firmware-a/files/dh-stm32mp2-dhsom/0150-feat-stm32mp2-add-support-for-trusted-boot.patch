From 6eac994c8a8bbf1181981d42c59eed8dcc1ee35d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Thu, 19 Sep 2024 09:57:35 +0200
Subject: [PATCH 150/572] feat(stm32mp2): add support for trusted boot

Add the required defines and compilation flags to manage trusted boot
(TRUSTED_BOARD_BOOT) for STM32MP2. The size of BL2 and its DT are
increased. Add traces in bl2_el3_plat_arch_setup(), as for STM32MP1.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 1c308105606d1fadf3b0c4ae28d85c4e95e250cf feat(stm32mp2): add support for trusted boot]
Signed-off-by: Yann Gautier <yann.gautier@foss.st.com>
Change-Id: Idd7db7bed6762fe2a619141e9945c4b199d9ded5
---
 plat/st/stm32mp2/bl2_plat_setup.c   | 18 ++++++++++++++++--
 plat/st/stm32mp2/platform.mk        | 29 +++++++++++++++++++++++++++++
 plat/st/stm32mp2/stm32mp2_def.h     | 10 ++++++++++
 plat/st/stm32mp2/stm32mp2_private.c |  4 ++--
 4 files changed, 57 insertions(+), 4 deletions(-)

diff --git a/plat/st/stm32mp2/bl2_plat_setup.c b/plat/st/stm32mp2/bl2_plat_setup.c
index 2453f8afd5..232a29cdea 100644
--- a/plat/st/stm32mp2/bl2_plat_setup.c
+++ b/plat/st/stm32mp2/bl2_plat_setup.c
@@ -179,7 +179,7 @@ void bl2_el3_plat_arch_setup(void)
 		panic();
 	}
 
-#if STM32MP_DDR_FIP_IO_STORAGE
+#if STM32MP_DDR_FIP_IO_STORAGE || TRUSTED_BOARD_BOOT
 	/*
 	 * RISAB3 setup (dedicated for SRAM1)
 	 *
@@ -188,7 +188,7 @@ void bl2_el3_plat_arch_setup(void)
 	 * DDR firmwares are saved there before being loaded in DDRPHY memory.
 	 */
 	mmio_write_32(RISAB3_BASE + RISAB_CR, RISAB_CR_SRWIAD);
-#endif
+#endif /* STM32MP_DDR_FIP_IO_STORAGE || TRUSTED_BOARD_BOOT */
 
 	stm32_save_boot_info(boot_context);
 
@@ -207,7 +207,21 @@ void bl2_el3_plat_arch_setup(void)
 
 	print_reset_reason();
 
+	if (boot_context->auth_status != BOOT_API_CTX_AUTH_NO) {
+		NOTICE("Bootrom authentication %s\n",
+		       (boot_context->auth_status == BOOT_API_CTX_AUTH_FAILED) ?
+		       "failed" : "succeeded");
+	}
+
 skip_console_init:
+#if !TRUSTED_BOARD_BOOT
+	if (stm32mp_check_closed_device() == STM32MP_CHIP_SEC_CLOSED) {
+		/* Closed chip mandates authentication */
+		ERROR("Secure chip: TRUSTED_BOARD_BOOT must be enabled\n");
+		panic();
+	}
+#endif
+
 	if (stm32_rng_init() != 0) {
 		panic();
 	}
diff --git a/plat/st/stm32mp2/platform.mk b/plat/st/stm32mp2/platform.mk
index be0ae09af2..fccec507a2 100644
--- a/plat/st/stm32mp2/platform.mk
+++ b/plat/st/stm32mp2/platform.mk
@@ -57,6 +57,14 @@ $(warning DTB_FILE_NAME=$(DTB_FILE_NAME))
 $(error Cannot enable more than one STM32MP2x flag)
 endif
 
+STM32MP_USE_EXTERNAL_HEAP 	:=	1
+
+ifeq (${TRUSTED_BOARD_BOOT},1)
+# PKA algo to include
+PKA_USE_NIST_P256		:=	1
+PKA_USE_BRAINPOOL_P256T1	:=	1
+endif
+
 # STM32 image header version v2.2 or v2.3 for STM32MP21
 STM32_HEADER_VERSION_MAJOR	:=	2
 ifeq ($(STM32MP21),1)
@@ -65,6 +73,9 @@ else
 STM32_HEADER_VERSION_MINOR	:=	2
 endif
 
+PKA_USE_NIST_P256		?=	0
+PKA_USE_BRAINPOOL_P256T1 	?=	0
+
 STM32_HASH_VER			:=	4
 STM32_RNG_VER			:=	4
 ifeq ($(STM32MP21),1)
@@ -133,6 +144,11 @@ ifeq (${STM32MP_DDR_FIP_IO_STORAGE},1)
 # Add the FW_DDR to FIP and specify the same to certtool
 $(eval $(call TOOL_ADD_IMG,STM32MP_DDR_FW,--ddr-fw))
 endif
+ifeq ($(GENERATE_COT),1)
+STM32MP_CFG_CERT		:=	$(BUILD_PLAT)/stm32mp_cfg_cert.crt
+# Add the STM32MP_CFG_CERT to FIP and specify the same to certtool
+$(eval $(call TOOL_ADD_PAYLOAD,${STM32MP_CFG_CERT},--stm32mp-cfg-cert))
+endif
 
 # Ultratronik Specific Boards
 ifeq ($(findstring ultra-fly,$(DTB_FILE_NAME)),ultra-fly)
@@ -150,11 +166,15 @@ endif
 # Enable flags for C files
 $(eval $(call assert_booleans,\
 	$(sort \
+		PKA_USE_BRAINPOOL_P256T1 \
+		PKA_USE_NIST_P256 \
+		STM32MP_CRYPTO_ROM_LIB \
 		STM32MP_DDR_DUAL_AXI_PORT \
 		STM32MP_DDR_FIP_IO_STORAGE \
 		STM32MP_DDR3_TYPE \
 		STM32MP_DDR4_TYPE \
 		STM32MP_LPDDR4_TYPE \
+		STM32MP_USE_EXTERNAL_HEAP \
 		STM32MP21 \
 		STM32MP23 \
 		STM32MP25 \
@@ -174,6 +194,8 @@ $(eval $(call assert_numerics,\
 $(eval $(call add_defines,\
 	$(sort \
 		DWL_BUFFER_BASE \
+		PKA_USE_BRAINPOOL_P256T1 \
+		PKA_USE_NIST_P256 \
 		PLAT_DEF_FIP_UUID \
 		PLAT_PARTITION_MAX_ENTRIES \
 		PLAT_TBBR_IMG_DEF \
@@ -181,11 +203,13 @@ $(eval $(call add_defines,\
 		STM32_RNG_VER \
 		STM32_RNG_VER_MINOR \
 		STM32_TF_A_COPIES \
+		STM32MP_CRYPTO_ROM_LIB \
 		STM32MP_DDR_DUAL_AXI_PORT \
 		STM32MP_DDR_FIP_IO_STORAGE \
 		STM32MP_DDR3_TYPE \
 		STM32MP_DDR4_TYPE \
 		STM32MP_LPDDR4_TYPE \
+		STM32MP_USE_EXTERNAL_HEAP \
 		STM32MP21 \
 		STM32MP23 \
 		STM32MP25 \
@@ -232,6 +256,11 @@ BL2_SOURCES			+=	drivers/st/crypto/stm32_hash.c
 BL2_SOURCES			+=	drivers/st/rif/stm32_rifsc.c 				\
 					drivers/st/rif/stm32mp2_risaf.c
 
+ifeq (${TRUSTED_BOARD_BOOT},1)
+BL2_SOURCES			+=	drivers/st/crypto/stm32_pka.c
+BL2_SOURCES			+=	drivers/st/crypto/stm32_saes.c
+endif
+
 ifneq ($(filter 1,${STM32MP_EMMC} ${STM32MP_SDMMC}),)
 BL2_SOURCES			+=	drivers/st/mmc/stm32_sdmmc2.c
 endif
diff --git a/plat/st/stm32mp2/stm32mp2_def.h b/plat/st/stm32mp2/stm32mp2_def.h
index d0d21f908a..b4f2908b6c 100644
--- a/plat/st/stm32mp2/stm32mp2_def.h
+++ b/plat/st/stm32mp2/stm32mp2_def.h
@@ -199,6 +199,15 @@ enum ddr_type {
 						 (STM32MP_PARAM_LOAD_SIZE +	\
 						  STM32MP_HEADER_SIZE))
 
+#if TRUSTED_BOARD_BOOT
+#if STM32MP_UART_PROGRAMMER || STM32MP_USB_PROGRAMMER
+#define STM32MP_BL2_RO_SIZE			U(0x00021000) /* 132 KB */
+#define STM32MP_BL2_SIZE			U(0x0002C000) /* 176 KB for BL2 */
+#else /* STM32MP_UART_PROGRAMMER || STM32MP_USB_PROGRAMMER */
+#define STM32MP_BL2_RO_SIZE			U(0x00020000) /* 128 KB */
+#define STM32MP_BL2_SIZE			U(0x0002C000) /* 176 KB for BL2 */
+#endif /* STM32MP_UART_PROGRAMMER || STM32MP_USB_PROGRAMMER */
+#else
 #if STM32MP_UART_PROGRAMMER || STM32MP_USB_PROGRAMMER
 #define STM32MP_BL2_RO_SIZE			U(0x0001F000) /* 124 KB */
 #define STM32MP_BL2_SIZE			U(0x00028000) /* 160 KB for BL2 */
@@ -206,6 +215,7 @@ enum ddr_type {
 #define STM32MP_BL2_RO_SIZE			U(0x00020000) /* 128 KB */
 #define STM32MP_BL2_SIZE			U(0x00029000) /* 164 KB for BL2 */
 #endif /* STM32MP_UART_PROGRAMMER || STM32MP_USB_PROGRAMMER */
+#endif
 
 /* Allocate remaining sysram to BL31 Binary only */
 #define STM32MP_BL31_SIZE			(STM32MP_SYSRAM_SIZE - \
diff --git a/plat/st/stm32mp2/stm32mp2_private.c b/plat/st/stm32mp2/stm32mp2_private.c
index fff1642f31..fc9f071085 100644
--- a/plat/st/stm32mp2/stm32mp2_private.c
+++ b/plat/st/stm32mp2/stm32mp2_private.c
@@ -47,7 +47,7 @@
 					MT_EXECUTE_NEVER)
 #endif /* STM32MP_USB_PROGRAMMER && !STM32MP21 */
 
-#if STM32MP_DDR_FIP_IO_STORAGE
+#if STM32MP_DDR_FIP_IO_STORAGE || TRUSTED_BOARD_BOOT
 #define MAP_SRAM1	MAP_REGION_FLAT(SRAM1_BASE, \
 					SRAM1_SIZE_FOR_TFA, \
 					MT_MEMORY | \
@@ -71,7 +71,7 @@ static const mmap_region_t stm32mp2_mmap[] = {
 #else /* !STM32MP_USB_PROGRAMMER || STM32MP21 */
 	MAP_SYSRAM,
 #endif /* STM32MP_USB_PROGRAMMER && !STM32MP21 */
-#if STM32MP_DDR_FIP_IO_STORAGE
+#if STM32MP_DDR_FIP_IO_STORAGE || TRUSTED_BOARD_BOOT
 	MAP_SRAM1,
 #endif
 	MAP_DEVICE,
-- 
