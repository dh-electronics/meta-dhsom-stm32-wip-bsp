From 24836b13ad58c52f704549f016c164b87ffc37ad Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Tue, 7 Apr 2026 09:28:00 +0200
Subject: [PATCH 456/572] fix(st-clock): improve clock enabling/disabling
 barriers

Instead of a dsb barrier, re-read the RCC register we've just written,
to ensure the operation has been done. And replace the dsb with a dmb
before disabling the clock, as this properly ensures the order of
operations, no need for a dsb.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 673a6dd79aaf0d524167b27d913bc2ed65e3ebbe fix(st-clock): improve clock enabling/disabling barriers]
Change-Id: I624084e8a11091c0e089ad81d0cf1dbb8d442389
Signed-off-by: Yann Gautier <yann.gautier@st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/554493
Tested-by: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
---
 drivers/st/clk/clk-stm32-core.c |  8 +++++---
 drivers/st/clk/stm32mp1_clk.c   | 10 +++++++---
 2 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/drivers/st/clk/clk-stm32-core.c b/drivers/st/clk/clk-stm32-core.c
index 59c553c9fc..629bf1129f 100644
--- a/drivers/st/clk/clk-stm32-core.c
+++ b/drivers/st/clk/clk-stm32-core.c
@@ -73,7 +73,8 @@ static int clk_gate_enable(struct stm32_clk_priv *priv, int id)
 
 	mmio_setbits_32(priv->base + cfg->offset, BIT(cfg->bit_idx));
 
-	dsb(); /* Make sure the clock is enabled.  */
+	/* Make sure the clock register has been written */
+	(void)mmio_read_32(priv->base + cfg->offset);
 
 	return 0;
 }
@@ -83,11 +84,12 @@ static void clk_gate_disable(struct stm32_clk_priv *priv, int id)
 	const struct clk_stm32 *clk = _clk_get(priv, id);
 	struct clk_gate_cfg *cfg = clk->clock_cfg;
 
-	dsb(); /* Ensure prebious transaction are performed before stop.  */
+	dmbsy(); /* Ensure previous transactions are performed. */
 
 	mmio_clrbits_32(priv->base + cfg->offset, BIT(cfg->bit_idx));
 
-	dsb(); /* Make sure the clock is disabled.  */
+	/* Make sure the clock register has been written */
+	(void)mmio_read_32(priv->base + cfg->offset);
 }
 
 static bool clk_gate_is_enabled(struct stm32_clk_priv *priv, int id)
diff --git a/drivers/st/clk/stm32mp1_clk.c b/drivers/st/clk/stm32mp1_clk.c
index 2a571d6996..45bdc88ba6 100644
--- a/drivers/st/clk/stm32mp1_clk.c
+++ b/drivers/st/clk/stm32mp1_clk.c
@@ -1312,7 +1312,9 @@ static void __clk_enable(struct stm32mp1_clk_gate const *gate)
 	} else {
 		mmio_setbits_32(rcc_base + gate->offset, BIT(gate->bit));
 	}
-	dsb(); /* Make sure the write operation are done before continue. */
+
+	/* Make sure the clock register has been written */
+	(void)mmio_read_32(rcc_base + gate->offset);
 }
 
 static void __clk_disable(struct stm32mp1_clk_gate const *gate)
@@ -1321,7 +1323,7 @@ static void __clk_disable(struct stm32mp1_clk_gate const *gate)
 
 	VERBOSE("Disable clock %u\n", gate->index);
 
-	dsb(); /* Waiting pending operation before disabling clock  */
+	dmbsy(); /* Ensure previous transactions are performed. */
 
 	if (gate->set_clr != 0U) {
 		mmio_write_32(rcc_base + gate->offset + RCC_MP_ENCLRR_OFFSET,
@@ -1329,7 +1331,9 @@ static void __clk_disable(struct stm32mp1_clk_gate const *gate)
 	} else {
 		mmio_clrbits_32(rcc_base + gate->offset, BIT(gate->bit));
 	}
-	dsb(); /* Make sure the write operation are done before continue. */
+
+	/* Make sure the clock register has been written */
+	(void)mmio_read_32(rcc_base + gate->offset);
 }
 
 static bool __clk_is_enabled(struct stm32mp1_clk_gate const *gate)
-- 
