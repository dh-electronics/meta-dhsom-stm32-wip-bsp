From fc8432ed8ac9fa43cef737b039707118cb58e328 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Thu, 10 Sep 2026 17:39:16 +0200
Subject: [PATCH 551/572] feat(stm32mp2): stub PM code in serial boot for OSI
 support

When booting from USB or UART, with programmer, the low-power sequences
won't be used, some code can then be stubbed under UART and USB flags.

Without this stub PSCI_SET_SUSPEND_MODE is not supported and Linux
kernel with OSI support, with CPU idle PSCI power domains,
fail to start (psci_cpuidle_domain_probe error on call of
psci_set_osi_mode failed).

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 67754b6de14c90c8c154add3f8b74217505f191f feat(stm32mp2): stub PM code in serial boot for OSI support]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I0e39a7a9d2124194cdc519f9c8f05ab8bceec63f
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/610793
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
---
 plat/st/stm32mp2/bl31_plat_setup.c | 33 ++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/plat/st/stm32mp2/bl31_plat_setup.c b/plat/st/stm32mp2/bl31_plat_setup.c
index 010ad74ec5..1363f7a7c8 100644
--- a/plat/st/stm32mp2/bl31_plat_setup.c
+++ b/plat/st/stm32mp2/bl31_plat_setup.c
@@ -218,8 +218,41 @@ static void __dead2 stm32_system_reset(void)
 	stm32mp_system_reset();
 }
 
+#if PSCI_OS_INIT_MODE
+static void stm32_pwr_domain_suspend(const psci_power_state_t *target_state)
+{
+}
+
+static void stm32_pwr_domain_suspend_finish(const psci_power_state_t
+					    *target_state)
+{
+}
+
+static int stm32_validate_power_state(unsigned int power_state,
+				      psci_power_state_t *req_state)
+{
+	return PSCI_E_INVALID_PARAMS;
+}
+
+static void stm32_get_sys_suspend_power_state(psci_power_state_t *req_state)
+{
+	unsigned int i;
+
+	for (i = 0U; i <= PLAT_MAX_PWR_LVL; i++) {
+		req_state->pwr_domain_state[i] = STM32MP_LOCAL_STATE_RUN;
+	}
+	req_state->last_at_pwrlvl = 0x0;
+}
+#endif
+
 static const plat_psci_ops_t stm32_psci_ops = {
 	.system_reset = stm32_system_reset,
+#if PSCI_OS_INIT_MODE
+	.pwr_domain_suspend = stm32_pwr_domain_suspend,
+	.pwr_domain_suspend_finish = stm32_pwr_domain_suspend_finish,
+	.validate_power_state = stm32_validate_power_state,
+	.get_sys_suspend_power_state = stm32_get_sys_suspend_power_state,
+#endif
 };
 
 /* Stub PSCI platform functions */
-- 
