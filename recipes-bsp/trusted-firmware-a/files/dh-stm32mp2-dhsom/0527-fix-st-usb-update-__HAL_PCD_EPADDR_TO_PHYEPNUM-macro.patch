From 9552ca2a06409c71ac639a46697d3337f852378e Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@foss.st.com>
Date: Mon, 27 Apr 2026 19:14:43 +0200
Subject: [PATCH 527/572] fix(st-usb): update __HAL_PCD_EPADDR_TO_PHYEPNUM
 macro

The __HAL_PCD_EPADDR_TO_PHYEPNUM macro sets the BIT(0) to 1 if the
direction is IN. We can then do that by shifting this EP_DIR bit from
BIT(7) to BIT(0).
Doing so avoids the following error reported by Coverity:
line 2341: `(i | (128ULL /* 1ULL << 7 */)) & (128ULL /* 1ULL << 7 */)`
is always 0x80 regardless of the values of its operands. This occurs as
a value.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 3fb33586c871585621d4d5d3037f00fb7efe11ac fix(st-usb): update __HAL_PCD_EPADDR_TO_PHYEPNUM macro]
Change-Id: Id611b83277ccabd6d3bcfc0306ddad6c7c264f64
Signed-off-by: Yann Gautier <yann.gautier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/561741
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/579557
Domain-Review: Maxime MERE <maxime.mere@foss.st.com>
Tested-by: Maxime MERE <maxime.mere@foss.st.com>
---
 drivers/st/usb_dwc3/usb_dwc3.c | 2 +-
 include/drivers/usb_device.h   | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/st/usb_dwc3/usb_dwc3.c b/drivers/st/usb_dwc3/usb_dwc3.c
index f0e144b744..9e30e31a25 100644
--- a/drivers/st/usb_dwc3/usb_dwc3.c
+++ b/drivers/st/usb_dwc3/usb_dwc3.c
@@ -498,7 +498,7 @@
 						intbuffers.evtbufferpos[intr]])
 
 #define __HAL_PCD_EPADDR_TO_PHYEPNUM(ep_addr)	((2U * ((ep_addr) & ADDRESS_MASK)) + \
-						((((ep_addr) & EP_DIR_MASK) != 0U) ? 1U : 0U))
+						(((ep_addr) & EP_DIR_MASK) >> EP_DIR_SHIFT))
 #define __HAL_PCD_PHYEPNUM_TO_EPADDR(phy_epnum)	(((phy_epnum) / 2U) | \
 						((((phy_epnum) & 0x1U) != 0U) ? EP_DIR_IN : 0U))
 
diff --git a/include/drivers/usb_device.h b/include/drivers/usb_device.h
index 2071234f4c..18951c0dac 100644
--- a/include/drivers/usb_device.h
+++ b/include/drivers/usb_device.h
@@ -14,6 +14,7 @@
 
 /* Define for EP address */
 #define EP_DIR_MASK	BIT(7)
+#define EP_DIR_SHIFT	U(7)
 #define EP_DIR_IN	BIT(7)
 #define EP_NUM_MASK	GENMASK(3, 0)
 
