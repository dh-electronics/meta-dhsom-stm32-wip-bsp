From 86255db2e368cb22ebd5a7431efeb5a238ed748f Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Fri, 5 Dec 2025 16:55:06 +0100
Subject: [PATCH 211/572] fix(stm32mp2): skip iac_dump when M33 is TDCID

When Cortex-M33 is TDCID, it has the control of IAC peripheral. Cortex-A
cannot access it. Put the code of iac_dump() under STM32MP_M33_TDCID
flag.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 0fe00bf15f5d22617443daaab4c54910c08fbecb fix(stm32mp2): skip iac_dump when M33 is TDCID]
Change-Id: I3c020f55d1d61261491d870080c091439eb8e9b6
Signed-off-by: Yann Gautier <yann.gautier@foss.st.com>
---
 plat/st/stm32mp2/bl2_plat_setup.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/plat/st/stm32mp2/bl2_plat_setup.c b/plat/st/stm32mp2/bl2_plat_setup.c
index d36c7452f7..beff181753 100644
--- a/plat/st/stm32mp2/bl2_plat_setup.c
+++ b/plat/st/stm32mp2/bl2_plat_setup.c
@@ -45,14 +45,14 @@ IMPORT_SYM(uintptr_t, __DATA_END__, DATA_END);
 #define IAC_EXCEPT_LSB_BIT(x) ((x) * 32U)
 #define IAC_EXCEPT_MSB_BIT(x) (IAC_EXCEPT_LSB_BIT(x) + 31U)
 
-#if DEBUG
+#if DEBUG && !STM32MP_M33_TDCID
 /* Save all IAC ISR registers + the number of IAC found on last u32 */
 static uint32_t iac_list[IAC_NB + 1U];
 #endif
 
 static void iac_dump(void)
 {
-#if DEBUG
+#if DEBUG && !STM32MP_M33_TDCID
 	uint32_t i;
 
 	for (i = 0U; i < IAC_NB; i++) {
@@ -72,7 +72,7 @@ static void iac_dump(void)
 
 static void iac_display(void)
 {
-#if DEBUG
+#if DEBUG && !STM32MP_M33_TDCID
 	unsigned int i;
 	unsigned int bit;
 
-- 
2.53.0

