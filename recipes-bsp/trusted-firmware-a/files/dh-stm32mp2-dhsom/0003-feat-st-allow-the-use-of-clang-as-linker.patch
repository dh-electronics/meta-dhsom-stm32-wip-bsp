From 67e270323f66ed434de893dd8067d7a6f7e72632 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Thu, 6 Nov 2025 19:30:37 +0100
Subject: [PATCH 003/572] feat(st): allow the use of clang as linker

Use same .map file structure for llvm-clang and llvm-lld.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 4dc9997b6df77c56c203b97065d52efa31339a5d feat(st): allow the use of clang as linker]
Change-Id: I4a3dd76df29e4a38ed33c2bc2c8bbdf31b8d5281
Signed-off-by: Yann Gautier <yann.gautier@st.com>
---
 plat/st/common/common_rules.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/plat/st/common/common_rules.mk b/plat/st/common/common_rules.mk
index 8557e0c6d6..b1dae1ce45 100644
--- a/plat/st/common/common_rules.mk
+++ b/plat/st/common/common_rules.mk
@@ -67,7 +67,7 @@ tf-a-%.bin: tf-a-%.elf
 tf-a-%.stm32: tf-a-%.bin ${STM32_DEPS}
 	$(s)echo
 	$(s)echo "Generate $@"
-ifeq ($($(ARCH)-ld-id),llvm-lld)
+ifneq ($(filter $($(ARCH)-ld-id),llvm-clang llvm-lld),)
 	$(eval LOADADDR = 0x$(shell cat $(@:.stm32=.map) | grep '\.data$$' | awk '{print $$1}'))
 	$(eval ENTRY = 0x$(shell cat $(@:.stm32=.map) | grep "__BL2_IMAGE_START" | awk '{print $$1}'))
 else
-- 
2.53.0

