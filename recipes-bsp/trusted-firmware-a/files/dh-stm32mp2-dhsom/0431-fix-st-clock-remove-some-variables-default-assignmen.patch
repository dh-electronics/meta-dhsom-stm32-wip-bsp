From 6ccbf0dc38ef11d0f8f473ff44e7285d45d77db7 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@foss.st.com>
Date: Wed, 11 Mar 2026 16:00:09 +0100
Subject: [PATCH 431/572] fix(st-clock): remove some variables default
 assignment

Some variables are assigned default values, but are overwritten before
those values have been used. Remove the default assignment.
This was found with Coverity: Defect (unused_value)

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git fb4473321bcc47659591ef186ff70f4b66d88e40 fix(st-clock): remove some variables default assignment]
Change-Id: I0286e64005bd766626ec7a80f88188dff31ede11
Signed-off-by: Yann Gautier <yann.gautier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/545847
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
---
 drivers/st/clk/clk-stm32-core.c | 2 +-
 drivers/st/clk/clk-stm32mp13.c  | 4 ++--
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/drivers/st/clk/clk-stm32-core.c b/drivers/st/clk/clk-stm32-core.c
index b08a72b640..59c553c9fc 100644
--- a/drivers/st/clk/clk-stm32-core.c
+++ b/drivers/st/clk/clk-stm32-core.c
@@ -653,7 +653,7 @@ void clk_stm32_enable_critical_clocks(void)
 
 static void stm32_clk_register(void)
 {
-	int node_rcc = -1;
+	int node_rcc;
 	void *fdt = NULL;
 
 	if (fdt_get_address(&fdt) == 0) {
diff --git a/drivers/st/clk/clk-stm32mp13.c b/drivers/st/clk/clk-stm32mp13.c
index d711a1230d..083ba3d69b 100644
--- a/drivers/st/clk/clk-stm32mp13.c
+++ b/drivers/st/clk/clk-stm32mp13.c
@@ -2532,8 +2532,8 @@ static int stm32_clk_parse_fdt_all_pll(void *fdt, int node, struct stm32_clk_pla
 	for (i = _PLL2; i < pdata->npll; i++) {
 		struct stm32_pll_dt_cfg *pll = &pdata->pll[i];
 		char name[RCC_PLL_NAME_SIZE];
-		int subnode = 0;
-		int err = 0;
+		int subnode;
+		int err;
 
 		snprintf(name, sizeof(name), "st,pll@%u", i);
 
-- 
