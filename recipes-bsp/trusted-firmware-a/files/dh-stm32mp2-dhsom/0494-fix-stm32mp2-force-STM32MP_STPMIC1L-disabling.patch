From d9320578084faeb5969df2bfcb4d98b38220b7b3 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Wed, 27 May 2026 15:39:05 +0200
Subject: [PATCH 494/572] fix(stm32mp2): force STM32MP_STPMIC1L disabling

The flag STM32MP_STPMIC1L is not used by STM32MP2 platforms, explicitly
disable it in platform.mk file. The flag is then defined to 0, and this
will avoid warnings when enabling -Wundef flag.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 60b1bcc9308bdfa334e66df60cdb725802ba8997 fix(stm32mp2): force STM32MP_STPMIC1L disabling]
Change-Id: I7da26084e01b42a86f6783bbe6b8f1f432b48a97
Signed-off-by: Yann Gautier <yann.gautier@st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/572134
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
Tested-by: Yann GAUTIER <yann.gautier@foss.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 plat/st/stm32mp2/platform.mk | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/plat/st/stm32mp2/platform.mk b/plat/st/stm32mp2/platform.mk
index 5e5e691f96..fc3d72e67e 100644
--- a/plat/st/stm32mp2/platform.mk
+++ b/plat/st/stm32mp2/platform.mk
@@ -55,6 +55,7 @@ STM32MP2X			:=	1
 STM32MP13			:=	0
 STM32MP1X			:=	0
 STM32MP15			:=	0
+STM32MP_STPMIC1L		:=	0
 
 ifneq ($(findstring stm32mp21,$(DTB_FILE_NAME)),)
 STM32MP21			:=	1
@@ -249,6 +250,7 @@ $(eval $(call assert_booleans,\
 		STM32MP_DDR4_TYPE \
 		STM32MP_LPDDR4_TYPE \
 		STM32MP_M33_TDCID \
+		STM32MP_STPMIC1L \
 		STM32MP_USE_EXTERNAL_HEAP \
 		STM32MP13 \
 		STM32MP15 \
@@ -297,6 +299,7 @@ $(eval $(call add_defines,\
 		STM32MP_DDR4_TYPE \
 		STM32MP_LPDDR4_TYPE \
 		STM32MP_M33_TDCID \
+		STM32MP_STPMIC1L \
 		STM32MP_USE_EXTERNAL_HEAP \
 		STM32MP_SIP_CA33SS_CLK \
 		STM32MP13 \
-- 
2.53.0

