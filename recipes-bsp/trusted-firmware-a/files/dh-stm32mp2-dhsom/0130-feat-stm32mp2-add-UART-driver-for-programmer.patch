From 24e3d67ddf4e824f995f8f10a29150e0fd07e283 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@foss.st.com>
Date: Tue, 10 May 2022 17:12:36 +0200
Subject: [PATCH 130/572] feat(stm32mp2): add UART driver for programmer

Add the compilation of UART driver, that will be used when programming
over UART.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git cb504262287afcea27b40be9dad709da8d69bc92 feat(stm32mp2): add UART driver for programmer]
Signed-off-by: Yann Gautier <yann.gautier@foss.st.com>
Change-Id: Iad91be72084ae44c9a393cafb6924afe3cb6fe6e
---
 plat/st/stm32mp2/platform.mk | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/plat/st/stm32mp2/platform.mk b/plat/st/stm32mp2/platform.mk
index 4355b9e586..be0ae09af2 100644
--- a/plat/st/stm32mp2/platform.mk
+++ b/plat/st/stm32mp2/platform.mk
@@ -248,6 +248,10 @@ ifneq ($(filter 1,${STM32MP_RAW_NAND} ${STM32MP_SPI_NAND} ${STM32MP_SPI_NOR}),)
 BL2_SOURCES			+=	plat/st/stm32mp2/stm32mp2_boot_device.c
 endif
 
+ifeq (${STM32MP_UART_PROGRAMMER},1)
+BL2_SOURCES			+=	drivers/st/uart/stm32_uart.c
+endif
+
 ifeq (${STM32MP_USB_PROGRAMMER},1)
 #The DFU stack uses only one end point, reduce the USB stack footprint
 $(eval $(call add_define_val,CONFIG_USBD_EP_NB,1U))
-- 
2.53.0

