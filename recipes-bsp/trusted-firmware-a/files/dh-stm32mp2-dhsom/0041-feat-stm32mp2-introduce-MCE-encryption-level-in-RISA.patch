From b1fb791d3f17e7ee7963ae1ecb522ddcaff2e4bc Mon Sep 17 00:00:00 2001
From: Nicolas Le Bayon <nicolas.le.bayon@st.com>
Date: Wed, 3 Jan 2024 11:06:35 +0100
Subject: [PATCH 041/572] feat(stm32mp2): introduce MCE encryption level in
 RISAF dt-bindings

STM32MP21 brings a new RISAF encryption level (MCE) against side-channel
attacks. Shift RISAFPROT definition to consider two bits for encrypting
field. Change RIF_ENC_EN value according to the shift.
Add related definitions in DT bindings under STM32MP21 flag.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git b9b6063c7e0218e5da72c7170a3a51bb7f302e4e feat(stm32mp2): introduce MCE encryption level in RISAF dt-bindings]
Signed-off-by: Nicolas Le Bayon <nicolas.le.bayon@st.com>
Change-Id: Ia0acbe7c572c3bf51453904f18ae28ff7769774c
---
 include/dt-bindings/soc/rif.h | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/include/dt-bindings/soc/rif.h b/include/dt-bindings/soc/rif.h
index a43bd6ddec..b8e883fa5f 100644
--- a/include/dt-bindings/soc/rif.h
+++ b/include/dt-bindings/soc/rif.h
@@ -75,11 +75,14 @@
 
 /* RISAF encryption modes */
 #define RIF_ENC_DIS		0x0
-#define RIF_ENC_EN		0x1
+#if STM32MP21
+#define RIF_ENC_MCE_EN		0x1 /* Side-channel attack protection */
+#endif
+#define RIF_ENC_EN		0x2
 
 #define RISAFPROT(risaf_region, cid_read_list, cid_write_list, cid_priv_list, sec, enc, enabled) \
 	(((cid_write_list) << 24) | ((cid_read_list) << 16) | ((cid_priv_list) << 8) | \
-	 ((enc) << 7) | ((sec) << 6) | ((enabled) << 5) | (risaf_region))
+	 ((enc) << 6) | ((sec) << 5) | ((enabled) << 4) | (risaf_region))
 
 /* RISAB page IDs */
 #define RISAB_PAGE_ID(idx)	(idx)
-- 
2.53.0

