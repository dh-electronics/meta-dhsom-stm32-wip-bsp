From ae4b64ea8095c441013c300d9d9873d7647b9752 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Alejandro=20V=C3=A1zquez?= <avazquez.dev@gmail.com>
Date: Wed, 26 Aug 2026 09:51:14 +0200
Subject: [PATCH 553/572] feat(stm32mp1): allow overriding secure DDR size
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The STM32MP1 fw-config files currently set DDR_SEC_SIZE to
STM32MP_DDR_S_SIZE. When OP-TEE uses a non-default CFG_TZDRAM_SIZE,
the secure DDR region described by TF-A may not match the region
actually used by OP-TEE.

Allow a board-specific fw-config to override DDR_SEC_SIZE. The default
value remains unchanged.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git c9e7cac9843abcea3832f0f5d8839231961716fa feat(stm32mp1): allow overriding secure DDR size]
Change-Id: If8c786c9e0c5ca67e8e6b4980168c35614a03191
Signed-off-by: Alejandro Vázquez <avazquez.dev@gmail.com>
(cherry picked from commit a96b482eb6dee45cad6c5f0abac755811e66b7ee)
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/607958
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Maxime MERE <maxime.mere@foss.st.com>
Domain-Review: Nicolas LE BAYON <nicolas.le.bayon@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
Reviewed-by: Nicolas LE BAYON <nicolas.le.bayon@st.com>
---
 fdts/stm32mp13-fw-config.dtsi | 2 ++
 fdts/stm32mp15-fw-config.dtsi | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/fdts/stm32mp13-fw-config.dtsi b/fdts/stm32mp13-fw-config.dtsi
index 4f3bb726b0..c360f31aca 100644
--- a/fdts/stm32mp13-fw-config.dtsi
+++ b/fdts/stm32mp13-fw-config.dtsi
@@ -13,7 +13,9 @@
 #endif
 
 #define DDR_NS_BASE	STM32MP_DDR_BASE
+#ifndef DDR_SEC_SIZE
 #define DDR_SEC_SIZE	STM32MP_DDR_S_SIZE
+#endif
 #define DDR_SEC_BASE	(STM32MP_DDR_BASE + (DDR_SIZE - DDR_SEC_SIZE))
 #define DDR_NS_SIZE	(DDR_SEC_BASE - DDR_NS_BASE)
 
diff --git a/fdts/stm32mp15-fw-config.dtsi b/fdts/stm32mp15-fw-config.dtsi
index 247e91ae99..8bf3983f43 100644
--- a/fdts/stm32mp15-fw-config.dtsi
+++ b/fdts/stm32mp15-fw-config.dtsi
@@ -15,7 +15,9 @@
 #define DDR_NS_BASE	STM32MP_DDR_BASE
 #ifdef AARCH32_SP_OPTEE
 /* OP-TEE secure memory: located at DDR top */
+#ifndef DDR_SEC_SIZE
 #define DDR_SEC_SIZE	STM32MP_DDR_S_SIZE
+#endif
 #define DDR_SEC_BASE	(STM32MP_DDR_BASE + (DDR_SIZE - DDR_SEC_SIZE))
 #define DDR_NS_SIZE	(DDR_SEC_BASE - DDR_NS_BASE)
 #else /* !AARCH32_SP_OPTEE */
-- 
