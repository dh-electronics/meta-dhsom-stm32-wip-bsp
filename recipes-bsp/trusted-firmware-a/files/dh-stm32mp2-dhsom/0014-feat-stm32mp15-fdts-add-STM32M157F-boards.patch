From fffceaef3a44defbb1271ebb273c9f530338924d Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Fri, 21 Oct 2022 11:22:37 +0200
Subject: [PATCH 014/572] feat(stm32mp15-fdts): add STM32M157F boards

STM32MP157F SoC is an update of STM32MP157C, that can run at 800MHz.
In TF-A, this increased  frequency is not managed (it is done in OP-TEE)
and both SoCs will start at the nominal frequency 650MHz.
To create the new boards, just include the STM32MP157C versions, and
update model and compatible.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 314e328d35333e679c03d139b777418d9759b0f6 feat(stm32mp15-fdts): add STM32M157F boards]
Signed-off-by: Yann Gautier <yann.gautier@st.com>
Change-Id: Ic9fa8f714ba8d8095664c55dbcadfae49e9e2f4f
---
 fdts/stm32mp157f-dk2.dts | 11 +++++++++++
 fdts/stm32mp157f-ed1.dts | 11 +++++++++++
 fdts/stm32mp157f-ev1.dts | 11 +++++++++++
 3 files changed, 33 insertions(+)
 create mode 100644 fdts/stm32mp157f-dk2.dts
 create mode 100644 fdts/stm32mp157f-ed1.dts
 create mode 100644 fdts/stm32mp157f-ev1.dts

diff --git a/fdts/stm32mp157f-dk2.dts b/fdts/stm32mp157f-dk2.dts
new file mode 100644
index 0000000000..b421494622
--- /dev/null
+++ b/fdts/stm32mp157f-dk2.dts
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+/*
+ * Copyright (C) 2026, STMicroelectronics - All Rights Reserved
+ */
+
+#include "stm32mp157c-dk2.dts"
+
+/ {
+	model = "STMicroelectronics STM32MP157F-DK2 Discovery Board";
+	compatible = "st,stm32mp157f-dk2", "st,stm32mp157";
+};
diff --git a/fdts/stm32mp157f-ed1.dts b/fdts/stm32mp157f-ed1.dts
new file mode 100644
index 0000000000..490162d3ce
--- /dev/null
+++ b/fdts/stm32mp157f-ed1.dts
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+/*
+ * Copyright (C) 2026, STMicroelectronics - All Rights Reserved
+ */
+
+#include "stm32mp157c-ed1.dts"
+
+/ {
+	model = "STMicroelectronics STM32MP157F eval daughter";
+	compatible = "st,stm32mp157f-ed1", "st,stm32mp157";
+};
diff --git a/fdts/stm32mp157f-ev1.dts b/fdts/stm32mp157f-ev1.dts
new file mode 100644
index 0000000000..6c9298c9ee
--- /dev/null
+++ b/fdts/stm32mp157f-ev1.dts
@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: (GPL-2.0-only OR BSD-3-Clause)
+/*
+ * Copyright (C) 2026, STMicroelectronics - All Rights Reserved
+ */
+
+#include "stm32mp157c-ev1.dts"
+
+/ {
+	model = "STMicroelectronics STM32MP157F eval daughter on eval mother";
+	compatible = "st,stm32mp157f-ev1", "st,stm32mp157f-ed1", "st,stm32mp157";
+};
