From 9e9e0d752bad178d66955171ee466e0be9a1b92c Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Tue, 2 Jun 2026 12:54:57 +0200
Subject: [PATCH 544/572] fix(dt-bindings): fix the low-power defines for
 STM32MP1

On STM32MP13 and on STM3MP15, the system low power "Standby"
in OpenSTLinux is always  associated to the MPU state "CStandby"
(with PDDS bit=1) and not "CStop" (with PPDS bit=0);
it is defined in OP-TEE low_power.c with config_pwr[].pwr_mpucr.

Moreover for STM32MP13, "CStandby" is mandatory for "Standby"
mode and LPLV-Stop2 (with STOP2 = 1).

This patch updates the binding defines to reflect the correct MPU
CState for the "Standby" and "LPLV-Stop2" low power modes.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 48aa260762dfcdd218e796d3bd5da1e8d467fac2 fix(dt-bindings): fix the low-power defines for STM32MP1]
Change-Id: I1e894b10356e6b4a28beb2e6ca9e717355e401e8
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/573646
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
---
 docs/devicetree/bindings/power/st,stm32mp1-pwr.txt | 9 +++++----
 include/dt-bindings/power/stm32mp1-power.h         | 6 +++---
 plat/st/stm32mp1/stm32mp1_critic_power.c           | 4 ++--
 3 files changed, 10 insertions(+), 9 deletions(-)

diff --git a/docs/devicetree/bindings/power/st,stm32mp1-pwr.txt b/docs/devicetree/bindings/power/st,stm32mp1-pwr.txt
index 22779b05af..0d98d67f87 100644
--- a/docs/devicetree/bindings/power/st,stm32mp1-pwr.txt
+++ b/docs/devicetree/bindings/power/st,stm32mp1-pwr.txt
@@ -22,9 +22,10 @@ The list of SoC modes is in include/dt-bindings/power/stm32mp1-power.h:
 	1 -> STM32_PM_CSTOP_ALLOW_STOP
 	2 -> STM32_PM_CSTOP_ALLOW_LP_STOP
 	3 -> STM32_PM_CSTOP_ALLOW_LPLV_STOP
-	4 -> STM32_PM_CSTOP_ALLOW_STANDBY_DDR_SR
+	4 -> STM32_PM_CSTANDBY_ALLOW_LPLV_STOP2 (only for STM32MP13)
+	5 -> STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_SR
   - modes for system_off
-	6 -> STM32_PM_CSTOP_ALLOW_STANDBY_DDR_OFF
+	6 -> STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_OFF
 	7 -> STM32_PM_SHUTDOWN
 
 Example:
@@ -36,8 +37,8 @@ pwr: pwr@50001000 {
 	system_suspend_supported_soc_modes = <
 		STM32_PM_CSLEEP_RUN
 		STM32_PM_CSTOP_ALLOW_LP_STOP
-		STM32_PM_CSTOP_ALLOW_STANDBY_DDR_SR
+		STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_SR
 	>;
 
-	system_off_soc_mode = <STM32_PM_CSTOP_ALLOW_STANDBY_DDR_OFF>;
+	system_off_soc_mode = <STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_OFF>;
 };
diff --git a/include/dt-bindings/power/stm32mp1-power.h b/include/dt-bindings/power/stm32mp1-power.h
index 3202e0b44e..231705635b 100644
--- a/include/dt-bindings/power/stm32mp1-power.h
+++ b/include/dt-bindings/power/stm32mp1-power.h
@@ -11,9 +11,9 @@
 #define STM32_PM_CSTOP_ALLOW_STOP		1
 #define STM32_PM_CSTOP_ALLOW_LP_STOP		2
 #define STM32_PM_CSTOP_ALLOW_LPLV_STOP		3
-#define STM32_PM_CSTOP_ALLOW_LPLV_STOP2		4
-#define STM32_PM_CSTOP_ALLOW_STANDBY_DDR_SR	5
-#define STM32_PM_CSTOP_ALLOW_STANDBY_DDR_OFF	6
+#define STM32_PM_CSTANDBY_ALLOW_LPLV_STOP2	4
+#define STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_SR	5
+#define STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_OFF	6
 #define STM32_PM_SHUTDOWN			7
 #define STM32_PM_MAX_SOC_MODE			8
 
diff --git a/plat/st/stm32mp1/stm32mp1_critic_power.c b/plat/st/stm32mp1/stm32mp1_critic_power.c
index e24fe74251..1b2dd3243f 100644
--- a/plat/st/stm32mp1/stm32mp1_critic_power.c
+++ b/plat/st/stm32mp1/stm32mp1_critic_power.c
@@ -172,7 +172,7 @@ int stm32_pwr_down_wfi_load(bool is_cstop, uint32_t mode)
 		stm32mp1_power_unlock();
 	}
 
-	if (soc_mode == (uint32_t)STM32_PM_CSTOP_ALLOW_LPLV_STOP2) {
+	if (soc_mode == (uint32_t)STM32_PM_CSTANDBY_ALLOW_LPLV_STOP2) {
 #if STM32MP15
 		ERROR("LPLV-Stop2 mode not supported\n");
 		panic();
@@ -194,7 +194,7 @@ int stm32_pwr_down_wfi_load(bool is_cstop, uint32_t mode)
 
 	/* Shutdown with STPMIC switch OFF mode when supported */
 	if (soc_mode == (uint32_t)STM32_PM_SHUTDOWN ||
-	    soc_mode == (uint32_t)STM32_PM_CSTOP_ALLOW_STANDBY_DDR_OFF) {
+	    soc_mode == (uint32_t)STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_OFF) {
 		shutdown_critic_enter(soc_mode);
 	}
 
-- 
2.53.0

