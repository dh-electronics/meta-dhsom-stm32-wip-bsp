From c0e94204e3b3c7cdcbd72b2073b5fa813a1c29e4 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@foss.st.com>
Date: Tue, 12 Sep 2023 17:07:46 +0200
Subject: [PATCH 199/572] feat(stm32mp2): introduce STM32MP_M33_TDCID flag

If Cortex-A35 does not own the Trusted Domain Compartment ID (TDCID), it
means the Cortex-M33 has it, and several secure resources can no more be
accessed from Cortex-A35. The STM32MP_M33_TDCID will be used to stub
the resources that are no more accessible.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 025420a6891bac57602e1e757d99376e681308b7 feat(stm32mp2): introduce STM32MP_M33_TDCID flag]
Signed-off-by: Yann Gautier <yann.gautier@foss.st.com>
Change-Id: Id3b61a04ac7851030eb1362eae2d00fad01f2221
---
 docs/plat/st/stm32mp2.rst    | 2 ++
 plat/st/stm32mp2/platform.mk | 3 +++
 2 files changed, 5 insertions(+)

diff --git a/docs/plat/st/stm32mp2.rst b/docs/plat/st/stm32mp2.rst
index 2375112eb7..79185d780a 100644
--- a/docs/plat/st/stm32mp2.rst
+++ b/docs/plat/st/stm32mp2.rst
@@ -107,6 +107,8 @@ Dedicated STM32MP2 build flags:
 
 - | ``STM32MP_DDR_FIP_IO_STORAGE``: to store DDR firmware in FIP.
   | Default: 1
+- | ``STM32MP_M33_TDCID``: Enable this flag if Cortex-A35 does not have the Trusted Domain Compartment ID (owned by Cortex-M33)
+  | Default: 0
 - | ``STM32MP21``: to select STM32MP21 variant configuration.
   | Default: 0
 - | ``STM32MP23``: to select STM32MP23 variant configuration.
diff --git a/plat/st/stm32mp2/platform.mk b/plat/st/stm32mp2/platform.mk
index 9cbe046095..a8fa518099 100644
--- a/plat/st/stm32mp2/platform.mk
+++ b/plat/st/stm32mp2/platform.mk
@@ -39,6 +39,7 @@ TF_CFLAGS			+=	-DSTM32MP2X
 STM32MP21			?=	0
 STM32MP23			?=	0
 STM32MP25			?=	0
+STM32MP_M33_TDCID		?=	0
 
 ifneq ($(findstring stm32mp21,$(DTB_FILE_NAME)),)
 STM32MP21			:=	1
@@ -188,6 +189,7 @@ $(eval $(call assert_booleans,\
 		STM32MP_DDR3_TYPE \
 		STM32MP_DDR4_TYPE \
 		STM32MP_LPDDR4_TYPE \
+		STM32MP_M33_TDCID \
 		STM32MP_USE_EXTERNAL_HEAP \
 		STM32MP21 \
 		STM32MP23 \
@@ -223,6 +225,7 @@ $(eval $(call add_defines,\
 		STM32MP_DDR3_TYPE \
 		STM32MP_DDR4_TYPE \
 		STM32MP_LPDDR4_TYPE \
+		STM32MP_M33_TDCID \
 		STM32MP_USE_EXTERNAL_HEAP \
 		STM32MP21 \
 		STM32MP23 \
-- 
