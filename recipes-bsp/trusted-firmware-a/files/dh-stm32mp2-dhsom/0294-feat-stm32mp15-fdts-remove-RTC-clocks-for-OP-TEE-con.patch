From d3afecc44f1dc990e7b38d6cfa17ba88fcf26750 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Wed, 11 Dec 2024 16:44:29 +0100
Subject: [PATCH 294/572] feat(stm32mp15-fdts): remove RTC clocks for OP-TEE
 configs

Now that OP-TEE properly configures RTC clock, it is no more useful
to do that in TF-A in the DT files used for OP-TEE. This is still
done for SP_MIN configs.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 8d451aaea1c99edd8411fdc497ff99f87a8e3587 feat(stm32mp15-fdts): remove RTC clocks for OP-TEE configs]
Change-Id: Ieb019f84afb0cf27c7afa949b76222f4139edaf6
Signed-off-by: Yann Gautier <yann.gautier@st.com>
---
 fdts/stm32mp157c-ed1.dts  | 2 --
 fdts/stm32mp15xx-dkx.dtsi | 2 --
 2 files changed, 4 deletions(-)

diff --git a/fdts/stm32mp157c-ed1.dts b/fdts/stm32mp157c-ed1.dts
index 49b7d3211c..ba342c3adc 100644
--- a/fdts/stm32mp157c-ed1.dts
+++ b/fdts/stm32mp157c-ed1.dts
@@ -201,7 +201,6 @@
 		CLK_MPU_PLL1P
 		CLK_AXI_PLL2P
 		CLK_MCU_PLL3P
-		CLK_RTC_LSE
 		CLK_CKPER_HSE
 		CLK_FMC_ACLK
 		CLK_QSPI_ACLK
@@ -220,7 +219,6 @@
 		DIV(DIV_APB3, 1)
 		DIV(DIV_APB4, 1)
 		DIV(DIV_APB5, 2)
-		DIV(DIV_RTC, 23)
 	>;
 
 	st,pll_vco {
diff --git a/fdts/stm32mp15xx-dkx.dtsi b/fdts/stm32mp15xx-dkx.dtsi
index 519784337d..472d55900c 100644
--- a/fdts/stm32mp15xx-dkx.dtsi
+++ b/fdts/stm32mp15xx-dkx.dtsi
@@ -205,7 +205,6 @@
 		CLK_MPU_PLL1P
 		CLK_AXI_PLL2P
 		CLK_MCU_PLL3P
-		CLK_RTC_LSE
 		CLK_CKPER_HSE
 		CLK_SDMMC12_PLL4P
 		CLK_STGEN_HSE
@@ -222,7 +221,6 @@
 		DIV(DIV_APB3, 1)
 		DIV(DIV_APB4, 1)
 		DIV(DIV_APB5, 2)
-		DIV(DIV_RTC, 23)
 	>;
 
 	st,pll_vco {
-- 
2.53.0

