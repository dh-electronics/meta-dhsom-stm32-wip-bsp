From e9e73be36174cfdd7c2110489e86c7082a5bfcb4 Mon Sep 17 00:00:00 2001
From: Christophe Roullier <christophe.roullier@st.com>
Date: Tue, 26 Apr 2022 14:54:39 +0200
Subject: [PATCH 129/572] feat(fdts): add watchdog support for STM32MP2

This patch add iwdg1 watchdog support on STM32MP2.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git ae3cf99fa6e05b670865d94a77a59f642b20d284 feat(fdts): add watchdog support for STM32MP2]
Signed-off-by: Christophe Roullier <christophe.roullier@st.com>
Change-Id: I16c25f6b8a1f10b591c8248cae881b575d04d1da
---
 fdts/stm32mp251.dtsi | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/fdts/stm32mp251.dtsi b/fdts/stm32mp251.dtsi
index c8f3b29b0c..4769330332 100644
--- a/fdts/stm32mp251.dtsi
+++ b/fdts/stm32mp251.dtsi
@@ -256,6 +256,14 @@
 				status = "disabled";
 			};
 
+			iwdg1: watchdog@44010000 {
+				compatible = "st,stm32mp1-iwdg";
+				reg = <0x44010000 0x400>;
+				clocks = <&rcc CK_BUS_IWDG1>, <&rcc LSI_CK>;
+				clock-names = "pclk", "lsi";
+				status = "disabled";
+			};
+
 			i2c8: i2c@46040000 {
 				compatible = "st,stm32mp25-i2c";
 				reg = <0x46040000 0x400>;
-- 
2.53.0

