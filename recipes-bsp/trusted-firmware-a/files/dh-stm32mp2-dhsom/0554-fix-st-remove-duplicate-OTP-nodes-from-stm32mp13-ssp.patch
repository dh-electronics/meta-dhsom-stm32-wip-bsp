From dc4bd3cc5f1355aea6fcc98cafbf66baa9653840 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Wed, 22 Jul 2026 14:10:12 +0200
Subject: [PATCH 554/572] fix(st): remove duplicate OTP nodes from
 stm32mp13-ssp-bl2.dtsi
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

NOT UPSTREAMABLE

Remove duplicate OTP node definitions (cfg0_otp, cfg2_otp, ssp_otp, pkh_otp)
already present in base stm32mp131.dtsi. Keep only SSP-specific nodes
(chip-otp, rma-otp) with consistent naming convention.

Fixes DTC duplicate label compilation error.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 51189b464570ded3055e8aa786faca6f7f2ecda2 fix(st): remove duplicate OTP nodes from stm32mp13-ssp-bl2.dtsi]
Change-Id: I2420dfc5a12f76b9df53c2f445e73fa96d1f6f4f
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/590961
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 fdts/stm32mp13-ssp-bl2.dtsi     | 16 ++--------------
 fdts/stm32mp15-ssp-bl2.dtsi     |  8 ++++----
 plat/st/stm32mp1/stm32mp1_def.h |  8 ++++----
 3 files changed, 10 insertions(+), 22 deletions(-)

diff --git a/fdts/stm32mp13-ssp-bl2.dtsi b/fdts/stm32mp13-ssp-bl2.dtsi
index bb86c49721..30c39eb341 100644
--- a/fdts/stm32mp13-ssp-bl2.dtsi
+++ b/fdts/stm32mp13-ssp-bl2.dtsi
@@ -16,24 +16,12 @@
 
 	soc {
 		efuse@5c005000 {
-			cfg0_otp: cfg0_otp@0 {
-				reg = <0x0 0x2>;
-			};
-			cfg2_otp: cfg2_otp@8 {
-				reg = <0x8 0x4>;
-			};
-			ssp_otp: cfg9_otp@24 {
-				reg = <0x24 0x4>;
-			};
-			chip_otp: chip_otp@a0 {
+			chip_otp: chip-otp@a0 {
 				reg = <0xa0 0x40>;
 			};
-			rma_otp: rma_otp@e0 {
+			rma_otp: rma-otp@e0 {
 				reg = <0xe0 0x4>;
 			};
-			pkh_otp: pkh_otp@60 {
-				reg = <0x60 0x20>;
-			};
 		};
 
 #if STM32MP_UART_PROGRAMMER
diff --git a/fdts/stm32mp15-ssp-bl2.dtsi b/fdts/stm32mp15-ssp-bl2.dtsi
index e2d5625e27..5cb9204ea3 100644
--- a/fdts/stm32mp15-ssp-bl2.dtsi
+++ b/fdts/stm32mp15-ssp-bl2.dtsi
@@ -27,19 +27,19 @@
 
 	soc {
 		efuse@5c005000 {
-			cfg2_otp: cfg2_otp@8 {
+			cfg2_otp: cfg2-otp@8 {
 				reg = <0x8 0x4>;
 			};
 
-			ssp_otp: ssp_otp@20 {
+			ssp_otp: ssp-otp@20 {
 				reg = <0x20 0x4>;
 			};
 
-			chip_otp: chip_otp@a0 {
+			chip_otp: chip-otp@a0 {
 				reg = <0xa0 0x40>;
 			};
 
-			rma_otp: rma_otp@e0 {
+			rma_otp: rma-otp@e0 {
 				reg = <0xe0 0x4>;
 			};
 		};
diff --git a/plat/st/stm32mp1/stm32mp1_def.h b/plat/st/stm32mp1/stm32mp1_def.h
index 513a8ce905..100e496ad5 100644
--- a/plat/st/stm32mp1/stm32mp1_def.h
+++ b/plat/st/stm32mp1/stm32mp1_def.h
@@ -440,11 +440,11 @@ enum ddr_type {
 #if STM32MP13
 #define NAND_OTP			"cfg9-otp"
 #define NAND2_OTP			"cfg10-otp"
-#define SSP_OTP				"cfg9_otp"
+#define SSP_OTP				"cfg9-otp"
 #endif
 #if STM32MP15
 #define NAND_OTP			"nand-otp"
-#define SSP_OTP				"ssp_otp"
+#define SSP_OTP				"ssp-otp"
 #endif
 #define MONOTONIC_OTP			"monotonic-otp"
 #define UID_OTP				"uid-otp"
@@ -452,8 +452,8 @@ enum ddr_type {
 #define ENCKEY_OTP			"oem-enc-key"
 #define BOARD_ID_OTP			"board-id"
 #define CFG2_OTP			"cfg2_otp"
-#define CHIP_CERTIFICATE_OTP		"chip_otp"
-#define RMA_OTP				"rma_otp"
+#define CHIP_CERTIFICATE_OTP		"chip-otp"
+#define RMA_OTP				"rma-otp"
 
 /* OTP mask */
 /* CFG0 */
