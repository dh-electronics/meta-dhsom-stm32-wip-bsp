From 4d396617fcf14f2ca9907f83d44196b7481afc88 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Fri, 30 Aug 2024 14:50:09 +0200
Subject: [PATCH 140/572] feat(stm32mp13-fdts): change PKA compatible name
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Change PKA compatible name to match other ST device tree.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git c39b1eb0a69d186a1c66bfa9c6ca82fa9159e2e2 feat(stm32mp13-fdts): change PKA compatible name]
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Change-Id: I5e6f72e68ebc90a114d2310e69d1adfb68da287e
---
 fdts/stm32mp13xc.dtsi | 2 +-
 fdts/stm32mp13xf.dtsi | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/fdts/stm32mp13xc.dtsi b/fdts/stm32mp13xc.dtsi
index 4b30c5c324..7fd90e9b0c 100644
--- a/fdts/stm32mp13xc.dtsi
+++ b/fdts/stm32mp13xc.dtsi
@@ -17,7 +17,7 @@
 		};
 
 		pka: pka@54006000 {
-			compatible = "st,stm32-pka64";
+			compatible = "st,stm32mp13-pka64";
 			reg = <0x54006000 0x2000>;
 			clocks = <&rcc PKA>;
 			resets = <&rcc PKA_R>;
diff --git a/fdts/stm32mp13xf.dtsi b/fdts/stm32mp13xf.dtsi
index 887c4e0069..2a22d23af2 100644
--- a/fdts/stm32mp13xf.dtsi
+++ b/fdts/stm32mp13xf.dtsi
@@ -16,7 +16,7 @@
 		};
 
 		pka: pka@54006000 {
-			compatible = "st,stm32-pka64";
+			compatible = "st,stm32mp13-pka64";
 			reg = <0x54006000 0x2000>;
 			clocks = <&rcc PKA>;
 			resets = <&rcc PKA_R>;
-- 
2.53.0

