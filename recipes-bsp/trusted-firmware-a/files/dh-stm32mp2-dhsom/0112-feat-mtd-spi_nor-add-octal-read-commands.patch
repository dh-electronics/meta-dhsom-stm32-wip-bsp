From 6b243482aa6e8f16cd207e68304371e3193ee651 Mon Sep 17 00:00:00 2001
From: Christophe Kerello <christophe.kerello@foss.st.com>
Date: Fri, 9 Jul 2021 09:27:19 +0200
Subject: [PATCH 112/572] feat(mtd): spi_nor: add octal read commands

This patch adds octal read commands (1-1-8 and 1-8-8).

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 0791bba030f1d539572ed3f2791359e6766e3087 feat(mtd): spi_nor: add octal read commands]
Change-Id: Ibe9bc3cc775e4862fae44af5a382e7558affef17
Signed-off-by: Christophe Kerello <christophe.kerello@foss.st.com>
---
 include/drivers/spi_nor.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/include/drivers/spi_nor.h b/include/drivers/spi_nor.h
index 72cfe5b346..444e84237b 100644
--- a/include/drivers/spi_nor.h
+++ b/include/drivers/spi_nor.h
@@ -29,6 +29,8 @@
 #define SPI_NOR_OP_READ_1_2_2	0xBBU	/* Read data bytes (Dual I/O SPI) */
 #define SPI_NOR_OP_READ_1_1_4	0x6BU	/* Read data bytes (Quad Output SPI) */
 #define SPI_NOR_OP_READ_1_4_4	0xEBU	/* Read data bytes (Quad I/O SPI) */
+#define SPI_NOR_OP_READ_1_1_8	0x8BU	/* Read data bytes (Octal Output SPI) */
+#define SPI_NOR_OP_READ_1_8_8	0xCBU	/* Read data bytes (Octal I/O SPI) */
 
 /* Flags for NOR specific configuration */
 #define SPI_NOR_USE_FSR		BIT(0)
-- 
2.53.0

