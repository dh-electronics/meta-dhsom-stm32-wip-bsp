From 714d045c6fa8c6dbfe1eb5e97a7f1c0053fd9f27 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Fri, 22 Sep 2023 09:51:06 +0200
Subject: [PATCH 147/572] feat(stm32mp2-fdts): enable HASH, PKA and SAES for
 eval board

Add status = "okay" for hash, pka and saes nodes for STM32MP257F
eval board. Those peripherals are required for Trusted Boot.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 7a5d119cb7658508df0d70653d4e743fe4f0d236 feat(stm32mp2-fdts): enable HASH, PKA and SAES for eval board]
Signed-off-by: Yann Gautier <yann.gautier@foss.st.com>
Change-Id: Ie29fd1940d5019a325bf9c1d3f079c4c49708a5a
---
 fdts/stm32mp257f-ev1.dts | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/fdts/stm32mp257f-ev1.dts b/fdts/stm32mp257f-ev1.dts
index 84c3021097..6df1f29c7e 100644
--- a/fdts/stm32mp257f-ev1.dts
+++ b/fdts/stm32mp257f-ev1.dts
@@ -54,6 +54,10 @@
 	vref-supply = <&vref_ddr>;
 };
 
+&hash {
+	status = "okay";
+};
+
 &i2c7 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&i2c7_pins_a>;
@@ -181,6 +185,10 @@
 	};
 };
 
+&pka {
+	status = "okay";
+};
+
 &pwr {
 	vddio1: vddio1 {
 		vddio1-supply = <&vddio_sdcard>;
@@ -203,6 +211,10 @@
 	status = "okay";
 };
 
+&saes {
+	status = "okay";
+};
+
 &sdmmc1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&sdmmc1_b4_pins_a>;
-- 
2.53.0

