From 67dcdcb54ea96a525dd0227f9f499d1944206dab Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Thu, 19 Sep 2024 10:00:54 +0200
Subject: [PATCH 274/572] feat(stm32mp2): manage OTP mirror area

If Cortex-A35 is TD-CID is used, OP-TEE mirror the configuration OTP
fuses (lower and middle) in the first page of SRAM1. BL31 could then
use it if needed. If Cortex-M33 is TDCID, TF-M will fill this area, and
both BL2 and BL31 will access it, as they won't be able to access OTP
values directly through BSEC. Upper OTP fuses will be managed through
PSA calls.
Add STM32MP_BSEC_MIRROR_BASE & STM32MP_BSEC_MIRROR_SIZE macros, and
use them to map this area as non-secure. The whole SRAM1 is still
mapped as secure in BL2 if Cortex-A35 is TDCID.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 6da872cc9cb56bc758b29ae9d7f72d59684de05c feat(stm32mp2): manage OTP mirror area]
Signed-off-by: Yann Gautier <yann.gautier@st.com>
Change-Id: I3ad2ef4db91392a06025c02aab85149972c5d11a
---
 plat/st/stm32mp2/stm32mp2_def.h     |  6 +++++-
 plat/st/stm32mp2/stm32mp2_private.c | 18 ++++++++++++++++--
 2 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/plat/st/stm32mp2/stm32mp2_def.h b/plat/st/stm32mp2/stm32mp2_def.h
index 97b623c697..75b3306360 100644
--- a/plat/st/stm32mp2/stm32mp2_def.h
+++ b/plat/st/stm32mp2/stm32mp2_def.h
@@ -157,6 +157,10 @@
 #define RETRAM_SIZE				U(0x00020000)
 #define STM32MP_BACKUP_RAM_BASE			U(0x42000000)
 
+/* The first 4KB of SRAM1 are reserved are for BSEC mirror */
+#define STM32MP_BSEC_MIRROR_BASE		SRAM1_BASE
+#define STM32MP_BSEC_MIRROR_SIZE		PAGE_SIZE
+
 #if defined(IMAGE_BL2) && STM32MP_USB_PROGRAMMER && !STM32MP21
 #define STM32MP_USB_DWC3_SIZE			PAGE_SIZE
 #define STM32MP_USB_DWC3_BASE			(STM32MP_SYSRAM_BASE + \
@@ -271,7 +275,7 @@ enum ddr_type {
 #endif
 
 #if STM32MP_DDR_FIP_IO_STORAGE
-#define STM32MP_DDR_FW_BASE			SRAM1_BASE
+#define STM32MP_DDR_FW_BASE			(SRAM1_BASE + STM32MP_BSEC_MIRROR_SIZE)
 #define STM32MP_DDR_FW_DMEM_OFFSET		U(0x400)
 #define STM32MP_DDR_FW_IMEM_OFFSET		U(0x800)
 #define STM32MP_DDR_FW_MAX_SIZE			U(0x8800)
diff --git a/plat/st/stm32mp2/stm32mp2_private.c b/plat/st/stm32mp2/stm32mp2_private.c
index 7262155f7b..7c3f2b7f53 100644
--- a/plat/st/stm32mp2/stm32mp2_private.c
+++ b/plat/st/stm32mp2/stm32mp2_private.c
@@ -47,7 +47,8 @@
 					MT_EXECUTE_NEVER)
 #endif /* STM32MP_USB_PROGRAMMER && !STM32MP21 */
 
-#if STM32MP_DDR_FIP_IO_STORAGE || TRUSTED_BOARD_BOOT
+#if STM32MP_DDR_FIP_IO_STORAGE && defined(IMAGE_BL2)
+/* Map the whole SRAM1 allocated to TF-A as secure, required to load DDR FW from FIP */
 #define MAP_SRAM1	MAP_REGION_FLAT(SRAM1_BASE, \
 					SRAM1_SIZE_FOR_TFA, \
 					MT_MEMORY | \
@@ -56,6 +57,16 @@
 					MT_EXECUTE_NEVER)
 #endif
 
+#if STM32MP_M33_TDCID
+#define MAP_BSEC_MIRROR	MAP_REGION_FLAT(STM32MP_BSEC_MIRROR_BASE, \
+					STM32MP_BSEC_MIRROR_SIZE, \
+					MT_RO_DATA | MT_NS)
+#else
+#define MAP_BSEC_MIRROR	MAP_REGION_FLAT(STM32MP_BSEC_MIRROR_BASE, \
+					STM32MP_BSEC_MIRROR_SIZE, \
+					MT_RO_DATA | MT_SECURE)
+#endif
+
 #define MAP_DEVICE	MAP_REGION_FLAT(STM32MP_DEVICE_BASE, \
 					STM32MP_DEVICE_SIZE, \
 					MT_DEVICE | \
@@ -71,8 +82,10 @@ static const mmap_region_t stm32mp2_mmap[] = {
 #else /* !STM32MP_USB_PROGRAMMER || STM32MP21 */
 	MAP_SYSRAM,
 #endif /* STM32MP_USB_PROGRAMMER && !STM32MP21 */
-#if STM32MP_DDR_FIP_IO_STORAGE || TRUSTED_BOARD_BOOT
+#if STM32MP_DDR_FIP_IO_STORAGE
 	MAP_SRAM1,
+#else
+	MAP_BSEC_MIRROR,
 #endif
 	MAP_DEVICE,
 	{0}
@@ -81,6 +94,7 @@ static const mmap_region_t stm32mp2_mmap[] = {
 #if defined(IMAGE_BL31)
 static const mmap_region_t stm32mp2_mmap[] = {
 	MAP_SYSRAM,
+	MAP_BSEC_MIRROR,
 	MAP_DEVICE,
 	{0}
 };
-- 
