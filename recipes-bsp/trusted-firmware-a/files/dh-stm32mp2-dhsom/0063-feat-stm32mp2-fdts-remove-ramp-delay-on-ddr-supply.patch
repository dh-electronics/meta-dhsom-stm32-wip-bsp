From 91e8f3258f74940f0f3be768c435c2316180bc08 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 12 Mar 2025 15:27:07 +0100
Subject: [PATCH 063/572] feat(stm32mp2-fdts): remove ramp delay on ddr supply

Remove the unneeded regulator-enable-ramp-delay for DDR regulator vpp.
This timeout is no more required for board with STPMIC25 since the
default enable delay is set at 1ms for every regulator in PMIC driver.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 10b474e6a9fe892c957e99f216615513333731ed feat(stm32mp2-fdts): remove ramp delay on ddr supply]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: Ia8e231d0a1086831fb4e56dd01d7ee7440072537
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/443762
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 fdts/stm32mp215f-dk.dts  | 1 -
 fdts/stm32mp235f-dk.dts  | 1 -
 fdts/stm32mp257f-dk.dts  | 1 -
 fdts/stm32mp257f-ev1.dts | 1 -
 4 files changed, 4 deletions(-)

diff --git a/fdts/stm32mp215f-dk.dts b/fdts/stm32mp215f-dk.dts
index 90da9e7b5f..24a5895743 100644
--- a/fdts/stm32mp215f-dk.dts
+++ b/fdts/stm32mp215f-dk.dts
@@ -107,7 +107,6 @@
 				regulator-name = "vdd1_ddr";
 				regulator-min-microvolt = <1800000>;
 				regulator-max-microvolt = <1800000>;
-				regulator-enable-ramp-delay = <1000>;
 			};
 			vdd3v3_usb: ldo4 {
 				regulator-name = "vdd3v3_usb";
diff --git a/fdts/stm32mp235f-dk.dts b/fdts/stm32mp235f-dk.dts
index 1af36e8610..47e27b1055 100644
--- a/fdts/stm32mp235f-dk.dts
+++ b/fdts/stm32mp235f-dk.dts
@@ -132,7 +132,6 @@
 				regulator-name = "vdd1_ddr";
 				regulator-min-microvolt = <1800000>;
 				regulator-max-microvolt = <1800000>;
-				regulator-enable-ramp-delay = <1000>;
 			};
 			vdd3v3_usb: ldo4 {
 				regulator-name = "vdd3v3_usb";
diff --git a/fdts/stm32mp257f-dk.dts b/fdts/stm32mp257f-dk.dts
index 15680244f5..14186e5aa7 100644
--- a/fdts/stm32mp257f-dk.dts
+++ b/fdts/stm32mp257f-dk.dts
@@ -128,7 +128,6 @@
 				regulator-name = "vdd1_ddr";
 				regulator-min-microvolt = <1800000>;
 				regulator-max-microvolt = <1800000>;
-				regulator-enable-ramp-delay = <1000>;
 			};
 			vdd3v3_usb: ldo4 {
 				regulator-name = "vdd3v3_usb";
diff --git a/fdts/stm32mp257f-ev1.dts b/fdts/stm32mp257f-ev1.dts
index e5c7dad777..2b358de223 100644
