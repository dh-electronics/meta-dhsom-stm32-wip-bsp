From 6e2fcd1357da378e9ba31b237fb9fb499679940e Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Tue, 21 Apr 2026 18:57:59 +0200
Subject: [PATCH 479/572] fix(el3-runtime): add missing prototypes

When compiling with -Wmissing-prototypes flag enabled, these warnings
are reported:
common/runtime_svc.c:129:6: warning: no previous prototype for
 'handler_interrupt_exception' [-Wmissing-prototypes]
  129 | void handler_interrupt_exception(cpu_context_t *ctx)
      |      ^~~~~~~~~~~~~~~~~~~~~~~~~~~
common/runtime_svc.c:234:6: warning: no previous prototype for
 'handler_sync_exception' [-Wmissing-prototypes]
  234 | void handler_sync_exception(cpu_context_t *ctx)
      |      ^~~~~~~~~~~~~~~~~~~~~~

Add the functions prototypes in runtime_svc.h.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 10f08ef8de2679dd90ef83cfb0ae4a6963cbc49b fix(el3-runtime): add missing prototypes]
Change-Id: I5d26fa167273c9f0a4f351617087d7b47cb7b5c6
Signed-off-by: Yann Gautier <yann.gautier@st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/572119
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
Tested-by: Yann GAUTIER <yann.gautier@foss.st.com>
---
 include/common/runtime_svc.h | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/include/common/runtime_svc.h b/include/common/runtime_svc.h
index 26e8d6f283..d4ebb026af 100644
--- a/include/common/runtime_svc.h
+++ b/include/common/runtime_svc.h
@@ -1,5 +1,5 @@
 /*
- * Copyright (c) 2013-2019, ARM Limited and Contributors. All rights reserved.
+ * Copyright (c) 2013-2026, Arm Limited and Contributors. All rights reserved.
  *
  * SPDX-License-Identifier: BSD-3-Clause
  */
@@ -7,6 +7,7 @@
 #ifndef RUNTIME_SVC_H
 #define RUNTIME_SVC_H
 
+#include <context.h>
 #include <common/bl_common.h>		/* to include exception types */
 #include <lib/cassert.h>
 #include <lib/utils_def.h>
@@ -125,6 +126,8 @@ static inline uint32_t get_unique_oen_from_smc_fid(uint32_t fid)
 /*******************************************************************************
  * Function & variable prototypes
  ******************************************************************************/
+void handler_interrupt_exception(cpu_context_t *ctx);
+void handler_sync_exception(cpu_context_t *ctx);
 void runtime_svc_init(void);
 uintptr_t handle_runtime_svc(uint32_t smc_fid, void *cookie, void *handle,
 						unsigned int flags);
