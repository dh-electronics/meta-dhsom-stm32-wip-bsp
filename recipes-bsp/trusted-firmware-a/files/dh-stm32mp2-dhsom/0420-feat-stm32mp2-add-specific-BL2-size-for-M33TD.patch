From ecc3cf541939e55e6af8c788a3faa469dc725ae3 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Fri, 13 Mar 2026 18:16:03 +0100
Subject: [PATCH 420/572] feat(stm32mp2): add specific BL2 size for M33TD
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add a dedicated BL2 size configuration when STM32MP_M33_TDCID is enabled:
BL2 total size is increased from 0x0002C000 (176 KB) to 0x0002D000 (180 KB)
in the trusted boot

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 0011381e84f949b0190d09cbb9fbd5b9f43f806c feat(stm32mp2): add specific BL2 size for M33TD]
Change-Id: I579efb2b26241780d5a7be9dc979c90410242f6d
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/546981
---
 plat/st/stm32mp2/stm32mp2_def.h | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/plat/st/stm32mp2/stm32mp2_def.h b/plat/st/stm32mp2/stm32mp2_def.h
index 05dccba1d7..ecdd995478 100644
--- a/plat/st/stm32mp2/stm32mp2_def.h
+++ b/plat/st/stm32mp2/stm32mp2_def.h
@@ -228,8 +228,13 @@ enum ddr_type {
 #define STM32MP_BL2_RO_SIZE			U(0x00021000) /* 132 KB */
 #define STM32MP_BL2_SIZE			U(0x0002C000) /* 176 KB for BL2 */
 #else /* STM32MP_UART_PROGRAMMER || STM32MP_USB_PROGRAMMER */
+#if STM32MP_M33_TDCID
+#define STM32MP_BL2_RO_SIZE			U(0x00020000) /* 128 KB */
+#define STM32MP_BL2_SIZE			U(0x0002D000) /* 180 KB for BL2 */
+#else /* STM32MP_M33_TDCID */
 #define STM32MP_BL2_RO_SIZE			U(0x00020000) /* 128 KB */
 #define STM32MP_BL2_SIZE			U(0x0002C000) /* 176 KB for BL2 */
+#endif /* STM32MP_M33_TDCID */
 #endif /* STM32MP_UART_PROGRAMMER || STM32MP_USB_PROGRAMMER */
 #else
 #if STM32MP_UART_PROGRAMMER || STM32MP_USB_PROGRAMMER
-- 
2.53.0

