From 272f6168cde4c825232186888af4f3e7eb2ad379 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Mon, 26 Jan 2026 19:07:43 +0100
Subject: [PATCH 418/572] refactor(stm32mp2): simplify stm32_pm_init

Refactor #if test with else part on STM32MP_M33_TDCID compilation flag.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git dd92d68a872c8610231ba97cc662146f86b5d5f2 refactor(stm32mp2): simplify stm32_pm_init]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: If228176d0898fbaf444f51e17a6698405e60eb93
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/529082
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
---
 plat/st/stm32mp2/stm32mp2_pm.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/plat/st/stm32mp2/stm32mp2_pm.c b/plat/st/stm32mp2/stm32mp2_pm.c
index 05f1f46967..bbee9e01d5 100644
--- a/plat/st/stm32mp2/stm32mp2_pm.c
+++ b/plat/st/stm32mp2/stm32mp2_pm.c
@@ -1560,10 +1560,10 @@ static void stm32_pm_init(void *fdt)
 	/* Clear CSleep and Stop request for CPU1 */
 	mmio_write_32(rcc_base + RCC_C1SREQCLRR, RCC_C1SREQSETR_STPREQ_MASK);
 
-#if !STM32MP_M33_TDCID
-	stm32_pm_tdcid_init(fdt);
-#else
+#if STM32MP_M33_TDCID
 	scmi_init();
+#else
+	stm32_pm_tdcid_init(fdt);
 #endif
 }
 
