+++ b/drivers/st/ddr/stm32mp2_ram.c
@@ -116,6 +116,8 @@ static int stm32mp2_ddr_setup(void)
 		config.self_refresh = true;
 	}
 
+	stm32mp_init_retram();
+
 	/*  Map dynamically RETRAM area to save or restore PHY retention registers */
 	if (stm32mp_map_retram() != 0) {
 		panic();
diff --git a/plat/st/common/include/stm32mp_common.h b/plat/st/common/include/stm32mp_common.h
index 0931d826ec..8698d16e9d 100644
--- a/plat/st/common/include/stm32mp_common.h
+++ b/plat/st/common/include/stm32mp_common.h
@@ -150,7 +150,8 @@ void stm32mp_io_exit(void);
 int stm32mp_map_ddr_non_cacheable(void);
 int stm32mp_unmap_ddr(void);
 
-/* Functions to map RETRAM, and unmap it */
+/* Functions for RETRAM memory: init, map and unmap */
