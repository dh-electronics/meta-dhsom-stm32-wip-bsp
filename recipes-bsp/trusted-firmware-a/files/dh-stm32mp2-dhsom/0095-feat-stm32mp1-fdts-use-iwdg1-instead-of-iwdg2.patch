From 1bc8603326feb8e11bf158f6fa20e462abf32a2c Mon Sep 17 00:00:00 2001
From: Lionel Debieve <lionel.debieve@foss.st.com>
Date: Tue, 11 Apr 2023 00:58:30 +0200
Subject: [PATCH 095/572] feat(stm32mp1-fdts): use iwdg1 instead of iwdg2

Change to use the iwdg1 by default on STM32MP1x boards.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 898fe8ab70283bbc67c06f3305b71f5bb7079146 feat(stm32mp1-fdts): use iwdg1 instead of iwdg2]
Signed-off-by: Lionel Debieve <lionel.debieve@foss.st.com>
Change-Id: Ie37ecdc9af17fa21023fa0709d7b38f1dbd542a7
---
 fdts/stm32mp135f-dk.dts   | 2 +-
 fdts/stm32mp157c-ed1.dts  | 2 +-
 fdts/stm32mp15xx-dkx.dtsi | 2 +-
 3 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/fdts/stm32mp135f-dk.dts b/fdts/stm32mp135f-dk.dts
index befb032515..6600db24f6 100644
--- a/fdts/stm32mp135f-dk.dts
+++ b/fdts/stm32mp135f-dk.dts
@@ -173,7 +173,7 @@
 	};
 };
 
-&iwdg2 {
+&iwdg1 {
 	timeout-sec = <32>;
 	status = "okay";
 };
diff --git a/fdts/stm32mp157c-ed1.dts b/fdts/stm32mp157c-ed1.dts
index 23e9d90cf1..49b7d3211c 100644
--- a/fdts/stm32mp157c-ed1.dts
+++ b/fdts/stm32mp157c-ed1.dts
@@ -185,7 +185,7 @@
 	};
 };
 
-&iwdg2 {
+&iwdg1 {
 	timeout-sec = <32>;
 	status = "okay";
 };
diff --git a/fdts/stm32mp15xx-dkx.dtsi b/fdts/stm32mp15xx-dkx.dtsi
index 76983f5178..519784337d 100644
--- a/fdts/stm32mp15xx-dkx.dtsi
+++ b/fdts/stm32mp15xx-dkx.dtsi
@@ -189,7 +189,7 @@
 	};
 };
 
-&iwdg2 {
+&iwdg1 {
 	timeout-sec = <32>;
 	status = "okay";
 };
