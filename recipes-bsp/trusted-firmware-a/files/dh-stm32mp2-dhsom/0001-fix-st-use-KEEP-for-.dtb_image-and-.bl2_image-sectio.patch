From 13e9c70b3b3c54fae08a009b7e5f17c99148f88d Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Fri, 7 Nov 2025 17:58:21 +0100
Subject: [PATCH 001/572] fix(st): use KEEP for .dtb_image and .bl2_image
 sections

Use KEEP keyword in linker scripts that are used to build .stm32 files.
This avoids them being removed if --gc-sections option is used.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 2385b94dd07c6bfa24de1e3b34da3f8a8ed4e4bc fix(st): use KEEP for .dtb_image and .bl2_image sections]
Change-Id: If8e98a293199184ef3cabc45da8de6cd505d9886
Signed-off-by: Yann Gautier <yann.gautier@st.com>
---
 plat/st/stm32mp1/stm32mp1.ld.S         | 6 +++---
 plat/st/stm32mp2/aarch64/stm32mp2.ld.S | 6 +++---
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/plat/st/stm32mp1/stm32mp1.ld.S b/plat/st/stm32mp1/stm32mp1.ld.S
index c9d987361b..4338afce08 100644
--- a/plat/st/stm32mp1/stm32mp1.ld.S
+++ b/plat/st/stm32mp1/stm32mp1.ld.S
@@ -1,5 +1,5 @@
 /*
- * Copyright (c) 2015-2025, Arm Limited and Contributors. All rights reserved.
+ * Copyright (c) 2015-2026, Arm Limited and Contributors. All rights reserved.
  *
  * SPDX-License-Identifier: BSD-3-Clause
  */
@@ -45,7 +45,7 @@ SECTIONS
          */
         . = ABSOLUTE( STM32MP_BL2_DTB_BASE );
         __DTB_IMAGE_START__ = .;
-        *(.dtb_image*)
+        KEEP(*(.dtb_image*))
         __DTB_IMAGE_END__ = .;
 
         /*
@@ -59,7 +59,7 @@ SECTIONS
         . = ABSOLUTE( STM32MP_BL2_BASE );
 #endif
         __BL2_IMAGE_START__ = .;
-        *(.bl2_image*)
+        KEEP(*(.bl2_image*))
         __BL2_IMAGE_END__ = .;
 
         __DATA_END__ = .;
diff --git a/plat/st/stm32mp2/aarch64/stm32mp2.ld.S b/plat/st/stm32mp2/aarch64/stm32mp2.ld.S
index cf71f2736c..ba03a726fe 100644
--- a/plat/st/stm32mp2/aarch64/stm32mp2.ld.S
+++ b/plat/st/stm32mp2/aarch64/stm32mp2.ld.S
@@ -1,5 +1,5 @@
 /*
- * Copyright (c) 2023-2025, STMicroelectronics - All Rights Reserved
+ * Copyright (c) 2023-2026, STMicroelectronics - All Rights Reserved
  *
  * SPDX-License-Identifier: BSD-3-Clause
  */
@@ -45,7 +45,7 @@ SECTIONS
          */
         . = ABSOLUTE( STM32MP_BL2_DTB_BASE );
         __DTB_IMAGE_START__ = .;
-        *(.dtb_image*)
+        KEEP(*(.dtb_image*))
         __DTB_IMAGE_END__ = .;
 
         /*
@@ -59,7 +59,7 @@ SECTIONS
         . = ABSOLUTE( STM32MP_BL2_BASE );
 #endif
         __BL2_IMAGE_START__ = .;
-        *(.bl2_image*)
+        KEEP(*(.bl2_image*))
         __BL2_IMAGE_END__ = .;
 
         __DATA_END__ = .;
-- 
