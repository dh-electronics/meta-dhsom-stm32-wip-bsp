From 43b4c91f4146f8cf259b7f53d44ae7bbe060a801 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Tue, 6 Feb 2024 14:54:19 +0100
Subject: [PATCH 232/572] fix(st-crypto): adapt kshareid values for STM32MP25
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

KSHAREID values in CR register are different between plaforms.
Adapt their definitions under flag condition.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git e31113b886fdc6cb43da40608223fffd7acbad38 fix(st-crypto): adapt kshareid values for STM32MP25]
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Change-Id: I100591769dad4565237967ec0a4844a621534516
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/361799
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Nicolas LE BAYON <nicolas.le.bayon@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 drivers/st/crypto/stm32_saes.c | 5 +++++
 plat/st/stm32mp1/platform.mk   | 4 ++++
 plat/st/stm32mp2/platform.mk   | 2 ++
 3 files changed, 11 insertions(+)

diff --git a/drivers/st/crypto/stm32_saes.c b/drivers/st/crypto/stm32_saes.c
index fdb53fbaa9..8817c43f79 100644
--- a/drivers/st/crypto/stm32_saes.c
+++ b/drivers/st/crypto/stm32_saes.c
@@ -77,7 +77,12 @@
 #define _SAES_CR_KEYSEL_TEST		0x7U
 #define _SAES_CR_KSHAREID_MASK		GENMASK(27, 26)
 #define _SAES_CR_KSHAREID_SHIFT		26U
+#if STM32_SAES_VER == 0x30
 #define _SAES_CR_KSHAREID_CRYP		0x0U
+#else /* STM32_SAES_VER != 0x30 */
+#define _SAES_CR_KSHAREID_CRYP1		0x0U
+#define _SAES_CR_KSHAREID_CRYP2		0x1U
+#endif /* STM32_SAES_VER == 0x30 */
 #define _SAES_CR_KEYMOD_MASK		GENMASK(25, 24)
 #define _SAES_CR_KEYMOD_SHIFT		24U
 #define _SAES_CR_KEYMOD_NORMAL		0x0U
diff --git a/plat/st/stm32mp1/platform.mk b/plat/st/stm32mp1/platform.mk
index 338096821f..178c433299 100644
--- a/plat/st/stm32mp1/platform.mk
+++ b/plat/st/stm32mp1/platform.mk
@@ -98,10 +98,12 @@ ifeq ($(STM32MP13),1)
 STM32_HASH_VER		:=	4
 STM32_RNG_VER		:=	4
 STM32_RNG_VER_MINOR	:=	2
+STM32_SAES_VER		:=	48 # 0x30
 else # Assuming STM32MP15
 STM32_HASH_VER		:=	2
 STM32_RNG_VER		:=	2
 STM32_RNG_VER_MINOR	:=	1
+STM32_SAES_VER		:=	0 # Unavailable in this platform
 endif
 
 # Download load address for serial boot devices
@@ -185,6 +187,7 @@ $(eval $(call assert_numerics,\
 		STM32_HEADER_VERSION_MAJOR \
 		STM32_RNG_VER \
 		STM32_RNG_VER_MINOR \
+		STM32_SAES_VER \
 		STM32_TF_A_COPIES \
 )))
 
@@ -199,6 +202,7 @@ $(eval $(call add_defines,\
 		STM32_HEADER_VERSION_MAJOR \
 		STM32_RNG_VER \
 		STM32_RNG_VER_MINOR \
+		STM32_SAES_VER \
 		STM32_TF_A_COPIES \
 		STM32MP_CRYPTO_ROM_LIB \
 		STM32MP_DDR_32BIT_INTERFACE \
diff --git a/plat/st/stm32mp2/platform.mk b/plat/st/stm32mp2/platform.mk
index f3a930d0d9..b30b4bfab2 100644
--- a/plat/st/stm32mp2/platform.mk
+++ b/plat/st/stm32mp2/platform.mk
@@ -212,6 +212,7 @@ $(eval $(call assert_numerics,\
 		STM32_HEADER_VERSION_MAJOR \
 		STM32_RNG_VER \
 		STM32_RNG_VER_MINOR \
+		STM32_SAES_VER \
 		STM32_TF_A_COPIES \
 )))
 
@@ -226,6 +227,7 @@ $(eval $(call add_defines,\
 		STM32_HASH_VER \
 		STM32_RNG_VER \
 		STM32_RNG_VER_MINOR \
+		STM32_SAES_VER \
 		STM32_TF_A_COPIES \
 		STM32MP_CRYPTO_ROM_LIB \
 		STM32MP_DDR_DUAL_AXI_PORT \
-- 
