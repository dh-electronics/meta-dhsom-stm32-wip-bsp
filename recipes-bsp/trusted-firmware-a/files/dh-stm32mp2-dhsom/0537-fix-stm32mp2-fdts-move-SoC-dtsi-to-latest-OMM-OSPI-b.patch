From dd5d54d2f6ab15d21afb70006b95a828da9d0749 Mon Sep 17 00:00:00 2001
From: Christophe Kerello <christophe.kerello@foss.st.com>
Date: Mon, 29 Jun 2026 15:50:28 +0200
Subject: [PATCH 537/572] fix(stm32mp2-fdts): move SoC dtsi to latest OMM/OSPI
 bindings

Update the OMM and OSPI nodes in the SoC device trees to the latest
upstream bindings:
- rename reg-names "omm"/"omm_mm" to "regs"/"memory_map";
- update the OSPI compatible from "st,stm32mp25-omi" to
  "st,stm32mp25-ospi";
- address the OSPI child nodes by instance (spi@0, spi@1) and declare
  the per-instance clocks and resets.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 18e937e821a8270825aec2680e5f6dd961c13bf3 fix(stm32mp2-fdts): move SoC dtsi to latest OMM/OSPI bindings]
Change-Id: Idf48fb0849297dd82645cfd7ccac0a3dc22c837b
Signed-off-by: Christophe Kerello <christophe.kerello@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/583563
Tested-by: Christophe KERELLO <christophe.kerello@st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
Domain-Review: Christophe KERELLO <christophe.kerello@st.com>
Reviewed-by: Christophe KERELLO <christophe.kerello@st.com>
---
 fdts/stm32mp21-bl2.dtsi |  2 +-
 fdts/stm32mp211.dtsi    |  2 +-
 fdts/stm32mp23-bl2.dtsi |  5 +----
 fdts/stm32mp231.dtsi    | 27 ++++++++++++++++-----------
 fdts/stm32mp25-bl2.dtsi |  5 +----
 fdts/stm32mp251.dtsi    | 27 ++++++++++++++++-----------
 6 files changed, 36 insertions(+), 32 deletions(-)

diff --git a/fdts/stm32mp21-bl2.dtsi b/fdts/stm32mp21-bl2.dtsi
index ec378cdf94..6b22fcafb5 100644
--- a/fdts/stm32mp21-bl2.dtsi
+++ b/fdts/stm32mp21-bl2.dtsi
@@ -7,7 +7,7 @@
 
 / {
 	soc@0 {
-#if !STM32MP_SPI_NAND && !STM32MP_SPI_NOR
+#if !STM32MP_SPI_NAND && !STM32MP_SPI_NOR && !STM32MP_HYPERFLASH
 		bus@42080000 {
 			/delete-node/ spi@40430000;
 		};
diff --git a/fdts/stm32mp211.dtsi b/fdts/stm32mp211.dtsi
index 74ef101971..566c8e5afb 100644
--- a/fdts/stm32mp211.dtsi
+++ b/fdts/stm32mp211.dtsi
@@ -206,7 +206,7 @@
 			};
 
 			ospi1: spi@40430000 {
-				compatible = "st,stm32mp25-omi";
+				compatible = "st,stm32mp25-ospi";
 				reg = <0x40430000 0x400>;
 				clocks = <&rcc CK_KER_OSPI1>;
 				resets = <&rcc OSPI1_R>, <&rcc OSPI1DLL_R>;
diff --git a/fdts/stm32mp23-bl2.dtsi b/fdts/stm32mp23-bl2.dtsi
index 01a1f9a803..2f0b96e43b 100644
--- a/fdts/stm32mp23-bl2.dtsi
+++ b/fdts/stm32mp23-bl2.dtsi
@@ -11,10 +11,7 @@
 		/delete-node/ ommanager@40500000;
 #else
 		ommanager@40500000 {
-#if STM32MP_HYPERFLASH
-			/delete-node/ spi@40430000;
-#endif
-			/delete-node/ spi@40440000;
+			/delete-node/ spi@1;
 		};
 #endif
 #if !STM32MP_RAW_NAND
diff --git a/fdts/stm32mp231.dtsi b/fdts/stm32mp231.dtsi
index c97deee464..13b5ece2c0 100644
--- a/fdts/stm32mp231.dtsi
+++ b/fdts/stm32mp231.dtsi
@@ -122,28 +122,33 @@
 		ranges = <0x0 0x0 0x0 0x80000000>;
 
 		ommanager: ommanager@40500000 {
-			#address-cells = <2>;
-			#size-cells = <1>;
 			compatible = "st,stm32mp25-omm";
 			reg = <0x40500000 0x400>, <0x60000000 0x10000000>;
-			reg-names = "omm", "omm_mm";
-			clocks = <&rcc CK_BUS_OSPIIOM>;
-			resets = <&rcc OSPIIOM_R>;
-			status = "disabled";
-
+			reg-names = "regs", "memory_map";
 			ranges = <0 0 0x40430000 0x400>,
 				 <1 0 0x40440000 0x400>;
+			clocks = <&rcc CK_BUS_OSPIIOM>,
+				 <&rcc CK_KER_OSPI1>,
+				 <&rcc CK_KER_OSPI2>;
+			clock-names = "omm", "ospi1", "ospi2";
+			resets = <&rcc OSPIIOM_R>,
+				 <&rcc OSPI1_R>,
+				 <&rcc OSPI2_R>;
+			reset-names = "omm", "ospi1", "ospi2";
+			#address-cells = <2>;
+			#size-cells = <1>;
+			status = "disabled";
 
-			ospi1: spi@40430000 {
-				compatible = "st,stm32mp25-omi";
+			ospi1: spi@0 {
+				compatible = "st,stm32mp25-ospi";
 				reg = <0 0 0x400>;
 				clocks = <&rcc CK_KER_OSPI1>;
 				resets = <&rcc OSPI1_R>, <&rcc OSPI1DLL_R>;
 				status = "disabled";
 			};
 
-			ospi2: spi@40440000 {
-				compatible = "st,stm32mp25-omi";
+			ospi2: spi@1 {
+				compatible = "st,stm32mp25-ospi";
 				reg = <1 0 0x400>;
 				clocks = <&rcc CK_KER_OSPI2>;
 				resets = <&rcc OSPI2_R>, <&rcc OSPI2DLL_R>;
diff --git a/fdts/stm32mp25-bl2.dtsi b/fdts/stm32mp25-bl2.dtsi
index 92ade9b179..b0a2f89659 100644
--- a/fdts/stm32mp25-bl2.dtsi
+++ b/fdts/stm32mp25-bl2.dtsi
@@ -11,10 +11,7 @@
 		/delete-node/ ommanager@40500000;
 #else
 		ommanager@40500000 {
-#if STM32MP_HYPERFLASH
-			/delete-node/ spi@40430000;
-#endif
-			/delete-node/ spi@40440000;
+			/delete-node/ spi@1;
 		};
 #endif
 #if !STM32MP_RAW_NAND
diff --git a/fdts/stm32mp251.dtsi b/fdts/stm32mp251.dtsi
index f19fee1dc0..bb1445d362 100644
--- a/fdts/stm32mp251.dtsi
+++ b/fdts/stm32mp251.dtsi
@@ -122,28 +122,33 @@
 		ranges = <0x0 0x0 0x0 0x80000000>;
 
 		ommanager: ommanager@40500000 {
-			#address-cells = <2>;
-			#size-cells = <1>;
 			compatible = "st,stm32mp25-omm";
 			reg = <0x40500000 0x400>, <0x60000000 0x10000000>;
-			reg-names = "omm", "omm_mm";
-			clocks = <&rcc CK_BUS_OSPIIOM>;
-			resets = <&rcc OSPIIOM_R>;
-			status = "disabled";
-
+			reg-names = "regs", "memory_map";
 			ranges = <0 0 0x40430000 0x400>,
 				 <1 0 0x40440000 0x400>;
+			clocks = <&rcc CK_BUS_OSPIIOM>,
+				 <&rcc CK_KER_OSPI1>,
+				 <&rcc CK_KER_OSPI2>;
+			clock-names = "omm", "ospi1", "ospi2";
+			resets = <&rcc OSPIIOM_R>,
+				 <&rcc OSPI1_R>,
+				 <&rcc OSPI2_R>;
+			reset-names = "omm", "ospi1", "ospi2";
+			#address-cells = <2>;
+			#size-cells = <1>;
+			status = "disabled";
 
-			ospi1: spi@40430000 {
-				compatible = "st,stm32mp25-omi";
+			ospi1: spi@0 {
+				compatible = "st,stm32mp25-ospi";
 				reg = <0 0 0x400>;
 				clocks = <&rcc CK_KER_OSPI1>;
 				resets = <&rcc OSPI1_R>, <&rcc OSPI1DLL_R>;
 				status = "disabled";
 			};
 
-			ospi2: spi@40440000 {
-				compatible = "st,stm32mp25-omi";
+			ospi2: spi@1 {
+				compatible = "st,stm32mp25-ospi";
 				reg = <1 0 0x400>;
 				clocks = <&rcc CK_KER_OSPI2>;
 				resets = <&rcc OSPI2_R>, <&rcc OSPI2DLL_R>;
-- 
