From 26fdccc84f8997bc4f026915d2a391d50e5547a0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Tue, 17 Feb 2026 15:37:32 +0100
Subject: [PATCH 438/572] feat(stm32mp2): add a cold boot detection indication
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add cold/warm boot indication to reset reason log.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git af41e49844bd13ea8a0e993afc9764145c157c3e feat(stm32mp2): add a cold boot detection indication]
Change-Id: I7a4be5c14a6159b802821cd252b70535846ecbdc
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/537519
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 plat/st/stm32mp2/bl2_plat_setup.c | 15 +++++++++++++--
 1 file changed, 13 insertions(+), 2 deletions(-)

diff --git a/plat/st/stm32mp2/bl2_plat_setup.c b/plat/st/stm32mp2/bl2_plat_setup.c
index e7a0af67b8..3af9eb88f5 100644
--- a/plat/st/stm32mp2/bl2_plat_setup.c
+++ b/plat/st/stm32mp2/bl2_plat_setup.c
@@ -120,7 +120,9 @@ static void clean_iac(void)
 
 static void print_reset_reason(void)
 {
-	uint32_t rstsr = mmio_read_32(stm32mp_rcc_base() + RCC_C1BOOTRSTSCLRR);
+	uintptr_t rcc_base = stm32mp_rcc_base();
+	uint32_t rstsr = mmio_read_32(rcc_base + RCC_C1BOOTRSTSCLRR);
+	const char *boot_str = "";
 	const char *reason_str = "Unidentified";
 
 #if !STM32MP21
@@ -129,6 +131,14 @@ static void print_reset_reason(void)
 	}
 #endif /* !STM32MP21 */
 
+#if !STM32MP_M33_TDCID
+	if (((mmio_read_32(rcc_base + RCC_BDCR) & RCC_BDCR_RTCCKEN) == 0U)) {
+		boot_str = " Cold boot.";
+	} else {
+		boot_str = " Warm boot.";
+	}
+#endif
+
 	if ((rstsr & RCC_C1BOOTRSTSCLRR_PADRSTF) == 0U) {
 		if ((rstsr & RCC_C1BOOTRSTSCLRR_STBYC1RSTF) != 0U) {
 			reason_str = "System exits from Standby for CA35";
@@ -160,7 +170,8 @@ static void print_reset_reason(void)
 		}
 	}
 
-	NOTICE("Reset reason: %s (0x%x)\n", reason_str, rstsr);
+	NOTICE("Reset reason: %s (0x%x).%s\n",
+	       reason_str, rstsr, boot_str);
 }
 
 #if STM32MP_M33_TDCID
-- 
2.53.0

