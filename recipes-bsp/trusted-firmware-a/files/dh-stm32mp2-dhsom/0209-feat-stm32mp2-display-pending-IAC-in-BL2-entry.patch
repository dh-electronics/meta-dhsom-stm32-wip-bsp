From 192b1f64ee40a3bf538427f7c50d021436b96321 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Fri, 13 Oct 2023 14:09:59 +0200
Subject: [PATCH 209/572] feat(stm32mp2): display pending IAC in BL2 entry

Dump the IAC in BL2 entry to detect issues in low power entry sequence,
including the IAC generated by the ROM code.
Display them later in the boot, when console is ready.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 897fa95d7ea449e70170764923a82fb5a4d22170 feat(stm32mp2): display pending IAC in BL2 entry]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I23c5fbf4bf2e27361b5346c5b80aff5cdd606525
---
 plat/st/stm32mp2/bl2_plat_setup.c | 60 ++++++++++++++++++++++++++++++-
 1 file changed, 59 insertions(+), 1 deletion(-)

diff --git a/plat/st/stm32mp2/bl2_plat_setup.c b/plat/st/stm32mp2/bl2_plat_setup.c
index 2a7be1a2c4..c42b10aed4 100644
--- a/plat/st/stm32mp2/bl2_plat_setup.c
+++ b/plat/st/stm32mp2/bl2_plat_setup.c
@@ -42,6 +42,61 @@ IMPORT_SYM(uintptr_t, __BSS_END__, BSS_END);
 IMPORT_SYM(uintptr_t, __DATA_START__, DATA_START);
 IMPORT_SYM(uintptr_t, __DATA_END__, DATA_END);
 
+#define IAC_EXCEPT_LSB_BIT(x) ((x) * 32U)
+#define IAC_EXCEPT_MSB_BIT(x) (IAC_EXCEPT_LSB_BIT(x) + 31U)
+
+#if DEBUG
+/* Save all IAC ISR registers + the number of IAC found on last u32 */
+static uint32_t iac_list[IAC_NB + 1U];
+#endif
+
+static void iac_dump(void)
+{
+#if DEBUG
+	uint32_t i;
+
+	for (i = 0U; i < IAC_NB; i++) {
+		uint32_t isr = mmio_read_32(IAC_BASE + IAC_ISR(i));
+		uint32_t ier = mmio_read_32(IAC_BASE + IAC_IER(i));
+
+		isr &= ier;
+		if (isr == 0U) {
+			continue;
+		}
+
+		iac_list[i] = isr;
+		iac_list[IAC_NB]++;
+	}
+#endif
+}
+
+static void iac_display(void)
+{
+#if DEBUG
+	unsigned int i;
+	unsigned int bit;
+
+	if (iac_list[IAC_NB] == 0U) {
+		return;
+	}
+
+	for (i = 0U; i < IAC_NB; i++) {
+		uint32_t isr = iac_list[i];
+
+		WARN("IAC exceptions pending [%u:%u] = %x\n",
+		     IAC_EXCEPT_MSB_BIT(i), IAC_EXCEPT_LSB_BIT(i), isr);
+		bit = 0U;
+		while ((isr != 0U) && (bit < 32U)) {
+			if ((isr & BIT(0)) != 0U) {
+				WARN(" - %u\n", IAC_EXCEPT_LSB_BIT(i) + bit);
+			}
+			isr >>= 1U;
+			bit++;
+		}
+	}
+#endif
+}
+
 static void print_reset_reason(void)
 {
 	uint32_t rstsr = mmio_read_32(stm32mp_rcc_base() + RCC_C1BOOTRSTSCLRR);
@@ -92,6 +147,8 @@ void bl2_el3_early_platform_setup(u_register_t arg0 __unused,
 				  u_register_t arg2 __unused,
 				  u_register_t arg3 __unused)
 {
+	iac_dump();
+
 	stm32mp_save_boot_ctx_address(BOOT_CTX_ADDR);
 
 	stm32_save_header();
@@ -196,7 +253,6 @@ end:
 #endif /* TRUSTED_BOARD_BOOT && DYN_DISABLE_AUTH && !STM32MP21 */
 }
 
-
 void bl2_el3_plat_arch_setup(void)
 {
 	const char *board_model;
@@ -257,6 +313,8 @@ void bl2_el3_plat_arch_setup(void)
 		goto skip_console_init;
 	}
 
+	iac_display();
+
 	stm32mp_print_cpuinfo();
 
 	board_model = dt_get_board_model();
-- 
2.53.0

