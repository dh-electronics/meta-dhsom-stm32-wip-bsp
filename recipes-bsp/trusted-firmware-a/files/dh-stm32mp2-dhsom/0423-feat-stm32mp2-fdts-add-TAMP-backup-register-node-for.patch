From 42c932d96d0c4f155d2e9a442b9efa28d416dd12 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Thu, 22 Jan 2026 15:51:59 +0100
Subject: [PATCH 423/572] feat(stm32mp2-fdts): add TAMP backup register node
 for M33 FW update status
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add a device tree node for TAMP backup register 73, used by MCUBoot in
M33TDCID configuration to report Cortex-M firmware update status.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 6f5688e51f562593a80e8b7b0b2d17ce056e50e2 feat(stm32mp2-fdts): add TAMP backup register node for M33 FW update status]
Change-Id: I6d9da75b599741d4ac89df13a5830fe4f35a51c4
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/528021
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 fdts/stm32mp211.dtsi | 8 ++++++--
 fdts/stm32mp231.dtsi | 8 ++++++--
 fdts/stm32mp251.dtsi | 8 ++++++--
 3 files changed, 18 insertions(+), 6 deletions(-)

diff --git a/fdts/stm32mp211.dtsi b/fdts/stm32mp211.dtsi
index 27e589afb2..74ef101971 100644
--- a/fdts/stm32mp211.dtsi
+++ b/fdts/stm32mp211.dtsi
@@ -383,6 +383,10 @@
 					/* see firmware update info feature */
 					reg = <0xc0 0x4>;
 				};
+				cm_fwu_info: tamp-bkp@124 {
+					/* see firmware update info feature */
+					reg = <0x124 0x4>;
+				};
 				boot_mode: tamp-bkp@180 {
 					reg = <0x180 0x4>;
 				};
@@ -391,8 +395,8 @@
 
 			boot_info: boot-info {
 				compatible = "st,stm32mp-bootinfo";
-				nvmem-cells = <&boot_mode>, <&fwu_info>, <&stop2_entrypoint>;
-				nvmem-cell-names = "boot-mode", "fwu-info", "stop2-entrypoint";
+				nvmem-cells = <&boot_mode>, <&fwu_info>, <&stop2_entrypoint>, <&cm_fwu_info>;
+				nvmem-cell-names = "boot-mode", "fwu-info", "stop2-entrypoint", "cm-fwu-info";
 			};
 		};
 
diff --git a/fdts/stm32mp231.dtsi b/fdts/stm32mp231.dtsi
index 19f80a5230..c97deee464 100644
--- a/fdts/stm32mp231.dtsi
+++ b/fdts/stm32mp231.dtsi
@@ -412,6 +412,10 @@
 					/* see firmware update info feature */
 					reg = <0xc0 0x4>;
 				};
+				cm_fwu_info: tamp-bkp@124 {
+					/* see firmware update info feature */
+					reg = <0x124 0x4>;
+				};
 				boot_mode: tamp-bkp@180 {
 					reg = <0x180 0x4>;
 				};
@@ -420,8 +424,8 @@
 
 			boot_info: boot-info {
 				compatible = "st,stm32mp-bootinfo";
-				nvmem-cells = <&boot_mode>, <&fwu_info>, <&stop2_entrypoint>;
-				nvmem-cell-names = "boot-mode", "fwu-info", "stop2-entrypoint";
+				nvmem-cells = <&boot_mode>, <&fwu_info>, <&stop2_entrypoint>, <&cm_fwu_info>;
+				nvmem-cell-names = "boot-mode", "fwu-info", "stop2-entrypoint", "cm-fwu-info";
 			};
 		};
 
diff --git a/fdts/stm32mp251.dtsi b/fdts/stm32mp251.dtsi
index 5bd95faffb..f19fee1dc0 100644
--- a/fdts/stm32mp251.dtsi
+++ b/fdts/stm32mp251.dtsi
@@ -460,6 +460,10 @@
 					/* see firmware update info feature */
 					reg = <0xc0 0x4>;
 				};
+				cm_fwu_info: tamp-bkp@124 {
+					/* see firmware update info feature */
+					reg = <0x124 0x4>;
+				};
 				boot_mode: tamp-bkp@180 {
 					reg = <0x180 0x4>;
 				};
@@ -468,8 +472,8 @@
 
 			boot_info: boot-info {
 				compatible = "st,stm32mp-bootinfo";
-				nvmem-cells = <&boot_mode>, <&fwu_info>, <&stop2_entrypoint>;
-				nvmem-cell-names = "boot-mode", "fwu-info", "stop2-entrypoint";
+				nvmem-cells = <&boot_mode>, <&fwu_info>, <&stop2_entrypoint>, <&cm_fwu_info>;
+				nvmem-cell-names = "boot-mode", "fwu-info", "stop2-entrypoint", "cm-fwu-info";
 			};
 		};
 
