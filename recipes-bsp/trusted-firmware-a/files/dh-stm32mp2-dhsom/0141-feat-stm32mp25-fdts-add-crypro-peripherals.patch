From b9b5c2a7c47450dbb5fc540935572cf250f644c3 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@foss.st.com>
Date: Wed, 18 Jan 2023 13:50:30 +0100
Subject: [PATCH 141/572] feat(stm32mp25-fdts): add crypro peripherals
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add nodes in device tree for CRYP, HASH, PKA and SAES peripherals.
HASH is available for all STM32MP2 SoCs, so add it in stm32mp251.dtsi.
CRYP1, CRYP2, PKA and SAES are only available for STM32MP25xC or
STM32MP25xF versions.
Add the nodes in the corresponding dtsi files.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 0371055c28d937c20725d6bba078f84ee7a8f6d2 feat(stm32mp25-fdts): add crypro peripherals]
Signed-off-by: Yann Gautier <yann.gautier@foss.st.com>
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Change-Id: Ia0f035aa5caad22ae76680a7d610815f952731ef
---
 fdts/stm32mp251.dtsi  |  8 ++++++++
 fdts/stm32mp25xc.dtsi | 33 +++++++++++++++++++++++++++++++++
 fdts/stm32mp25xf.dtsi | 33 +++++++++++++++++++++++++++++++++
 3 files changed, 74 insertions(+)

diff --git a/fdts/stm32mp251.dtsi b/fdts/stm32mp251.dtsi
index 4769330332..6e2c1fc0a7 100644
--- a/fdts/stm32mp251.dtsi
+++ b/fdts/stm32mp251.dtsi
@@ -248,6 +248,14 @@
 				status = "disabled";
 			};
 
+			hash: hash@42010000 {
+				compatible = "st,stm32mp13-hash";
+				reg = <0x42010000 0x400>;
+				clocks = <&rcc CK_BUS_HASH>;
+				resets = <&rcc HASH_R>;
+				status = "disabled";
+			};
+
 			rng: rng@42020000 {
 				compatible = "st,stm32mp13-rng";
 				reg = <0x42020000 0x400>;
diff --git a/fdts/stm32mp25xc.dtsi b/fdts/stm32mp25xc.dtsi
index 8afb68583d..c58fa9fec5 100644
--- a/fdts/stm32mp25xc.dtsi
+++ b/fdts/stm32mp25xc.dtsi
@@ -5,4 +5,37 @@
  */
 
 / {
+	soc@0 {
+		cryp1: cryp@42030000 {
+			compatible = "st,stm32mp1-cryp";
+			reg = <0x42030000 0x400>;
+			clocks = <&rcc CK_BUS_CRYP1>;
+			resets = <&rcc CRYP1_R>;
+			status = "disabled";
+		};
+
+		cryp2: cryp@42040000 {
+			compatible = "st,stm32mp1-cryp";
+			reg = <0x42040000 0x400>;
+			clocks = <&rcc CK_BUS_CRYP2>;
+			resets = <&rcc CRYP2_R>;
+			status = "disabled";
+		};
+
+		saes: saes@42050000 {
+			compatible = "st,stm32-saes";
+			reg = <0x42050000 0x400>;
+			clocks = <&rcc CK_BUS_SAES>;
+			resets = <&rcc SAES_R>;
+			status = "disabled";
+		};
+
+		pka: pka@42060000 {
+			compatible = "st,stm32mp13-pka64";
+			reg = <0x42060000 0x2000>;
+			clocks = <&rcc CK_BUS_PKA>;
+			resets = <&rcc PKA_R>;
+			status = "disabled";
+		};
+	};
 };
diff --git a/fdts/stm32mp25xf.dtsi b/fdts/stm32mp25xf.dtsi
index 8afb68583d..c58fa9fec5 100644
--- a/fdts/stm32mp25xf.dtsi
+++ b/fdts/stm32mp25xf.dtsi
@@ -5,4 +5,37 @@
  */
 
 / {
+	soc@0 {
+		cryp1: cryp@42030000 {
+			compatible = "st,stm32mp1-cryp";
+			reg = <0x42030000 0x400>;
+			clocks = <&rcc CK_BUS_CRYP1>;
+			resets = <&rcc CRYP1_R>;
+			status = "disabled";
+		};
+
+		cryp2: cryp@42040000 {
+			compatible = "st,stm32mp1-cryp";
+			reg = <0x42040000 0x400>;
+			clocks = <&rcc CK_BUS_CRYP2>;
+			resets = <&rcc CRYP2_R>;
+			status = "disabled";
+		};
+
+		saes: saes@42050000 {
+			compatible = "st,stm32-saes";
+			reg = <0x42050000 0x400>;
+			clocks = <&rcc CK_BUS_SAES>;
+			resets = <&rcc SAES_R>;
+			status = "disabled";
+		};
+
+		pka: pka@42060000 {
+			compatible = "st,stm32mp13-pka64";
+			reg = <0x42060000 0x2000>;
+			clocks = <&rcc CK_BUS_PKA>;
+			resets = <&rcc PKA_R>;
+			status = "disabled";
+		};
+	};
 };
