From f0ec867d5b93505754165c91b0955e059b37b69d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Wed, 26 Jun 2024 14:22:19 +0200
Subject: [PATCH 222/572] feat(st): rework FWU to consider trial counter 0 as
 uninitialized
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ST platforms use a backup register as a countdown  trial counter to
avoid an infinite boot loop in case of a bad firmware update. Use boot
count 1 instead of 0 to switch to an alternate boot bank. This allows
consideration of a 0 in the backup register as an uninitialized counter
and simplifies its setup.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 9ca47e2d5b6953777d7b8dd99050ec9579f447a1 feat(st): rework FWU to consider trial counter 0 as uninitialized]
Signed-off-by: Christophe Guibout <christophe.guibout@st.com>
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Change-Id: I2424fadaa355aa2bdbdb2d3da395485fbbc8e530
---
 plat/st/common/bl2_io_storage.c         | 20 ++++++++++++++------
 plat/st/common/include/stm32mp_common.h |  2 +-
 2 files changed, 15 insertions(+), 7 deletions(-)

diff --git a/plat/st/common/bl2_io_storage.c b/plat/st/common/bl2_io_storage.c
index ecadefb3bb..68c194f304 100644
--- a/plat/st/common/bl2_io_storage.c
+++ b/plat/st/common/bl2_io_storage.c
@@ -807,10 +807,18 @@ uint32_t plat_fwu_get_boot_idx(void)
 
 		boot_idx = data->active_index;
 
-		if (data->bank_state[boot_idx] == FWU_BANK_STATE_VALID) {
+		switch (data->bank_state[boot_idx]) {
+		case FWU_BANK_STATE_ACCEPTED:
+			err = stm32_set_max_fwu_trial_boot_cnt();
+			break;
+		case FWU_BANK_STATE_VALID:
 			err = stm32_get_and_dec_fwu_trial_boot_cnt(&bootcount);
 			if (err == 0) {
-				if (bootcount == 0U) {
+				if (bootcount == 1U) {
+					WARN("Trial FWU fails %u times\n",
+					     (FWU_MAX_TRIAL_REBOOT - 1U));
+					boot_idx = fwu_get_alternate_boot_bank();
+				} else if (bootcount == 0U) {
 					WARN("Trial backup register empty : set max boot count\n");
 					err = stm32_set_max_fwu_trial_boot_cnt();
 				} else {
@@ -818,14 +826,14 @@ uint32_t plat_fwu_get_boot_idx(void)
 						FWU_MAX_TRIAL_REBOOT - bootcount);
 				}
 			}
-		} else if (data->bank_state[boot_idx] ==
-			   FWU_BANK_STATE_ACCEPTED) {
-			err = stm32_set_max_fwu_trial_boot_cnt();
-		} else {
+			break;
+		case FWU_BANK_STATE_INVALID:
+		default:
 			ERROR("The active bank(%u) of the platform is in Invalid State.\n",
 			      boot_idx);
 			boot_idx = fwu_get_alternate_boot_bank();
 			err = stm32_clear_fwu_trial_boot_cnt();
+			break;
 		}
 
 		if (err != 0) {
diff --git a/plat/st/common/include/stm32mp_common.h b/plat/st/common/include/stm32mp_common.h
index 22f9482323..c16103fe5e 100644
--- a/plat/st/common/include/stm32mp_common.h
+++ b/plat/st/common/include/stm32mp_common.h
@@ -19,7 +19,7 @@
 #define STM32MP_CHIP_SEC_OPEN		U(0xA764D182)
 
 /* FWU configuration (max supported value is 15) */
-#define FWU_MAX_TRIAL_REBOOT		U(3)
+#define FWU_MAX_TRIAL_REBOOT		U(4)
 
 /* Define maximum page size for NAND devices */
 #define PLATFORM_MTD_MAX_PAGE_SIZE	U(0x1000)
-- 
