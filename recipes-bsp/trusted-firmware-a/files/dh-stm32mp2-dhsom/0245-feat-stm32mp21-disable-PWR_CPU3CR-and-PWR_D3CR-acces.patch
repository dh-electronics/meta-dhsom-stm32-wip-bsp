From c46d41f7ecb7e50ae13d3a51fa65179b5dee8d20 Mon Sep 17 00:00:00 2001
From: Nicolas Le Bayon <nicolas.le.bayon@st.com>
Date: Sat, 30 Sep 2023 23:07:23 +0200
Subject: [PATCH 245/572] feat(stm32mp21): disable PWR_CPU3CR and PWR_D3CR
 access on STM32MP21

PWR_CPU3CR and PWR_D3CR are not present on STM32MP21.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git dddd87bc666402a5f593560bd22b6752e92f57c4 feat(stm32mp21): disable PWR_CPU3CR and PWR_D3CR access on STM32MP21]
Signed-off-by: Nicolas Le Bayon <nicolas.le.bayon@st.com>
Change-Id: Ibf0bb9edd65fd0155d0e864d2a8346bcb28df155
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/356323
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 plat/st/stm32mp2/stm32mp2_pm.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/plat/st/stm32mp2/stm32mp2_pm.c b/plat/st/stm32mp2/stm32mp2_pm.c
index fbde19f7d3..6364600b25 100644
--- a/plat/st/stm32mp2/stm32mp2_pm.c
+++ b/plat/st/stm32mp2/stm32mp2_pm.c
@@ -462,7 +462,9 @@ static void stm32_pwr_domain_suspend(const psci_power_state_t *target_state)
 	/* Clear previous status */
 	mmio_setbits_32(pwr_base + PWR_CPU1CR, PWR_CPU1CR_CSSF);
 	mmio_setbits_32(pwr_base + PWR_CPU2CR, PWR_CPU2CR_CSSF);
+#if !STM32MP21
 	mmio_setbits_32(pwr_base + PWR_CPU3CR, PWR_CPU3CR_CSSF);
+#endif /* !STM32MP21 */
 
 	/* Enable the Non-secure interrupt to wake up the CPU with WFI for pending interrupt */
 	saved_scr_el3 = read_scr_el3();
@@ -1042,8 +1044,10 @@ static void stm32_pm_init(void)
 					   (1 << PWR_D2CR_LPLVDLY_D2_SHIFT) |
 					   (1 << PWR_D2CR_PODH_D2_SHIFT));
 
+#if !STM32MP21
 	/* System standby not set (D3) */
 	mmio_write_32(pwr_base + PWR_D3CR, 0U);
+#endif /* !STM32MP21 */
 
 	/* To confirmed: delay can be customizable or keep hardcoded at 1ms / 2ms */
 
-- 
2.53.0

