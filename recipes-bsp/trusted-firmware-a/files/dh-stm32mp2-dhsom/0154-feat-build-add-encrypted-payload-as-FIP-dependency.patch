From 42ffe97ddb8d09746936dc021196ee0c12aa86d7 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@foss.st.com>
Date: Mon, 27 Jan 2025 14:52:35 +0100
Subject: [PATCH 154/572] feat(build): add encrypted payload as FIP dependency

When using TOOL_ADD_PAYLOAD with an encrypted file as 5th parameter,
this file should be added as a dependency to FIP file creation, adding
it to FIP_DEPS.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 2f799ba31fd0684fec9ff2b2f5af47ff4da028e1 feat(build): add encrypted payload as FIP dependency]
Change-Id: I69e81a333578fd894117afceb92ab0ed950932d7
Signed-off-by: Yann Gautier <yann.gautier@foss.st.com>
---
 make_helpers/build_macros.mk | 1 +
 1 file changed, 1 insertion(+)

diff --git a/make_helpers/build_macros.mk b/make_helpers/build_macros.mk
index b6a4c93507..22f12b0b3a 100644
--- a/make_helpers/build_macros.mk
+++ b/make_helpers/build_macros.mk
@@ -204,6 +204,7 @@ define TOOL_ADD_PAYLOAD
 ifneq ($(5),)
     $(4)FIP_ARGS += $(2) $(5)
     $(if $(3),$(4)CRT_DEPS += $(1))
+    $(if $(3),$(4)FIP_DEPS += $(5))
 else
     $(4)FIP_ARGS += $(2) $(1)
     $(if $(3),$(4)CRT_DEPS += $(3))
-- 
2.53.0

