From 88ea2445517a3891f83132f04bfdafc4df71960c Mon Sep 17 00:00:00 2001
From: Pascal Paillet <p.paillet@foss.st.com>
Date: Fri, 20 Sep 2024 10:34:45 +0200
Subject: [PATCH 279/572] fix(stm32mp2): isolate STGEN in low power

To guarantee a correct synchronization of the ARM counter with STGEN,
the ARM generic timer has to  be isolated before entering in low power
mode.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git ad6bd728b447202f28bb2ab7e119abc4b8368342 fix(stm32mp2): isolate STGEN in low power]
Change-Id: Ic5c35030bc84965866b0979baa7781979ac688b8
Signed-off-by: Pascal Paillet <p.paillet@foss.st.com>
---
 plat/st/stm32mp2/stm32mp2_pm.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/plat/st/stm32mp2/stm32mp2_pm.c b/plat/st/stm32mp2/stm32mp2_pm.c
index 429ab3e92f..ab28ba06f2 100644
--- a/plat/st/stm32mp2/stm32mp2_pm.c
+++ b/plat/st/stm32mp2/stm32mp2_pm.c
@@ -520,6 +520,8 @@ static void stm32_pwr_domain_suspend(const psci_power_state_t *target_state)
 		break;
 	}
 
+	stm32mp_ca35_lpi_isolate();
+
 	/* Clear previous status */
 	mmio_setbits_32(pwr_base + PWR_CPU1CR, PWR_CPU1CR_CSSF);
 	if (!cpu2_running) {
@@ -612,10 +614,10 @@ static void stm32_pwr_domain_suspend_finish(const psci_power_state_t
 		stm32mp_gic_resume();
 		stm32mp_gic_cpuif_enable();
 
+#if !STM32MP21
 		/* Restore register in CA35SS */
 		stm32mp_ca35_set_vbar(stm32_sec_entrypoint);
 
-#if !STM32MP21
 		/* Start the secondary core if it was running before STOP */
 		if ((core_id == STM32MP_PRIMARY_CPU) &&
 		    stm32mp_state_check(STM32MP_SECONDARY_CPU, STATE_START)) {
@@ -628,6 +630,7 @@ static void stm32_pwr_domain_suspend_finish(const psci_power_state_t
 	case PWRSTATE_LP_STOP1:
 	case PWRSTATE_LPLV_STOP1:
 		VERBOSE("STOP1 exit\n");
+		stm32mp_ca35_lpi_restore();
 		/* Exit DDR self refresh mode after STOP mode */
 		ddr_sr_exit();
 		ddr_restore_sr_mode();
-- 
