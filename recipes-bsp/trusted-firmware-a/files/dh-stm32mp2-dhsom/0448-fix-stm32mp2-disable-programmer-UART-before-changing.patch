From 68b12f1cd7780d1a2108ec2a7e3c9989e42ffc15 Mon Sep 17 00:00:00 2001
From: Nicolas Le Bayon <nicolas.le.bayon@foss.st.com>
Date: Wed, 4 Mar 2026 23:15:34 +0100
Subject: [PATCH 448/572] fix(stm32mp2): disable programmer UART before
 changing clock tree

In the UART programmer use case, the UART port has to be stopped
before updating the clock tree to avoid any spurious character.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git bc161aa10bcc20074f3711b599ca9a9f49c83865 fix(stm32mp2): disable programmer UART before changing clock tree]
Signed-off-by: Nicolas Le Bayon <nicolas.le.bayon@foss.st.com>
Change-Id: Ibbb2760f5d145f058cf59b424a1ac1420adcc559
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/543540
Tested-by: Nicolas LE BAYON <nicolas.le.bayon@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Nicolas LE BAYON <nicolas.le.bayon@st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
---
 plat/st/stm32mp2/bl2_plat_setup.c | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/plat/st/stm32mp2/bl2_plat_setup.c b/plat/st/stm32mp2/bl2_plat_setup.c
index 3af9eb88f5..fbf384e309 100644
--- a/plat/st/stm32mp2/bl2_plat_setup.c
+++ b/plat/st/stm32mp2/bl2_plat_setup.c
@@ -479,6 +479,15 @@ void bl2_el3_plat_arch_setup(void)
 	ddr_sub_system_clk_init();
 #endif
 
+#if STM32MP_UART_PROGRAMMER
+	uart_prog_addr = get_uart_address(boot_context->boot_interface_instance);
+
+	/* Disable programmer UART before changing clock tree */
+	if (serial_uart_interface) {
+		stm32_uart_stop(uart_prog_addr);
+	}
+#endif
+
 	if (fdt_get_address(&fdt) == 0) {
 		panic();
 	}
@@ -506,15 +515,6 @@ void bl2_el3_plat_arch_setup(void)
 		panic();
 	}
 
-#if STM32MP_UART_PROGRAMMER
-	uart_prog_addr = get_uart_address(boot_context->boot_interface_instance);
-
-	/* Disable programmer UART before changing clock tree */
-	if (serial_uart_interface) {
-		stm32_uart_stop(uart_prog_addr);
-	}
-#endif
-
 	if (stm32_iwdg_init() < 0) {
 		panic();
 	}
-- 
