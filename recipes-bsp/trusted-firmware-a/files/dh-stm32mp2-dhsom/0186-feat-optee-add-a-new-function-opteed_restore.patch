From f177143b4880cee2a58b5798134966c4bf275f64 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 13 Sep 2023 20:06:23 +0200
Subject: [PATCH 186/572] feat(optee): add a new function opteed_restore

Add a new function opteed_restore() called to restore the SPD
configuration when BL31 memory is lost but OP-TEE is still load in
memory, for example in DDR kept in self refresh during standby.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git fc544c649a1243af027691bff10cd2575ae7b6df feat(optee): add a new function opteed_restore]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I35fe157397f8b7d46c6e45bb926b934ee96181af
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/327296
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 services/spd/opteed/opteed_main.c    | 12 ++++++++++++
 services/spd/opteed/opteed_private.h |  3 +++
 2 files changed, 15 insertions(+)

diff --git a/services/spd/opteed/opteed_main.c b/services/spd/opteed/opteed_main.c
index b682a698da..6d1e74e7aa 100644
--- a/services/spd/opteed/opteed_main.c
+++ b/services/spd/opteed/opteed_main.c
@@ -867,3 +867,15 @@ DECLARE_RT_SVC(
 	NULL,
 	opteed_smc_handler
 );
+
+/* Define an OPTEED service to restore the SPD when BL31 data are lost */
+void opteed_restore(void)
+{
+	/*
+	 * OPTEE has been successfully initialized.
+	 * Register power management hooks with PSCI
+	 */
+	psci_register_spd_pm_hook(&opteed_pm);
+
+	register_opteed_interrupt_handler();
+}
diff --git a/services/spd/opteed/opteed_private.h b/services/spd/opteed/opteed_private.h
index c484516d34..ccf44ef78f 100644
--- a/services/spd/opteed/opteed_private.h
+++ b/services/spd/opteed/opteed_private.h
@@ -156,6 +156,9 @@ void opteed_cpu_on_finish_handler(u_register_t unused);
 extern optee_context_t opteed_sp_context[OPTEED_CORE_COUNT];
 extern uint32_t opteed_rw;
 extern struct optee_vectors *optee_vector_table;
+
+void opteed_restore(void);
+
 #endif /*__ASSEMBLER__*/
 
 #endif /* OPTEED_PRIVATE_H */
-- 
