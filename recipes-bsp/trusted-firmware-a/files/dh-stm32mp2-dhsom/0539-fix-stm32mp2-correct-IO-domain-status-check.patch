From fa331669ad7cb75b1868599a3c4eb51522b02f28 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 25 Jun 2026 11:04:29 +0200
Subject: [PATCH 539/572] fix(stm32mp2): correct IO domain status check

Fix IO domain enabled detection and correct debug typo.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 38a7380849a2f59ad12a8e30999738590db5c480 fix(stm32mp2): correct IO domain status check]
Change-Id: I479e269204bd3a76b3005fe2ea61f7be718e39f4
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/582093
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
---
 plat/st/stm32mp2/stm32mp2_pwr.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/plat/st/stm32mp2/stm32mp2_pwr.c b/plat/st/stm32mp2/stm32mp2_pwr.c
index 2b3045d70b..ef1a5af1d2 100644
--- a/plat/st/stm32mp2/stm32mp2_pwr.c
+++ b/plat/st/stm32mp2/stm32mp2_pwr.c
@@ -84,9 +84,9 @@ static const struct pwr_regu pwr_regulators[] = {
 static bool stm32mp2_pwr_domain_is_enabled(const struct pwr_regu *regu)
 {
 	uint32_t val = mmio_read_32(stm32mp_pwr_base() + regu->enable_reg);
-	bool status = (val & (regu->valid_mask | regu->enable_reg)) != 0U;
+	bool status = (val & regu->valid_mask) != 0U;
 
-	VERBOSE("pwr: IO doamin status for %s is %d\n", regu->node_name, status);
+	VERBOSE("pwr: IO domain status for %s is %d\n", regu->node_name, status);
 
 	return status;
 
-- 
2.53.0

