From 4c7c47add26f24a4628a354f24444a514c59e2a7 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@foss.st.com>
Date: Wed, 1 Mar 2023 18:12:20 +0100
Subject: [PATCH 167/572] feat(stm32mp2): save/restore DDR encryption key

Save the DDR encryption key in low power context when it is generated.
And retore it when returning from low-power mode.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git ab4ac083a7ac49d8d580dbc55df76c43b4318fa1 feat(stm32mp2): save/restore DDR encryption key]
Signed-off-by: Yann Gautier <yann.gautier@foss.st.com>
Change-Id: I272b5e75d0e5885d2414ae3c09de5e007305a86b
---
 plat/st/stm32mp2/bl2_plat_setup.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/plat/st/stm32mp2/bl2_plat_setup.c b/plat/st/stm32mp2/bl2_plat_setup.c
index 7db3bc49b7..06b7a2b8c7 100644
--- a/plat/st/stm32mp2/bl2_plat_setup.c
+++ b/plat/st/stm32mp2/bl2_plat_setup.c
@@ -32,6 +32,7 @@
 #include <platform_def.h>
 #include <stm32mp_common.h>
 #include <stm32mp_dt.h>
+#include <stm32mp2_context.h>
 
 #define BOOT_CTX_ADDR	0x0e000020UL
 
@@ -307,10 +308,22 @@ static void prepare_encryption(void)
 {
 	uint8_t mkey[RISAF_KEY_SIZE_IN_BYTES];
 
-	/* Generate RISAF encryption key from RNG */
+#if STM32MP_SUPPORT_PM
+	if (stm32mp_is_wakeup_from_standby()) {
+		stm32mp_pm_get_enc_mkey_from_context(mkey);
+	} else {
+		/* Generate RISAF encryption key from RNG */
+		if (stm32_rng_read(mkey, RISAF_KEY_SIZE_IN_BYTES) != 0) {
+			panic();
+		}
+
+		stm32mp_pm_save_enc_mkey_in_context(mkey);
+	}
+#else /* STM32MP_SUPPORT_PM */
 	if (stm32_rng_read(mkey, RISAF_KEY_SIZE_IN_BYTES) != 0) {
 		panic();
 	}
+#endif /* STM32MP_SUPPORT_PM */
 
 	if (stm32mp2_risaf_write_encryption_key(RISAF4_INST, mkey) != 0) {
 		panic();
-- 
