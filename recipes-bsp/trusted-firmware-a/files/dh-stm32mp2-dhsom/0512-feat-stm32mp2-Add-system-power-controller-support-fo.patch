From 7e12c5747781eb5223d988ee24383aa84b64807b Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Tue, 9 Jun 2026 18:55:08 +0200
Subject: [PATCH 512/572] feat(stm32mp2): Add system-power-controller support
 for STPMIC

This indicates that STPMIC is the power supply master of the
system. With this flag, the driver will initiate an software switch OFF
for system poweroff.

For STPM32MP1, PMIC switch off is forced when mode is STM32_PM_SHUTDOWN
for backyard compatibility but the PMIC switch off is request for any
poweroff request when "system-power-controller" is present in pmic node
for TFA device tree.

This patch also uses this new binding for stm32mp135f-dk device tree.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git b1c5f8882e2a0b15b61880bfd664abbb9141d1cf feat(stm32mp2): Add system-power-controller support for STPMIC]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I904e933b64c10b43a5212a29f05b5b3c1ee00867
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/577282
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
---
 docs/devicetree/bindings/power/st,stpmic1.txt |  5 +++++
 drivers/st/pmic/stm32mp_pmic.c                | 15 ++++++++++++++-
 drivers/st/pmic/stm32mp_pmic2.c               | 14 +++++++++++++-
 fdts/stm32mp135f-dk.dts                       |  1 +
 include/drivers/st/stm32mp_pmic.h             |  2 +-
 include/drivers/st/stpmic2.h                  |  1 +
 plat/st/stm32mp1/stm32mp1_critic_power.c      | 14 ++++++++++----
 plat/st/stm32mp2/stm32mp2_pm.c                |  6 ++++++
 8 files changed, 51 insertions(+), 7 deletions(-)

diff --git a/docs/devicetree/bindings/power/st,stpmic1.txt b/docs/devicetree/bindings/power/st,stpmic1.txt
index 83307d23b4..5a19e067b7 100644
--- a/docs/devicetree/bindings/power/st,stpmic1.txt
+++ b/docs/devicetree/bindings/power/st,stpmic1.txt
@@ -45,6 +45,11 @@ Required parent device properties:
 	IT_TWARN_R=30
 	IT_TWARN_F=31
 
+Optional properties:
+- system-power-controller: This indicates that STPMIC is the power supply master of the
+  system. With this flag, the driver will initiate an software switch OFF
+  for system poweroff.
+
 STPMIC1 consists in a varied group of sub-devices.
 Each sub-device binding is be described in own documentation file.
 
diff --git a/drivers/st/pmic/stm32mp_pmic.c b/drivers/st/pmic/stm32mp_pmic.c
index d706d49101..95203d8653 100644
--- a/drivers/st/pmic/stm32mp_pmic.c
+++ b/drivers/st/pmic/stm32mp_pmic.c
@@ -24,6 +24,7 @@
 
 static struct i2c_handle_s i2c_handle;
 static uint32_t pmic_i2c_addr;
+static bool stpmic1_system_power_controller;
 
 static int register_pmic(void);
 
@@ -254,8 +255,14 @@ int pmic_voltages_init(void)
 	return 0;
 }
 
-void pmic_switch_off(void)
+/* Execute STPMIC sotfware switch off if requested or configured in DT */
+void pmic_switch_off(bool force)
 {
+	if (!force && !stpmic1_system_power_controller)
+		return;
+
+	INFO("STPMIC1: software switch off\n");
+	console_flush();
 	if (stpmic1_switch_off() == 0) {
 		udelay(100);
 	}
@@ -416,6 +423,12 @@ static int register_pmic(void)
 		return pmic_node;
 	}
 
+	if (fdt_getprop(fdt, pmic_node, "system-power-controller", NULL) == NULL) {
+		stpmic1_system_power_controller = false;
+	} else {
+		stpmic1_system_power_controller = true;
+	}
+
 	regulators_node = fdt_subnode_offset(fdt, pmic_node, "regulators");
 	if (regulators_node < 0) {
 		return -ENOENT;
diff --git a/drivers/st/pmic/stm32mp_pmic2.c b/drivers/st/pmic/stm32mp_pmic2.c
index 57f34905ef..a9761a75ef 100644
--- a/drivers/st/pmic/stm32mp_pmic2.c
+++ b/drivers/st/pmic/stm32mp_pmic2.c
@@ -188,8 +188,14 @@ bool initialize_pmic_i2c(void)
 	return true;
 }
 
-void pmic_switch_off(void)
+/* Execute STPMIC sotfware switch off if requested or configured in DT */
+void pmic_switch_off(bool force)
 {
+	if (!force && !pmic2->system_power_controller)
+		return;
+
+	INFO("STPMIC2: software switch off\n");
+	console_flush();
 	if (stpmic2_switch_off(pmic2) == 0) {
 		udelay(100);
 	}
@@ -444,6 +450,12 @@ static int register_pmic2(void)
 		return pmic_node;
 	}
 
+	if (fdt_getprop(fdt, pmic_node, "system-power-controller", NULL) == NULL) {
+		pmic2->system_power_controller = false;
+	} else {
+		pmic2->system_power_controller = true;
+	}
+
 	regulators_node = fdt_subnode_offset(fdt, pmic_node, "regulators");
 	if (regulators_node < 0) {
 		return -ENOENT;
diff --git a/fdts/stm32mp135f-dk.dts b/fdts/stm32mp135f-dk.dts
index 6600db24f6..63df71364b 100644
--- a/fdts/stm32mp135f-dk.dts
+++ b/fdts/stm32mp135f-dk.dts
@@ -80,6 +80,7 @@
 	pmic: stpmic@33 {
 		compatible = "st,stpmic1";
 		reg = <0x33>;
+		system-power-controller;
 
 		status = "okay";
 
diff --git a/include/drivers/st/stm32mp_pmic.h b/include/drivers/st/stm32mp_pmic.h
index e810767e9f..300634667a 100644
--- a/include/drivers/st/stm32mp_pmic.h
+++ b/include/drivers/st/stm32mp_pmic.h
@@ -63,6 +63,6 @@ int pmic_voltages_init(void);
  *
  * Panics on errors
  */
-void pmic_switch_off(void);
+void pmic_switch_off(bool force);
 
 #endif /* STM32MP_PMIC_H */
diff --git a/include/drivers/st/stpmic2.h b/include/drivers/st/stpmic2.h
index 8c403f1284..488dc541d1 100644
--- a/include/drivers/st/stpmic2.h
+++ b/include/drivers/st/stpmic2.h
@@ -371,6 +371,7 @@ struct pmic_handle_s {
 	uint32_t i2c_addr;
 	unsigned int pmic_status;
 	uint8_t ref_id;
+	bool system_power_controller;
 };
 
 int stpmic2_register_read(struct pmic_handle_s *pmic,
diff --git a/plat/st/stm32mp1/stm32mp1_critic_power.c b/plat/st/stm32mp1/stm32mp1_critic_power.c
index 5f2f3d8937..e24fe74251 100644
--- a/plat/st/stm32mp1/stm32mp1_critic_power.c
+++ b/plat/st/stm32mp1/stm32mp1_critic_power.c
@@ -45,14 +45,18 @@ static void cstop_critic_enter(uint32_t mode)
 	}
 }
 
-static void shutdown_critic_enter(void)
+static void shutdown_critic_enter(uint32_t mode)
 {
 	if (dt_pmic_status() > 0) {
 		if (!initialize_pmic_i2c()) {
 			panic();
 		}
 
-		pmic_switch_off();
+		/*
+		 * Force shutdown when requested by OP-TEE (legacy)
+		 * or when indicated by DT with "system-power-controller"
+		 */
+		pmic_switch_off(mode == (uint32_t)STM32_PM_SHUTDOWN);
 	}
 }
 
@@ -188,8 +192,10 @@ int stm32_pwr_down_wfi_load(bool is_cstop, uint32_t mode)
 		cstop_critic_enter(soc_mode);
 	}
 
-	if (soc_mode == (uint32_t)STM32_PM_SHUTDOWN) {
-		shutdown_critic_enter();
+	/* Shutdown with STPMIC switch OFF mode when supported */
+	if (soc_mode == (uint32_t)STM32_PM_SHUTDOWN ||
+	    soc_mode == (uint32_t)STM32_PM_CSTOP_ALLOW_STANDBY_DDR_OFF) {
+		shutdown_critic_enter(soc_mode);
 	}
 
 	/*
diff --git a/plat/st/stm32mp2/stm32mp2_pm.c b/plat/st/stm32mp2/stm32mp2_pm.c
index caa3fde3cd..bfb5854a8e 100644
--- a/plat/st/stm32mp2/stm32mp2_pm.c
+++ b/plat/st/stm32mp2/stm32mp2_pm.c
@@ -20,6 +20,7 @@
 #include <drivers/st/bsec3_reg.h>
 #include <drivers/st/stm32mp_clkfunc.h>
 #include <drivers/st/stm32mp_ddr.h>
+#include <drivers/st/stm32mp_pmic.h>
 #include <drivers/st/stm32mp_reset.h>
 #include <drivers/st/stm32mp2_ddr_helpers.h>
 #include <lib/mmio.h>
@@ -1202,6 +1203,11 @@ static void stm32_system_off(void)
 	INFO("BL31: power off\n");
 	console_flush();
 
+	if (dt_pmic_status() > 0) {
+		/* STPMIC switch off when requested in BL31 device tree */
+		pmic_switch_off(false);
+	}
+
 	stm32mp_ca35_lpi_isolate();
 
 	dsb();
-- 
2.53.0

