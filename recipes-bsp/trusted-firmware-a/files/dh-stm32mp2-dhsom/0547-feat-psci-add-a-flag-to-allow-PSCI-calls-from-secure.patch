+-  ``PSCI_CALLS_FROM_SECURE``: Enable this flag to allow PSCI calls from
+   secure world. This is disabled by default. This can be used when there is
+   no non-secure software running, and the secure software could call PSCI
+   functions like CPU_ON.
+
 -  ``PSCI_EXTENDED_STATE_ID``: As per PSCI1.0 Specification, there are 2 formats
    possible for the PSCI power-state parameter: original and extended State-ID
    formats. This flag if set to 1, configures the generic PSCI layer to use the
diff --git a/lib/psci/psci_common.c b/lib/psci/psci_common.c
index 10f7d9c701..a28f0d1620 100644
--- a/lib/psci/psci_common.c
+++ b/lib/psci/psci_common.c
@@ -912,6 +912,69 @@ void psci_release_pwr_domain_locks(unsigned int end_pwrlvl,
  * PSCI entrypoint on power on/resume and returns it.
  ******************************************************************************/
 #ifdef __aarch64__
+#if PSCI_CALLS_FROM_SECURE
+static int psci_get_s_ep_info(entry_point_info_t *ep,
+			       uintptr_t entrypoint,
+			       u_register_t context_id)
+{
+	u_register_t ep_attr, sctlr;
+	unsigned int daif, ee, mode;
+	u_register_t s_scr_el3 = read_scr_el3();
+	u_register_t s_esr_el3 = read_esr_el3();
+	u_register_t s_sctlr_el1 = read_sctlr_el1();
+
+	sctlr = ((s_scr_el3 & SCR_EEL2_BIT) != 0U) ?
+		read_sctlr_el2() : s_sctlr_el1;
+	ee = 0;
+
+	ep_attr = EP_ST_DISABLE;
+	if ((sctlr & SCTLR_EE_BIT) != 0U) {
+		ep_attr |= EP_EE_BIG;
+		ee = 1;
+	}
+	SET_PARAM_HEAD(ep, PARAM_EP, VERSION_1, ep_attr);
+
+	ep->pc = entrypoint;
+	zeromem(&ep->args, sizeof(ep->args));
+	ep->args.arg0 = context_id;
+
+	/*
+	 * Figure out whether the cpu enters the secure address space
+	 * in aarch32 or aarch64 from ESR first, or SCR elsewhere.
+	 */
+	if ((EC_BITS(s_esr_el3) != EC_AARCH32_SMC) &&
+	    ((s_scr_el3 & SCR_RW_BIT) != 0U)) {
+
+		/*
+		 * Check whether a Thumb entry point has been provided for an
+		 * aarch64 EL
+		 */
+		if ((entrypoint & 0x1UL) != 0UL) {
+			return PSCI_E_INVALID_ADDRESS;
+		}
+
+		mode = ((s_scr_el3 & SCR_EEL2_BIT) != 0U) ? MODE_EL2 : MODE_EL1;
+
+		ep->spsr = SPSR_64((uint64_t)mode, MODE_SP_ELX,
+				   DISABLE_ALL_EXCEPTIONS);
+	} else {
+
+		mode = ((s_scr_el3 & SCR_EEL2_BIT) != 0U) ?
+			MODE32_hyp : MODE32_svc;
+
+		/*
+		 * TODO: Choose async. exception bits if HYP mode is not
+		 * implemented according to the values of SCR.{AW, FW} bits
+		 */
+		daif = DAIF_ABT_BIT | DAIF_IRQ_BIT | DAIF_FIQ_BIT;
+
+		ep->spsr = SPSR_MODE32((uint64_t)mode, entrypoint & 0x1, ee,
+				       daif);
+	}
+
+	return PSCI_E_SUCCESS;
+}
+#else
 static int psci_get_ns_ep_info(entry_point_info_t *ep,
 			       uintptr_t entrypoint,
 			       u_register_t context_id)
@@ -973,6 +1036,7 @@ static int psci_get_ns_ep_info(entry_point_info_t *ep,
 
 	return PSCI_E_SUCCESS;
 }
+#endif
 #else /* !__aarch64__ */
 static int psci_get_ns_ep_info(entry_point_info_t *ep,
 			       uintptr_t entrypoint,
@@ -1045,7 +1109,11 @@ int psci_validate_entry_point(entry_point_info_t *ep,
 	 * the non-secure world from the non-secure state from
 	 * where this call originated.
 	 */
+#if PSCI_CALLS_FROM_SECURE
+	rc = psci_get_s_ep_info(ep, entrypoint, context_id);
+#else
 	rc = psci_get_ns_ep_info(ep, entrypoint, context_id);
+#endif
 	return rc;
 }
 
@@ -1132,7 +1200,11 @@ void psci_warmboot_entrypoint(unsigned int cpu_idx)
 	 * information that we had stashed away during the cpu_on
 	 * call to set this cpu on its way.
 	 */
+#if PSCI_CALLS_FROM_SECURE
+	cm_prepare_el3_exit(SECURE);
+#else
 	cm_prepare_el3_exit_ns();
+#endif
 
 	/*
 	 * Set the requested and target state of this CPU and all the higher
diff --git a/lib/psci/psci_main.c b/lib/psci/psci_main.c
index 19011fd104..ff6005701a 100644
--- a/lib/psci/psci_main.c
+++ b/lib/psci/psci_main.c
@@ -454,9 +454,15 @@ u_register_t psci_smc_handler(uint32_t smc_fid,
 	(void)handle;
 	u_register_t ret;
 
+#if PSCI_CALLS_FROM_SECURE
+	if (!is_caller_secure(flags)) {
+		return (u_register_t)SMC_UNK;
+	}
+#else
 	if (!is_caller_non_secure(flags)) {
 		return (u_register_t)SMC_UNK;
 	}
+#endif
 
 	/* Check the fid against the capabilities */
 	if ((psci_caps & define_psci_cap(smc_fid)) == 0U) {
diff --git a/lib/psci/psci_setup.c b/lib/psci/psci_setup.c
index 907775ef65..da7697cff8 100644
--- a/lib/psci/psci_setup.c
+++ b/lib/psci/psci_setup.c
@@ -30,7 +30,11 @@ CASSERT(PLATFORM_CORE_COUNT <= (PSCI_MAX_CPUS_INDEX + 1U), assert_psci_cores_ove
  * TODO: Use the memory allocator to set aside memory for the contexts instead
  * of relying on platform defined constants.
  ******************************************************************************/
+#if PSCI_CALLS_FROM_SECURE
+static PER_CPU_DEFINE(cpu_context_t, psci_s_context);
+#else
 static PER_CPU_DEFINE(cpu_context_t, psci_ns_context);
+#endif
 static entry_point_info_t warmboot_ep_info[PLATFORM_CORE_COUNT];
 
 /******************************************************************************
@@ -78,10 +82,17 @@ static void __init psci_init_pwr_domain_node(uint16_t node_idx,
 		psci_flush_dcache_range((uintptr_t)svc_cpu_data,
 						 sizeof(*svc_cpu_data));
 
+#if PSCI_CALLS_FROM_SECURE
+		cm_set_context_by_index(node_idx,
+					(void *) PER_CPU_BY_INDEX(psci_s_context,
+					node_idx),
+					SECURE);
+#else
 		cm_set_context_by_index(node_idx,
 					(void *) PER_CPU_BY_INDEX(psci_ns_context,
 					node_idx),
 					NON_SECURE);
+#endif
 	}
 }
 
