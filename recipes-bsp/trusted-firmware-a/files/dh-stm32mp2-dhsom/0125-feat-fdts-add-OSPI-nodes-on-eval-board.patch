From 7c9187b1270169a0dd3b278cb7d4e4d60e1e8080 Mon Sep 17 00:00:00 2001
From: Christophe Kerello <christophe.kerello@foss.st.com>
Date: Tue, 29 Nov 2022 09:29:49 +0100
Subject: [PATCH 125/572] feat(fdts): add OSPI nodes on eval board

This patch adds OSPI nodes on eval board.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 4470b8f986158ad21f5c8138946a7f434690a2fb feat(fdts): add OSPI nodes on eval board]
Change-Id: I6f480896a186e66e8766d2aae10c88fb7c617e10
Signed-off-by: Christophe Kerello <christophe.kerello@foss.st.com>
---
 fdts/stm32mp257f-ev1.dts | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/fdts/stm32mp257f-ev1.dts b/fdts/stm32mp257f-ev1.dts
index 2b358de223..4b96ba3fd6 100644
--- a/fdts/stm32mp257f-ev1.dts
+++ b/fdts/stm32mp257f-ev1.dts
@@ -151,6 +151,27 @@
 	};
 };
 
+&ommanager {
+	pinctrl-names = "default";
+	pinctrl-0 = <&ospi1_clk_pins_a
+		     &ospi1_io03_pins_a
+		     &ospi1_cs0_pins_a>;
+	status = "okay";
+
+	spi@40430000 {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "okay";
+
+		flash0: flash@0 {
+			compatible = "jedec,spi-nor";
+			reg = <0>;
+			spi-rx-bus-width = <4>;
+			spi-max-frequency = <133000000>;
+		};
+	};
+};
+
 &pwr {
 	vddio1: vddio1 {
 		vddio1-supply = <&vddio_sdcard>;
-- 
2.53.0

