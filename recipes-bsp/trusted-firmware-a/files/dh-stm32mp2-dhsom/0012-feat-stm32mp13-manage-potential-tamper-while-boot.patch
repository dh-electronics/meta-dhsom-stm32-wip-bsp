From bc0f79517c746ee79fea747b547d7be24e30269c Mon Sep 17 00:00:00 2001
From: Nicolas Toromanoff <nicolas.toromanoff@st.com>
Date: Mon, 8 Feb 2021 08:55:53 +0100
Subject: [PATCH 012/572] feat(stm32mp13): manage potential tamper while boot

In BL2, with BMEN=1 blocked secrets due to any potential tamper
will be unblocked, and blocked again at end of boot when
BMEN is reset to 0 at end of BL2.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 7e206c87771834dfdc5966039130b6aa47ed4e6b feat(stm32mp13): manage potential tamper while boot]
Change-Id: I27119ee11281a5991e799c9f5b7c4f6735b0c50b
Signed-off-by: Nicolas Toromanoff <nicolas.toromanoff@st.com>
---
 plat/st/stm32mp1/bl2_plat_setup.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/plat/st/stm32mp1/bl2_plat_setup.c b/plat/st/stm32mp1/bl2_plat_setup.c
index 6e8b5d4f3a..a9c623d8c5 100644
--- a/plat/st/stm32mp1/bl2_plat_setup.c
+++ b/plat/st/stm32mp1/bl2_plat_setup.c
@@ -1,5 +1,5 @@
 /*
- * Copyright (c) 2015-2025, Arm Limited and Contributors. All rights reserved.
+ * Copyright (c) 2015-2026, Arm Limited and Contributors. All rights reserved.
  *
  * SPDX-License-Identifier: BSD-3-Clause
  */
@@ -297,6 +297,9 @@ void bl2_el3_plat_arch_setup(void)
 		goto skip_console_init;
 	}
 
+	/* Enter in boot mode */
+	stm32mp_syscfg_boot_mode_enable();
+
 	stm32mp_print_cpuinfo();
 
 	board_model = dt_get_board_model();
@@ -575,4 +578,7 @@ void bl2_el3_plat_prepare_exit(void)
 #endif /* STM32MP_UART_PROGRAMMER || STM32MP_USB_PROGRAMMER */
 
 	stm32mp1_security_setup();
+
+	/* end of boot mode */
+	stm32mp_syscfg_boot_mode_disable();
 }
-- 
2.53.0

