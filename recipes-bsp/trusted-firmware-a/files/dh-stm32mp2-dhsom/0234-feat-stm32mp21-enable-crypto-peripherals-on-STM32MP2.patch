From e865256ebea202177fde533c0d51964ddb827d04 Mon Sep 17 00:00:00 2001
From: Serge BARANDAO <serge.barandao-ext@st.com>
Date: Mon, 3 Jun 2024 15:35:28 +0200
Subject: [PATCH 234/572] feat(stm32mp21): enable crypto peripherals on
 STM32MP215F-DK board
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

enable SAES, HASH, PKA and RNG1 and RNG2 as they are needed during boot
process.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 7d1f7bf5360625c5f72c6e983b6de38814751d47 feat(stm32mp21): enable crypto peripherals on STM32MP215F-DK board]
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Change-Id: Ib7dc44314c2d56c12497653d812d10b5917839c1
---
 fdts/stm32mp215f-dk.dts | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/fdts/stm32mp215f-dk.dts b/fdts/stm32mp215f-dk.dts
index 24a5895743..e27a20dc73 100644
--- a/fdts/stm32mp215f-dk.dts
+++ b/fdts/stm32mp215f-dk.dts
@@ -54,6 +54,10 @@
 	vddq-supply = <&vdd2_ddr>;
 };
 
+&hash1 {
+	status = "okay";
+};
+
 &i2c3 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&i2c3_pins_a>;
@@ -139,6 +143,10 @@
 	status = "okay";
 };
 
+&pka {
+	status = "okay";
+};
+
 &pwr {
 	vddio1 {
 		vddio1-supply = <&vddio_pmic>;
@@ -157,6 +165,18 @@
 	};
 };
 
+&rng1 {
+	status = "okay";
+};
+
+&rng2 {
+	status = "okay";
+};
+
+&saes {
+	status = "okay";
+};
+
 &sdmmc1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&sdmmc1_b4_pins_a>;
-- 
2.53.0

