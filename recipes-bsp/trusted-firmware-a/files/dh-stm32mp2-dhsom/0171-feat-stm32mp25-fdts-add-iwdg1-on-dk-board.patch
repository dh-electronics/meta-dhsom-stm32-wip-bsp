From 5b3bb26a6b04d2c7bc6e9e341d1eeb241987c640 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Wed, 18 Dec 2024 11:25:07 +0100
Subject: [PATCH 171/572] feat(stm32mp25-fdts): add iwdg1 on dk board
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Enable iwdg1 on dk board file.
Specify the timeout even if the driver ignores it and uses the
reset values already present in the watchdog registers.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 555b43017d946eab861416f817d366f57066b87b feat(stm32mp25-fdts): add iwdg1 on dk board]
Change-Id: Ic67f9cdb3129898b58a0bb5fb2acdea249d15726
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
---
 fdts/stm32mp257f-dk.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/fdts/stm32mp257f-dk.dts b/fdts/stm32mp257f-dk.dts
index f0814b31dc..b0d68ce4d0 100644
--- a/fdts/stm32mp257f-dk.dts
+++ b/fdts/stm32mp257f-dk.dts
@@ -161,6 +161,11 @@
 	};
 };
 
+&iwdg1 {
+	timeout-sec = <32>;
+	status = "okay";
+};
+
 &pwr {
 	vddio1: vddio1 {
 		vddio1-supply = <&vddio_sdcard>;
-- 
2.53.0

