From b900f6fcc973586ba3e6c8eb7f0bd64cb7b11287 Mon Sep 17 00:00:00 2001
From: Nicolas Le Bayon <nicolas.le.bayon@st.com>
Date: Tue, 19 Dec 2023 22:10:20 +0100
Subject: [PATCH 194/572] feat(stm32mp21): stub GPU and VENC BW limiter on
 STM32MP21

GPU and VENC are not present on STM32MP21, so don't manage their BW
limiters.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git dd9bc41e5ff26a278409a5d1643d028e682e65c1 feat(stm32mp21): stub GPU and VENC BW limiter on STM32MP21]
Signed-off-by: Nicolas Le Bayon <nicolas.le.bayon@st.com>
Change-Id: Ifdfc203df36a4b4591b9e0a61864ce9b361d5acb
---
 plat/st/stm32mp2/stm32mp2_syscfg.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/plat/st/stm32mp2/stm32mp2_syscfg.c b/plat/st/stm32mp2/stm32mp2_syscfg.c
index 5ff01b0ce5..30c79bb60b 100644
--- a/plat/st/stm32mp2/stm32mp2_syscfg.c
+++ b/plat/st/stm32mp2/stm32mp2_syscfg.c
@@ -502,11 +502,13 @@ void stm32mp_syscfg_set_icn_qos(void)
 	/* Enable BW regulator */
 	mmio_write_32(SYSCFG_BASE + SYSCFG_ICNE2EBWRCR, U(0x00000051));
 
+#if !STM32MP21
 	/* Disable GPU BW limiter */
 	mmio_write_32(SYSCFG_BASE + SYSCFG_ICNGPUBWLCR, U(0x00004009));
 
 	/* Reduce ICN QOS VDEC priority from 4 to 1 */
 	mmio_write_32(SYSCFG_BASE + SYSCFG_ICNQPCR2, U(0x2149865A));
+#endif /* !STM32MP21 */
 
 #if STM32MP_DDR4_TYPE || STM32MP_LPDDR4_TYPE
 	/* Change value of CPU BW limiter */
-- 
2.53.0

