From 4c80b3376447c416cd5ee0e1d9b8e631e4b8c157 Mon Sep 17 00:00:00 2001
From: Christophe Kerello <christophe.kerello@foss.st.com>
Date: Wed, 12 May 2021 18:42:31 +0200
Subject: [PATCH 100/572] feat(stm32mp25-fdts): add FMC2 support

This patch adds FMC2 support on STM32MP257.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 44dc9a236264a57563eeee0f042b0d71c7553c7a feat(stm32mp25-fdts): add FMC2 support]
Change-Id: I16a72b4bdcb489fa72b0fcecb6f09dd32035a23d
Signed-off-by: Christophe Kerello <christophe.kerello@foss.st.com>
---
 fdts/stm32mp25-bl2.dtsi  |  3 +++
 fdts/stm32mp25-bl31.dtsi |  1 +
 fdts/stm32mp251.dtsi     | 36 ++++++++++++++++++++++++++++++++++++
 3 files changed, 40 insertions(+)

diff --git a/fdts/stm32mp25-bl2.dtsi b/fdts/stm32mp25-bl2.dtsi
index e6662d07b0..723cf012ef 100644
--- a/fdts/stm32mp25-bl2.dtsi
+++ b/fdts/stm32mp25-bl2.dtsi
@@ -5,6 +5,9 @@
 
 / {
 	soc@0 {
+#if !STM32MP_RAW_NAND
+		/delete-node/ memory-controller@48200000;
+#endif
 #if !STM32MP_EMMC && !STM32MP_SDMMC
 		rifsc@42080000 {
 			/delete-node/ mmc@48220000;
diff --git a/fdts/stm32mp25-bl31.dtsi b/fdts/stm32mp25-bl31.dtsi
index fa63f6398f..dcbf89186c 100644
--- a/fdts/stm32mp25-bl31.dtsi
+++ b/fdts/stm32mp25-bl31.dtsi
@@ -5,6 +5,7 @@
 
 / {
 	soc@0 {
+		/delete-node/ memory-controller@48200000;
 		rifsc@42080000 {
 			/delete-node/ mmc@48220000;
 			/delete-node/ mmc@48230000;
diff --git a/fdts/stm32mp251.dtsi b/fdts/stm32mp251.dtsi
index f826eee748..f4ded5acfc 100644
--- a/fdts/stm32mp251.dtsi
+++ b/fdts/stm32mp251.dtsi
@@ -357,6 +357,42 @@
 			status = "okay";
 		};
 
+		fmc: memory-controller@48200000 {
+			#address-cells = <2>;
+			#size-cells = <1>;
+			compatible = "st,stm32mp25-fmc2-ebi";
+			reg = <0x48200000 0x400>;
+			clocks = <&rcc CK_KER_FMC>;
+			resets = <&rcc FMC_R>;
+			status = "disabled";
+
+			ranges = <0 0 0x70000000 0x04000000>, /* EBI CS 1 */
+				 <1 0 0x74000000 0x04000000>, /* EBI CS 2 */
+				 <2 0 0x78000000 0x04000000>, /* EBI CS 3 */
+				 <3 0 0x7c000000 0x04000000>, /* EBI CS 4 */
+				 <4 0 0x48810000 0x00001000>; /* NAND */
+
+			nand-controller@4,0 {
+				#address-cells = <1>;
+				#size-cells = <0>;
+				compatible = "st,stm32mp25-fmc2-nfc";
+				reg = <4 0x0000 0x10>,
+				      <4 0x0090 0x10>,
+				      <4 0x00a0 0x10>,
+				      <4 0x0400 0x10>,
+				      <4 0x0490 0x10>,
+				      <4 0x04a0 0x10>,
+				      <4 0x0800 0x10>,
+				      <4 0x0890 0x10>,
+				      <4 0x08a0 0x10>,
+				      <4 0x0c00 0x10>,
+				      <4 0x0c90 0x10>,
+				      <4 0x0ca0 0x10>;
+				interrupts = <GIC_SPI 122 IRQ_TYPE_LEVEL_HIGH>;
+				status = "disabled";
+			};
+		};
+
 		pinctrl: pinctrl@44240000 {
 			#address-cells = <1>;
 			#size-cells = <1>;
-- 
2.53.0

