From 0be199896c0f8fa42a89ed5912bf1e6752580e3d Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 3 Jun 2026 14:44:16 +0200
Subject: [PATCH 517/572] fix(stm32mp2): drop the "wfi" from
 `stm32mp_pwr_domain_pwr_down_wfi`

To allow for generic handling of a wakeup, the hook
pwr_domain_pwr_down_wfi is no longer expected to call wfi itself.
Update the function name stm32_pwr_domain_pwr_down to reflect this.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 468510e0ecccc7739435f3222dcec0793e5b1be3 fix(stm32mp2): drop the "wfi" from `stm32mp_pwr_domain_pwr_down_wfi`]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I1c2b8c5f84ef37125e4c8e0d3e4328364a9010da
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/574228
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
---
 plat/st/stm32mp2/stm32mp2_pm.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/plat/st/stm32mp2/stm32mp2_pm.c b/plat/st/stm32mp2/stm32mp2_pm.c
index 27aa6836ae..78ea70a9fd 100644
--- a/plat/st/stm32mp2/stm32mp2_pm.c
+++ b/plat/st/stm32mp2/stm32mp2_pm.c
@@ -946,7 +946,7 @@ static void stm32_pwr_domain_suspend_finish(const psci_power_state_t
 	console_switch_state(CONSOLE_FLAG_RUNTIME);
 }
 
-static void stm32_pwr_domain_pwr_down_wfi(const psci_power_state_t *target_state)
+static void stm32_pwr_domain_pwr_down(const psci_power_state_t *target_state)
 {
 	u_register_t mpidr = read_mpidr();
 	uintptr_t pwr_base __maybe_unused = stm32mp_pwr_base();
@@ -1459,7 +1459,7 @@ static const plat_psci_ops_t stm32_psci_ops = {
 	.pwr_domain_suspend = stm32_pwr_domain_suspend,
 	.pwr_domain_on_finish = stm32_pwr_domain_on_finish,
 	.pwr_domain_suspend_finish = stm32_pwr_domain_suspend_finish,
-	.pwr_domain_pwr_down = stm32_pwr_domain_pwr_down_wfi,
+	.pwr_domain_pwr_down = stm32_pwr_domain_pwr_down,
 	.system_off = stm32_system_off,
 	.system_reset = stm32_system_reset,
 	.system_reset2 = stm32_system_reset2,
-- 
