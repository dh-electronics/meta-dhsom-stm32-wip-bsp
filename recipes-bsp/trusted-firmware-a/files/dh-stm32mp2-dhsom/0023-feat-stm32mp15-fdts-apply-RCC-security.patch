From cbcbacee0069c1686dcdbfdc7bbc11089bfc5e38 Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Fri, 21 Oct 2022 12:09:30 +0200
Subject: [PATCH 023/572] feat(stm32mp15-fdts): apply RCC security

RCC is secured when "st,stm32mp1-rcc-secure" compatible is used in DT.
Force this new compatible for ST boards.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git daf829a7aa3f46411d3786f2e1cb4b875cbb9ea1 feat(stm32mp15-fdts): apply RCC security]
Change-Id: I1b51344c19bf2e21d011e185874fbb98ba1c987a
Signed-off-by: Yann Gautier <yann.gautier@foss.st.com>
---
 fdts/stm32mp157c-ed1.dts  | 1 +
 fdts/stm32mp15xx-dkx.dtsi | 1 +
 2 files changed, 2 insertions(+)

diff --git a/fdts/stm32mp157c-ed1.dts b/fdts/stm32mp157c-ed1.dts
index 9af72ad208..23e9d90cf1 100644
--- a/fdts/stm32mp157c-ed1.dts
+++ b/fdts/stm32mp157c-ed1.dts
@@ -196,6 +196,7 @@
 };
 
 &rcc {
+	compatible = "st,stm32mp1-rcc-secure", "st,stm32mp1-rcc", "syscon";
 	st,clksrc = <
 		CLK_MPU_PLL1P
 		CLK_AXI_PLL2P
diff --git a/fdts/stm32mp15xx-dkx.dtsi b/fdts/stm32mp15xx-dkx.dtsi
index 9a11fcc94b..76983f5178 100644
--- a/fdts/stm32mp15xx-dkx.dtsi
+++ b/fdts/stm32mp15xx-dkx.dtsi
@@ -200,6 +200,7 @@
 };
 
 &rcc {
+	compatible = "st,stm32mp1-rcc-secure", "st,stm32mp1-rcc", "syscon";
 	st,clksrc = <
 		CLK_MPU_PLL1P
 		CLK_AXI_PLL2P
-- 
2.53.0

