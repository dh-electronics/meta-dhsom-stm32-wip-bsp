From 7405c4536d60048f212f8ed55371b8f9aed3860d Mon Sep 17 00:00:00 2001
From: Yann Gautier <yann.gautier@st.com>
Date: Wed, 30 Sep 2026 10:04:39 +0200
Subject: [PATCH 567/572] feat(st): propose a legacy version of DDR_FW_HASH_OID

NOT UPSTREAMABLE

This legacy version of DDR_FW_HASH_OID is the one already delivered with
v2.8-stm32mp and v2.10-stm32mp software versions.
But it is conflicting with ETHOSN_NPU_FW_CONTENT_CERT_PK_OID.
To avoid that, create a flag STM32MP_LEGACY_DDR_FW_OID, disabled by
default to use the new version, but that allows keeping the former
version of OID if the flag is enabled.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 41282bdf8b90941415ad3103d9431774a7bf1fe6 feat(st): propose a legacy version of DDR_FW_HASH_OID]
Change-Id: I414db8e4213aea662b77f6e464fd42aab2574515
Signed-off-by: Yann Gautier <yann.gautier@st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/st/tf-a/+/619853
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Tested-by: Yann GAUTIER <yann.gautier@foss.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
---
 docs/plat/st/stm32mp2.rst               |  2 ++
 plat/st/common/common.mk                |  7 +++++++
 plat/st/stm32mp2/cert_create_tbbr.mk    | 10 +++++++++-
 plat/st/stm32mp2/include/platform_oid.h |  4 ++++
 4 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/docs/plat/st/stm32mp2.rst b/docs/plat/st/stm32mp2.rst
index 805289d4db..43059e73e6 100644
--- a/docs/plat/st/stm32mp2.rst
+++ b/docs/plat/st/stm32mp2.rst
@@ -107,6 +107,8 @@ Dedicated STM32MP2 build flags:
 
 - | ``STM32MP_DDR_FIP_IO_STORAGE``: to store DDR firmware in FIP.
   | Default: 1
+- | ``STM32MP_LEGACY_DDR_FW_OID``: Use previous OID for DDR FW certificate.
+  | Default: 0
 - | ``STM32MP_M33_TDCID``: Enable this flag if Cortex-A35 does not have the Trusted Domain Compartment ID (owned by Cortex-M33)
   | Default: 0
 - | ``STM32MP_SEC_APP_FW``: Load only a secure application firmware (at BL32), and no non-secure OS.
diff --git a/plat/st/common/common.mk b/plat/st/common/common.mk
index d4fe8be148..fa8d4b9a86 100644
--- a/plat/st/common/common.mk
+++ b/plat/st/common/common.mk
@@ -107,6 +107,11 @@ $(PLAT_PARTITION_MAX_ENTRIES)")
 endif
 endif
 
+# Use unique DDR_FW_HASH_OID (default with STM32MP_LEGACY_DDR_FW_OID = 0)
+# Or the former version compatible with previous ST TF-A versions (STM32MP_LEGACY_DDR_FW_OID = 1),
+# but conflicting with ETHOSN_NPU_FW_CONTENT_CERT_PK_OID
+STM32MP_LEGACY_DDR_FW_OID	:=	0
+
 $(eval DTC_V = $(shell $($(ARCH)-dtc) -v | awk '{print $$NF}'))
 $(eval DTC_VERSION = $(shell printf "%d" $(shell echo ${DTC_V} | cut -d- -f1 | sed "s/\./0/g" | grep -o "[0-9]*")))
 DTC_CPPFLAGS			+=	${INCLUDES}
@@ -163,6 +168,7 @@ $(eval $(call assert_booleans,\
 		STM32MP_EMMC_BOOT \
 		STM32MP_HALT_ON_PANIC \
 		STM32MP_HYPERFLASH \
+		STM32MP_LEGACY_DDR_FW_OID \
 		STM32MP_PSA_FWU_AB_SUPPORT \
 		STM32MP_RAW_NAND \
 		STM32MP_RECONFIGURE_CONSOLE \
@@ -189,6 +195,7 @@ $(eval $(call add_defines,\
 		STM32MP_EMMC_BOOT \
 		STM32MP_HALT_ON_PANIC \
 		STM32MP_HYPERFLASH \
+		STM32MP_LEGACY_DDR_FW_OID \
 		STM32MP_PSA_FWU_AB_SUPPORT \
 		STM32MP_RAW_NAND \
 		STM32MP_RECONFIGURE_CONSOLE \
diff --git a/plat/st/stm32mp2/cert_create_tbbr.mk b/plat/st/stm32mp2/cert_create_tbbr.mk
index 6214e57422..f7f0934555 100644
--- a/plat/st/stm32mp2/cert_create_tbbr.mk
+++ b/plat/st/stm32mp2/cert_create_tbbr.mk
@@ -1,5 +1,5 @@
 #
-# Copyright (c) 2025, STMicroelectronics - All Rights Reserved
+# Copyright (c) 2025-2026, STMicroelectronics - All Rights Reserved
 #
 # SPDX-License-Identifier: BSD-3-Clause
 #
@@ -10,6 +10,14 @@ CRTTOOL_DEFINES += PLAT_DEF_OID
 CRTTOOL_DEFINES += PDEF_CERTS
 CRTTOOL_DEFINES += PDEF_EXTS
 
+# Check the STM32MP_LEGACY_DDR_FW_OID is passed to the command line
+# The definition in plat/st/common/common.mk is not forwarded to this makefile
+ifeq (${STM32MP_LEGACY_DDR_FW_OID},1)
+CRTTOOL_DEFINES += STM32MP_LEGACY_DDR_FW_OID=1
+else
+CRTTOOL_DEFINES += STM32MP_LEGACY_DDR_FW_OID=0
+endif
+
 CRTTOOL_INCLUDE_DIRS	+= ${PLAT_DIR}include
 
 CRTTOOL_SOURCES		+= ${PLAT_DIR}stm32mp2_tbb_cert.c
diff --git a/plat/st/stm32mp2/include/platform_oid.h b/plat/st/stm32mp2/include/platform_oid.h
index 737f36ecbd..da5f6b09c4 100644
--- a/plat/st/stm32mp2/include/platform_oid.h
+++ b/plat/st/stm32mp2/include/platform_oid.h
@@ -4,4 +4,8 @@
  * SPDX-License-Identifier: BSD-3-Clause
  */
 
+#if STM32MP_LEGACY_DDR_FW_OID
+#define DDR_FW_HASH_OID		"1.3.6.1.4.1.4128.2300.1"
+#else
 #define DDR_FW_HASH_OID		"1.3.6.1.4.1.7616.2100.1401"
+#endif
