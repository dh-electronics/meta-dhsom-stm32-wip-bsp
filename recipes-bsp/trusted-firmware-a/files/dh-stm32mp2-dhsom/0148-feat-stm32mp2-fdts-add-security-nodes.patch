From 9d5b51bed18878da9e9d3a77bb83eb7eda9c9b6c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Wed, 18 Dec 2024 11:23:22 +0100
Subject: [PATCH 148/572] feat(stm32mp2-fdts): add security nodes
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

add HASH, PKA and SAES as they should be used in trusted boot.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/arm-trusted-firmware.git 214b0c1a9413901b7cd3364e3489a0ee91b4889f feat(stm32mp2-fdts): add security nodes]
Change-Id: I15e316d339968b87d502b383261d9fd25662a67e
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
---
 fdts/stm32mp257f-dk.dts | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/fdts/stm32mp257f-dk.dts b/fdts/stm32mp257f-dk.dts
index 14186e5aa7..f0814b31dc 100644
--- a/fdts/stm32mp257f-dk.dts
+++ b/fdts/stm32mp257f-dk.dts
@@ -53,6 +53,10 @@
 	vddq-supply = <&vdd2_ddr>;
 };
 
+&hash {
+	status = "okay";
+};
+
 &i2c7 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&i2c7_pins_a>;
@@ -175,10 +179,18 @@
 	};
 };
 
+&pka {
+	status = "okay";
+};
+
 &rng {
 	status = "okay";
 };
 
+&saes {
+	status = "okay";
+};
+
 &sdmmc1 {
 	pinctrl-names = "default";
 	pinctrl-0 = <&sdmmc1_b4_pins_b>;
-- 
2.53.0

