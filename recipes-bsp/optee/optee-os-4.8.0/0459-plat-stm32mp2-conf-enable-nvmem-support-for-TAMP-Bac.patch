From c9c3fee2262b3aa70161574c2ab66d7f9adcbc60 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 20 May 2026 11:10:42 +0200
Subject: [PATCH 459/913] plat-stm32mp2: conf: enable nvmem support for TAMP
 Backup registers

TAMP backup registers allow information sharing between different
software components/execution levels.
They are described individually as nvmem cells.
The RIF memory access rights of the backup registers is configured
within TAMP registers.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git bfb19fe939372d102cce9b12b1c0a552eeec86bf plat-stm32mp2: conf: enable nvmem support for TAMP Backup registers]
Change-Id: Ib0f7df40e5a2772489b909b6ed0bba1516c2ec5b
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp2/conf.mk | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index b7d793964..e6b68ef84 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -277,6 +277,8 @@ ifeq ($(CFG_TA_STM32MP_NVMEM),y)
 $(call force,CFG_STM32_BSEC_PTA,y,Mandated by CFG_TA_STM32MP_NVMEM)
 CFG_IN_TREE_EARLY_TAS += stm32mp_nvmem/1a8342cc-81a5-4512-99fe-9e2b3e37d626
 endif
+CFG_DRIVERS_NVMEM ?= y
+CFG_STM32_TAMP_NVRAM ?= y
 
 # Default enable PKCS11 TA to have PKCS11 tests built in OP-TEE Test
 CFG_PKCS11_TA ?= y
