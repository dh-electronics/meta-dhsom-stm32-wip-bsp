From e5acf24753f6d5731111856683f8d61b426948cd Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Mon, 12 Feb 2024 17:41:14 +0100
Subject: [PATCH 625/913] plat-stm32mp1: stm32mp1_stpmic1: add regulator
 configuration

Configure the default ramp delay for the STPMIC1 regulators, the
DT configuration should be use only to change this values, for example
fort board or external device constraints.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 5adc07237ce5d5683d9b8faed16f3b2e4ad774a0 plat-stm32mp1: stm32mp1_stpmic1: add regulator configuration]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I5c577e10570d7ecae48ff955ffb4d94ba897ada1
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/359383
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
---
 .../plat-stm32mp1/drivers/stm32mp1_stpmic1.c  | 28 ++++++++++++++++---
 1 file changed, 24 insertions(+), 4 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c b/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c
index 155a0f949..d6d514919 100644
--- a/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c
+++ b/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c
@@ -485,8 +485,26 @@ static TEE_Result pmic_regu_pm(enum pm_op op, uint32_t pm_hint,
 	return TEE_SUCCESS;
 }
 
-static TEE_Result pmic_regu_init(struct regulator *regulator,
-				 const void *fdt __unused, int node __unused)
+static TEE_Result pmic_regu_init(struct regulator *regulator)
+{
+	/* Default configuration for STPMIC regulators */
+	regulator->ramp_delay_uv_per_us = U(2200);
+	regulator->enable_ramp_delay_us = U(1000);
+
+	return TEE_SUCCESS;
+}
+
+static TEE_Result pmic_sw_init(struct regulator *regulator)
+{
+	/* Default configuration for STPMIC power switch */
+	regulator->enable_ramp_delay_us = U(1000);
+
+	return TEE_SUCCESS;
+}
+
+static TEE_Result pmic_supplied_init(struct regulator *regulator,
+				     const void *fdt __unused,
+				     int node __unused)
 {
 	struct pmic_regulator_data *priv = regulator->priv;
 	struct stpmic1_bo_cfg cfg = { };
@@ -526,14 +544,16 @@ static const struct regulator_ops pmic_regu_ops = {
 	.set_voltage = pmic_set_voltage,
 	.get_voltage = pmic_get_voltage,
 	.supported_voltages = pmic_list_voltages,
-	.supplied_init = pmic_regu_init,
+	.init = pmic_regu_init,
+	.supplied_init = pmic_supplied_init,
 };
 DECLARE_KEEP_PAGER_PM(pmic_regu_ops);
 
 static const struct regulator_ops pmic_sw_ops = {
 	.set_state = pmic_set_state,
 	.get_state = pmic_get_state,
-	.supplied_init = pmic_regu_init,
+	.init = pmic_sw_init,
+	.supplied_init = pmic_supplied_init,
 };
 DECLARE_KEEP_PAGER_PM(pmic_sw_ops);
 
-- 
2.53.0

