From 9bd15218a748f810490eb503a85f8496c13d5932 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Fri, 10 Oct 2025 17:58:55 +0200
Subject: [PATCH 684/913] plat-stm32mp1: pageable PM sequences (extend to
 PSCI_CPU_SUSPEND)

Make stm32mp1 PM system-off and system-suspend sequences to execute
in a pageable thread context when CFG_PAGED_PSCI_SYSTEM_OFF,
CFG_PAGED_PSCI_SYSTEM_SUSPEND and CFG_PAGED_PSCI_CPU_SUSPEND are enabled.

Change stm32mp_cpu_reset_state() to call straight the resume entry
point. This is needed because that function disables the MMU, hence
the pager so we can't use the stack to return to caller since
the stack is likely pageable.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git cb4606e6e450e6fd4e20ea484a5ecd469c57fccf plat-stm32mp1: pageable PM sequences (extend to PSCI_CPU_SUSPEND)]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: I4be10c966d08a4a7d66486edd27cfea0fd81c8b0
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/501264
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk           |  1 +
 .../arm/plat-stm32mp1/link_dummies_paged.c    | 11 ++++++++++
 core/arch/arm/plat-stm32mp1/pm/psci.c         | 20 +++++++++++++++----
 .../arch/arm/plat-stm32mp1/pm/stm32mp1_psci.h |  4 ++++
 4 files changed, 32 insertions(+), 4 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index d6cc085ac..14cc6cc80 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -254,6 +254,7 @@ ifeq ($(CFG_WITH_PAGER),y)
 # Default use pageable PM sequence to relax pressure on pager
 CFG_PAGED_PSCI_SYSTEM_OFF ?= y
 CFG_PAGED_PSCI_SYSTEM_SUSPEND ?= y
+CFG_PAGED_PSCI_CPU_SUSPEND ?= y
 # Default use 32bit MMU since it consumes a bit less of resident memory
 CFG_WITH_LPAE ?= n
 endif
diff --git a/core/arch/arm/plat-stm32mp1/link_dummies_paged.c b/core/arch/arm/plat-stm32mp1/link_dummies_paged.c
index a325848ff..6e77d4c1b 100644
--- a/core/arch/arm/plat-stm32mp1/link_dummies_paged.c
+++ b/core/arch/arm/plat-stm32mp1/link_dummies_paged.c
@@ -28,3 +28,14 @@ __psci_system_off(void)
 	panic();
 }
 #endif
+
+#if defined(CFG_PAGED_PSCI_CPU_SUSPEND) && defined(CFG_STM32_PSCI_OSI)
+int __section(".text.dummy.__psci_cpu_suspend")
+__psci_cpu_suspend(uint32_t power_state __unused,
+		   uintptr_t entry __unused,
+		   uint32_t context_id __unused,
+		   struct sm_nsec_ctx *nsec __unused)
+{
+	return 0;
+}
+#endif
diff --git a/core/arch/arm/plat-stm32mp1/pm/psci.c b/core/arch/arm/plat-stm32mp1/pm/psci.c
index 53ef60224..709f833ef 100644
--- a/core/arch/arm/plat-stm32mp1/pm/psci.c
+++ b/core/arch/arm/plat-stm32mp1/pm/psci.c
@@ -572,6 +572,7 @@ static void stm32_cpu_standby(void)
 	while (get_locked(&cstop_enter) != STATE_NONE)
 		wfe();
 }
+DECLARE_KEEP_PAGER(stm32_cpu_standby);
 
 static void stm32_pwr_domain_suspend(unsigned int soc_mode)
 {
@@ -613,10 +614,14 @@ static_assert(CFG_TEE_CORE_NB_CORE <= 2);
 #define STM32_STATE_ID_LP_STOP1		U(0x22)
 #define STM32_STATE_ID_LPLV_STOP1	U(0x222)
 
-int psci_cpu_suspend(uint32_t power_state,
-		     uintptr_t entry __unused,
-		     uint32_t context_id __unused,
-		     struct sm_nsec_ctx *nsec __unused)
+/*
+ * Note: this function is weak just to make it possible to exclude it from
+ * the unpaged area.
+ */
+int __weak __psci_cpu_suspend(uint32_t power_state,
+			      uintptr_t entry __unused,
+			      uint32_t context_id __unused,
+			      struct sm_nsec_ctx *nsec __unused)
 {
 	uint32_t state_id = 0;
 	uint32_t state_type = 0;
@@ -659,4 +664,11 @@ int psci_cpu_suspend(uint32_t power_state,
 	return ret;
 }
 
+/* Override default psci_cpu_suspend() with platform specific sequence */
+int psci_cpu_suspend(uint32_t power_state, uintptr_t entry, uint32_t context_id,
+		     struct sm_nsec_ctx *nsec)
+{
+	return __psci_cpu_suspend(power_state, entry, context_id, nsec);
+}
+
 #endif /* CFG_STM32_PSCI_OSI */
diff --git a/core/arch/arm/plat-stm32mp1/pm/stm32mp1_psci.h b/core/arch/arm/plat-stm32mp1/pm/stm32mp1_psci.h
index 359587f8f..fed64cfb1 100644
--- a/core/arch/arm/plat-stm32mp1/pm/stm32mp1_psci.h
+++ b/core/arch/arm/plat-stm32mp1/pm/stm32mp1_psci.h
@@ -16,4 +16,8 @@ uint32_t __psci_system_suspend(uintptr_t entry, uint32_t context_id,
 /* STM32MP1 PSCI system off entry, possibly excluded from unpaged memory */
 void __psci_system_off(void);
 
+/* STM32MP1 PSCI cpu suspend entry, possibly excluded from unpaged memory */
+int __psci_cpu_suspend(uint32_t power_state, uintptr_t entry,
+		       uint32_t context_id, struct sm_nsec_ctx *nsec);
+
 #endif /*__PM_STM32MP1_PSCI_H*/
-- 
2.53.0

