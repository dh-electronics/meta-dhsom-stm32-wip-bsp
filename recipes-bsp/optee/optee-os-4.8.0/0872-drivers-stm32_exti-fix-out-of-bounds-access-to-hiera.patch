From df5ba40b8e0b3a2c4ddad0f82ae11f5a693d4843 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Thu, 23 Jul 2026 15:09:47 +0200
Subject: [PATCH 872/913] drivers: stm32_exti: fix out-of-bounds access to
 hierarchy array
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

stm32_exti_nbevents() derives the number of EXTI events from an 8-bit
hardware configuration field (hwcfgr1), which can report up to 255
events. The exti->hierarchy[] array is statically sized to
_EXTI_LINES_PER_BANK * _EXTI_BANK_NR (96) entries. Bounding an index
only against stm32_exti_nbevents() therefore does not guarantee it
stays within the array, allowing an out-of-bounds read/write.

Add an explicit bound check against ARRAY_SIZE(exti->hierarchy) in
stm32_exti_get_parent_itr() and stm32_exti_dt_get_chip_cb().

Coverity issue: CID 1200006: CERT-C Characters and Strings
Coverity issue: CID 1200156: Out-of-bounds write
Coverity issue: CID 1200355: CERT-C Characters and Strings
Coverity issue: CID 1200361: Out-of-bounds read

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 6873a0026d3d08a299e3245d46f138317ed2b278 drivers: stm32_exti: fix out-of-bounds access to hierarchy array]
Assisted-by: GitHub-Copilot:Claude-Sonnet-5
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Change-Id: Iec3e149917513a6e30f2d87ca01846c42a9a3d6f
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/592848
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/drivers/stm32_exti.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/core/drivers/stm32_exti.c b/core/drivers/stm32_exti.c
index 454a5386b..4ef5706b1 100644
--- a/core/drivers/stm32_exti.c
+++ b/core/drivers/stm32_exti.c
@@ -271,7 +271,8 @@ static void stm32_exti_set_tz(struct stm32_exti_pdata *exti,
 static struct itr_desc *
 stm32_exti_get_parent_itr(struct stm32_exti_pdata *exti, size_t it)
 {
-	if (!exti || it >= stm32_exti_nbevents(exti) || !exti->hierarchy[it])
+	if (!exti || it >= stm32_exti_nbevents(exti) ||
+	    it >= ARRAY_SIZE(exti->hierarchy) || !exti->hierarchy[it])
 		panic();
 
 	return &exti->hierarchy[it]->parent;
@@ -704,7 +705,8 @@ stm32_exti_dt_get_chip_cb(struct dt_pargs *pargs, void *priv_data,
 	itr_desc->chip = &exti->chip;
 	itr_desc->itr_num = exti_line;
 
-	if (exti_line >= stm32_exti_nbevents(exti))
+	if (exti_line >= stm32_exti_nbevents(exti) ||
+	    exti_line >= ARRAY_SIZE(exti->hierarchy))
 		return TEE_ERROR_GENERIC;
 
 	/* With RIF, check the permission */
