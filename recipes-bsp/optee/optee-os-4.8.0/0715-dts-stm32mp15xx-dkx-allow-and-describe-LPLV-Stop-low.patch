From b5bd0704061e205a6a4bb32303771092de96ef33 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Thu, 2 Apr 2026 11:15:46 +0200
Subject: [PATCH 715/913] dts: stm32mp15xx-dkx: allow and describe LPLV-Stop
 low-power mode.

As LPLV-Stop low power mode is supported by this board. Describe its
regulators configuration and allow it.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git dcdccb8c6ed424e0a40fa042a266b2becb00bae5 dts: stm32mp15xx-dkx: allow and describe LPLV-Stop low-power mode.]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: Id74337698c959079b5cf343fe5bd53fb9501761c
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/553551
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/dts/stm32mp15xx-dkx.dtsi | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/arch/arm/dts/stm32mp15xx-dkx.dtsi b/core/arch/arm/dts/stm32mp15xx-dkx.dtsi
index 4297c1a1c..7562bfba4 100644
--- a/core/arch/arm/dts/stm32mp15xx-dkx.dtsi
+++ b/core/arch/arm/dts/stm32mp15xx-dkx.dtsi
@@ -603,6 +603,7 @@
 	system_suspend_supported_soc_modes = <
 		STM32_PM_CSLEEP_RUN
 		STM32_PM_CSTOP_ALLOW_LP_STOP
+		STM32_PM_CSTOP_ALLOW_LPLV_STOP
 		STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_SR
 	>;
 	system_off_soc_mode = <STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_OFF>;
-- 
