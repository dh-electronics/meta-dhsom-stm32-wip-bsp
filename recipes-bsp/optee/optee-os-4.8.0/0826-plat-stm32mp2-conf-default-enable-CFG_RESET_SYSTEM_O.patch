From 789a998a29d047555cb4ac676a57d0fd753a181b Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Thu, 9 Jul 2026 14:20:15 +0200
Subject: [PATCH 826/913] plat-stm32mp2: conf: default enable
 CFG_RESET_SYSTEM_ON_PANIC

Enable CFG_RESET_SYSTEM_ON_PANIC by default on stm32mp2x platforms to
execute a system reset after dumping the panic backtrace.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git f110a53e5420220392e816b82ac01f682fac7c8d plat-stm32mp2: conf: default enable CFG_RESET_SYSTEM_ON_PANIC]
Change-Id: I81321199d631b1ce1bf35d9e74a0e03109e2b315
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/587085
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 core/arch/arm/plat-stm32mp2/conf.mk | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index 0d8be2e34..4fbd7e855 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -118,6 +118,7 @@ $(call force,CFG_DT,y)
 $(call force,CFG_GIC,y)
 $(call force,CFG_HALT_CORES_SGI,15)
 $(call force,CFG_INIT_CNTVOFF,y)
+CFG_RESET_SYSTEM_ON_PANIC ?= y
 $(call force,CFG_SCMI_SCPFW_PRODUCT,stm32mp2)
 $(call force,CFG_SECURE_TIME_SOURCE_CNTPCT,y)
 $(call force,CFG_STM32_HSE_MONITORING,y)
