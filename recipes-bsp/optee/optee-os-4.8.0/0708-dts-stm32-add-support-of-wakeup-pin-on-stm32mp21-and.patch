From 5268c2483320e51757461a6fdeb61b4dcdc5a591 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Thu, 7 May 2026 11:43:48 +0200
Subject: [PATCH 708/913] dts: stm32: add support of wakeup pin on stm32mp21
 and configure PMIC IRQ on stm32mp215f-dk

Add pwr IRQ on STM32mp21 and use PWR through EXTI.
Add wake-up pin support on stm32mp21.
Add PMIC IRQ and configure wakeup button on stm32mp215f-dk.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git e631f239ca574154e8633979b6fc8df5b3cf5c25 dts: stm32: add support of wakeup pin on stm32mp21 and configure PMIC IRQ on stm32mp215f-dk]
Change-Id: I61b48b8273f2be31422fa0851689cd5867ac19cf
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp211.dtsi    | 17 +++++++++++------
 core/arch/arm/dts/stm32mp215f-dk.dts |  4 ++++
 2 files changed, 15 insertions(+), 6 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index 71c7a8179..1dada5351 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -677,6 +677,10 @@
 		pwr: pwr@44210000 {
 			compatible = "st,stm32mp21-pwr";
 			reg = <0x44210000 0x400>;
+			interrupts = <GIC_SPI 190 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			wakeup-gpios = <0>, <0>, <0>, <0>, <0>, <0>;
 			status = "disabled";
 
 			vdda18adc: vdda18adc {
@@ -717,6 +721,7 @@
 
 		exti1: interrupt-controller@44220000 {
 			compatible = "st,stm32mp1-exti";
+			wakeup-parent = <&pwr>;
 			interrupt-controller;
 			#interrupt-cells = <2>;
 			reg = <0x44220000 0x400>;
@@ -773,12 +778,12 @@
 				<0>,
 				<0>,						/* EXTI_50 */
 				<0>,
-				<0>,
-				<0>,
-				<0>,
-				<0>,
-				<0>,
-				<0>,
+				<&pwr 0 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr 1 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr 2 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr 3 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr 4 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr 5 IRQ_TYPE_EDGE_FALLING>,
 				<0>,
 				<&intc GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>,
 				<0>,						/* EXTI_60 */
diff --git a/core/arch/arm/dts/stm32mp215f-dk.dts b/core/arch/arm/dts/stm32mp215f-dk.dts
index 3440e13d4..53f7a591c 100644
--- a/core/arch/arm/dts/stm32mp215f-dk.dts
+++ b/core/arch/arm/dts/stm32mp215f-dk.dts
@@ -82,6 +82,10 @@
 	pmic2: pmic@33 {
 		compatible = "st,stpmic2l";
 		reg = <0x33>;
+		interrupts-extended = <&exti1 52 IRQ_TYPE_EDGE_FALLING>;
+		wakeup-source;
+		st,pmic-it-id = <IT_PKEY_FA IT_PKEY_RI>;
+		st,notif-it-id = <0 1>;
 		status = "okay";
 
 		regulators {
-- 
2.53.0

