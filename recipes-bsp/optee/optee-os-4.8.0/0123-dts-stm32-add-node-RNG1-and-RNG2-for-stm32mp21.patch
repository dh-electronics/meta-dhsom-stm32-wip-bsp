From 14436a6e3bca809f093760390cbe09780fab47f4 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Thu, 5 Mar 2026 10:59:55 +0100
Subject: [PATCH 123/913] dts: stm32: add node RNG1 and RNG2 for stm32mp21

Add node RNG1 and RNG2 in stm32mp211.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 42c052439bf8b4870940f2ff690335ff551cda28 dts: stm32: add node RNG1 and RNG2 for stm32mp21]
Change-Id: I92cebe48d7ce655ab0354742f4d34a4e8d791714
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp211.dtsi | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index 41c4a69c2..c9c99c2f4 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -133,6 +133,25 @@
 				status = "disabled";
 			};
 
+			rng2: rng@42020000 {
+				compatible = "st,stm32mp21-rng";
+				reg = <0x42020000 0x400>;
+				clocks = <&clk_rcbsec>, <&rcc CK_BUS_RNG2>;
+				clock-names = "rng_clk", "rng_hclk";
+				access-controllers = <&rifsc STM32MP21_RIFSC_RNG2_ID>;
+				resets = <&rcc RNG2_R>;
+			};
+
+			rng1: rng@42030800 {
+				compatible = "st,stm32mp21-rng";
+				reg = <0x42030800 0x400>;
+				clocks = <&clk_rcbsec>, <&rcc CK_BUS_RNG1>;
+				clock-names = "rng_clk", "rng_hclk";
+				resets = <&rcc RNG1_R>;
+				access-controllers = <&rifsc STM32MP21_RIFSC_RNG1_ID>;
+				status = "disabled";
+			};
+
 			iwdg1: watchdog@44010000 {
 				compatible = "st,stm32mp1-iwdg";
 				reg = <0x44010000 0x400>;
-- 
2.53.0

