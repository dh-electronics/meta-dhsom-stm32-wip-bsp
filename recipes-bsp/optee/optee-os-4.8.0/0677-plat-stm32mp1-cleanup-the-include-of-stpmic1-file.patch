 #include <drivers/stm32mp_dt_bindings.h>
-#include <drivers/stm32mp1_stpmic1.h>
 #include <drivers/stm32mp1_rcc.h>
-#include <drivers/stpmic1.h>
 #include <initcall.h>
 #include <io.h>
 #include <keep.h>
diff --git a/core/arch/arm/plat-stm32mp1/stm32_util.h b/core/arch/arm/plat-stm32mp1/stm32_util.h
index 00398f04a..704b9b785 100644
--- a/core/arch/arm/plat-stm32mp1/stm32_util.h
+++ b/core/arch/arm/plat-stm32mp1/stm32_util.h
@@ -8,7 +8,6 @@
 
 #include <assert.h>
 #include <drivers/clk.h>
-#include <drivers/stm32mp1_stpmic1.h>
 #include <drivers/stm32mp1_rcc_util.h>
 #include <kernel/panic.h>
 #include <stdbool.h>
