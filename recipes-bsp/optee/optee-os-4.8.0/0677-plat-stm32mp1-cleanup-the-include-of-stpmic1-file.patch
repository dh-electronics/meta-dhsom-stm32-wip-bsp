From 7981d5b17b1dc125f83b1312ec6287a31d7d3af0 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Tue, 5 May 2026 13:38:47 +0200
Subject: [PATCH 677/913] plat-stm32mp1: cleanup the include of stpmic1 file

Let only the files that need them to include 'stm32mp1_stpmic1.h'
and 'stpmic1.h'.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 8cd98e7b2f3c7884a207133ffe298ed20c8d81fb plat-stm32mp1: cleanup the include of stpmic1 file]
Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: I5393c66efd8b229998275b86bb3f1f13f71dbd05
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/441057
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/pm/low_power.c | 1 +
 core/arch/arm/plat-stm32mp1/pm/psci.c      | 2 --
 core/arch/arm/plat-stm32mp1/stm32_util.h   | 1 -
 3 files changed, 1 insertion(+), 3 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/pm/low_power.c b/core/arch/arm/plat-stm32mp1/pm/low_power.c
index 926e103a1..04da30549 100644
--- a/core/arch/arm/plat-stm32mp1/pm/low_power.c
+++ b/core/arch/arm/plat-stm32mp1/pm/low_power.c
@@ -14,6 +14,7 @@
 #include <drivers/stm32mp_dt_bindings.h>
 #include <drivers/stm32mp1_ddrc.h>
 #include <drivers/stm32mp1_pwr.h>
+#include <drivers/stm32mp1_stpmic1.h>
 #ifdef CFG_STM32MP13
 #include <drivers/stm32mp13_rcc.h>
 #else
diff --git a/core/arch/arm/plat-stm32mp1/pm/psci.c b/core/arch/arm/plat-stm32mp1/pm/psci.c
index affcabd9c..5e82f1bf8 100644
