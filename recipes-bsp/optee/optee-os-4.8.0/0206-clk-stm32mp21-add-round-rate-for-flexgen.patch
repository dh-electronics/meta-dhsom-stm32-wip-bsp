From aa8687abc925b6d1d67afd8efb84164093d8ae8f Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Tue, 24 Mar 2026 07:55:19 +0100
Subject: [PATCH 206/913] clk: stm32mp21: add round rate for flexgen

Use round_rate ops for Flexgen clocks (need for lcd IP for e.g)

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git e43dd407c33a1bb8a5cf3132b41dfb04a6c218f5 clk: stm32mp21: add round rate for flexgen]
Change-Id: I3d0b37a7a359793c27a45b3b72529ce75a18324f
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
---
 core/drivers/clk/clk-stm32mp21.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/core/drivers/clk/clk-stm32mp21.c b/core/drivers/clk/clk-stm32mp21.c
index 8cccf6318..3207921d8 100644
--- a/core/drivers/clk/clk-stm32mp21.c
+++ b/core/drivers/clk/clk-stm32mp21.c
@@ -2915,6 +2915,16 @@ static bool clk_stm32_flexgen_is_enabled(struct clk *clk)
 	       RCC_FINDIV0CFGR_FINDIV0EN;
 }
 
+static unsigned long clk_stm32_flexgen_round_rate(struct clk *clk __unused,
+						  unsigned long rate,
+						  unsigned long prate)
+{
+	unsigned int prediv = 0;
+	unsigned int findiv = 0;
+
+	return clk_stm32_flexgen_get_round_rate(rate, prate, &prediv, &findiv);
+}
+
 static void __maybe_unused clk_stm32_flexgen_pm_restore(struct clk *clk)
 {
 	TEE_Result ret = TEE_ERROR_GENERIC;
@@ -2941,6 +2951,7 @@ static const struct clk_ops clk_stm32_flexgen_ops = {
 	.enable = clk_stm32_flexgen_enable,
 	.disable = clk_stm32_flexgen_disable,
 	.is_enabled = clk_stm32_flexgen_is_enabled,
+	.round_rate = clk_stm32_flexgen_round_rate,
 	.save_context = clk_stm32_pm_save_rate,
 	.restore_context = clk_stm32_flexgen_pm_restore,
 };
-- 
