From 57d3597c3fe0958d3b4102fc8015127b7c9eda34 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 10 Jun 2026 18:02:59 +0200
Subject: [PATCH 747/913] plat-stm32mp1: stpmic2: remove STM32_PM_DEFAULT in
 binding file

Move internal define STM32_PM_DEFAULT used only in PMIC driver
from binding to platform include.

This define have no reason to be present in binding file.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 1f3b04c6949d6b3fcaf9b78a98945fbb9379d37a plat-stm32mp1: stpmic2: remove STM32_PM_DEFAULT in binding file]
Change-Id: Ic71b3836352004e31d865fe8c69e0cd47bf3c805
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/577548
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c | 1 +
 core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic2.c | 1 +
 core/arch/arm/plat-stm32mp1/stm32mp_pm.h               | 4 ++++
 core/include/dt-bindings/power/stm32mp1-power.h        | 3 ---
 4 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c b/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c
index 8ffe37b12..bbf8547cd 100644
--- a/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c
+++ b/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c
@@ -26,6 +26,7 @@
 #include <stdbool.h>
 #include <stdlib.h>
 #include <stm32_util.h>
+#include <stm32mp_pm.h>
 #include <trace.h>
 #include <util.h>
 
diff --git a/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic2.c b/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic2.c
index e8c2ee2d1..97da7b1e7 100644
--- a/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic2.c
+++ b/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic2.c
@@ -11,6 +11,7 @@
 #include <kernel/pm.h>
 #include <platform_config.h>
 #include <trace.h>
+#include <stm32mp_pm.h>
 
 #include "pm/power.h"
 
diff --git a/core/arch/arm/plat-stm32mp1/stm32mp_pm.h b/core/arch/arm/plat-stm32mp1/stm32mp_pm.h
index a03179b85..d44f3bf42 100644
--- a/core/arch/arm/plat-stm32mp1/stm32mp_pm.h
+++ b/core/arch/arm/plat-stm32mp1/stm32mp_pm.h
@@ -5,9 +5,13 @@
 #ifndef __STM32MP_PM_H__
 #define __STM32MP_PM_H__
 
+#include <dt-bindings/power/stm32mp1-power.h>
+
 #define PSCI_MODE_SYSTEM_SUSPEND	0
 #define PSCI_MODE_SYSTEM_OFF		1
 
+/* Default configuration for PMIC (first level with alternate setting)*/
+#define STM32_PM_DEFAULT		STM32_PM_CSTOP_ALLOW_LP_STOP
 
 #endif /*__STM32MP_PM_H__*/
 
diff --git a/core/include/dt-bindings/power/stm32mp1-power.h b/core/include/dt-bindings/power/stm32mp1-power.h
index 4ce5bc4f7..ff85c14bf 100644
--- a/core/include/dt-bindings/power/stm32mp1-power.h
+++ b/core/include/dt-bindings/power/stm32mp1-power.h
@@ -17,7 +17,4 @@
 #define STM32_PM_SHUTDOWN			7
 #define STM32_PM_MAX_SOC_MODE			8
 
-/* Default configuration for PMIC (first level with alternate setting)*/
-#define STM32_PM_DEFAULT			STM32_PM_CSTOP_ALLOW_LP_STOP
-
 #endif /* DT_BINDINGS_STM32MP1_POWER_H */
