From 04ae6cc9f247585285830071315a32f2cde61dd6 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Tue, 28 Oct 2025 11:45:43 +0100
Subject: [PATCH 052/913] drivers: stm32_i2c: add support of stm32mp2 family

Add compatible st,stm32mp25-i2c to support stm32mp2x SoCs.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 40018ce913eecc40c448f3ea0716bde786de6af8 drivers: stm32_i2c: add support of stm32mp2 family]
Change-Id: Ib54eb6c879fa5787fa0ffe99f87a747e445ef91d
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/drivers/stm32_i2c.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/drivers/stm32_i2c.c b/core/drivers/stm32_i2c.c
index 8e0fcac93..e7c1acc90 100644
--- a/core/drivers/stm32_i2c.c
+++ b/core/drivers/stm32_i2c.c
@@ -1692,6 +1692,7 @@ static const struct dt_device_match stm32_i2c_match_table[] = {
 		.compatible = "st,stm32mp15-i2c-non-secure",
 		.compat_data = &non_secure_bus,
 	},
+	{ .compatible = "st,stm32mp25-i2c" },
 	{ }
 };
 
