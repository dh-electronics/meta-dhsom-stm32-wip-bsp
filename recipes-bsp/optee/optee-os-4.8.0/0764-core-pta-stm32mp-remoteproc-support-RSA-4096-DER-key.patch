From daa27f7cd124fb17260f5d9bf8442e78be2492e2 Mon Sep 17 00:00:00 2001
From: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Date: Fri, 19 Jun 2026 16:06:13 +0200
Subject: [PATCH 764/913] core: pta: stm32mp: remoteproc: support RSA-4096 DER
 key

Extend the DER-based RSA key validation to also accept 4096-bit moduli.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 96c4de6cb3812533a2c3a62367f596ff7b56c983 core: pta: stm32mp: remoteproc: support RSA-4096 DER key]
Signed-off-by: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Change-Id: I3e5fb810bf1ac5e88101ae7982d60192576c572d
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/583450
Tested-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
---
 core/pta/stm32mp/remoteproc_pta.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/core/pta/stm32mp/remoteproc_pta.c b/core/pta/stm32mp/remoteproc_pta.c
index fd065dd29..a70287388 100644
--- a/core/pta/stm32mp/remoteproc_pta.c
+++ b/core/pta/stm32mp/remoteproc_pta.c
@@ -36,8 +36,9 @@
 #define PTA_ECC_X_SIZE   32
 #define PTA_ECC_Y_SIZE   32
 
-#define PTA_RSA_MOD_SIZE 256
-#define PTA_RSA_E_SIZE   3
+#define PTA_RSA2048_MOD_SIZE 256
+#define PTA_RSA4096_MOD_SIZE 512
+#define PTA_RSA_E_SIZE       3
 
 /*
  * AES test key for decryption.
@@ -749,8 +750,11 @@ rproc_pta_verify_rsa_signature(TEE_Param *hash, TEE_Param *sig,
 		if (res)
 			goto out;
 
-		if (mod_len != PTA_RSA_MOD_SIZE || exp_len != PTA_RSA_E_SIZE) {
-			EMSG("Invalid RSA public key size");
+		if ((mod_len != PTA_RSA2048_MOD_SIZE &&
+		     mod_len != PTA_RSA4096_MOD_SIZE) ||
+		    exp_len != PTA_RSA_E_SIZE) {
+			EMSG("Unsupported RSA key size %zu",
+			     mod_len * CHAR_BIT);
 			res = TEE_ERROR_NOT_SUPPORTED;
 			goto out;
 		}
