From b3605975916b3b6b1d40b2f3354d31c07ebce8f9 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 29 Oct 2025 13:53:53 +0100
Subject: [PATCH 076/913] dts: stm32: expose regulator with SCMI to Linux for
 stm32mp257f-ev1 and stm32mp257f-dk

Add PWR regulator to SCMI agent@1 in stm32mp25-st-scmi-cfg.dtsi so Linux
can access these regulators.
Also export PMIC regulators to Linux for stm32mp257f-ev1 and
stm32mp257f-dk.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 321e3a5bb831d38ce691871aa5adfe7b465224d8 dts: stm32: expose regulator with SCMI to Linux for stm32mp257f-ev1 and stm32mp257f-dk]
Change-Id: I6614759d316b987d029624e0e458901e6d5cc27e
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi  | 35 +++++++++++++++
 .../arm/dts/stm32mp257f-dk-ca35tdcid-rif.dtsi | 18 ++++++++
 core/arch/arm/dts/stm32mp257f-dk.dts          | 44 +++++++++++++++++++
 .../dts/stm32mp257f-ev1-ca35tdcid-rif.dtsi    | 18 ++++++++
 core/arch/arm/dts/stm32mp257f-ev1.dts         | 34 ++++++++++++++
 5 files changed, 149 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi b/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
index 8b7426cf7..56f0095b5 100644
--- a/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
+++ b/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
@@ -6,6 +6,7 @@
  * boards when CA35 is TDCID
  */
 
+#include <dt-bindings/regulator/st,stm32mp25-regulator.h>
 #include <dt-bindings/scmi/scmi-clock.h>
 
 / {
@@ -723,6 +724,40 @@
 					};
 				};
 			};
+
+			scmi_regulator: protocol@17 {
+				reg = <0x17>;
+
+				regulators {
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					regulator@0 {
+						reg = <VOLTD_SCMI_VDDIO1>;
+						voltd-supply = <&vddio1>;
+					};
+
+					regulator@1 {
+						reg = <VOLTD_SCMI_VDDIO2>;
+						voltd-supply = <&vddio2>;
+					};
+
+					regulator@2 {
+						reg = <VOLTD_SCMI_VDDIO3>;
+						voltd-supply = <&vddio3>;
+					};
+
+					regulator@3 {
+						reg = <VOLTD_SCMI_VDDIO4>;
+						voltd-supply = <&vddio4>;
+					};
+
+					regulator@7 {
+						reg = <VOLTD_SCMI_ADC>;
+						voltd-supply = <&vdda18adc>;
+					};
+				};
+			};
 		};
 	};
 };
diff --git a/core/arch/arm/dts/stm32mp257f-dk-ca35tdcid-rif.dtsi b/core/arch/arm/dts/stm32mp257f-dk-ca35tdcid-rif.dtsi
