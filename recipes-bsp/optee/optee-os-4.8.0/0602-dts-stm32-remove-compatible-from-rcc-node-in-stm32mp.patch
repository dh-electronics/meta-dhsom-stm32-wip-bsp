From 2b88cf5bdf4339f03b3259e6575ef4ac2b7bc5b4 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 1 Jun 2026 13:39:44 +0200
Subject: [PATCH 602/913] dts: stm32: remove compatible from rcc node in
 stm32mp135f-dk board

RCC compatible is already set in file stm32mp131.dtsi. no need to
overload it in the board file. So remove the line :
        compatible = "st,stm32mp13-rcc", "syscon";

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git fae8841558def503c2f87d1fbeabbb244bb21ffa dts: stm32: remove compatible from rcc node in stm32mp135f-dk board]
Change-Id: Ic6c10ed02122553b1eada42db35a6f5ac5d470aa
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/573252
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 core/arch/arm/dts/stm32mp135f-dk.dts | 2 --
 1 file changed, 2 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp135f-dk.dts b/core/arch/arm/dts/stm32mp135f-dk.dts
index fe09986d4..f3692e3a7 100644
--- a/core/arch/arm/dts/stm32mp135f-dk.dts
+++ b/core/arch/arm/dts/stm32mp135f-dk.dts
@@ -381,8 +381,6 @@
 };
 
 &rcc {
-	compatible = "st,stm32mp13-rcc", "syscon";
-
 	st,clksrc = <
 		CLK_MPU_PLL1P
 		CLK_AXI_PLL2P
-- 
