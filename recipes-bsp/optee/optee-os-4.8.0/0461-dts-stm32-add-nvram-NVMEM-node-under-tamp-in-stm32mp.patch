From 62a77e42622f677188ce0831f2443a81cb11fc9a Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 20 May 2026 13:34:36 +0200
Subject: [PATCH 461/913] dts: stm32: add nvram (NVMEM) node under tamp in
 stm32mp131.dtsi

Backup Registers nvram will be accessed using the NVMEM framework

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git ba2832f175859c4c585739e2b9a60c2e8de7d6a9 dts: stm32: add nvram (NVMEM) node under tamp in stm32mp131.dtsi]
Change-Id: I64735244ed492cf4a7e6de6a51e6142bbd28d37c
Signed-off-by: Simeon Marijon <simeon.marijon@foss.st.com>
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/569765
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/dts/stm32mp131.dtsi | 23 +++++++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp131.dtsi b/core/arch/arm/dts/stm32mp131.dtsi
index 896d730d3..433b684cb 100644
--- a/core/arch/arm/dts/stm32mp131.dtsi
+++ b/core/arch/arm/dts/stm32mp131.dtsi
@@ -432,9 +432,32 @@
 		tamp: tamp@5c00a000 {
 			compatible = "st,stm32mp13-tamp";
 			reg = <0x5c00a000 0x400>;
+			#address-cells = <1>;
+			#size-cells = <1>;
 			interrupts-extended = <&exti 18 IRQ_TYPE_EDGE_RISING>;
 			clocks = <&rcc RTCAPB>;
+			ranges;
 			st,backup-zones = <10 5 17>;
+
+			nvram: nvram@5c00a100 {
+				compatible = "st,stm32mp15-tamp-nvram";
+				#address-cells = <1>;
+				#size-cells = <1>;
+				reg = <0x5c00a100 0x80>;
+
+				saes_secret_key: tamp-bkp@0 {
+					/* see saes secret key feature */
+					reg = <0x0 0x20>;
+				};
+				boot_mode: tamp-bkp@78 {
+					/* see boot mode selection feature */
+					reg = <0x78 0x4>;
+				};
+				boot_counter: tamp-bkp@7c {
+					/* see boot counter feature */
+					reg = <0x7c 0x4>;
+				};
+			};
 		};
 
 		pinctrl: pin-controller@50002000 {
-- 
