From 4efb83a0784333fcb59b79ff37dc5274852600ce Mon Sep 17 00:00:00 2001
From: Hugues Fruchet <hugues.fruchet@foss.st.com>
Date: Tue, 16 Jun 2026 12:06:27 +0200
Subject: [PATCH 786/913] drivers: stm32_rif: fix 32-bit RIF bit overflow

In stm32_rif_parse_cfg(), the register word index is computed as
channel_id / 32, but the bit mask was still built with BIT(channel_id).

On 32-bit builds this overflows when channel_id >= 32.

Use channel_id % 32 for the in-word bit selection while keeping
channel_id / 32 for the register index.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 46464bdcc19d9242352ff0107b32e4c613851fcc drivers: stm32_rif: fix 32-bit RIF bit overflow]
Signed-off-by: Hugues Fruchet <hugues.fruchet@foss.st.com>
Assisted-by: GitHub Copilot <github-copilot@users.noreply.github.com>
Change-Id: Ife38048400ed46978bf6f8e27f1f43fddb17fe3c
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/586679
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Hugues FRUCHET <hugues.fruchet@st.com>
Reviewed-by: Hugues FRUCHET <hugues.fruchet@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 core/drivers/firewall/stm32_rif.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/core/drivers/firewall/stm32_rif.c b/core/drivers/firewall/stm32_rif.c
index 363770b54..5442f0863 100644
--- a/core/drivers/firewall/stm32_rif.c
+++ b/core/drivers/firewall/stm32_rif.c
@@ -62,6 +62,7 @@ void stm32_rif_parse_cfg(uint32_t rif_conf, struct rif_conf_data *conf_data,
 			 unsigned int nb_channel)
 {
 	uint32_t channel_id = 0;
+	uint32_t channel_bit = 0;
 	unsigned int conf_index = 0;
 
 	/* Shift corresponding to the desired resources */
@@ -71,25 +72,26 @@ void stm32_rif_parse_cfg(uint32_t rif_conf, struct rif_conf_data *conf_data,
 
 	/* Some peripherals have more than 32 RIF channels */
 	conf_index = channel_id / 32;
+	channel_bit = channel_id % 32;
 
 	/* Privilege configuration */
 	if (rif_conf & BIT(RIF_PRIV_SHIFT))
-		conf_data->priv_conf[conf_index] |= BIT(channel_id);
+		conf_data->priv_conf[conf_index] |= BIT(channel_bit);
 
 	/* Security RIF configuration */
 	if (rif_conf & BIT(RIF_SEC_SHIFT))
-		conf_data->sec_conf[conf_index] |= BIT(channel_id);
+		conf_data->sec_conf[conf_index] |= BIT(channel_bit);
 
 	/* RIF configuration lock */
 	if (rif_conf & BIT(RIF_LOCK_SHIFT) && conf_data->lock_conf)
-		conf_data->lock_conf[conf_index] |= BIT(channel_id);
+		conf_data->lock_conf[conf_index] |= BIT(channel_bit);
 
 	/* CID configuration */
 	conf_data->cid_confs[channel_id] = (rif_conf & RIF_PERx_CID_MASK) >>
 					   RIF_PERx_CID_SHIFT;
 
 	/* Store that this RIF resource is to be configured */
-	conf_data->access_mask[conf_index] |= BIT(channel_id);
+	conf_data->access_mask[conf_index] |= BIT(channel_bit);
 }
 
 bool stm32_rif_semaphore_is_available(vaddr_t addr)
