diff --git a/core/lib/scmi-server/SCP-firmware/product/neoverse-rd/rdv3/scp_ramfw/include/scp_fw_mmap.h b/core/lib/scmi-server/SCP-firmware/product/neoverse-rd/rdv3/scp_ramfw/include/scp_fw_mmap.h
