+    ctx = __mod_rcar_pmic_get_valid_device_ctx(device_id);
+    if (ctx == NULL)
+        return FWK_E_PARAM;
+
+    /* Get the enabled state from the driver */
+    status = ctx->apis.driver->get_enabled(ctx->config->driver_id, enabled);
+    if (status != FWK_SUCCESS)
+        return FWK_E_HANDLER;
+
+    return FWK_SUCCESS;
+}
