+#define SI0_SI0_TIMER_ALARM_ELEMENT_IDX  0
+#define SI0_PFDI_MONITOR_ALARM_IDX_CORE0 0
+#define SI0_PFDI_MONITOR_ALARM_IDX_CORE1 1
+
+#define PFDI_OOR_PERIOD_US  5000000UL
+#define PFDI_BOOT_PERIOD_US 50000000UL
