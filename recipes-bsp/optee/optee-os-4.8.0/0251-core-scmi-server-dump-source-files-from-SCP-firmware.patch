+
+uint8_t n1sdp_get_chipid(void)
+{
+    return ((uint8_t)((SCC->PLATFORM_CTRL & SCC_PLATFORM_CTRL_CHIPID_MASK) >>
+            SCC_PLATFORM_CTRL_CHIPID_POS));
+}
