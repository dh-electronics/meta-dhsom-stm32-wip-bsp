+target_include_directories(
+    juno-bl2
+    PUBLIC $<TARGET_PROPERTY:cmsis::core-m,INTERFACE_INCLUDE_DIRECTORIES>)
+
+if(SCP_ENABLE_DEBUG_UNIT)
+    list(APPEND SCP_MODULES "debug")
+    list(APPEND SCP_MODULES "juno-debug")
+endif()
