+
+#include <mod_nor.h>
+#include <mod_power_domain.h>
+#include <mod_synquacer_system.h>
+#include <mod_system_power.h>
+
+#include <fwk_core.h>
+#include <fwk_event.h>
+#include <fwk_id.h>
+#include <fwk_log.h>
+#include <fwk_module.h>
+#include <fwk_module_idx.h>
