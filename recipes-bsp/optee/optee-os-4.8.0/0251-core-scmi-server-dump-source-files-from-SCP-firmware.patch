+/*!
+ * @cond
+ */
+
+/* Device context */
+struct rcar_clock_dev_ctx {
+    bool initialized;
+    uint64_t current_rate;
+    enum mod_clock_state current_state;
+    const struct mod_rcar_clock_dev_config *config;
+};
