+/* Framework API */
+static int mod_dmc500_init(fwk_id_t module_id, unsigned int element_count,
+                           const void *data)
+{
+    return FWK_SUCCESS;
+}
+
+static int mod_dmc500_element_init(fwk_id_t element_id, unsigned int unused,
+                                   const void *data)
+{
+    fwk_assert(data != NULL);
+
+    return FWK_SUCCESS;
