+    uint32_t reserved1[(0x800 - (0x400 + SMMU_NUMCB * 4)) / 4];
+    FWK_RW uint32_t CBA2R[SMMU_NUMCB];
+    uint32_t reserved2[(0x1000 - (0x800 + SMMU_NUMCB * 4)) / 4];
