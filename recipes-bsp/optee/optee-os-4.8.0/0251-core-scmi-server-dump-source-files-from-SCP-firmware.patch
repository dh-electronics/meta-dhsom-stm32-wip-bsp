+            ARM_MPU_SH_INNER, /* SH */
+            0, /* RO */
+            0, /* NP */
+            1 /* XN */),
+        .RLAR = ARM_MPU_RLAR(LCP_CORE_DTCM_REGION_END, MPU_ATTR_1),
