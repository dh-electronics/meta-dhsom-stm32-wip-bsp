+static const struct fwk_test_case_desc test_case_table[] = {
+    FWK_TEST_CASE(test_fwk_notification_subscribe),
+    FWK_TEST_CASE(test_fwk_notification_unsubscribe),
+    FWK_TEST_CASE(test_fwk_notification_notify)
+};
