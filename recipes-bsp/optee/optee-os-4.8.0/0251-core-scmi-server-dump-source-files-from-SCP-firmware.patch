diff --git a/core/lib/scmi-server/SCP-firmware/product/neoverse-rd/rdn2/include/scp_software_mmap.h b/core/lib/scmi-server/SCP-firmware/product/neoverse-rd/rdn2/include/scp_software_mmap.h
