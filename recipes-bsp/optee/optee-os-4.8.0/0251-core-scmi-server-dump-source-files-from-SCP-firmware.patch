+#define PL011_RSR_OE  (uint8_t)0x08
+#define PL011_ECR_CLR (uint8_t)0xFF
+
+#define PL011_FR_CTS  (uint16_t)0x0001
+#define PL011_FR_DSR  (uint16_t)0x0002
+#define PL011_FR_DCD  (uint16_t)0x0004
