+                .parent_idx = PD_SINGLE_CHIP_IDX_CLUSTER1,
+                .driver_id = FWK_ID_ELEMENT_INIT(FWK_MODULE_IDX_PPU_V1, 3),
+                .api_id = FWK_ID_API_INIT(
