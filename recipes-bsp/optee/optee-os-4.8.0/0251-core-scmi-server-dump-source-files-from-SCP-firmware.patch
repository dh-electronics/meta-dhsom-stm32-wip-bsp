+
+/*
+ * cli_timestamp_t
+ *   Description
+ *     Stores timestamp information in human-readable format.
+ *   Members
+ *     uint32_t days
+ *       Number of days elapsed since restart.
+ *     uint8_t hours
+ *       Hours portion of time since restart.
+ *     uint8_t minutes
