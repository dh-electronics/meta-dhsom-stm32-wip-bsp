+
+typedef struct {
+    FWK_RW uint32_t CB_SCTLR;
+    FWK_RW uint32_t CB_ACTLR;
+    FWK_W uint32_t CB_RESUME;
+    uint32_t reserved0;
+    FWK_RW uint32_t CB_TCR2;
