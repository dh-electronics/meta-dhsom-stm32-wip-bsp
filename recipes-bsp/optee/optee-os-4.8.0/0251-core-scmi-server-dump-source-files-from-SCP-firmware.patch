+
+    if (rate <= Z2_CLK_MAX_THRESHOLD) { /* Focus on changing z2-clock */
+        prate = Z2_CLK_MAX_THRESHOLD; /* Set parent to: 1.2GHz */
+        mult = DIV_ROUND(rate * 32, prate);
