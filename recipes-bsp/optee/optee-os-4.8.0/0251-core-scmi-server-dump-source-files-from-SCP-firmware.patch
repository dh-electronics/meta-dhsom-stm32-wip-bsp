+    TEST_ASSERT_BIT_HIGH(mon1_idx, fake_smcf_mgi_reg.MON_REQ);
+    TEST_ASSERT_BIT_HIGH(mon2_idx, fake_smcf_mgi_reg.MON_REQ);
