+            "${CMAKE_CURRENT_SOURCE_DIR}/config_scmi_system_power.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/config_sds.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/config_sensor.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/config_sgm775_ddr_phy500.c"
