+        0x0, 0x0, 0xFFFFFFFF, 0xFFFFFFFF, 0xFF00,
+        0x0, 0x0, 0xFFFFFFFF, 0xFFFFFFFF, 0xFF00,
+        0x0, 0x0, 0xFFFFFFFF, 0xFFFFFFFF, 0xFF00,
+    },
+    {
