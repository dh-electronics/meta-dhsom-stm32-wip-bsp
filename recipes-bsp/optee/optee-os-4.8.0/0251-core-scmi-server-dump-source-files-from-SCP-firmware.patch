+static int dmc_bing_verify_phy_status(fwk_id_t ddr_id)
+{
+    int status;
+
+    status = morello_verify_phy_status(
+        ddr_id, DDR_ADDR_TRAIN_TYPE_WR_LVL, &ddr_info);
+    if (status != FWK_SUCCESS) {
+        return status;
+    }
+
+    status = morello_verify_phy_status(
+        ddr_id, DDR_ADDR_TRAIN_TYPE_RD_GATE, &ddr_info);
+    if (status != FWK_SUCCESS) {
+        return status;
+    }
+
+    status = morello_verify_phy_status(
+        ddr_id, DDR_ADDR_TRAIN_TYPE_RD_EYE, &ddr_info);
+    if (status != FWK_SUCCESS) {
+        return status;
+    }
+
+    status =
+        morello_verify_phy_status(ddr_id, DDR_ADDR_TRAIN_TYPE_VREF, &ddr_info);
+    if (status != FWK_SUCCESS) {
+        return status;
+    }
+
+    return FWK_SUCCESS;
+}
