+                pik_clock_element_table[element_idx].data;
+            config->rate_table = rate_table_cpu_a75;
+            config->rate_count = FWK_ARRAY_SIZE(rate_table_cpu_a75);
+        }
+        break;
+    default:
+        return NULL;
+    }
+
