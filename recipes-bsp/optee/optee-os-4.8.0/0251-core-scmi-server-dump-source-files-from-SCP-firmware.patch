+    /*! Identifier of timer alarm element */
+    fwk_id_t alarm_id;
+
+    /*! Identifier of timer alarm API */
+    fwk_id_t alarm_api;
+
+    /*! Temperature sensor count */
+    uint8_t t_sensor_count;
+
+    /*! Voltage sensor count */
+    uint8_t v_sensor_count;
+};
+
+/*!
+ * \}
+ */
+
+/*!
+ * \}
+ */
+
+#endif /* MOD_N1SDP_SENSOR_H */
