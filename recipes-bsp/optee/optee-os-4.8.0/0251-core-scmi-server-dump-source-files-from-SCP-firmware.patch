+#define SCP_CCSM_LIT    (SCP_CCSM_BASE + 0x010000)
+#define SCP_CCSM_CME    (SCP_CCSM_BASE + 0x020000)
+#define SCP_CCSM_MID    (SCP_CCSM_BASE + 0x030000)
+#define SCP_CCSM_BIG    (SCP_CCSM_BASE + 0x040000)
