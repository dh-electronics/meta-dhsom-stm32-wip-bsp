+/*!
+ * \brief SGM775 DMC-500 module configuration.
+ */
+struct mod_sgm775_dmc500_module_config {
+    /*!
+     * Element identifier of the timer used for delays when programming the
+     * DMC-500.
+     */
+    fwk_id_t timer_id;
+};
