+    fwk_optional_id_is_defined_ExpectAndReturn(domains[2].phy_group_id, true);
+    fwk_id_get_element_idx_ExpectAndReturn(
+        domains[2].phy_group_id, DVFS_ELEMENT_IDX_1);
