+#define MHU3_MASK_GENERATE(BITSTART, LENGTH) \
+    (((1 << (LENGTH)) - 1) << ((BITSTART) + 1 - (LENGTH)))
+#define MHU3_MASKED_RECOVER(MASKED, BITSTART, LENGTH) \
