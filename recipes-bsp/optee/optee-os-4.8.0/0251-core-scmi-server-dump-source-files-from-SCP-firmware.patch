+        fwk_interrupt_enable(DMCS1_TEMPERATURE_EVENT_INT_IRQ);
+        fwk_interrupt_enable(DMCS1_FAILED_ACCESS_INT_IRQ);
+        fwk_interrupt_enable(DMCS1_MGR_INT_IRQ);
+    } else {
+        return FWK_E_PARAM;
+    }
+    return FWK_SUCCESS;
+}
