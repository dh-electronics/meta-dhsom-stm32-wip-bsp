+                FWK_MODULE_IDX_PPU_V1, PPU_V1_ELEMENT_IDX_CLUSTER0), \
+            .observer_id = FWK_ID_NONE_INIT, \
+        }), \
+    }
+
+#define CME_PPU_ELEMENT_INIT(_cme_num) \
+    [PPU_V1_ELEMENT_IDX_CME##_cme_num] = { \
+        .name = "CME" #_cme_num, \
+        .data = &((struct mod_ppu_v1_pd_config){ \
