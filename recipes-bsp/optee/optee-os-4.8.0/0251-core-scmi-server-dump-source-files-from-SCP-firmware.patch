diff --git a/core/lib/scmi-server/SCP-firmware/product/neoverse-rd/rdv3/mcp_ramfw/CMakeLists.txt b/core/lib/scmi-server/SCP-firmware/product/neoverse-rd/rdv3/mcp_ramfw/CMakeLists.txt
