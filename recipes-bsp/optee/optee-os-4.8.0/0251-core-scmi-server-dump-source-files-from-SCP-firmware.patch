+#
+# SPDX-License-Identifier: BSD-3-Clause
+
+"""
+Check pycodestyle
+This script runs pycodestyle to check all python scripts.
+"""
+
+import sys
+import subprocess
+from utils import banner
+
+INCLUDE_DIRECTORIES = 'tools/'
+
+
+def run():
+    print(banner('Run PyCodeStyle tests'))
+
+    result = subprocess.Popen(
