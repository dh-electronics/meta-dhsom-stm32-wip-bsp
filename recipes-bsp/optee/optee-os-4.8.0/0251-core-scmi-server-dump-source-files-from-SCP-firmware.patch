+    fwk_id_t module_id)
+{
+    return scmi_sensor_req_element_table;
+}
+
+struct fwk_module_config config_scmi_sensor_req = {
+    .elements = FWK_MODULE_DYNAMIC_ELEMENTS(get_sensor_req_element_table),
+};
