+static struct mod_scmi_to_protocol_api scmi_sensor_mod_scmi_to_protocol_api = {
+    .get_scmi_protocol_id = scmi_sensor_get_scmi_protocol_id,
+    .message_handler = scmi_sensor_message_handler
+};
