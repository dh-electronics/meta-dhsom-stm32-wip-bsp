+static char *dimm_module_type[] = { "Extended DIMM", "RDIMM",    "UDIMM",
+                                    "SO-DIMM",       "LRDIMM",   "Mini-RDIMM",
+                                    "Mini-UDIMM",    "Reserved", "72b-SO-RDIMM",
+                                    "72b-SO-UDIMM" };
