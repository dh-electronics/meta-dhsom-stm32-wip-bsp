+#define CML_PORT_AGGR_CTRL_NUM_CXG_PAG_WIDTH         12
+#define CMN_PORT_AGGR_GRP_PAG_TGTID_PER_GROUP        5
+#define CMN_PORT_AGGR_GRP_PAG_TGTID_WIDTH            12
+#define CMN_PORT_AGGR_GRP_PAG_TGTID_WIDTH_PER_GROUP  60
