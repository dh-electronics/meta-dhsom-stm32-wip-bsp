+            FWK_LOG_INFO("[C2C] Error!");
+            return status;
+        }
+        if (run_in_secondary) {
+            status = n1sdp_c2c_primary_rx_response();
+            if (status != FWK_SUCCESS) {
+                return status;
+            }
+            if (n1sdp_c2c_ctx.primary_rx_data[0] != N1SDP_C2C_SUCCESS) {
+                FWK_LOG_INFO("[C2C] Command failed in secondary!");
