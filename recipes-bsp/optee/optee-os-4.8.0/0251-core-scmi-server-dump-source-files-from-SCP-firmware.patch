+#include <fwk_macros.h>
+
+/*
+ * PLL clock rates.
+ */
+#define CLOCK_RATE_CLUSTERPLLCLK (1500UL * FWK_MHZ)
+#define CLOCK_RATE_COREPLL0CLK   (2500UL * FWK_MHZ)
