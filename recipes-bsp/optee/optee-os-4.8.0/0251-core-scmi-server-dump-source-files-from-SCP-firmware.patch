+void fch_polled_extra_alarm_stop_CMockIgnoreAndReturn(UNITY_LINE_TYPE cmock_line, int cmock_to_return);
+#define fch_polled_extra_alarm_stop_StopIgnore() fch_polled_extra_alarm_stop_CMockStopIgnore()
+void fch_polled_extra_alarm_stop_CMockStopIgnore(void);
+#define fch_polled_extra_alarm_stop_ExpectAnyArgsAndReturn(cmock_retval) fch_polled_extra_alarm_stop_CMockExpectAnyArgsAndReturn(__LINE__, cmock_retval)
+void fch_polled_extra_alarm_stop_CMockExpectAnyArgsAndReturn(UNITY_LINE_TYPE cmock_line, int cmock_to_return);
+#define fch_polled_extra_alarm_stop_ExpectAndReturn(alarm_id, cmock_retval) fch_polled_extra_alarm_stop_CMockExpectAndReturn(__LINE__, alarm_id, cmock_retval)
+void fch_polled_extra_alarm_stop_CMockExpectAndReturn(UNITY_LINE_TYPE cmock_line, fwk_id_t alarm_id, int cmock_to_return);
+typedef int (* CMOCK_fch_polled_extra_alarm_stop_CALLBACK)(fwk_id_t alarm_id, int cmock_num_calls);
+void fch_polled_extra_alarm_stop_AddCallback(CMOCK_fch_polled_extra_alarm_stop_CALLBACK Callback);
+void fch_polled_extra_alarm_stop_Stub(CMOCK_fch_polled_extra_alarm_stop_CALLBACK Callback);
+#define fch_polled_extra_alarm_stop_StubWithCallback fch_polled_extra_alarm_stop_Stub
