+static int ddr_get_mem_size(uint64_t *size)
+{
+#if defined(PLAT_FVP)
+    /* FVP has fixed memory size of 8GB */
+    *size = 0x200000000ULL;
+#else
+    uint32_t size_gb = 0;
+    int status;
+
+    fwk_assert(size != NULL);
+
+    status = dimm_spd_calculate_dimm_size_gb(&size_gb);
+    if (status != FWK_SUCCESS) {
+        return status;
+    }
+
+    *size = (uint64_t)size_gb * 2ULL * FWK_GIB;
+#endif
+
+    return FWK_SUCCESS;
+}
