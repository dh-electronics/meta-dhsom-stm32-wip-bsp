+            0,
+            1,
+            1,
+            0,
+            ARM_MPU_REGION_SIZE_256KB),
+    },
+    {
+        /*
+         * 0x7000_0000 - 0x7000_1FFF
+         * This is mapped to 0x0000_0000 - 0x0000_1FFF in AP memory map.
+         */
+        .RBAR = ARM_MPU_RBAR(0x3UL, SCP_AP_PERIPHERAL_SRAM_TRUSTED_BASE),
