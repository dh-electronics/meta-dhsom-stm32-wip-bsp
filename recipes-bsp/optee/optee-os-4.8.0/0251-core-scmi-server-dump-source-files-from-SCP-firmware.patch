+    fwk_id_t driver_id;
+
+    /*! API identifier of the driver */
+    fwk_id_t driver_api_id;
+
+    /*!  Notifications identifier */
+    fwk_id_t notification_id;
+
+    /*! Trip point API identifier */
+    fwk_id_t trip_point_api_id;
+
