+#define CPG_PLL0CR_ZFC_MASK 0x7F000000
+#define CPG_PLL0CR_ZFC_SHIFT 24
+#ifndef CPG_PLL2CR
+#    define CPG_PLL2CR (CPG_BASE + 0x002c)
