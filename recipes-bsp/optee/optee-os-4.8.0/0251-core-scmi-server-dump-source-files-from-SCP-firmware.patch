+        .name = "CLUSTER" #_cluster_num, \
+        .data = &((struct mod_ppu_v1_pd_config){ \
+            .pd_type = MOD_PD_TYPE_CLUSTER, \
+            .ppu.reg_base = SCP_PPU_CLUSTER_BASE, \
+            .ppu.irq = FWK_INTERRUPT_NONE, \
