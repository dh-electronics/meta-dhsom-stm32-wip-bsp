+            ((reg_value >> CCPRTCL_LINK_STATUS_SNPDOMAIN_ACK_POS) &
+             CCPRTCL_LINK_STATUS_SNPDOMAIN_ACK_MASK);
+        break;
+
+    default:
+        status = FWK_E_SUPPORT;
+    };
+
+    return status;
+}
