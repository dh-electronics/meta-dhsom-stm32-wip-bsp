+    config.domains = NULL;
+
+    module_id = FWK_ID_MODULE(FWK_MODULE_IDX_SCMI_PERF);
+    status = scmi_perf_init(module_id, 0, &config);
+
+    TEST_ASSERT_EQUAL(FWK_E_PARAM, status);
