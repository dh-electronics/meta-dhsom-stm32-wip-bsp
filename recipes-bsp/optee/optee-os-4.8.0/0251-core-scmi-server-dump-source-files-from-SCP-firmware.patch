+/*
+ * Cross chip CCG connections between the chips:
+ *
+ *  +-----------------------------+             +----------------------------+
+ *  |                             |             |                            |
+ *  |                         CCG6+-------------+CCG6                        |
+ *  |                             |             |                        CCG4|
+ *  |CCG4                     CCG7+-------------+CCG7                        |
+ *  |        CHIP 0               |             |          CHIP 2            |
+ *  |                         CCG8+----+  +-----+CCG8                    CCG5|
+ *  |CCG                          |    |  |     |                            |
+ *  |                         CCG9+-+  |  |  +--+CCG9                        |
+ *  |                             | |  |  |  |  |                            |
+ *  |  CCG0  CCG1  CCG2    CCG3   | |  |  |  |  |   CCG0  CCG1  CCG2  CCG3   |
+ *  +---+-----+------+------+-----+ |  |  |  |  +-----+-----+-----+-----+----+
+ *      |     |      |      |       |  |  |  |        |     |     |     |
+ *      |     |      |      |       |  |  |  |        |     |     |     |
+ *  +---+-----+------+------+-----+ |  |  |  |  +-----+-----+-----+-----+----+
+ *  |  CCG3  CCG2   CCG1   CCG0   | |  |  |  |  |    CCG3 CCG2  CCG1   CCG0  |
+ *  |                             | |  |  |  |  |                            |
+ *  |                         CCG4+-|--|--+  |  |                            |
+ *  |                             | |  |     |  |                            |
+ *  |                         CCG5+-|--|-----+  |                            |
+ *                                | |  |        |                            |
+ *  |CCG8                         | |  +--------+CCG4                    CCG8|
+ *  |        CHIP 1               | |           |          CHIP 3            |
+ *  |                             | +-----------+CCG5                        |
+ *  |CCG9                         |             |                        CCG9|
+ *  |                         CCG6+-------------+CCG6                        |
+ *  |                             |             |                            |
+ *  |                         CCG7+-------------+CCG7                        |
+ *  |                             |             |                            |
+ *  +-----------------------------+             +----------------------------+
+ */
+//clang-format off
