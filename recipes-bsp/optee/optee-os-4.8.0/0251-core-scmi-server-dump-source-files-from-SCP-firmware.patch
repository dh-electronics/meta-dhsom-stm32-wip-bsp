+
+static fwk_id_t sds_isolated_cpu_mpid_list_id = FWK_ID_ELEMENT_INIT(
+    FWK_MODULE_IDX_SDS,
+    PLATFORM_SDS_ISOLATED_CPU_MPID_LIST_IDX);
