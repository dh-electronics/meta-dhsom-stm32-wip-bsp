+#define SMMU_TCR_T0SZ_256GB ((uint32_t)26 << 0)
+#define SMMU_TCR_T0SZ_512GB ((uint32_t)25 << 0)
+#define SMMU_TCR_T0SZ_1TB ((uint32_t)24 << 0)
