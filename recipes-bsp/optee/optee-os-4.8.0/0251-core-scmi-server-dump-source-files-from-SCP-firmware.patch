+/*
+ * Arm SCP/MCP Software
+ * Copyright (c) 2023-2024, Arm Limited and Contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Description:
+ *     TC3 Power Model (Thermal Management Driver)
+ */
+
+#ifndef MOD_TC3_POWER_MODEL_H
+#define MOD_TC3_POWER_MODEL_H
+
+//#include <mod_power_domain.h>
+
+/*!
+ * \addtogroup GroupTC3Module TC3 Product Modules
+ * \{
+ */
+
+/*!
+ * \defgroup GroupTC3PowerModel TC3 Power Model
+ * \{
+ */
+
+/*!
+ * \brief TC3 Power Model element configuration
+ */
+struct mod_tc3_power_model_dev_config {
+    /*!
+     * \brief Coefficient to compute the power from level and viceversa.
+     *
+     * \details This is an oversimplified example of element configuration. For
+     *      the purpose of code reference, we assume that power and level are
+     *      tied each other by a simple coefficient.
+     */
+    unsigned int coeff;
+};
+
+/*!
+ * \brief Number of defined APIs for Power Model.
+ */
+enum mod_tc3_power_model_api_idx {
+    /*! API index for the driver interface of the Thermal Management module */
+    MOD_TC3_POWER_MODEL_THERMAL_DRIVER_API_IDX,
+
+    /*! Number of exposed interfaces */
+    MOD_TC3_POWER_MODEL_API_COUNT,
+};
+
+/*!
+ * \}
+ */
+
+/*!
+ * \}
+ */
+
+#endif /* MOD_TC3_POWER_MODEL_H */
diff --git a/core/lib/scmi-server/SCP-firmware/product/totalcompute/tc3/module/tc3_power_model/src/mod_tc3_power_model.c b/core/lib/scmi-server/SCP-firmware/product/totalcompute/tc3/module/tc3_power_model/src/mod_tc3_power_model.c
new file mode 100644
index 000000000..3aa28849b
--- /dev/null
+++ b/core/lib/scmi-server/SCP-firmware/product/totalcompute/tc3/module/tc3_power_model/src/mod_tc3_power_model.c
@@ -0,0 +1,92 @@
+/*
+ * Arm SCP/MCP Software
+ * Copyright (c) 2023-2024, Arm Limited and Contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Description:
+ *     TC3 Power Model.
+ */
+
+#include <mod_tc3_power_model.h>
+#include <mod_thermal_mgmt.h>
+
+#include <fwk_id.h>
+#include <fwk_module.h>
+#include <fwk_module_idx.h>
+
+#include <stdint.h>
+
+uint32_t tc3_pm_level_to_power(fwk_id_t pm_id, const uint32_t level)
+{
+    const struct mod_tc3_power_model_dev_config *config;
+
+    config = fwk_module_get_data(pm_id);
+    return (config->coeff * level);
+}
+
+uint32_t tc3_pm_power_to_level(fwk_id_t pm_id, const uint32_t power)
+{
+    const struct mod_tc3_power_model_dev_config *config;
+
+    config = fwk_module_get_data(pm_id);
+    return (power / config->coeff);
+}
+
+static const struct mod_thermal_mgmt_driver_api tc3_thermal_mgmt_driver_api = {
+    .level_to_power = tc3_pm_level_to_power,
+    .power_to_level = tc3_pm_power_to_level,
+};
+
+/*
+ * Framework handlers.
+ */
+
+static int tc3_power_model_mod_init(
+    fwk_id_t module_id,
+    unsigned int unused,
+    const void *data)
+{
+    return FWK_SUCCESS;
+}
+
+static int tc3_power_model_elem_init(
+    fwk_id_t element_id,
+    unsigned int sub_element_count,
+    const void *data)
+{
+    return FWK_SUCCESS;
+}
+
+static int tc3_power_model_bind(fwk_id_t id, unsigned int round)
+{
+    return FWK_SUCCESS;
+}
+
+static int tc3_power_model_process_bind_request(
+    fwk_id_t requester_id,
+    fwk_id_t pd_id,
+    fwk_id_t api_id,
+    const void **api)
+{
+    fwk_id_t power_model_api_id = FWK_ID_API(
+        FWK_MODULE_IDX_TC3_POWER_MODEL,
+        MOD_TC3_POWER_MODEL_THERMAL_DRIVER_API_IDX);
+
+    if (fwk_id_is_equal(api_id, power_model_api_id)) {
+        *api = &tc3_thermal_mgmt_driver_api;
+
+        return FWK_SUCCESS;
+    }
+
+    return FWK_E_ACCESS;
+}
+
+const struct fwk_module module_tc3_power_model = {
+    .type = FWK_MODULE_TYPE_DRIVER,
+    .api_count = (unsigned int)MOD_TC3_POWER_MODEL_API_COUNT,
+    .init = tc3_power_model_mod_init,
+    .element_init = tc3_power_model_elem_init,
+    .bind = tc3_power_model_bind,
+    .process_bind_request = tc3_power_model_process_bind_request,
+};
