+            0,
+            ARM_MPU_REGION_SIZE_4GB),
+    },
+    {
+        /* 0x0080_0000 - 0x0088_0000 */
+        .RBAR = ARM_MPU_RBAR(1, SCP_RAM0_BASE),
+        .RASR = ARM_MPU_RASR(
+            0,
+            ARM_MPU_AP_PRO,
+            0,
+            0,
+            1,
+            0,
+            0,
+            ARM_MPU_REGION_SIZE_512KB),
