+ * \param node_type Type of the target node
+ * \param sam_type Type of the region register to program (NON-HASH or
+ * SYS-CACHE)
+ *
+ * \return None
+ */
+void configure_region(
+    void *rnsam_reg,
+    unsigned int region_idx,
+    uint64_t base,
+    uint64_t size,
+    enum sam_node_type node_type,
+    enum sam_type sam_type);
