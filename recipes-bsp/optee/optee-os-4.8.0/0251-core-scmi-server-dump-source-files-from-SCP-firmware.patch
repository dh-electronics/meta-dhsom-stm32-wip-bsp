+
+#include <fwk_id.h>
+
+#include <stdint.h>
+
+/*!
+ * \addtogroup GroupInterfaces Interfaces
+ * @{
+ */
+
+/*!
+ * \defgroup GroupMacros Macros
+ * @{
+ */
+/*!
+ * \brief Maximum power value
+ */
+#define MAX_POWER UINT32_MAX
+/*!
+ * \brief No power limit is set to Maximum power value
+ */
+#define NO_POWER_LIMIT MAX_POWER
+/*!
+ * @}
