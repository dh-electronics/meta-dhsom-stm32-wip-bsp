+/*
+ * Bit definitions for MGI_WREN, Data Write Enable Register
+ */
+/* MGI_WREN.DMA_IF = Data Write Enable, as configured in MGI_WRCFG Register. */
+#define SMCF_MGI_WREN_DMA_IF_POS 0
