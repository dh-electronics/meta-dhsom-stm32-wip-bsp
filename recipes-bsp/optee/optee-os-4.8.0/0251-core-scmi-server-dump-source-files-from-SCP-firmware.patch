+static const struct fwk_element *clock_get_dev_desc_table(fwk_id_t module_id)
+{
+    unsigned int i;
+    struct mod_clock_dev_config *dev_config;
+
+    for (i = 0; i < CLOCK_IDX_COUNT; i++) {
+        dev_config =
