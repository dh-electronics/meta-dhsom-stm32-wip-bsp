+                                         .level = 562500 * 1000UL,
+                                         .frequency = 562500,
+                                         .voltage = 950,
+                                     },
+                                     {
+                                         .level = 800 * 1000000UL,
+                                         .frequency = 800 * FWK_KHZ,
+                                         .voltage = 1000,
+                                     },
+                                     { 0 } }
+};
