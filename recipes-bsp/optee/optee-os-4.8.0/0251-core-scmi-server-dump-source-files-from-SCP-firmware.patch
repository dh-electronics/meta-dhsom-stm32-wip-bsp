+    uintptr_t param,
+    int cmock_num_calls)
+{
+    struct phase_event_params *evt_params = (struct phase_event_params *)param;
+
+    TEST_ASSERT_EQUAL(SYS_COOR_PHASE_TWO, evt_params->phase_idx);
+
+    return FWK_SUCCESS;
+}
