+
+#ifndef CONFIG_CLOCK_H
+#define CONFIG_CLOCK_H
+
+#include <fwk_macros.h>
+
+/*
+ * DDR Subsystem clock in MHz
+ */
+#define DDR_CLOCK_MHZ (4000.0 / 3) // 1333Mhz
+
+/*
+ * SCC & PIK clock rates.
+ */
+#define SCC_CLK_RATE_IOFPGA_TMIF2XCLK  (120 * FWK_MHZ)
