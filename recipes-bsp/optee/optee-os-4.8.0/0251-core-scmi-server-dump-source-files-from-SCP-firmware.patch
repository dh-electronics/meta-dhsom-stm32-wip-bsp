+    FWK_LOG_INFO(MOD_NAME "Total RN-D nodes: %d", shared_ctx->rnd_count);
+
+    FWK_LOG_INFO(MOD_NAME "Total RN-F nodes: %d", shared_ctx->rnf_count);
+
+    FWK_LOG_INFO(MOD_NAME "Total RN-I nodes: %d", shared_ctx->rni_count);
