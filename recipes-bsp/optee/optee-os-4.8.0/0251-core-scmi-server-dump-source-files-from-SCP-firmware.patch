+/* is alternate address supported */
+bool mgi_is_alternate_data_address_supported(struct smcf_mgi_reg *smcf_mgi);
+
+/* Is DMA supported */
+bool mgi_is_dma_supported(struct smcf_mgi_reg *smcf_mgi);
