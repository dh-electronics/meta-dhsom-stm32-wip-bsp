+static void fw_prepare_debug_pik(void)
+{
+    /* DEBUG ack */
+    /*
+     * bit2 : CSYSPWRUPACK
+     * bit1 : CDBGPWRUPACK
+     * bit0 : CDBGPWRUPACK
+     */
+    writel(PIK_DEBUG_BASE, 0x00000007);
+}
