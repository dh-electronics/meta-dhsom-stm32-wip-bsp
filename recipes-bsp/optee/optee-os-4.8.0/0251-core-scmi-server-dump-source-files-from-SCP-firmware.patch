+static uint32_t cal_dly_wth_rounding(int32_t spd_val, int32_t spd_val_fine)
+{
+    int32_t tDLY = 0;
+    int32_t tempNck = 0;
+    int32_t tDLY_int_nck = 0;
+
+    tDLY = ((spd_val * MTB) + (spd_val_fine * FTB));
+    tempNck = (tDLY * 1000) / dmc_clk_period_ps;
+    tempNck = tempNck + 974;
+    tDLY_int_nck = (int32_t)(tempNck / 1000);
+
+    return tDLY_int_nck;
+}
