+#define BKUP_MODE_CNT (0x20)
+#define DVFS_SET_VID (0x54)
+#define REG_KEEP10 (0x79)
+
+/* EEPROM subordinate */
+#define EEPROM   (0x50)
+#define BOARD_ID (0x70)
+
