+    assert(!result);
+
+    /* Event IDX non valid */
+    id = FWK_ID_EVENT(FWK_MODULE_IDX_FAKE1, 0x03);
+    result = fwk_module_is_valid_event_id(id);
+    assert(!result);
+
+    /* Module IDX non valid */
