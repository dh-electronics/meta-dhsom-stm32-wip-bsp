+#define NUM_SLICES         9
+#define NUM_BITS_PER_SLICE 8
+#define NUM_DATA_PATTERNS  5
+#define DCI_FIFO_SIZE      20
+
+#define NUM_DQ_BITS            (NUM_SLICES) * (NUM_BITS_PER_SLICE)
+#define NUM_DFI_BEATS_TO_CHECK UINT32_C(4)
+
+#define SLICE_MASK (~(UINT32_C(0xFFFFFFFF) << (NUM_BITS_PER_SLICE)))
+
+#define NUM_WORDS_IN_DFI_BEAT UINT32_C(5)
+
+#define BIT_WRRD_SUCCESS ((NUM_DATA_PATTERNS) * (NUM_DFI_BEATS_TO_CHECK)*2)
+
+#define PHY_PER_CS_TRAINING_INDEX_0_REG_IDX UINT32_C(9)
+#define PHY_CLK_WRDQ0_SUBORDINATE_DELAY_0_REG_IDX UINT32_C(82)
+#define SC_PHY_MANUAL_UPDATE_REG_IDX        UINT32_C(2310)
+
