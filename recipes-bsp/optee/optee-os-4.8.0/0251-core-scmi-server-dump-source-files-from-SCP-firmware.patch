+ */
+typedef struct {
+    uint32_t days;
+    uint8_t hours;
+    uint8_t minutes;
+    uint8_t seconds;
+    uint8_t fraction;
+} cli_timestamp_t;
+
+/*****************************************************************************/
+/* CLI Platform-Specific Function Prototypes                                 */
+/*****************************************************************************/
+
+/*
+ * cli_platform_get_time
