+target_sources(
+    framework
+    PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src/assert.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/src/fwk_arch.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/src/fwk_dlist.c"
