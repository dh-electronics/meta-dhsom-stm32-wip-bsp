+if(SCP_ENABLE_SCMI_PERF_FAST_CHANNELS)
+    target_compile_definitions(framework PUBLIC "BUILD_HAS_FAST_CHANNELS")
+    target_compile_definitions(framework PUBLIC "BUILD_HAS_SCMI_PERF_FAST_CHANNELS")
