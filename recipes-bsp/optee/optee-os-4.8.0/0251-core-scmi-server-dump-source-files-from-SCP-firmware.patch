+void fw_clear_clkforce(uint32_t value)
+{
+    /*
+     * Writing 1 to a bit enables dynamic hardware clock-gating.
+     * Writing 0 to a bit is ignored.
+     * bit8 : SYSPLLCLKDBGFORCE
+     * bit7 : DMCCLKFORCE
+     * bit6 : SYSPERCLKFORCE
+     * bit5 : PCLKSCPFORCE
+     * bit2 : CCNCLKFORCE
+     * bit0 : PPUCLKFORCE
+     */
+    PIK_SYSTEM->CLKFORCE_CLR = value;
+}
