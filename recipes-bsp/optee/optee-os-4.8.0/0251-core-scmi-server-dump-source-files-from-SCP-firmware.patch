diff --git a/core/lib/scmi-server/SCP-firmware/product/totalcompute/common/config_ppu_v1.c b/core/lib/scmi-server/SCP-firmware/product/totalcompute/common/config_ppu_v1.c
new file mode 100644
index 000000000..cfc819bd2
--- /dev/null
+++ b/core/lib/scmi-server/SCP-firmware/product/totalcompute/common/config_ppu_v1.c
@@ -0,0 +1,170 @@
+/*
