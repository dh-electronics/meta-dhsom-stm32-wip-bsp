diff --git a/core/lib/scmi-server/SCP-firmware/product/rcar/module/rcar_mfismh/src/mod_rcar_mfismh.c b/core/lib/scmi-server/SCP-firmware/product/rcar/module/rcar_mfismh/src/mod_rcar_mfismh.c
