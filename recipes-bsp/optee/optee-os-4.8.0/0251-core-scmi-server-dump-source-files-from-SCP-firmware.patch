+#if UINTPTR_MAX == 0xFFFFFFFFu
+#    define TEST_ASSERT_EQUAL_UINTPTR(expected, actual) \
+        TEST_ASSERT_EQUAL_UINT32((uint32_t)(expected), (uint32_t)(actual))
+#else
+#    define TEST_ASSERT_EQUAL_UINTPTR(expected, actual) \
+        TEST_ASSERT_EQUAL_UINT64((uint64_t)(expected), (uint64_t)(actual))
+#endif
+
