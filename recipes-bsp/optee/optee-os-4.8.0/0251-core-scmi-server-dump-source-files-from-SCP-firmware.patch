+            ARM_MPU_REGION_SIZE_256KB),
+    },
+    {
+        /* 0x2000_0000 - 0x2003_FFFF */
+        .RBAR = ARM_MPU_RBAR(0x2UL, SCP_DTC_RAM_BASE),
+        .RASR = ARM_MPU_RASR(
+            1,
+            ARM_MPU_AP_PRIV,
