+#define min(x, y) \
+    ({ \
+        __typeof__(x) _x = (x); \
+        __typeof__(y) _y = (y); \
+        _x < _y ? _x : _y; \
+    })
+
+#define max(x, y) \
+    ({ \
+        __typeof__(x) _x = (x); \
+        __typeof__(y) _y = (y); \
+        _x > _y ? _x : _y; \
+    })
+
+#define clamp(val, lo, hi) min((__typeof__(val))max(val, lo), hi)
