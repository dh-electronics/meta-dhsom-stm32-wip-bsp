+
+#include "scp_css_mmap.h"
+
+/* PLLs are connected in SCP's expansion3 memory region */
+#define SCP_PLL_BASE (SCP_SOC_EXPANSION3_BASE + 0x03000000)
+
+#define SCP_PLL_SYSPLL       (SCP_PLL_BASE + 0x00000000)
