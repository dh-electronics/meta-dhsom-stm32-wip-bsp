+
+    /* Re-calculate the parent_rate to propagate new rate for it */
+    prate = DIV_ROUND(rate * 32, mult);
+    prate = 100000000 * DIV_ROUND(prate, 100000000);
+    rate = 100000000 * DIV_ROUND(prate / 32 * mult, 100000000);
+    *parent_rate = prate;
+
+    return rate;
+}
+
