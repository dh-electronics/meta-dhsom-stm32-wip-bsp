+         */
+        .base = UINT64_C(0x0040000000),
+        .size = UINT64_C(1) * FWK_GIB,
+        .type = MOD_CMN600_MEMORY_REGION_TYPE_IO,
+        .node_id = NODE_ID_HND,
+    },
+    {
+        /*
+         * 64-bit PCIe MMIO region
+         * Map: 0x05_0000_0000 - 0x05_FFFF_FFFF (4 GB)
+         */
+        .base = UINT64_C(0x0500000000),
+        .size = UINT64_C(4) * FWK_GIB,
+        .type = MOD_CMN600_MEMORY_REGION_TYPE_IO,
+        .node_id = NODE_ID_HND,
+    },
+};
+
