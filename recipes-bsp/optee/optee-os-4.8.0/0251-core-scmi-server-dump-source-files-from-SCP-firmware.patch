+    CFGD_MOD_SYSTEM_PLL_EIDX_PERIPH,
+    CFGD_MOD_SYSTEM_PLL_EIDX_GIC,
+    CFGD_MOD_SYSTEM_PLL_EIDX_IOBLOCK,
+    CFGD_MOD_SYSTEM_PLL_EIDX_RSE,
+    CFGD_MOD_SYSTEM_PLL_EIDX_SI,
