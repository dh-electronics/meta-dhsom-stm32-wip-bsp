+
+// clang-format off
+/*!
+ * \brief SCP PIK register definitions
+ */
+struct pik_scp_reg {
+            uint8_t   RESERVED0[0x10 - 0x0];
+    FWK_RW  uint32_t  RESET_SYNDROME;
+            uint8_t   RESERVED1[0x20 - 0x14];
+    FWK_RW  uint32_t  SURVIVAL_RESET_STATUS;
+            uint8_t   RESERVED2[0x34 - 0x24];
