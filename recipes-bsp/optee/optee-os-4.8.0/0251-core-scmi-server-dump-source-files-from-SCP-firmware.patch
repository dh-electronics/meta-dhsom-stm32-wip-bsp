+target_sources(
+    juno-bl2
+    PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/config_sds.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/config_pl011.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/config_ut.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/tests_entry.c"
+        )
