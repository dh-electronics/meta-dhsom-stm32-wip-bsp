+    [SENSOR_DEVICE1] = {
+        .smcf_mli_id = FWK_ID_SUB_ELEMENT(
+            FWK_MODULE_IDX_SMCF, SENSOR_DEVICE_CNT + SENSOR_DEVICE1, 0),
