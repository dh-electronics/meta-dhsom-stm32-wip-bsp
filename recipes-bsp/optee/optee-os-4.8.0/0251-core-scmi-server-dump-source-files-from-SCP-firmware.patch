+
+#include <fwk_macros.h>
+
+#include <stdint.h>
+
+// clang-format off
+struct lcp_extended_control_reg {
+    FWK_RW  uint32_t  LCP_CFG;
+            uint8_t   RESERVED0[0x10-0x4];
