+set(CMOCK_SRC_ROOT ${CMOCK_ROOT}/src)
+
+# Framework mock sources
+set(FWK_MOCKS_SRC_ROOT ${SCP_ROOT}/unit_test/unity_mocks/mocks)
+
+set(TEST_ON_HOST TRUE)
+
+# Architecture sources
