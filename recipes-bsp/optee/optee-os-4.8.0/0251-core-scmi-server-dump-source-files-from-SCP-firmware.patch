+
+set(SCP_FIRMWARE "rdn2-mcp-bl2")
+
+set(SCP_ENABLE_NEWLIB_NANO FALSE)
+
+set(SCP_FIRMWARE_TARGET "rdn2-mcp-bl2")
+
