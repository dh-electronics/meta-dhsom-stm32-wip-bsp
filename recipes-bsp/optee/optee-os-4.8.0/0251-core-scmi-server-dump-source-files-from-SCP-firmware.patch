+    SI0_MOD_PFDI_MONITOR_EIDX_CORE_0,
+    SI0_MOD_PFDI_MONITOR_EIDX_CORE_1,
+    SI0_MOD_PFDI_MONITOR_EIDX_COUNT,
+};
