+    pik_clock_element_table[CLOCK_PIK_IDX_COUNT + 1] = {
+        [CLOCK_PIK_IDX_MCP_CORECLK] = {
+            .name = "MCP CORECLK",
+            .data = &((struct mod_pik_clock_dev_config) {
