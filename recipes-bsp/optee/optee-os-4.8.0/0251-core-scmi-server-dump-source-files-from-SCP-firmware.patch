+     *
+     * \retval ::FWK_SUCCESS Operation succeeded.
+     * \return One of the other specific error codes described by the framework.
+     */
+    int (*read)(
+        fwk_id_t device_id,
+        uint16_t address,
+        char *data,
+        uint16_t length);
+
+    /*!
