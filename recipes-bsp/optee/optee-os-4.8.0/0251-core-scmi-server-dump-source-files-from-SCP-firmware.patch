+    fwk_assert(
+        channel_ctx->config->transport_type ==
+        MOD_TRANSPORT_CHANNEL_TRANSPORT_TYPE_FAST_CHANNELS);
+
+    return channel_ctx->driver_api->get_fch_interrupt_type(
+        channel_ctx->config->driver_id, fch_interrupt_type);
+}
