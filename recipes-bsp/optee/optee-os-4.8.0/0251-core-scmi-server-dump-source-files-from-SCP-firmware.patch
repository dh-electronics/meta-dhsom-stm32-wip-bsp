+
+#define PLL_STATUS_CPUPLLLOCK(CPU) ((uint32_t)(1 << (CPU % 32)))
+
+/* Pointer to SCP PIK */
+#define SCP_PIK_PTR ((struct pik_scp_reg *)SCP_PIK_SCP_BASE)
+// clang-format on
+
+#endif /* SCP_PIK_H */
