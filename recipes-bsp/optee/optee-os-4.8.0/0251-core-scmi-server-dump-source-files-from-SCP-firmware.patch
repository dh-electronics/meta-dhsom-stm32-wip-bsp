diff --git a/core/lib/scmi-server/SCP-firmware/module/dmc500/include/mod_dmc500.h b/core/lib/scmi-server/SCP-firmware/module/dmc500/include/mod_dmc500.h
new file mode 100644
index 000000000..af837139a
--- /dev/null
+++ b/core/lib/scmi-server/SCP-firmware/module/dmc500/include/mod_dmc500.h
@@ -0,0 +1,568 @@
+/*
+ * Arm SCP/MCP Software
+ * Copyright (c) 2015-2022, Arm Limited and Contributors. All rights reserved.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ *
+ * Description:
+ *     DMC-500 module.
+ */
+
+/* The use of "primary" may not be in sync with older versions of TRM */
+
+#ifndef MOD_DMC500_H
+#define MOD_DMC500_H
+
