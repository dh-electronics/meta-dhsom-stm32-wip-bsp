+#define MOD_NAME "[MCP_PLATFORM] "
+
+static int mod_mcp_platform_init(
+    fwk_id_t module_id,
+    unsigned int element_count,
+    const void *unused)
+{
+    /* No elements support */
+    if (element_count > 0) {
+        return FWK_E_DATA;
+    }
+
+    return FWK_SUCCESS;
+}
