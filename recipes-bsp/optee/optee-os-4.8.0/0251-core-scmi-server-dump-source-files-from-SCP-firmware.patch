+
+#ifndef INTERNAL_CMN600_CCIX_H
+#define INTERNAL_CMN600_CCIX_H
+
+#include <internal/cmn600_ctx.h>
+
+#include <fwk_module_idx.h>
+
+#include <stdbool.h>
