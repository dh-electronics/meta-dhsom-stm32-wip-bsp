+
+if(SCP_ENABLE_SCMI_RESET)
+    target_sources(
+        juno-bl2
+        PRIVATE
+            "${CMAKE_CURRENT_SOURCE_DIR}/config_reset_domain.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/config_scmi_reset_domain.c"
+            "${CMAKE_CURRENT_SOURCE_DIR}/config_juno_reset_domain.c")
+endif()
+
+if(SCP_ENABLE_STATISTICS)
