+};
+
+/*
+ * PERFORMANCE_NOTIFY_LIMITS
+ */
+
+#define SCMI_PERF_NOTIFY_LIMITS_NOTIFY_ENABLE_MASK UINT32_C(0x1)
+
+struct scmi_perf_notify_limits_a2p {
