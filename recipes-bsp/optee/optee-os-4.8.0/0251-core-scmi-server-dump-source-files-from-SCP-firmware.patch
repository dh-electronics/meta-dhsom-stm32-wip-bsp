+
+/* SYSC */
+#define RCAR_PWRSR3 UINT32_C(0xE6180140) /* Power stat A53-SCU   */
+#define RCAR_PWRSR5 UINT32_C(0xE61801C0) /* Power stat A57-SCU   */
