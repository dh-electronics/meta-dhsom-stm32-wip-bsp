+    status =
+        pcapping_core_get_cap(parameters->domain_id, &return_values.power_cap);
+
+    if (status != FWK_SUCCESS) {
+        return scmi_power_capping_respond_error(service_id, SCMI_GENERIC_ERROR);
+    }
+
+    return_values.status = SCMI_SUCCESS;
