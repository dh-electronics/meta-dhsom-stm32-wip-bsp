+#define CXLA_CCIX_PROP_MAX_PACK_SIZE_MASK      UINT64_C(0x0000000000000380)
+#define CXLA_CCIX_PROP_MAX_PACK_SIZE_SHIFT_VAL 7
+#define CXLA_CCIX_PROP_MAX_PACK_SIZE_128       0
