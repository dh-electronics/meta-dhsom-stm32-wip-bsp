+            .ppu.reg_base = SCP_PPU_CME_BASE(_cme_num), \
+            .ppu.irq = FWK_INTERRUPT_NONE, \
+            .cluster_id = FWK_ID_ELEMENT_INIT( \
+                FWK_MODULE_IDX_PPU_V1, PPU_V1_ELEMENT_IDX_CLUSTER0), \
+            .observer_id = FWK_ID_NONE_INIT, \
+        }), \
+    }
