+/* The use of "secondary" may not be in sync with platform documentation */
+
+#ifndef DIMM_SPD_H
+#define DIMM_SPD_H
+
+#include <mod_cdns_i2c.h>
+#include <mod_n1sdp_dmc620.h>
+
+#include <fwk_attributes.h>
+
+#include <stdint.h>
