+        },
+        [AGENT_IDX(JUNO_SCMI_AGENT_IDX_PSCI)] = {
+            [MOD_RES_PERMS_SCMI_PERF_ATTRIBUTES_IDX][0] = 0x0,
+            [MOD_RES_PERMS_SCMI_PERF_DESCRIBE_LEVELS_IDX][0] = 0x0,
+            [MOD_RES_PERMS_SCMI_PERF_LIMITS_SET_IDX][0] = 0x0,
