diff --git a/core/lib/scmi-server/SCP-firmware/product/rcar/module/rcar_reg_sensor/src/mod_rcar_reg_sensor.c b/core/lib/scmi-server/SCP-firmware/product/rcar/module/rcar_reg_sensor/src/mod_rcar_reg_sensor.c
