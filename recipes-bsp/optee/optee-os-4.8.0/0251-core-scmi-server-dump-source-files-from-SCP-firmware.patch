+ * \brief Handle response SCMI message
+ *
+ * \param service_id Service identifier.
+ *
+ * \retval ::FWK_SUCCESS The operation succeeded.
+ */
+int mod_scmi_from_protocol_api_response_message_handler(fwk_id_t service_id);
