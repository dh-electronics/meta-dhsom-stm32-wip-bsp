+    dmc->CLK_STATUS_OVERRIDE = 0x00000003;
+    dmc->DIRECT_CMD_SETTINGS = 0x01F40003;
+    dmc->DIRECT_CMD = 0x00800080;
+    dmc->RANK_STATUS_OVERRIDE = 0x30000003;
+    dmc->DIRECT_CMD_SETTINGS = 0x04B00003;
+    dmc->DIRECT_CMD = 0x00800FE0;
