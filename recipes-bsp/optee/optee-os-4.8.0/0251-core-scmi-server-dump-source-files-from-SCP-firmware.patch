+
+/*
+ * SPD - Base Configuration and DRAM Parameter structure
+ *  Block   0
+ *  Bytes   0 - 127
+ *  Address 0x000 - 0x07F
+ *  This section defines parameters that are common to all DDR4 module types
+ */
+struct ddr4_dram_param {
+    /* Number of Bytes used */
+    uint8_t num_bytes;
