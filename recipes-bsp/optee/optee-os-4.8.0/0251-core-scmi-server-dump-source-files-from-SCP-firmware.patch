+enum scp_cfgd_mod_sds_element_idx {
+    SCP_CFGD_MOD_SDS_EIDX_CPU_INFO,
+    SCP_CFGD_MOD_SDS_EIDX_ROM_VERSION,
+    SCP_CFGD_MOD_SDS_EIDX_RAM_VERSION,
