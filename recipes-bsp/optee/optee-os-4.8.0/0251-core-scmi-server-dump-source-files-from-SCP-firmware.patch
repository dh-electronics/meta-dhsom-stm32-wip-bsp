+static int get_dimm_rank_bits(
+    uint8_t element,
+    uint32_t *temp_reg,
+    struct dimm_info *ddr)
+{
+    int status;
+    uint8_t pkg_rank =
+        (element & SPD_PKG_RANK_BITS_MASK) >> SPD_PKG_RANK_BITS_OFFSET;
+
+    *temp_reg &= ~RANK_BITS_NEXT_MASK;
+
+    switch (pkg_rank) {
+    case SPD_PKG_RANK1:
+        *temp_reg |= RANK_BITS_NEXT_0;
+        multi_rank = false;
+        ddr->ranks_to_train = 0x01;
+        ddr->number_of_ranks = 1;
+        status = FWK_SUCCESS;
+        break;
+    case SPD_PKG_RANK2:
+        *temp_reg |= RANK_BITS_NEXT_1;
+        multi_rank = true;
+        ddr->ranks_to_train = 0x03;
+        ddr->number_of_ranks = 2;
+        status = FWK_SUCCESS;
+        break;
+    case SPD_PKG_RANK4:
+        *temp_reg |= RANK_BITS_NEXT_2;
+        multi_rank = true;
+        ddr->ranks_to_train = 0x0F;
+        ddr->number_of_ranks = 4;
+        status = FWK_SUCCESS;
+        break;
+    case SPD_PKG_RANK8:
+        *temp_reg |= RANK_BITS_NEXT_3;
+        multi_rank = true;
+        ddr->ranks_to_train = 0xFF;
+        ddr->number_of_ranks = 8;
+        status = FWK_SUCCESS;
+        break;
+    default:
+        status = FWK_E_PARAM;
+        break;
+    }
+
+    return status;
+}
