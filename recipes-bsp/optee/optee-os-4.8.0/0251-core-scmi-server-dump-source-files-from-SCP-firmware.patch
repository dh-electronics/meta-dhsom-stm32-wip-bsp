+#define fch_polled_extra_alarm_start_IgnoreArg_callback() fch_polled_extra_alarm_start_CMockIgnoreArg_callback(__LINE__)
+void fch_polled_extra_alarm_start_CMockIgnoreArg_callback(UNITY_LINE_TYPE cmock_line);
+#define fch_polled_extra_alarm_start_IgnoreArg_param() fch_polled_extra_alarm_start_CMockIgnoreArg_param(__LINE__)
+void fch_polled_extra_alarm_start_CMockIgnoreArg_param(UNITY_LINE_TYPE cmock_line);
