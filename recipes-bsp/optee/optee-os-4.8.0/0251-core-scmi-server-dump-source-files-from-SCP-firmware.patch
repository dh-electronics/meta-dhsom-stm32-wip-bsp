index 000000000..3df09b534
--- /dev/null
+++ b/core/lib/scmi-server/SCP-firmware/product/synquacer/module/synquacer_system/src/synquacer_pd_manage.c
@@ -0,0 +1,374 @@
+/*
+ * Arm SCP/MCP Software
+ * Copyright (c) 2018-2021, Arm Limited and Contributors. All rights reserved.
