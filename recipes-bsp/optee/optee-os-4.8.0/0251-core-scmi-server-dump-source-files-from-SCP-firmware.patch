+int rcar_dvfs_get_nr_opp(int domain)
+{
+    if (domain == A57_DOMAIN)
+        return current_a57_opp_limit;
+    else if (domain == A53_DOMAIN)
+        return current_a53_opp_limit;
+
+    return 0;
+}
