+};
+
+/*!
+ * \brief Sensor data.
+ *
+ * \details Sensor data structure that contains all related value reading
+ *      information.
+ */
+struct mod_sensor_data {
+    /*! Status of the response event */
+    int status;
+
+    /*! Sensor value */
+    union {
+        /*! Sensor N-axis value */
+        mod_sensor_value_t *axis_value;
