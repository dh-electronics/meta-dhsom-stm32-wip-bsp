+/*!
+ * \brief MHU Register Definitions
+ */
+struct mhu_reg {
+    /*! Status register */
+    FWK_R  uint32_t STAT;
+           uint32_t RESERVED0;
+    /*! Set register (sets the value of STAT) */
+    FWK_W  uint32_t SET;
+           uint32_t RESERVED1;
+    /*! Clear register (clears STAT) */
+    FWK_W  uint32_t CLEAR;
+};
