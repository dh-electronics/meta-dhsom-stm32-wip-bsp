From f0f572b16efe6b350f5fbf489983fc156f88aa01 Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Fri, 1 Dec 2023 16:09:00 +0100
Subject: [PATCH 446/913] drivers: stm32_tamp: add support for masking
 potential tamper reset

When "st,tamp-mask-pot-reset" property is set in the device tree TAMP
node, some resource aren't reset when a potential tamper even occurs.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 81825434c6694f83ba6641ec7ae447d557dca609 drivers: stm32_tamp: add support for masking potential tamper reset]
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Change-Id: I093f053a3226297af6ed76ac92afcb42e022a728
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/343477
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
Tested-by: Maxime MERE <maxime.mere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/427742
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
---
 core/drivers/stm32_tamp.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/core/drivers/stm32_tamp.c b/core/drivers/stm32_tamp.c
index 98e3a8435..1a291d2c0 100644
--- a/core/drivers/stm32_tamp.c
+++ b/core/drivers/stm32_tamp.c
@@ -18,6 +18,9 @@
 #include <libfdt.h>
 #include <mm/core_memprot.h>
 #include <stdbool.h>
+#if defined(CFG_STM32MP25) || defined(CFG_STM32MP23) || defined(CFG_STM32MP21)
+#include <stm32_sysconf.h>
+#endif /* defined(CFG_STM32MP25) || defined(CFG_STM32MP23) || defined(CFG_STM32MP21) */
 #include <stm32_util.h>
 
 /* STM32 Registers */
@@ -430,6 +433,7 @@ struct stm32_tamp_platdata {
 	uint32_t pins_conf;
 	uint32_t out_pins;
 	bool is_wakeup_source;
+	bool mask_pot_reset;
 	bool is_tdcid;
 };
 
@@ -2055,6 +2059,9 @@ static TEE_Result stm32_tamp_parse_fdt(const void *fdt, int node,
 	if (fdt_getprop(fdt, node, "wakeup-source", NULL))
 		pdata->is_wakeup_source = true;
 
+	if (fdt_getprop(fdt, node, "st,tamp-mask-pot-reset", NULL))
+		pdata->mask_pot_reset = true;
+
 	parse_bkpregs_dt_conf(fdt, node);
 
 	if (pdata->compat->tags & TAMP_HAS_RIF_SUPPORT) {
@@ -2146,6 +2153,11 @@ static TEE_Result stm32_tamp_probe(const void *fdt, int node,
 		goto err_clk;
 	}
 
+#if defined(CFG_STM32MP25) || defined(CFG_STM32MP23) || defined(CFG_STM32MP21)
+	if (stm32_tamp_dev->pdata.mask_pot_reset)
+		stm32mp_syscfg_write(SYSCFG_POTTAMPRSTCR, BIT(0), BIT(0));
+#endif
+
 	if (stm32_tamp_dev->pdata.compat->tags & TAMP_HAS_RIF_SUPPORT) {
 		apply_rif_config();
 
-- 
