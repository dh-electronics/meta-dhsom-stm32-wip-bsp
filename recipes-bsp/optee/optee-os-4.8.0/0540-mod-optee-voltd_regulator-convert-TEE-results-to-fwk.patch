From 85005cdbab7e8fbca68dfeb650029d0071642576 Mon Sep 17 00:00:00 2001
From: Theo GOUREAU <theo.goureau-ext@st.com>
Date: Tue, 12 Nov 2024 10:52:01 +0100
Subject: [PATCH 540/913] mod/optee/voltd_regulator: convert TEE results to fwk
 error statuses

Use scmi_tee_result_to_fwk_status() to convert TEE results into
framework errors in module OP-TEE voltd_regulator.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 6bc7006526bd5d1471782bbdfbb9e6d9f69e4db6 mod/optee/voltd_regulator: convert TEE results to fwk error statuses]
Change-Id: I595770f55c2c33f1d4bd4f4f242103aa2b7a4d8e
Signed-off-by: Theo GOUREAU <theo.goureau-ext@st.com>
---
 .../src/mod_optee_voltd_regulator.c           | 28 +++++++++++++------
 1 file changed, 19 insertions(+), 9 deletions(-)

diff --git a/core/lib/scmi-server/SCP-firmware/product/optee/common/module/voltd_regulator/src/mod_optee_voltd_regulator.c b/core/lib/scmi-server/SCP-firmware/product/optee/common/module/voltd_regulator/src/mod_optee_voltd_regulator.c
index 3b00fb888..967cf5576 100644
--- a/core/lib/scmi-server/SCP-firmware/product/optee/common/module/voltd_regulator/src/mod_optee_voltd_regulator.c
+++ b/core/lib/scmi-server/SCP-firmware/product/optee/common/module/voltd_regulator/src/mod_optee_voltd_regulator.c
@@ -7,6 +7,8 @@
 
 #include <drivers/regulator.h>
 
+#include <arch_main.h>
+
 #include <mod_optee_voltd_regulator.h>
 #include <mod_scmi_std.h>
 #include <mod_voltage_domain.h>
@@ -89,6 +91,7 @@ static int optee_voltd_regulator_set_config(
     uint8_t mode_id)
 {
     struct optee_voltd_regulator_dev_ctx *ctx;
+    TEE_Result res;
 
     ctx = get_ctx(dev_id);
     if (ctx == NULL) {
@@ -111,8 +114,9 @@ static int optee_voltd_regulator_set_config(
     switch (mode_id) {
     case MOD_VOLTD_MODE_ID_ON:
         if (!ctx->enabled) {
-            if (regulator_enable(ctx->regulator) != TEE_SUCCESS) {
-                return FWK_E_DEVICE;
+            res = regulator_enable(ctx->regulator);
+            if (res != TEE_SUCCESS) {
+                return scmi_tee_result_to_fwk_status(res);
             }
 
             ctx->enabled = true;
@@ -121,8 +125,9 @@ static int optee_voltd_regulator_set_config(
 
     case MOD_VOLTD_MODE_ID_OFF:
         if (ctx->enabled) {
-            if (regulator_disable(ctx->regulator) != TEE_SUCCESS) {
-                return FWK_E_DEVICE;
+            res = regulator_disable(ctx->regulator);
+            if (res != TEE_SUCCESS) {
+                return scmi_tee_result_to_fwk_status(res);
             }
 
             ctx->enabled = false;
@@ -173,6 +178,7 @@ static int optee_voltd_regulator_get_level(fwk_id_t dev_id, int *level_uv)
 static int optee_voltd_regulator_set_level(fwk_id_t dev_id, int level_uv)
 {
     struct optee_voltd_regulator_dev_ctx *ctx;
+    TEE_Result res;
 
     ctx = get_ctx(dev_id);
     if (ctx == NULL) {
@@ -183,8 +189,9 @@ static int optee_voltd_regulator_set_level(fwk_id_t dev_id, int level_uv)
         return FWK_E_ACCESS;
     }
 
-    if (regulator_set_voltage(ctx->regulator, level_uv) != TEE_SUCCESS) {
-        return FWK_E_DEVICE;
+    res = regulator_set_voltage(ctx->regulator, level_uv);
+    if (res != TEE_SUCCESS) {
+        return scmi_tee_result_to_fwk_status(res);
     }
 
     FWK_LOG_DEBUG(
@@ -284,7 +291,7 @@ static int optee_voltd_regulator_level_from_index(
 
     res = regulator_supported_voltages(ctx->regulator, &desc, &levels);
     if (res != TEE_SUCCESS) {
-        return FWK_E_SUPPORT;
+        return scmi_tee_result_to_fwk_status(res);
     }
 
     if (desc->type != VOLTAGE_TYPE_FULL_LIST) {
@@ -343,6 +350,7 @@ static int optee_voltd_regulator_element_init(
 {
     const struct mod_optee_voltd_regulator_dev_config *dev_config;
     struct optee_voltd_regulator_dev_ctx *ctx;
+    TEE_Result res;
 
     ctx = get_ctx(element_id);
     if (ctx == NULL) {
@@ -357,8 +365,10 @@ static int optee_voltd_regulator_element_init(
         if (ctx->regulator == NULL) {
             return FWK_E_PANIC;
         }
-        if (regulator_enable(ctx->regulator) != TEE_SUCCESS) {
-            return FWK_E_DEVICE;
+
+        res = regulator_enable(ctx->regulator);
+        if (res != TEE_SUCCESS) {
+            return scmi_tee_result_to_fwk_status(res);
         }
     }
 
-- 
2.53.0

