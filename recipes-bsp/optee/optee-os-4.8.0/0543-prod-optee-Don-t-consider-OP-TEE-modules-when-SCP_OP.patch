From 01fb5528bad8dfc3a5ce740cb2a37ed48c74f933 Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Fri, 13 Sep 2024 16:08:23 +0200
Subject: [PATCH 543/913] prod/optee: Don't consider OP-TEE modules when
 SCP_OPTEE_DIR is not set

Do not consider OP-TEE modules when SCP_OPTEE_DIR build directive is not
set. This change prevents build failures (see error trace below) with
some toolchains when build for product that do not provide OP-TEE OS
source tree path.

Building C object scp/CMakeFiles/scmi-fw.dir/config_all.o
cc1: error: /core/arch/arm/include: Not a directory
cc1: error: /core/include: Not a directory

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 46c0de36cf72f3f1340f3bef0427148b23de21db prod/optee: Don't consider OP-TEE modules when SCP_OPTEE_DIR is not set]
Change-Id: Ia3bb3b506329e3e5b39fe9859b0e0de091f45027
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
---
 .../SCP-firmware/product/optee/common/CMakeLists.txt            | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/core/lib/scmi-server/SCP-firmware/product/optee/common/CMakeLists.txt b/core/lib/scmi-server/SCP-firmware/product/optee/common/CMakeLists.txt
index 7be606e7f..0badf56a7 100644
--- a/core/lib/scmi-server/SCP-firmware/product/optee/common/CMakeLists.txt
+++ b/core/lib/scmi-server/SCP-firmware/product/optee/common/CMakeLists.txt
@@ -13,6 +13,7 @@
 # The module paths are listed in an alphabetical order.
 #
 
+if(SCP_OPTEE_DIR)
 list(PREPEND SCP_MODULE_PATHS "${CMAKE_CURRENT_SOURCE_DIR}/module/clock")
 list(PREPEND SCP_MODULE_PATHS "${CMAKE_CURRENT_SOURCE_DIR}/module/console")
 list(PREPEND SCP_MODULE_PATHS "${CMAKE_CURRENT_SOURCE_DIR}/module/mbx")
@@ -20,5 +21,6 @@ list(PREPEND SCP_MODULE_PATHS "${CMAKE_CURRENT_SOURCE_DIR}/module/psu_regulator"
 list(PREPEND SCP_MODULE_PATHS "${CMAKE_CURRENT_SOURCE_DIR}/module/reset")
 list(PREPEND SCP_MODULE_PATHS "${CMAKE_CURRENT_SOURCE_DIR}/module/smt")
 list(PREPEND SCP_MODULE_PATHS "${CMAKE_CURRENT_SOURCE_DIR}/module/voltd_regulator")
+endif(SCP_OPTEE_DIR)
 
 set(SCP_MODULE_PATHS ${SCP_MODULE_PATHS} PARENT_SCOPE)
