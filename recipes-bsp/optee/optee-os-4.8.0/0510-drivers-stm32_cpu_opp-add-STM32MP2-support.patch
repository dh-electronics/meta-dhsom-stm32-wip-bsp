+#define TIMEOUT_US_OPP			U(1000)
+
 /*
  * struct cpu_dvfs - CPU DVFS registered operating point
  * @freq_khz: CPU frequency in kilohertz (kHz)
@@ -245,6 +252,291 @@ static TEE_Result set_opp(unsigned int opp)
