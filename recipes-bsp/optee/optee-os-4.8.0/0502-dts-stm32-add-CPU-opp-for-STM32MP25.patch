From ee3a8a178eea346794d1e0ea794bb84054489bb9 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 20 May 2026 14:22:13 +0200
Subject: [PATCH 502/913] dts: stm32: add CPU opp for STM32MP25

Describe CPU operating points in the STM32MP25 device trees.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git db816f2ad09bca47dc72bee22826bdbc87ec6b05 dts: stm32: add CPU opp for STM32MP25]
Change-Id: I89b5a61b2ff0032d4f384ac993bd07c4a624607d
Signed-off-by: Pascal Paillet <p.paillet@st.com>
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
---
 core/arch/arm/dts/stm32mp251.dtsi | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp251.dtsi b/core/arch/arm/dts/stm32mp251.dtsi
index 6a8113275..ae04dd55b 100644
--- a/core/arch/arm/dts/stm32mp251.dtsi
+++ b/core/arch/arm/dts/stm32mp251.dtsi
@@ -25,6 +25,25 @@
 			device_type = "cpu";
 			reg = <0>;
 			enable-method = "psci";
+			operating-points-v2 = <&cpu0_opp_table>;
+			clocks = <&rcc CK_CPU1>;
+		};
+	};
+
+	cpu0_opp_table: cpu0-opp-table {
+		compatible = "operating-points-v2";
+
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <800000>;
+			opp-supported-hw = <0x3>;
+			st,opp-default;
+		};
+
+		opp-1500000000 {
+			opp-hz = /bits/ 64 <1500000000>;
+			opp-microvolt = <910000>;
+			opp-supported-hw = <0x2>;
 		};
 	};
 
-- 
