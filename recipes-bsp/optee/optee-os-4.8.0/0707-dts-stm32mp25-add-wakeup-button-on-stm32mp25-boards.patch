From 92ad3052816d5b38774a3184a1c8865fa52dc609 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Thu, 7 May 2026 11:24:49 +0200
Subject: [PATCH 707/913] dts: stm32mp25: add wakeup button on stm32mp25 boards

Configure GPIOA 0 (wakeup button) as a wake-up pin for PWR on
stm32mp257f-dk and stm32mp257f-ev1.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 931d0713738ef3c1ff90aac32a8369989f2d6b9b dts: stm32mp25: add wakeup button on stm32mp25 boards]
Change-Id: I482e819337d62c7970aed54c63d5ff1d96aaa355
Signed-off-by: Pascal Paillet <p.paillet@st.com>
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp257f-dk.dts  | 2 ++
 core/arch/arm/dts/stm32mp257f-ev1.dts | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp257f-dk.dts b/core/arch/arm/dts/stm32mp257f-dk.dts
index 069906121..390847101 100644
--- a/core/arch/arm/dts/stm32mp257f-dk.dts
+++ b/core/arch/arm/dts/stm32mp257f-dk.dts
@@ -7,6 +7,7 @@
 /dts-v1/;
 
 #include <dt-bindings/clock/stm32mp25-clksrc.h>
+#include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/mfd/st,stpmic2.h>
 #include <dt-bindings/regulator/st,stm32mp25-regulator.h>
 #include <dt-bindings/soc/stm32mp-provisioning.h>
@@ -368,6 +369,7 @@
 
 &pwr {
 	status = "okay";
+	wakeup-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>, <0>, <0>, <0>, <0>, <0>;
 
 	vdd33ucpd: vdd33ucpd {
 		status = "okay";
diff --git a/core/arch/arm/dts/stm32mp257f-ev1.dts b/core/arch/arm/dts/stm32mp257f-ev1.dts
index e605c5c17..a4c4be586 100644
--- a/core/arch/arm/dts/stm32mp257f-ev1.dts
+++ b/core/arch/arm/dts/stm32mp257f-ev1.dts
@@ -6,6 +6,7 @@
 
 /dts-v1/;
 #include <dt-bindings/clock/stm32mp25-clksrc.h>
+#include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/soc/stm32mp-provisioning.h>
 #include <dt-bindings/mfd/st,stpmic2.h>
 #include <dt-bindings/regulator/st,stm32mp25-regulator.h>
@@ -395,6 +396,7 @@
 
 &pwr {
 	status = "okay";
+	wakeup-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>, <0>, <0>, <0>, <0>, <0>;
 
 	vdd33ucpd: vdd33ucpd {
 		status = "okay";
-- 
2.53.0

