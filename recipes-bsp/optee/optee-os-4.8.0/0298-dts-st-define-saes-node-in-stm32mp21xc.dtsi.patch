From 71eb80b1bf0b97bb7b13897dc34e2888026b04e4 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 13 Apr 2026 15:53:40 +0200
Subject: [PATCH 298/913] dts: st: define saes node in stm32mp21xc.dtsi

Add node saes in stm32mp21xc.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 8a98422f26fa6c5c0a807c9fcf531627eec7b091 dts: st: define saes node in stm32mp21xc.dtsi]
Change-Id: I53c56f46b1093340c88ce870c8c4e878c3f0384e
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/557095
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/dts/stm32mp21xc.dtsi | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp21xc.dtsi b/core/arch/arm/dts/stm32mp21xc.dtsi
index ddbb8bfac..a1fbfccc2 100644
--- a/core/arch/arm/dts/stm32mp21xc.dtsi
+++ b/core/arch/arm/dts/stm32mp21xc.dtsi
@@ -24,4 +24,15 @@
 		access-controllers = <&rifsc STM32MP21_RIFSC_CRYP2_ID>;
 		status = "disabled";
 	};
+
+	saes: saes@42030c00 {
+		compatible = "st,stm32mp13-saes";
+		reg = <0x42030c00 0x400>;
+		interrupts = <GIC_SPI 156 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&rcc CK_BUS_SAES>, <&rcc CK_BUS_RNG1>;
+		clock-names = "bus", "rng";
+		resets = <&rcc SAES_R>;
+		access-controllers = <&rifsc STM32MP21_RIFSC_SAES_ID>, <&rifsc STM32MP21_RIFSC_RNG1_ID>;
+		status = "disabled";
+	};
 };
