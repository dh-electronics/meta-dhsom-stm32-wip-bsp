From bdc2d658d34da87ee36fc69afaa57777cd4c9939 Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Fri, 1 Dec 2023 16:03:38 +0100
Subject: [PATCH 442/913] plat-stm32mp2: add tamper masking in SYSCFG support

Adds support to access SYSCFG_POTTAMPRSTCR in order to mask some resource
reset upon receiving a potential tamper.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 48ff6acb3c183b6e924f5ca3d7f09d946006073d plat-stm32mp2: add tamper masking in SYSCFG support]
Change-Id: I81483d2c2c5d0be7f03440e9692535e95628725e
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
---
 core/arch/arm/plat-stm32mp2/stm32_sysconf.h | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/arch/arm/plat-stm32mp2/stm32_sysconf.h b/core/arch/arm/plat-stm32mp2/stm32_sysconf.h
index d81a5f53c..473d53a87 100644
--- a/core/arch/arm/plat-stm32mp2/stm32_sysconf.h
+++ b/core/arch/arm/plat-stm32mp2/stm32_sysconf.h
@@ -25,6 +25,7 @@ enum syscon_banks {
  * SYSCFG register offsets (base relative)
  */
 #define SYSCFG_VDERAMCR		SYSCON_ID(SYSCON_SYSCFG, 0x1800)
+#define SYSCFG_POTTAMPRSTCR	SYSCON_ID(SYSCON_SYSCFG, 0x1804)
 #define SYSCFG_HPDMAARCR	SYSCON_ID(SYSCON_SYSCFG, 0x2050)
 
 /*
