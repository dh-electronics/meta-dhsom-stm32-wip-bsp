From fec365a905f640ae3b9743a20fb14028099965b8 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Fri, 20 Mar 2026 16:14:39 +0100
Subject: [PATCH 179/913] clk: stm32mp21: enable safe reset feature
 systematically

Safe reset feature should be always enabled.
Don't need parameter to enable it in device tree.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 8900c2fed887bab9c9369f1f8ee54e889f28ff08 clk: stm32mp21: enable safe reset feature systematically]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: Iab36778143271fb9c5e9d8b697979ca2aabd76b8
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/484600
---
 core/drivers/clk/clk-stm32mp21.c | 16 +---------------
 1 file changed, 1 insertion(+), 15 deletions(-)

diff --git a/core/drivers/clk/clk-stm32mp21.c b/core/drivers/clk/clk-stm32mp21.c
index 8f80b2a62..591a6fe04 100644
--- a/core/drivers/clk/clk-stm32mp21.c
+++ b/core/drivers/clk/clk-stm32mp21.c
@@ -196,7 +196,6 @@ struct stm32_clk_platdata {
 	uint32_t nflexgen;
 	uint32_t *flexgen;
 	uint32_t c1msrd;
-	bool safe_rst;
 };
 
 /*
@@ -1248,9 +1247,6 @@ static int stm32_clk_parse_fdt(const void *fdt, int node,
 
 	pdata->c1msrd = fdt_read_uint32_default(fdt, node, "st,c1msrd", 0);
 
-	if (fdt_getprop(fdt, node, "st,safe_rst", NULL))
-		pdata->safe_rst = true;
-
 	pdata->rcc_base = stm32_rcc_base();
 
 	cuint = fdt_getprop(fdt, node, "st,protreg", &lenp);
@@ -3411,14 +3407,6 @@ static void clk_stm32_init_oscillators(const void *fdt, int node)
 	ck_msi_ker.parents[0] = ck_msi.parents[0];
 }
 
-static TEE_Result clk_stm32_apply_rcc_config(struct stm32_clk_platdata *pdata)
-{
-	if (pdata->safe_rst)
-		stm32mp25_syscfg_set_safe_reset(true);
-
-	return TEE_SUCCESS;
-}
-
 static struct stm32_pll_dt_cfg mp21_pll[PLL_NB];
 static struct stm32_clk_opp_dt_cfg mp21_clk_opp;
 static struct stm32_osci_dt_cfg mp21_osci[NB_OSCILLATOR];
@@ -3728,9 +3716,7 @@ static TEE_Result stm32mp21_clk_probe(const void *fdt, int node,
 
 	clk_stm32_init_oscillators(fdt, node);
 
-	res = clk_stm32_apply_rcc_config(pdata);
-	if (res)
-		panic("Error when applying RCC config");
+	stm32mp25_syscfg_set_safe_reset(true);
 
 	stm32mp_clk_provider_probe_final(fdt, node, priv);
 
-- 
2.53.0

