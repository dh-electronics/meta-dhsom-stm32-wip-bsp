From 3d5f4387e49de7118635dcb51f2418d954f50764 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Mon, 25 May 2026 17:12:32 +0200
Subject: [PATCH 522/913] dts: stm32: declare ipcc1 as mbox provider on
 stm32mp251

Add mbox-cells property on ipcc1 in stm32mp251.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 40370eec6be515ef945d18452d788f5da4edeb81 dts: stm32: declare ipcc1 as mbox provider on stm32mp251]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: Id084278b2b037f4fd099663b76efb51449d263fb
---
 core/arch/arm/dts/stm32mp251.dtsi | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/arch/arm/dts/stm32mp251.dtsi b/core/arch/arm/dts/stm32mp251.dtsi
index ae04dd55b..ec6faee5d 100644
--- a/core/arch/arm/dts/stm32mp251.dtsi
+++ b/core/arch/arm/dts/stm32mp251.dtsi
@@ -152,6 +152,7 @@
 		ipcc1: mailbox@40490000 {
 			compatible = "st,stm32mp25-ipcc";
 			reg = <0x40490000 0x400>;
+			#mbox-cells = <1>;
 			interrupts = <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-names = "rx";
 			clocks = <&rcc CK_BUS_IPCC1>;
-- 
2.53.0

