From a16f64ee55f36774fd3cd142181793a6dde8c38e Mon Sep 17 00:00:00 2001
From: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Date: Tue, 5 Sep 2023 18:29:25 +0200
Subject: [PATCH 404/913] plat-stm32mp2: conf: enable lptimer driver

Add STM32_LPTIMER driver support on stm32mp2 platforms.
It depends on the counter driver. Therefore, enable it if
the STM32_LPTIMER driver is enabled.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 08e58303b66aa1c201b2c233a12518b13526e982 plat-stm32mp2: conf: enable lptimer driver]
Signed-off-by: Fabrice Gasnier <fabrice.gasnier@foss.st.com>
Change-Id: Ia562deb9bca51e48210b06114ebc1a965d61df6d
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/326259
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Domain-Review: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/plat-stm32mp2/conf.mk | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index b3b5cd3c3..8b602104d 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -164,6 +164,7 @@ CFG_STM32_I2C ?= y
 CFG_STM32_IAC ?= y
 CFG_STM32_IPCC ?= y
 CFG_STM32_IWDG ?= y
+CFG_STM32_LPTIMER ?= y
 CFG_STM32_OMM ?= y
 CFG_STM32_PKA ?= y
 CFG_STM32_RIF ?= y
@@ -292,6 +293,11 @@ else
 CFG_STM32_PANIC_ON_SERC_EVENT ?= y
 endif
 
+# Enable associated counter driver
+ifeq ($(CFG_STM32_LPTIMER),y)
+$(call force,CFG_COUNTER_DRIVER,y)
+endif
+
 # Default enable firewall support
 CFG_DRIVERS_FIREWALL ?= y
 ifeq ($(call cfg-one-enabled, CFG_STM32_RISAB CFG_STM32_RIFSC),y)
-- 
2.53.0

