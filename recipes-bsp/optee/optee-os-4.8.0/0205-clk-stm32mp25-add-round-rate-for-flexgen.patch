From 39e307829e0ee5fd3ca8eb48a09f5be9403cda17 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 12 Oct 2023 08:40:25 +0200
Subject: [PATCH 205/913] clk: stm32mp25: add round rate for flexgen

Use round_rate ops for Flexgen clocks (need for lcd IP for e.g)

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 58bdb77705eb69a14430423073f2570292fb7230 clk: stm32mp25: add round rate for flexgen]
Change-Id: I1afb638abefae50ddb7b9dc953d6658020ef998f
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
---
 core/drivers/clk/clk-stm32mp25.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/core/drivers/clk/clk-stm32mp25.c b/core/drivers/clk/clk-stm32mp25.c
index af1f851f9..a7efb5dc6 100644
--- a/core/drivers/clk/clk-stm32mp25.c
+++ b/core/drivers/clk/clk-stm32mp25.c
@@ -3170,6 +3170,15 @@ static bool clk_stm32_flexgen_is_enabled(struct clk *clk)
 	       RCC_FINDIV0CFGR_FINDIV0EN;
 }
 
+static unsigned long clk_stm32_flexgen_round_rate(struct clk *clk __unused,
+						  unsigned long rate,
+						  unsigned long prate)
+{
+	unsigned int prediv = 0;
+	unsigned int findiv = 0;
+
+	return clk_stm32_flexgen_get_round_rate(rate, prate, &prediv, &findiv);
+}
 
 static void __maybe_unused clk_stm32_flexgen_pm_restore(struct clk *clk)
 {
@@ -3197,6 +3206,7 @@ static const struct clk_ops clk_stm32_flexgen_ops = {
 	.enable = clk_stm32_flexgen_enable,
 	.disable = clk_stm32_flexgen_disable,
 	.is_enabled = clk_stm32_flexgen_is_enabled,
+	.round_rate = clk_stm32_flexgen_round_rate,
 	.save_context = clk_stm32_pm_save_rate,
 	.restore_context = clk_stm32_flexgen_pm_restore,
 };
-- 
