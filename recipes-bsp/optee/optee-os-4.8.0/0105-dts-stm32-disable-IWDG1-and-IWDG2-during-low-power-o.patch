From 2c7867b519b6055dd1b7821b64cd83b29e33462c Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Thu, 14 Mar 2024 08:33:53 +0100
Subject: [PATCH 105/913] dts: stm32: disable IWDG1 and IWDG2 during low power
 on stm32mp15x-ed1 boards

Update shadow value of otp HW2 to disable IWDG1 and IWDG2 during standby
and stop on stm32mp15x-ed1 boards.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git b1f506e6a5e20f9bb7f45f5c93c8b8eb5a1d03c2 dts: stm32: disable IWDG1 and IWDG2 during low power on stm32mp15x-ed1 boards]
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/366597
Change-Id: I185cfc1c19355d93d60d02afb48daa9eb5c5b997
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/372977
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 core/arch/arm/dts/stm32mp157c-ed1.dts | 10 ++++++++++
 core/arch/arm/dts/stm32mp157d-ed1.dts | 10 ++++++++++
 core/arch/arm/dts/stm32mp157f-ed1.dts | 10 ++++++++++
 3 files changed, 30 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp157c-ed1.dts b/core/arch/arm/dts/stm32mp157c-ed1.dts
index 4af45d744..b1cef0ae8 100644
--- a/core/arch/arm/dts/stm32mp157c-ed1.dts
+++ b/core/arch/arm/dts/stm32mp157c-ed1.dts
@@ -11,6 +11,7 @@
 #include "stm32mp15xxaa-pinctrl.dtsi"
 #include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/mfd/st,stpmic1.h>
+#include <dt-bindings/soc/stm32mp-provisioning.h>
 
 / {
 	model = "STMicroelectronics STM32MP157C eval daughter";
@@ -78,6 +79,15 @@
 		};
 	};
 
+	shadow-prov {
+		compatible = "st,provisioning";
+		hw2_prov {
+			nvmem-cells = <&hw2_otp>;
+			st,shadow-value = <0x000001E0>;
+			st,shadow-lock = <STICKY_LOCK_SR>;
+		};
+	};
+
 	aliases {
 		serial0 = &uart4;
 	};
diff --git a/core/arch/arm/dts/stm32mp157d-ed1.dts b/core/arch/arm/dts/stm32mp157d-ed1.dts
index a91b5ff0b..3c0a69f2f 100644
--- a/core/arch/arm/dts/stm32mp157d-ed1.dts
+++ b/core/arch/arm/dts/stm32mp157d-ed1.dts
@@ -13,6 +13,7 @@
 #include "stm32mp15xxaa-pinctrl.dtsi"
 #include <dt-bindings/clock/stm32mp1-clksrc.h>
 #include <dt-bindings/mfd/st,stpmic1.h>
+#include <dt-bindings/soc/stm32mp-provisioning.h>
 
 / {
 	model = "STMicroelectronics STM32MP157D eval daughter";
@@ -31,6 +32,15 @@
 		reg = <0xC0000000 0x40000000>;
 	};
 
+	shadow-prov {
+		compatible = "st,provisioning";
+		hw2_prov {
+			nvmem-cells = <&hw2_otp>;
+			st,shadow-value = <0x000001E0>;
+			st,shadow-lock = <STICKY_LOCK_SR>;
+		};
+	};
+
 	vin: vin {
 		compatible = "regulator-fixed";
 		regulator-name = "vin";
diff --git a/core/arch/arm/dts/stm32mp157f-ed1.dts b/core/arch/arm/dts/stm32mp157f-ed1.dts
index 99bf5dd91..ece06f67d 100644
--- a/core/arch/arm/dts/stm32mp157f-ed1.dts
+++ b/core/arch/arm/dts/stm32mp157f-ed1.dts
@@ -13,6 +13,7 @@
 #include "stm32mp15xxaa-pinctrl.dtsi"
 #include <dt-bindings/clock/stm32mp1-clksrc.h>
 #include <dt-bindings/mfd/st,stpmic1.h>
+#include <dt-bindings/soc/stm32mp-provisioning.h>
 
 / {
 	model = "STMicroelectronics STM32MP157F eval daughter";
@@ -31,6 +32,15 @@
 		serial0 = &uart4;
 	};
 
+	shadow-prov {
+		compatible = "st,provisioning";
+		hw2_prov {
+			nvmem-cells = <&hw2_otp>;
+			st,shadow-value = <0x000001E0>;
+			st,shadow-lock = <STICKY_LOCK_SR>;
+		};
+	};
+
 	vin: vin {
 		compatible = "regulator-fixed";
 		regulator-name = "vin";
-- 
2.53.0

