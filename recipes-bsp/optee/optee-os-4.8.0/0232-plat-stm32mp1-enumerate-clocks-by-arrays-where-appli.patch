From 9cd73a437286cc1683cebbaf7b162503d4bf8dfa Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Fri, 12 Jul 2024 09:42:23 +0200
Subject: [PATCH 232/913] plat-stm32mp1: enumerate clocks by arrays where
 applicable

Replace clock rates enumeration by step with a discrete enumeration
where applicable to support round rate requests passed through
SCMI describe rate commands.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git dadb1988ae97dec6e3a85d6a94ed3b9d70e739ce plat-stm32mp1: enumerate clocks by arrays where applicable
bb4d7d15251bb87c8a3282f3c9c1996f7270ce58 plat-stm32mp1: enumerate clocks by arrays where applicable]
Change-Id: I35a1283332c2bc8db8b242cf87de5895a8b5ca0a
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/393549
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/scmi_server.c | 63 +++++++++++++++--------
 1 file changed, 41 insertions(+), 22 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/scmi_server.c b/core/arch/arm/plat-stm32mp1/scmi_server.c
index 2f05d84ea..620acc4b5 100644
--- a/core/arch/arm/plat-stm32mp1/scmi_server.c
+++ b/core/arch/arm/plat-stm32mp1/scmi_server.c
@@ -445,17 +445,48 @@ const char *plat_scmi_clock_get_name(unsigned int channel_id,
 	return clock->name;
 }
 
-int32_t plat_scmi_clock_rates_array(unsigned int channel_id __unused,
-				    unsigned int scmi_id __unused,
-				    size_t start_index __unused,
-				    unsigned long *array __unused,
-				    size_t *nb_elts __unused)
+int32_t plat_scmi_clock_rates_array(unsigned int channel_id,
+				    unsigned int scmi_id, size_t start_index,
+				    unsigned long *array, size_t *nb_elts)
 {
 	/*
-	 * Explicitly do not expose clock rates by array since not
-	 * fully supported by Linux kernel as of v5.4.24.
+	 * Be warned that Linux kernel as of v5.4.24 may not fully support
+	 * clock rates by array description.
 	 */
-	return SCMI_NOT_SUPPORTED;
+	struct stm32_scmi_clk *clock = find_clock(channel_id, scmi_id);
+	TEE_Result __maybe_unused res = TEE_ERROR_GENERIC;
+
+	assert(nb_elts && (!*nb_elts || array));
+
+	if (!clock)
+		return SCMI_NOT_FOUND;
+
+	if (!nsec_can_access_resource(clock->etzpc_id))
+		return SCMI_DENIED;
+
+	switch (scmi_id) {
+	case CK_SCMI_MPU:
+		/* MPU clock shall use plat_scmi_clock_rates_by_step() */
+		return SCMI_NOT_SUPPORTED;
+#ifdef CFG_STM32MP13
+	case CK_SCMI_PLL4_Q:
+		res = clk_get_rates_array(clock->clk, start_index, array,
+					  nb_elts);
+		if (res == TEE_ERROR_NOT_SUPPORTED)
+			return SCMI_NOT_SUPPORTED;
+		if (res)
+			return SCMI_GENERIC_ERROR;
+		return SCMI_SUCCESS;
+#endif
+	default:
+		if (start_index)
+			return SCMI_INVALID_PARAMETERS;
+		if (*nb_elts)
+			*array = clk_get_rate(clock->clk);
+		*nb_elts = 1;
+
+		return SCMI_SUCCESS;
+	}
 }
 
 int32_t plat_scmi_clock_rates_by_step(unsigned int channel_id,
@@ -479,22 +510,10 @@ int32_t plat_scmi_clock_rates_by_step(unsigned int channel_id,
 		array[0] = 0U;
 		array[1] = UINT32_MAX;
 		array[2] = 1U;
-		break;
-#ifdef CFG_STM32MP13
-	case CK_SCMI_PLL4_Q:
-		array[0] = 0U;
-		array[1] = UINT32_MAX;
-		array[2] = 0U;
-		break;
-#endif
+		return SCMI_SUCCESS;
 	default:
-		array[0] = clk_get_rate(clock->clk);
-		array[1] = array[0];
-		array[2] = 0U;
-		break;
+		return SCMI_NOT_SUPPORTED;
 	}
-
-	return SCMI_SUCCESS;
 }
 
 int32_t plat_scmi_clock_set_rate(unsigned int channel_id, unsigned int scmi_id,
-- 
2.53.0

