From 92fe9d54b1ffe38517c7c2c00747bbf352c0203f Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Wed, 28 Feb 2024 18:11:58 +0100
Subject: [PATCH 782/913] plat-stm32mp1: default enable hardware RNG for
 STM32MP15 series

Default enable hardware RNG for STM32MP15x boards. Boards that don't
use a hardware RNG in OP-TEE should be part of flavorlist-no_rng.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git c85c6287cb5b4fe03a9717afd172d1ea97a6b30d plat-stm32mp1: default enable hardware RNG for STM32MP15 series]
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Change-Id: I35655ee3d4e790239d918dc00bcc80cf76176907
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/582821
Tested-by: Maxime MERE <maxime.mere@foss.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Maxime MERE <maxime.mere@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 1 -
 1 file changed, 1 deletion(-)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index af7352f6f..1549bd3ef 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -254,7 +254,6 @@ CFG_STM32MP_OPP_COUNT ?= 2
 CFG_CORE_RESERVED_SHM ?= n
 CFG_MULTI_CORE_HALTING ?= y
 CFG_TEE_CORE_NB_CORE ?= 2
-CFG_WITH_SOFTWARE_PRNG ?= y
 CFG_STM32MP1_OPTEE_IN_SYSRAM ?= n
 ifeq ($(CFG_STM32MP1_OPTEE_IN_SYSRAM),y)
 $(call force,CFG_WITH_PAGER,y)
