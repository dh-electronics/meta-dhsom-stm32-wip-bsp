From 8499e893a4d96339152c0c7083975df1342ab8a0 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Tue, 9 Apr 2024 19:32:41 +0200
Subject: [PATCH 727/913] dts: stm32: fix pwr irq node in STM32MP13

Add missing reg for pwr_irq nodes.
This patch solves a DTC warning:
  /soc/pwr@50001010: missing or empty reg/ranges property

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 68e3849d57f0b48b5c4cf084d02ff174b88949e8 dts: stm32: fix pwr irq node in STM32MP13]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I4b13586bf250338713a2a20c18a336d7131b088f
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/372554
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/573549
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/dts/stm32mp131.dtsi | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/arch/arm/dts/stm32mp131.dtsi b/core/arch/arm/dts/stm32mp131.dtsi
index 4af49f558..72094933e 100644
--- a/core/arch/arm/dts/stm32mp131.dtsi
+++ b/core/arch/arm/dts/stm32mp131.dtsi
@@ -293,6 +293,7 @@
 
 		pwr_irq: pwr@50001010 {
 			compatible = "st,stm32mp1-pwr-irq";
+			reg = <0x50001010 0x10>;
 			interrupts = <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-controller;
 			#interrupt-cells = <2>;
-- 
2.53.0

