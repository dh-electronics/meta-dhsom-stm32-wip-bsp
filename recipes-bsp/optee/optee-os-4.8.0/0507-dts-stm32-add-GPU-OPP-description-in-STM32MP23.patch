From 7c46bcf022b3337fe7225b523c4878a11c074b28 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Tue, 1 Oct 2024 18:20:19 +0200
Subject: [PATCH 507/913] dts: stm32: add GPU OPP description in STM32MP23

Add the description for GPU operating points for STM32MP23 family.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git cff77152125f03f7976f90f8e70255e7ef57cf03 dts: stm32: add GPU OPP description in STM32MP23]
Change-Id: Ifdc65de2f498d4fa9987925226b4eafd86db5102
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Signed-off-by: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 core/arch/arm/dts/stm32mp235.dtsi | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp235.dtsi b/core/arch/arm/dts/stm32mp235.dtsi
index 9dea821b6..23da66bd0 100644
--- a/core/arch/arm/dts/stm32mp235.dtsi
+++ b/core/arch/arm/dts/stm32mp235.dtsi
@@ -7,4 +7,25 @@
 #include "stm32mp233.dtsi"
 
 / {
+	gpu_opp_table: opp-table-gpu {
+		compatible = "operating-points-v2";
+
+		opp-400000000 {
+			opp-hz = /bits/ 64 <400000000>;
+			opp-microvolt = <800000>;
+			opp-supported-hw = <0x3>;
+			st,opp-default;
+		};
+	};
+};
+
+&rifsc {
+	gpu: gpu@48280000 {
+		compatible = "vivante,gc";
+		reg = <0x48280000 0x800>;
+		gpu-supply = <&vddgpu>;
+		clocks = <&rcc CK_KER_GPU>;
+		operating-points-v2 = <&gpu_opp_table>;
+		access-controllers = <&rifsc STM32MP25_RIFSC_GPU_ID>;
+	};
 };
-- 
