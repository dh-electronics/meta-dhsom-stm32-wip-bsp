From 94448149f0e39bb7255f3e1ec82ace361c172578 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Fri, 24 Mar 2023 17:07:15 +0100
Subject: [PATCH 089/913] dts: stm32: add bsec node in stm32mp251.dtsi

Add the bsec node to access OTP on stm32mp25 platforms with
the NVMEM description needed by OP-TEE for STM32MP25x device
- part_number_otp
- package_otp
- HCONF1: hardware configuration fuse
- PKH OTP: hash of public keys hashes
- encryption keys
- TFM IAK
- OEM rproc authentification public key
- OEM rproc encryption key

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git fe6c46166ab155e2ac7703c3bdbd77c5296644b0 dts: stm32: add bsec node in stm32mp251.dtsi]
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Signed-off-by: Lionel Debieve <lionel.debieve@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/247732
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/247733
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/267534
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/289113
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/349109
Change-Id: I0ab2fdd500bca9400245cccbb107082cec4f0520
---
 core/arch/arm/dts/stm32mp251.dtsi | 55 +++++++++++++++++++++++++++++++
 1 file changed, 55 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp251.dtsi b/core/arch/arm/dts/stm32mp251.dtsi
index ce6f2ad84..190919d59 100644
--- a/core/arch/arm/dts/stm32mp251.dtsi
+++ b/core/arch/arm/dts/stm32mp251.dtsi
@@ -385,6 +385,61 @@
 			status = "disabled";
 		};
 
+		bsec: efuse@44000000 {
+			compatible = "st,stm32mp25-bsec";
+			reg = <0x44000000 0x1000>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			part_number_otp@24 {
+				reg = <0x24 0x4>;
+			};
+
+			package_otp@1e8 {
+				reg = <0x1e8 0x1>;
+			};
+
+			hconf1_otp: otp124@1f0 {
+				reg = <0x1f0 0x4>;
+			};
+
+			pkh_otp: otp144@240 {
+				reg = <0x240 0x20>;
+			};
+
+			oem_rproc_pkh: oem_rproc_pkh@2c0 {
+				/* 0x2C0 -> otp176 */
+				reg = <0x2C0 0x20>;
+				st,non-secure-otp-provisioning;
+			};
+
+			oem_fip_enc_key: otp260@410 {
+				reg = <0x410 0x20>;
+				st,non-secure-otp-provisioning;
+			};
+
+			oem_rproc_enc_key: oem_rproc_enc_key@540 {
+				/* 0x540 -> otp336 */
+				reg = <0x540 0x20>;
+				st,non-secure-otp-provisioning;
+			};
+
+			tfm_iak: otp352@580 {
+				reg = <0x580 0x20>;
+				st,non-secure-otp-provisioning;
+			};
+
+			oem_enc_key_2: otp360@5a0 {
+				reg = <0x5a0 0x10>;
+				st,non-secure-otp-provisioning;
+			};
+
+			oem_enc_key_1: otp364@5b0 {
+				reg = <0x5b0 0x10>;
+				st,non-secure-otp-provisioning;
+			};
+		};
+
 		serc: serc@44080000 {
 			compatible = "st,stm32mp25-serc";
 			reg = <0x44080000 0x1000>;
-- 
2.53.0

