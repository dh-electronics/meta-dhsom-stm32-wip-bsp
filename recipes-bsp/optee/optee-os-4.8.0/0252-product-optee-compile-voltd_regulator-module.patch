From: Valentin Caron <valentin.caron@foss.st.com>
Date: Fri, 14 Feb 2025 15:55:11 +0100
Subject: [PATCH 252/913] product: optee: compile voltd_regulator module

Compile voltd_regulator optee module.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 58ac46012fba4cdba73110b45bd71991435a8e9a product: optee: compile voltd_regulator module]
Fixes: bf5b4150ff780 ("module/optee: Add voltage domain regulators")
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
---
 core/lib/scmi-server/SCP-firmware/product/optee/sub.mk | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/lib/scmi-server/SCP-firmware/product/optee/sub.mk b/core/lib/scmi-server/SCP-firmware/product/optee/sub.mk
index 47d7f4fb0..50b406340 100644
--- a/core/lib/scmi-server/SCP-firmware/product/optee/sub.mk
+++ b/core/lib/scmi-server/SCP-firmware/product/optee/sub.mk
@@ -127,6 +127,7 @@ $(eval $(call scpfw-embed-optee-module,console))
 $(eval $(call scpfw-embed-optee-module,mbx))
 $(eval $(call scpfw-embed-optee-module,reset))
 $(eval $(call scpfw-embed-optee-module,smt))
+$(eval $(call scpfw-embed-optee-module,voltd_regulator))
 
 # Some modules have extra and non generic C files
 srcs-$(CFG_SCPFW_MOD_CLOCK) += $(scpfw-path)/module/clock/src/clock_tree_management.c
