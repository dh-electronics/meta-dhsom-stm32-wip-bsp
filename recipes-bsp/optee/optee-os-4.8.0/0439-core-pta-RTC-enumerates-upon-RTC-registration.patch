From 11b9ee06dd2b2779a7e7e9a9f44a5a92805fabb6 Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Thu, 25 Apr 2024 09:15:56 +0200
Subject: [PATCH 439/913] core: pta: RTC enumerates upon RTC registration

Allow RTC PTA to be enumerated only upon registration of an
RTC device.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git f8d06168fb6eeb5069c4127d49e3d9197b2b6e7d core: pta: RTC enumerates upon RTC registration]
Change-Id: Ib031021f1f936482be9b37bb417d1eb7ce2ee313
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/377162
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570355
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/pta/rtc.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/core/pta/rtc.c b/core/pta/rtc.c
index d07757efc..9b2810cd7 100644
--- a/core/pta/rtc.c
+++ b/core/pta/rtc.c
@@ -351,8 +351,18 @@ static TEE_Result invoke_command(void *session __unused,
 	return TEE_ERROR_NOT_IMPLEMENTED;
 }
 
+static bool do_enumerate(void)
+{
+#ifdef CFG_DRIVERS_RTC
+	return rtc_device;
+#else
+	return false;
+#endif
+}
+
 pseudo_ta_register(.uuid = PTA_RTC_UUID, .name = PTA_NAME,
 		   .flags = PTA_DEFAULT_FLAGS | TA_FLAG_CONCURRENT |
 			    TA_FLAG_DEVICE_ENUM,
 		   .open_session_entry_point = open_session,
-		   .invoke_command_entry_point = invoke_command);
+		   .invoke_command_entry_point = invoke_command,
+		   .ask_for_enumeration = do_enumerate);
-- 
