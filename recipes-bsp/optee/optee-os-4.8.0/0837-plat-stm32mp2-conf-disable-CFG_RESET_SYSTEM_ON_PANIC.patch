From 587d8a26bda9f7b787fcb5823e1f8f0deefe998d Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 15 Jul 2026 10:56:48 +0200
Subject: [PATCH 837/913] plat-stm32mp2: conf: disable
 CFG_RESET_SYSTEM_ON_PANIC on M33TD

Force CFG_RESET_SYSTEM_ON_PANIC to n when CFG_STM32_CM33TDCID is
enabled. In this configuration OP-TEE has no access to RCC and no
SCMI client is available to send a system reset request to TF-M,
so the system reset on panic cannot be performed.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git c6adeb5b4ea99e8a48922141e7848d1973212f02 plat-stm32mp2: conf: disable CFG_RESET_SYSTEM_ON_PANIC on M33TD]
Change-Id: If152613ba7bf84d3cfadebabf917edb734ce3d5b
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/588229
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 core/arch/arm/plat-stm32mp2/conf.mk | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index 4fbd7e855..9eb64c167 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -83,6 +83,7 @@ CFG_STM32_CM33TDCID ?= n
 ifeq ($(CFG_STM32_CM33TDCID),y)
 $(call force,CFG_HWRNG_PTA,n)
 CFG_WITH_SOFTWARE_PRNG ?= y
+$(call force,CFG_RESET_SYSTEM_ON_PANIC,n)
 $(call force,CFG_SCMI_CORTEXM_AGENT,n)
 $(call force,CFG_SCMI_MSG_DRIVERS,n)
 $(call force,CFG_SCMI_PTA,n)
