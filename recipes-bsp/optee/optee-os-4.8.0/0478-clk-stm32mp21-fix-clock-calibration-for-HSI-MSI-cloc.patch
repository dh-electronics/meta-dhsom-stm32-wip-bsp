From 554b567f7cd4db573f61d0b63a2eea957f18a227 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 12 Jan 2023 17:03:43 +0100
Subject: [PATCH 478/913] clk: stm32mp21: fix clock calibration for HSI / MSI
 clocks

Use specific registers for STM32MP21 (could be different with STM32MP25).

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 91bf2d0e69fc4fd37bfb4cfca4335cc38d6b6531 clk: stm32mp21: fix clock calibration for HSI / MSI clocks]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I9932cdd446d8082357f8b209abba172d0971983b
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570763
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/drivers/clk/clk-stm32mp2-cal.c  | 4 ++++
 core/include/drivers/stm32mp21_rcc.h | 2 ++
 2 files changed, 6 insertions(+)

diff --git a/core/drivers/clk/clk-stm32mp2-cal.c b/core/drivers/clk/clk-stm32mp2-cal.c
index 82a9936bd..85315d9a5 100644
--- a/core/drivers/clk/clk-stm32mp2-cal.c
+++ b/core/drivers/clk/clk-stm32mp2-cal.c
@@ -5,7 +5,11 @@
 
 #include <drivers/clk.h>
 #include <drivers/stm32mp_dt_bindings.h>
+#ifdef CFG_STM32MP21_CLK
+#include <drivers/stm32mp21_rcc.h>
+#else
 #include <drivers/stm32mp25_rcc.h>
+#endif
 #include <io.h>
 #include <keep.h>
 #include <kernel/delay.h>
diff --git a/core/include/drivers/stm32mp21_rcc.h b/core/include/drivers/stm32mp21_rcc.h
index 8eca25fa8..98bdea051 100644
--- a/core/include/drivers/stm32mp21_rcc.h
+++ b/core/include/drivers/stm32mp21_rcc.h
@@ -1208,8 +1208,10 @@
 
 /* RCC_HSIFMONCR register fields */
 #define RCC_HSIFMONCR_HSIREF_MASK		GENMASK_32(10, 0)
+#define RCC_HSIFMONCR_HSIREF_SHIFT		0
 #define RCC_HSIFMONCR_HSIMONEN			BIT(15)
 #define RCC_HSIFMONCR_HSIDEV_MASK		GENMASK_32(21, 16)
+#define RCC_HSIFMONCR_HSIDEV_SHIFT		16
 #define RCC_HSIFMONCR_HSIMONIE			BIT(30)
 #define RCC_HSIFMONCR_HSIMONF			BIT(31)
 
-- 
