From 509d501d2e27d6720ed839baa07805fced6e50cb Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 15 Oct 2025 15:23:28 +0200
Subject: [PATCH 033/913] dt-bindings: stm32_rng: add RNG support for STM32MP21
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

update bindings to support rng in STM32MP21.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git a87318fe5e3de83974d39ccf951d7d337e6c0bc0 dt-bindings: stm32_rng: add RNG support for STM32MP21]
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Change-Id: I2d7a4753fda39c84e548a9bd83f25e83655fca30
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/414254
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 .../devicetree/bindings/rng/st,stm32-rng.yaml | 49 ++++++++++++++++---
 1 file changed, 42 insertions(+), 7 deletions(-)

diff --git a/documentation/devicetree/bindings/rng/st,stm32-rng.yaml b/documentation/devicetree/bindings/rng/st,stm32-rng.yaml
index 7db65f497..b6c1ced3c 100644
--- a/documentation/devicetree/bindings/rng/st,stm32-rng.yaml
+++ b/documentation/devicetree/bindings/rng/st,stm32-rng.yaml
@@ -18,6 +18,7 @@ properties:
     enum:
       - st,stm32-rng
       - st,stm32mp13-rng
+      - st,stm32mp21-rng
       - st,stm32mp25-rng
 
   reg:
@@ -39,11 +40,6 @@ properties:
     type: boolean
     description: If set enable the clock detection management
 
-  st,rng-lock-conf:
-    type: boolean
-    description: If set, the RNG configuration in RNG_CR, RNG_HTCR and
-                  RNG_NSCR will be locked.
-
   access-controllers:
     minItems: 1
     maxItems: 2
@@ -59,10 +55,14 @@ allOf:
         compatible:
           contains:
             enum:
-              - st,stm32-rng
+              - st,stm32mp13-rng
+              - st,stm32mp25-rng
     then:
       properties:
-        st,rng-lock-conf: false
+        st,rng-lock-conf:
+          type: boolean
+          description: If set, the RNG configuration in RNG_CR, RNG_HTCR and
+                       RNG_NSCR will be locked.
 
   - if:
       properties:
@@ -80,9 +80,44 @@ allOf:
       properties:
         clocks:
           minItems: 2
+
+        clock-names:
+          items:
+            - const: rng_clk  # RNG kernel clock
+            - const: rng_hclk # RNG bus clock
+
       required:
         - clock-names
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - st,stm32mp13-rng
+              - st,stm32mp21-rng
+              - st,stm32mp25-rng
+    then:
+      properties:
+        st,rng-cfg:
+          minItems: 1
+          maxItems: 3
+          type: boolean
+          description: The configuration bitfields to initialize the RNG. They
+                       must be listed in the numerical order. If not specified,
+                       the default hard-coded values will be used. Number of
+                       values depends on the presence of
+                       st,rng-nist-custom property.
+
+        st,rng-cfg-nist-custom:
+          type: boolean
+          description: Enable custom values for NIST compliant RNG.
+
+        st,rng-htcfg:
+          maxItems: 1
+          description: The values to configure health tests. If not specified,
+                       the default hard-coded values will be used.
+
 additionalProperties: false
 
 examples:
-- 
2.53.0

