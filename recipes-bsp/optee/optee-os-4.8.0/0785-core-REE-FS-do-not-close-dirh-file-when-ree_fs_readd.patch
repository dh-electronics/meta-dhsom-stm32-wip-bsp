From d771e773ff34446a01c034eb1c7ec46b960d0829 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Fri, 3 Jul 2026 13:23:25 +0200
Subject: [PATCH 785/913] core: REE FS: do not close dirh file when
 ree_fs_readdir_rpc() does not find a file

ree_fs_readdir_rpc() might fail when you try to enumerate files.
In this case tee_fs_dirfile_get_next() return TEE_ERROR_ITEM_NOT_FOUND.
But since res is used to know if we need to close dirh or not, we will
close dirh for the wrong reason.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git cbfa8cc12092bfc36eefc29dd6d04512126f4370 core: REE FS: do not close dirh file when ree_fs_readdir_rpc() does not find a file]
Fixes: 7ae15736f2ab ("core: ree_fs: fix dirfile handle refcount")
Change-Id: I8d8bcb71b61715552a3cb011dfbd7b44e47604d3
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/584551
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 core/tee/tee_ree_fs.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/core/tee/tee_ree_fs.c b/core/tee/tee_ree_fs.c
index 34ac697ba..e59fc9797 100644
--- a/core/tee/tee_ree_fs.c
+++ b/core/tee/tee_ree_fs.c
@@ -1076,6 +1076,7 @@ static TEE_Result ree_fs_readdir_rpc(struct tee_fs_dir *d,
 {
 	struct tee_fs_dirfile_dirh *dirh = NULL;
 	TEE_Result res = TEE_SUCCESS;
+	bool close = false;
 
 	mutex_lock(&ree_fs_mutex);
 
@@ -1089,7 +1090,10 @@ static TEE_Result ree_fs_readdir_rpc(struct tee_fs_dir *d,
 	if (res == TEE_SUCCESS)
 		*ent = &d->d;
 
-	put_dirh(dirh, res);
+	if (res != TEE_SUCCESS && res != TEE_ERROR_ITEM_NOT_FOUND)
+		close = true;
+
+	put_dirh(dirh, close);
 out:
 	mutex_unlock(&ree_fs_mutex);
 
-- 
