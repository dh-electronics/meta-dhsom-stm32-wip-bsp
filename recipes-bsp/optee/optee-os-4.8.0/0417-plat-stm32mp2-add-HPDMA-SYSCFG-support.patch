From d44b7cf94fb926dcfcc171d270c1e33aaaf1193e Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Wed, 13 May 2026 14:34:10 +0200
Subject: [PATCH 417/913] plat-stm32mp2: add HPDMA SYSCFG support

Add support for the HPDMA Address Remapping configuration that is present
in SYSCFG.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 33ffe54a5e23653381ecca8a93ff95c20890e4e0 plat-stm32mp2: add HPDMA SYSCFG support]
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Change-Id: Ifcc3f80c8ea32a243d10e3dd1c35b3d632e6bc97
---
 core/arch/arm/plat-stm32mp2/stm32_sysconf.h | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/stm32_sysconf.h b/core/arch/arm/plat-stm32mp2/stm32_sysconf.h
index af149960c..d81a5f53c 100644
--- a/core/arch/arm/plat-stm32mp2/stm32_sysconf.h
+++ b/core/arch/arm/plat-stm32mp2/stm32_sysconf.h
@@ -25,6 +25,7 @@ enum syscon_banks {
  * SYSCFG register offsets (base relative)
  */
 #define SYSCFG_VDERAMCR		SYSCON_ID(SYSCON_SYSCFG, 0x1800)
+#define SYSCFG_HPDMAARCR	SYSCON_ID(SYSCON_SYSCFG, 0x2050)
 
 /*
  * SYSCFG_VDERAMCR register fields
@@ -32,6 +33,13 @@ enum syscon_banks {
 #define VDERAMCR_VDERAM_EN		BIT(0)
 #define VDERAMCR_MASK			BIT(0)
 
+/*
+ * SYSCFG HPDMA address remapping control register (SYSCFG_HPDMAARCR) fields
+ */
+#define HPDMAARCR_HPDMA1AREN		BIT(0)
+#define HPDMAARCR_HPDMA2AREN		BIT(1)
+#define HPDMAARCR_HPDMA3AREN		BIT(2)
+
 /*
  * CA35SS register offsets (base relative)
  * Standardized Status and Control registers (SSC) access modes.
-- 
2.53.0

