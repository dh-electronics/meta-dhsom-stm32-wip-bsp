From c85a7fcf113402873b9b81722ea73b0c037b5113 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Fri, 20 Mar 2026 16:12:05 +0100
Subject: [PATCH 178/913] clk: stm32mp25: enable safe reset feature
 systematically

Safe reset feature should be always enabled.
Don't need parameter to enable it in device tree.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git ab1ea1b65880eee0018b20f3dcb79126790d45c4 clk: stm32mp25: enable safe reset feature systematically]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I26ba55c7e484bd173f836845e667ba16fb389609
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/484599
---
 core/drivers/clk/clk-stm32mp25.c | 17 +----------------
 1 file changed, 1 insertion(+), 16 deletions(-)

diff --git a/core/drivers/clk/clk-stm32mp25.c b/core/drivers/clk/clk-stm32mp25.c
index 649859074..34346bdcb 100644
--- a/core/drivers/clk/clk-stm32mp25.c
+++ b/core/drivers/clk/clk-stm32mp25.c
@@ -141,7 +141,6 @@ struct stm32_clk_platdata {
 	uint32_t nflexgen;
 	uint32_t *flexgen;
 	uint32_t c1msrd;
-	bool safe_rst;
 };
 
 /*
@@ -1266,9 +1265,6 @@ static int stm32_clk_parse_fdt(const void *fdt, int node,
 
 	pdata->c1msrd = fdt_read_uint32_default(fdt, node, "st,c1msrd", 0);
 
-	if (fdt_getprop(fdt, node, "st,safe_rst", NULL))
-		pdata->safe_rst = true;
-
 	pdata->rcc_base = stm32_rcc_base();
 
 	cuint = fdt_getprop(fdt, node, "st,protreg", &lenp);
@@ -3507,14 +3503,6 @@ static void clk_stm32_init_oscillators(const void *fdt, int node)
 	}
 }
 
-static TEE_Result clk_stm32_apply_rcc_config(struct stm32_clk_platdata *pdata)
-{
-	if (pdata->safe_rst)
-		stm32mp25_syscfg_set_safe_reset(true);
-
-	return TEE_SUCCESS;
-}
-
 static struct stm32_pll_dt_cfg mp25_pll[PLL_NB];
 static struct stm32_clk_opp_dt_cfg mp25_clk_opp;
 static struct stm32_osci_dt_cfg mp25_osci[NB_OSCILLATOR];
@@ -3745,7 +3733,6 @@ driver_init_late(rcc_rif_config);
 static TEE_Result stm32mp25_clk_probe(const void *fdt, int node,
 				      const void *compat_data __unused)
 {
-	TEE_Result res = TEE_ERROR_GENERIC;
 	int fdt_rc = 0;
 	int rc = 0;
 	struct clk_stm32_priv *priv = &stm32mp25_clock_data;
@@ -3766,9 +3753,7 @@ static TEE_Result stm32mp25_clk_probe(const void *fdt, int node,
 
 	clk_stm32_init_oscillators(fdt, node);
 
-	res = clk_stm32_apply_rcc_config(pdata);
-	if (res)
-		panic("Error when applying RCC config");
+	stm32mp25_syscfg_set_safe_reset(true);
 
 	stm32mp_clk_provider_probe_final(fdt, node, priv);
 
-- 
2.53.0

