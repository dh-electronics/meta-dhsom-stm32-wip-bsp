From 81fe0264b121b1bf8d7a5ad291fa7c7275a2b7ea Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Fri, 25 Apr 2025 15:10:56 +0200
Subject: [PATCH 375/913] dts: stm32: stm32mp2: fix address conflict between
 SCMI SHM and IPCC SHM

Currently, the server must be addressed by M33 (secure or non secure)
for some SCMI requests. As symmetric approach, we will use the same
SRAM1 shared memory as used in M33-TD.

It needs 4kB for each mailbox:
 - scmi_cid2_ns for M33_NS to A35S
 - scmi_cid2_s for M33_S to A35_S

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git c1ec20261806f0734bc81d26f082ccd31f83fa92 dts: stm32: stm32mp2: fix address conflict between SCMI SHM and IPCC SHM]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: I5d816f797552ba1b72cfbd56283a976320735beb
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/562868
Tested-by: Nicolas LE BAYON <nicolas.le.bayon@st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Nicolas LE BAYON <nicolas.le.bayon@st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 .../arm/dts/stm32mp257f-ev1-ca35tdcid-resmem.dtsi  | 14 ++++++++++++--
 .../arm/dts/stm32mp257f-ev1-ca35tdcid-rif.dtsi     | 10 +++++++++-
 2 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp257f-ev1-ca35tdcid-resmem.dtsi b/core/arch/arm/dts/stm32mp257f-ev1-ca35tdcid-resmem.dtsi
index 4b397c292..554c52fde 100644
--- a/core/arch/arm/dts/stm32mp257f-ev1-ca35tdcid-resmem.dtsi
+++ b/core/arch/arm/dts/stm32mp257f-ev1-ca35tdcid-resmem.dtsi
@@ -25,8 +25,18 @@
 			no-map;
 		};
 
-		cm33_sram1: cm33-sram1@a041000 {
-			reg = <0x0 0xa041000 0x0 0x1f000>;
+		scmi_cid2_s: scmi-cid2-s@a041000 {
+			reg = <0x0 0xa041000 0x0 0x1000>;
+			no-map;
+		};
+
+		scmi_cid2_ns: scmi-cid2-ns@a042000 {
+			reg = <0x0 0xa042000 0x0 0x1000>;
+			no-map;
+		};
+
+		cm33_sram1: cm33-sram1@a043000 {
+			reg = <0x0 0xa043000 0x0 0x1d000>;
 			no-map;
 		};
 
diff --git a/core/arch/arm/dts/stm32mp257f-ev1-ca35tdcid-rif.dtsi b/core/arch/arm/dts/stm32mp257f-ev1-ca35tdcid-rif.dtsi
index 31925f76b..2259d93a8 100644
--- a/core/arch/arm/dts/stm32mp257f-ev1-ca35tdcid-rif.dtsi
+++ b/core/arch/arm/dts/stm32mp257f-ev1-ca35tdcid-rif.dtsi
@@ -851,6 +851,14 @@
 	st,protreg = <RISABPROT(RIF_DDCID_DIS, RIF_UNUSED, RIF_SEC, RIF_NPRIV, RIF_CFDIS, RIF_UNUSED, RIF_UNUSED, RIF_UNUSED)>;
 };
 
+&scmi_cid2_s {
+	st,protreg = <RISABPROT(RIF_DDCID_DIS, RIF_UNUSED, RIF_SEC, RIF_NPRIV, RIF_CFDIS, RIF_UNUSED, RIF_UNUSED, RIF_UNUSED)>;
+};
+
+&scmi_cid2_ns {
+	st,protreg = <RISABPROT(RIF_DDCID_DIS, RIF_UNUSED, RIF_NSEC, RIF_NPRIV, RIF_CFDIS, RIF_UNUSED, RIF_UNUSED, RIF_UNUSED)>;
+};
+
 &cm33_sram1 {
 	st,protreg = <RISABPROT(RIF_DDCID_DIS, RIF_UNUSED, RIF_NSEC, RIF_NPRIV, RIF_CFDIS, RIF_UNUSED, RIF_UNUSED, RIF_UNUSED)>;
 };
@@ -877,7 +885,7 @@
 
 &risab3 {
 	st,srwiad;
-	memory-region = <&bsec_mirror>, <&cm33_sram1>;
+	memory-region = <&bsec_mirror>, <&scmi_cid2_s>, <&scmi_cid2_ns>, <&cm33_sram1>;
 };
 
 &risab4 {
