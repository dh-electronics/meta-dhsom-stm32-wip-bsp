From 905173d9f60f0fa1c50c89f29abbe93d6ebe4e3d Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Tue, 9 Jun 2026 15:42:51 +0200
Subject: [PATCH 745/913] plat-stm32mp1: fix low power drivers for stm32mp1

Remove the unused functions:
- stm32mp1_set_lp_deepest_soc_mode
- stm32_enter_cstop_reset

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 2d2c55de1d39ce26ab9856130b5f0c029427e777 plat-stm32mp1: fix low power drivers for stm32mp1]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I43fd7399ed96bcb777dadb3bbb595e5a0041ecea
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/577546
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/pm/context.h      |  1 -
 core/arch/arm/plat-stm32mp1/pm/low_power.c    | 35 ++-----------------
 core/arch/arm/plat-stm32mp1/pm/power.h        |  1 -
 core/arch/arm/plat-stm32mp1/pm/power_config.c | 21 -----------
 core/arch/arm/plat-stm32mp1/stm32mp_pm.h      |  3 --
 5 files changed, 3 insertions(+), 58 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/pm/context.h b/core/arch/arm/plat-stm32mp1/pm/context.h
index 7eb95f1eb..33e70c535 100644
--- a/core/arch/arm/plat-stm32mp1/pm/context.h
+++ b/core/arch/arm/plat-stm32mp1/pm/context.h
@@ -96,7 +96,6 @@ int stm32mp1_set_pm_domain_state(enum stm32mp1_pm_domain domain, bool status);
 
 bool stm32mp1_lp_soc_mode_is_supported(uint32_t soc_mode);
 uint32_t stm32mp1_get_lp_soc_mode(uint32_t psci_mode);
-int stm32mp1_set_lp_deepest_soc_mode(uint32_t psci_mode, uint32_t soc_mode);
 
 bool stm32mp1_is_retram_during_standby(void);
 
diff --git a/core/arch/arm/plat-stm32mp1/pm/low_power.c b/core/arch/arm/plat-stm32mp1/pm/low_power.c
index 48020f182..6dfc78b53 100644
--- a/core/arch/arm/plat-stm32mp1/pm/low_power.c
+++ b/core/arch/arm/plat-stm32mp1/pm/low_power.c
@@ -101,7 +101,7 @@ static const struct pwr_lp_config config_pwr[STM32_PM_MAX_SOC_MODE] = {
 	[STM32_PM_SHUTDOWN] = {
 		.pwr_cr1 = 0U,
 		.pwr_mpucr = 0U,
-		.regul_suspend_node_name = "standby-ddr-off",
+		.regul_suspend_node_name = NULL,
 	},
 };
 #else
@@ -144,7 +144,7 @@ static const struct pwr_lp_config config_pwr[STM32_PM_MAX_SOC_MODE] = {
 	[STM32_PM_SHUTDOWN] = {
 		.pwr_cr1 = 0U,
 		.pwr_mpucr = 0U,
-		.regul_suspend_node_name = "standby-ddr-off",
+		.regul_suspend_node_name = NULL,
 	},
 };
 #endif
@@ -161,7 +161,7 @@ static void restore_rcc_it_priority(uint8_t it_prio, uint8_t pmr)
 	(void)gic_set_pmr(pmr);
 }
 
-const char *stm32mp_pm_hint2mode_name(uint32_t pm_hint)
+static const char *stm32mp_pm_hint2mode_name(uint32_t pm_hint)
 {
 	assert(pm_hint < ARRAY_SIZE(config_pwr));
 
@@ -228,13 +228,6 @@ void stm32_enter_cstop(uint32_t mode)
 				    mode == STM32_PM_CSTANDBY_ALLOW_LPLV_STOP2))
 		pwr_cr1 |= PWR_CR1_LPCFG;
 
-	/* The PMIC2 applies it's low power config in a suspend call back */
-	if (stm32_stpmic1_is_present()) {
-		stm32mp_get_pmic();
-		stm32mp_pmic_apply_lp_config(config_pwr[mode].regul_suspend_node_name);
-		stm32mp_put_pmic();
-	}
-
 	if (mode == STM32_PM_CSTANDBY_ALLOW_LPLV_STOP2) {
 		struct clk *hsi_clk = stm32mp_rcc_clock_id_to_clk(CK_HSI);
 		unsigned long freq = clk_get_rate(hsi_clk);
@@ -389,28 +382,6 @@ void __noreturn stm32_enter_cstop_shutdown(uint32_t mode)
 	panic();
 }
 
-/*
- * stm32_enter_cstop_reset - Reset CPUs to target low power mode
- * @mode - Target low power mode
- */
-void __noreturn stm32_enter_cstop_reset(uint32_t mode)
-{
-	switch (mode) {
-	case STM32_PM_SHUTDOWN:
-		stm32_reset_system();
-		udelay(100);
-		break;
-	default:
-		IMSG("Forced system reset");
-		wait_console_flushed();
-		stm32_reset_system();
-		udelay(100);
-		break;
-	}
-
-	panic();
-}
-
 /*
  * stm32_enter_csleep - enter CSLEEP state while WFI and exit in CRUN
  *
diff --git a/core/arch/arm/plat-stm32mp1/pm/power.h b/core/arch/arm/plat-stm32mp1/pm/power.h
index 5d1fcdfd1..a7907452a 100644
--- a/core/arch/arm/plat-stm32mp1/pm/power.h
+++ b/core/arch/arm/plat-stm32mp1/pm/power.h
@@ -21,7 +21,6 @@ void stm32_enter_cstop(uint32_t mode);
 void stm32_exit_cstop(void);
 
 void stm32_enter_cstop_shutdown(uint32_t mode) __noreturn;
-void stm32_enter_cstop_reset(uint32_t mode) __noreturn;
 
 void stm32_pm_cpu_power_down_wfi(void) __noreturn;
 void stm32_pm_cpu_wfi(void);
diff --git a/core/arch/arm/plat-stm32mp1/pm/power_config.c b/core/arch/arm/plat-stm32mp1/pm/power_config.c
index 091578e66..4582be166 100644
--- a/core/arch/arm/plat-stm32mp1/pm/power_config.c
+++ b/core/arch/arm/plat-stm32mp1/pm/power_config.c
@@ -332,27 +332,6 @@ uint32_t stm32mp1_get_lp_soc_mode(uint32_t psci_mode)
 	return mode;
 }
 
-int stm32mp1_set_lp_deepest_soc_mode(uint32_t psci_mode, uint32_t soc_mode)
-{
-	if (soc_mode >= STM32_PM_MAX_SOC_MODE)
-		return -1;
-
-	if (psci_mode == PSCI_MODE_SYSTEM_SUSPEND) {
-		deepest_suspend_mode = soc_mode;
-
-#ifdef CFG_STM32MP1_OPTEE_IN_SYSRAM
-		if (!stm32mp_supports_hw_cryp() &&
-		    deepest_suspend_mode == STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_SR)
-			deepest_suspend_mode = STM32_PM_CSTOP_ALLOW_LPLV_STOP;
-#endif
-	}
-
-	if (psci_mode == PSCI_MODE_SYSTEM_OFF)
-		system_off_mode = soc_mode;
-
-	return 0;
-}
-
 #ifdef CFG_EMBED_DTB
 static int dt_get_pwr_node(void *fdt)
 {
diff --git a/core/arch/arm/plat-stm32mp1/stm32mp_pm.h b/core/arch/arm/plat-stm32mp1/stm32mp_pm.h
index a4dcb2292..4cbf619fa 100644
--- a/core/arch/arm/plat-stm32mp1/stm32mp_pm.h
+++ b/core/arch/arm/plat-stm32mp1/stm32mp_pm.h
@@ -15,8 +15,5 @@ enum stm32mp1_pm_domain {
 	STM32MP1_PD_MAX_PM_DOMAIN
 };
 
-/* Convert low power mode carried by pm_hint into pm mode name */
-const char *stm32mp_pm_hint2mode_name(uint32_t pm_hint);
-
 #endif /*__STM32MP_PM_H__*/
 
-- 
2.53.0

