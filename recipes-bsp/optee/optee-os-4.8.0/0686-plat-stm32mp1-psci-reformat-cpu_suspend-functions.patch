From ac4785e2db081fee7607ccbfc77f4107f31457d8 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Thu, 4 Dec 2025 11:57:43 +0100
Subject: [PATCH 686/913] plat-stm32mp1: psci: reformat cpu_suspend functions

In stm32_cpu_standby:
 - Transform while into a do while to remove the boolean again
 - Get down itr_chip and other_pos directly in the brackets where they
   are used

In stm32_pwr_domain_suspend:
 - Invert the condition to avoid a big if else.

Behavior are not be impacted.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git acf43947715072cb42fc317c2b65007bc443ae76 plat-stm32mp1: psci: reformat cpu_suspend functions]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: Ibc06481e4f7e3cf359fa60f8b72a502042f4ea91
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/515752
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/pm/psci.c | 50 +++++++++++++--------------
 1 file changed, 24 insertions(+), 26 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/pm/psci.c b/core/arch/arm/plat-stm32mp1/pm/psci.c
index 011b934fe..5a8c19393 100644
--- a/core/arch/arm/plat-stm32mp1/pm/psci.c
+++ b/core/arch/arm/plat-stm32mp1/pm/psci.c
@@ -535,11 +535,8 @@ static inline size_t stm32_get_pos_other(void) {
 
 static void stm32_cpu_standby(void)
 {
-	struct itr_chip *itr_chip = interrupt_get_main_chip();
 	size_t pos = get_core_pos();
-	size_t other_pos = stm32_get_pos_other();
 	uint32_t exceptions = 0;
-	bool again = true;
 
 	set_locked(&cstop_cpux_state[pos], STATE_AUTO_CSTOP_ENTRY);
 
@@ -548,20 +545,21 @@ static void stm32_cpu_standby(void)
 	 * Synchronize on memory accesses and instruction flow before the WFI
 	 * instruction.
 	 */
-	while (again) {
+	do {
 		dsb();
 		isb();
 		wfi();
-
-		if (read_isr())
-			again = false;
-	}
+	} while (!read_isr());
 
 	exceptions = may_spin_lock(&cstop_lock);
 
-	if (cstop_enter == STATE_AUTO_CSTOP_ENTRY)
+	if (cstop_enter == STATE_AUTO_CSTOP_ENTRY) {
+		struct itr_chip *itr_chip = interrupt_get_main_chip();
+		size_t other_pos = stm32_get_pos_other();
+
 		interrupt_raise_sgi(itr_chip, GIC_SEC_SGI_6,
 				    TARGET_CPUX_GIC_MASK(other_pos));
+	}
 
 	cstop_cpux_state[pos] = STATE_NONE;
 
@@ -576,30 +574,30 @@ static void stm32_pwr_domain_suspend(unsigned int soc_mode)
 {
 	size_t other_pos = stm32_get_pos_other();
 	uint32_t exceptions = 0;
+	uint32_t scr = 0;
 
 	exceptions = may_spin_lock(&cstop_lock);
-	if ((core_state[other_pos] == CORE_OFF) ||
-	    (cstop_cpux_state[other_pos] == STATE_AUTO_CSTOP_ENTRY)) {
-		uint32_t scr = 0;
+	if (core_state[other_pos] != CORE_OFF &&
+	    cstop_cpux_state[other_pos] != STATE_AUTO_CSTOP_ENTRY) {
+		may_spin_unlock(&cstop_lock, exceptions);
+		return;
+	}
 
-		cstop_enter = STATE_AUTO_CSTOP_ENTRY;
+	cstop_enter = STATE_AUTO_CSTOP_ENTRY;
 
-		may_spin_unlock(&cstop_lock, exceptions);
+	may_spin_unlock(&cstop_lock, exceptions);
 
-		scr = read_scr();
-		write_scr(scr | SCR_IRQ | SCR_FIQ);
+	scr = read_scr();
+	write_scr(scr | SCR_IRQ | SCR_FIQ);
 
-		plat_suspend((uint32_t)soc_mode);
-		interrupt_ack_sgi(interrupt_get_main_chip(),
-				  GIC_SEC_SGI_6,
-				  TARGET_CPUX_GIC_MASK(other_pos));
+	plat_suspend((uint32_t)soc_mode);
+	interrupt_ack_sgi(interrupt_get_main_chip(),
+			  GIC_SEC_SGI_6,
+			  TARGET_CPUX_GIC_MASK(other_pos));
 
-		write_scr(scr);
-		set_locked(&cstop_enter, STATE_NONE);
-		sev();
-	} else {
-		may_spin_unlock(&cstop_lock, exceptions);
-	}
+	write_scr(scr);
+	set_locked(&cstop_enter, STATE_NONE);
+	sev();
 }
 
