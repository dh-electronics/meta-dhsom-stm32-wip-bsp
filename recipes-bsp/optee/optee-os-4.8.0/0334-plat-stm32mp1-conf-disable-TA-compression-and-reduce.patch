From e33df27d88be28b5d80fdfa22e6532730259ed9c Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Fri, 17 Apr 2026 09:19:27 +0200
Subject: [PATCH 334/913] plat-stm32mp1: conf: disable TA compression and
 reduce heap size when pager is on

Disable CFG_EARLY_TA_COMPRESS when CFG_WITH_PAGER is enabled. With this
change, the TAs will not be compressed into the TEE binary. Now, core
heap can be reduced to 48kB and platform can leverage that to assign
more physical pages in the pager pool.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 78dfc6fc0718361cb890c0cc9cc1a3e398a36557 plat-stm32mp1: conf: disable TA compression and reduce heap size when pager is on]
Change-Id: I82d80afe19bd33c4084cfe7255a0b5ff68604c1b
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index c73e81ab7..87203650f 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -436,6 +436,9 @@ CFG_TEE_CORE_DEBUG ?= n
 CFG_UNWIND ?= n
 CFG_LOCKDEP ?= n
 CFG_TA_BGET_TEST ?= n
+# Default disable early TA compression to support a smaller HEAP size
+CFG_EARLY_TA_COMPRESS ?= n
+CFG_CORE_HEAP_SIZE ?= 53248
 endif
 
 # Non-secure UART and GPIO/pinctrl for the output console
