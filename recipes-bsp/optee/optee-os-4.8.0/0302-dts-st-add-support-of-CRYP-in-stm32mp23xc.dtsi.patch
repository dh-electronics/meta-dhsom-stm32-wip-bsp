From 729066db659deee5515ba8c4a1c6a3d82f0998bc Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 13 Apr 2026 17:25:03 +0200
Subject: [PATCH 302/913] dts: st: add support of CRYP in stm32mp23xc.dtsi

Add node cryp1 and cryp2 in stm32mp23xc.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git e47fe3e10a747c07c0888a76d5a40d8644e70567 dts: st: add support of CRYP in stm32mp23xc.dtsi]
Change-Id: I6e0fd7e59f580c379511ca6a2dc4f26ec31be634
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/557099
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/dts/stm32mp23xc.dtsi | 22 ++++++++++++++++++++++
 1 file changed, 22 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp23xc.dtsi b/core/arch/arm/dts/stm32mp23xc.dtsi
index a0887e65f..138c36ca7 100644
--- a/core/arch/arm/dts/stm32mp23xc.dtsi
+++ b/core/arch/arm/dts/stm32mp23xc.dtsi
@@ -3,3 +3,25 @@
  * Copyright (C) 2025, STMicroelectronics - All Rights Reserved
  * Author: Alexandre Torgue <alexandre.torgue@foss.st.com> for STMicroelectronics.
  */
+
+&rifsc {
+	cryp1: cryp@42030000 {
+		compatible = "st,stm32mp1-cryp";
+		reg = <0x42030000 0x400>;
+		interrupts = <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&rcc CK_BUS_CRYP1>;
+		resets = <&rcc CRYP1_R>;
+		access-controllers = <&rifsc STM32MP25_RIFSC_CRYP1_ID>;
+		status = "disabled";
+	};
+
+	cryp2: cryp@42040000 {
+		compatible = "st,stm32mp1-cryp";
+		reg = <0x42040000 0x400>;
+		interrupts = <GIC_SPI 180 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&rcc CK_BUS_CRYP2>;
+		resets = <&rcc CRYP2_R>;
+		access-controllers = <&rifsc STM32MP25_RIFSC_CRYP2_ID>;
+		status = "disabled";
+	};
+};
-- 
2.53.0

