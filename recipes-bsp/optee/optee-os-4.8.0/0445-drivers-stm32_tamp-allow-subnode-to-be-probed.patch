From b28d3401ccdb01b9af39e1b64c7dfc5a9357b134 Mon Sep 17 00:00:00 2001
From: Simeon Marijon <simeon.marijon@foss.st.com>
Date: Wed, 4 Oct 2023 17:53:34 +0200
Subject: [PATCH 445/913] drivers: stm32_tamp: allow subnode to be probed

TAMP peripheral includes a NVMEM block. It will be exposed using NVMEM
framework as a subnode of tamp. Therefore we need to parse all the
children of a "stm32-tamp" compatible node

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 872d9f21fb33aac235f13834517a68e232e04981 drivers: stm32_tamp: allow subnode to be probed]
Change-Id: I57d0ef71d742754c7cfe9bce4b230cd26975d677
Signed-off-by: Simeon Marijon <simeon.marijon@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/328923
Reviewed-by: Simeon MARIJON <simeon.marijon@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Tested-by: Simeon MARIJON <simeon.marijon@st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Domain-Review: Gatien CHEVALLIER <gatien.chevallier@st.com>
---
 core/drivers/stm32_tamp.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/core/drivers/stm32_tamp.c b/core/drivers/stm32_tamp.c
index b5eae1776..98e3a8435 100644
--- a/core/drivers/stm32_tamp.c
+++ b/core/drivers/stm32_tamp.c
@@ -2104,6 +2104,7 @@ static TEE_Result stm32_tamp_probe(const void *fdt, int node,
 	struct itr_chip *chip = NULL;
 	TEE_Result res = TEE_SUCCESS;
 	vaddr_t base = 0;
+	int subnode = -FDT_ERR_NOTFOUND;
 
 	/* Manage dependency on RNG driver */
 	res = dt_driver_get_crypto();
@@ -2196,6 +2197,15 @@ static TEE_Result stm32_tamp_probe(const void *fdt, int node,
 
 	interrupt_enable(chip, it_num);
 
+	fdt_for_each_subnode(subnode, fdt, node) {
+		res = dt_driver_maybe_add_probe_node(fdt, subnode);
+		if (res) {
+			EMSG("Failed on node %s with %#" PRIx32,
+			     fdt_get_name(fdt, subnode, NULL), res);
+			panic();
+		}
+	}
+
 	return TEE_SUCCESS;
 
 err_clk:
-- 
2.53.0

