From 726888f1ff34433a9b25a09c62f4071c8f585362 Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@st.com>
Date: Mon, 11 May 2026 19:54:35 +0200
Subject: [PATCH 847/913] ta: pkcs11: release private resources on logout

Correct release of sessions resources when client logs out.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git cd3f2f5442ddc5e36c3c0fb02b0f04d9e7e4bc1d ta: pkcs11: release private resources on logout]
Fixes: 897357879e4a ("ta: pkcs11: Deal with the private objects in C_Logout")
Change-Id: I0a505abd9ee92ae50f3b443bafbd7ec89c9e2225
Signed-off-by: Etienne Carriere <etienne.carriere@st.com>
Acked-by: Jens Wiklander <jenswi@kernel.org>
(cherry picked from commit 13db1c50a0bb30676f117eaee4f99f889dd983a9)
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/609429
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Tested-by: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Yann GAUTIER <yann.gautier@foss.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 ta/pkcs11/src/pkcs11_token.c | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/ta/pkcs11/src/pkcs11_token.c b/ta/pkcs11/src/pkcs11_token.c
index 23ecbc7c8..bb21c38e0 100644
--- a/ta/pkcs11/src/pkcs11_token.c
+++ b/ta/pkcs11/src/pkcs11_token.c
@@ -1364,7 +1364,7 @@ static void session_logout(struct pkcs11_session *session)
 		if (sess->token != session->token)
 			continue;
 
-		release_active_processing(session);
+		release_active_processing(sess);
 
 		/* Destroy private session objects */
 		LIST_FOREACH_SAFE(obj, &sess->object_list, link, tobj) {
@@ -1377,13 +1377,13 @@ static void session_logout(struct pkcs11_session *session)
 		 * sessions object_handle_db
 		 */
 		LIST_FOREACH(obj, &session->token->object_list, link) {
-			handle = pkcs11_object2handle(obj, session);
+			handle = pkcs11_object2handle(obj, sess);
 
 			if (handle && object_is_private(obj->attributes))
 				handle_put(get_object_handle_db(sess), handle);
 		}
 
-		release_session_find_obj_context(session);
+		release_session_find_obj_context(sess);
 
 		if (pkcs11_session_is_read_write(sess))
 			sess->state = PKCS11_CKS_RW_PUBLIC_SESSION;
-- 
