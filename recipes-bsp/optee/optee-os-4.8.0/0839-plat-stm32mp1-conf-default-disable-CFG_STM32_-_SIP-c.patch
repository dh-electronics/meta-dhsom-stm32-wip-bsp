From 00a8e2454bc64cc24a8003e71fb455d238eace37 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Fri, 17 Jul 2026 11:53:28 +0200
Subject: [PATCH 839/913] plat-stm32mp1: conf: default disable CFG_STM32_*_SIP
 configs

Sets CFG_STM32_LOWPOWER_SIP and CFG_STM32_PWR_SIP disabled by default,
enable it only on boards stm32mp157c-dk2-rcc-scmi.dts with the flavor
MP1-RCC-SCMI.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 699e2cebed3d3546411a1dc16b896e55e9e28802 plat-stm32mp1: conf: default disable CFG_STM32_*_SIP configs]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: Ib2f98a0b2e11e9b2ed4296e4bc60739fae2b4653
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/593264
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index 4d119bbf4..9d6572e54 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -178,9 +178,9 @@ $(call force,CFG_STM32_SAES,n)
 CFG_WITH_SOFTWARE_PRNG ?= y
 endif
 
-ifneq ($(filter $(CFG_EMBED_DTB_SOURCE_FILE),$(flavorlist-MP1-PWR-OSTL)),)
-$(call force,CFG_STM32_LOWPOWER_SIP,n)
-$(call force,CFG_STM32_PWR_SIP,n)
+ifneq ($(filter $(CFG_EMBED_DTB_SOURCE_FILE),$(flavorlist-MP1-RCC-SCMI)),)
+$(call force,CFG_STM32_LOWPOWER_SIP,y)
+$(call force,CFG_STM32_PWR_SIP,y)
 endif
 
 # Force this mode to keep performance on RSA key operations
@@ -411,8 +411,8 @@ $(eval $(call cfg-depends-all,CFG_STM32_IWDG,CFG_WDT_SM_HANDLER CFG_WDT))
 CFG_STM32MP_PANIC_ON_TZC_PERM_VIOLATION ?= y
 
 # SiP/OEM service for non-secure world
-CFG_STM32_LOWPOWER_SIP ?= y
-CFG_STM32_PWR_SIP ?= y
+CFG_STM32_LOWPOWER_SIP ?= n
+CFG_STM32_PWR_SIP ?= n
 
 # Support or not PSCI CPU_SUSPEND command.
 CFG_STM32_PSCI_OSI ?= y
-- 
