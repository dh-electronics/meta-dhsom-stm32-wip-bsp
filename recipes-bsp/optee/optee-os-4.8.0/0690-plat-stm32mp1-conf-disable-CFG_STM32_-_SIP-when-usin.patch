From e5412ff00c8bcf368fa4af42469eabe2ece088a4 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Tue, 5 May 2026 13:50:56 +0200
Subject: [PATCH 690/913] plat-stm32mp1: conf: disable CFG_STM32_*_SIP when
 using OSTL device-tree

On STM32MP15, using theses device-trees means secure the I2C used by the
PMIC. In this configuration the CFG_STM32_LOWPOWER_SIP and
CFG_STM32_PWR_SIP config should be disabled.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git f39f59255c06028ac565d57e2c99d701eb99a845 plat-stm32mp1: conf: disable CFG_STM32_*_SIP when using OSTL device-tree]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: I31a864493228832cd3f8508c41b66afc044e2e2e
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/523088
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index 14cc6cc80..daa2c3b21 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -178,6 +178,11 @@ $(call force,CFG_STM32_SAES,n)
 CFG_WITH_SOFTWARE_PRNG ?= y
 endif
 
+ifneq ($(filter $(CFG_EMBED_DTB_SOURCE_FILE),$(flavorlist-MP1-PWR-OSTL)),)
+$(call force,CFG_STM32_LOWPOWER_SIP,n)
+$(call force,CFG_STM32_PWR_SIP,n)
+endif
+
 # Force this mode to keep performance on RSA key operations
 CFG_CORE_UNSAFE_MODEXP ?= y
 
-- 
2.53.0

