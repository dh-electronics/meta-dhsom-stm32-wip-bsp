From f4fec4c261d45c9bf32f2afcfcf5a40deda53235 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 20 May 2026 14:25:15 +0200
Subject: [PATCH 504/913] dts: stm32: add CPU OPP description in STPM32P21

Add the description for CPU operating points for STM32MP21 family.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 81f86fb5e231325843ea13f7f25e9df49573f9e0 dts: stm32: add CPU OPP description in STPM32P21]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I0cf762ec79383431e9a9a10e53d5d0cbbc5a3545
---
 core/arch/arm/dts/stm32mp211.dtsi | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index 97baab505..451fd3f2c 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -25,6 +25,25 @@
 			device_type = "cpu";
 			reg = <0>;
 			enable-method = "psci";
+			operating-points-v2 = <&cpu0_opp_table>;
+			clocks = <&rcc CK_CPU1>;
+		};
+	};
+
+	cpu0_opp_table: cpu0-opp-table {
+		compatible = "operating-points-v2";
+
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <800000>;
+			opp-supported-hw = <0x3>;
+			st,opp-default;
+		};
+
+		opp-1500000000 {
+			opp-hz = /bits/ 64 <1500000000>;
+			opp-microvolt = <910000>;
+			opp-supported-hw = <0x2>;
 		};
 	};
 
-- 
2.53.0

