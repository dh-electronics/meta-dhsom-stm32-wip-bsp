From 9a161bc016a3831dc17732250850aa89471c3c1e Mon Sep 17 00:00:00 2001
From: Pascal Paillet <p.paillet@st.com>
Date: Wed, 3 Apr 2024 14:39:21 +0200
Subject: [PATCH 508/913] dts: stm32: describe opp configuration for STM32MP2
 boards

Describe OPP configuration in the board device trees for STM32MP21,
STM32MP23 and STM32MP25 family:
- the CPU clock configuration (PLL1) and CPU supply
- the GPU clock configuration (PLL3) when supported

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git aee9703169883248f9ef3d90beb64b406cc091ee dts: stm32: describe opp configuration for STM32MP2 boards]
Signed-off-by: Pascal Paillet <p.paillet@st.com>
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I1957d4513837eae8d720049006ff7ecc60ebda79
---
 core/arch/arm/dts/stm32mp215f-dk.dts  | 14 +++++++-----
 core/arch/arm/dts/stm32mp235f-dk.dts  | 27 ++++++++++++++++++++++
 core/arch/arm/dts/stm32mp257f-dk.dts  | 32 +++++++++++++++++++++++++++
 core/arch/arm/dts/stm32mp257f-ev1.dts | 32 +++++++++++++++++++++++++++
 4 files changed, 99 insertions(+), 6 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp215f-dk.dts b/core/arch/arm/dts/stm32mp215f-dk.dts
index 61ff1268f..6e7620e49 100644
--- a/core/arch/arm/dts/stm32mp215f-dk.dts
+++ b/core/arch/arm/dts/stm32mp215f-dk.dts
@@ -44,6 +44,10 @@
 	};
 };
 
+&cpu0 {
+	cpu-supply = <&vddcpu>;
+};
+
 &hash1 {
 	status = "okay";
 };
@@ -320,15 +324,13 @@
 	st,clk_opp {
 		st,ck_cpu1 {
 			cfg_1 {
-				hz = <1500000000>;
-				st,clksrc = <0>;
-				st,pll = <&pll1_cfg_1500MHz>;
+				hz = <1200000000>;
+				st,pll = <&pll1_cfg_1200MHz>;
 			};
 
 			cfg_2 {
-				hz = <1200000000>;
-				st,clksrc = <0>;
-				st,pll = <&pll1_cfg_1200MHz>;
+				hz = <1500000000>;
+				st,pll = <&pll1_cfg_1500MHz>;
 			};
 		};
 	};
diff --git a/core/arch/arm/dts/stm32mp235f-dk.dts b/core/arch/arm/dts/stm32mp235f-dk.dts
index efb22196d..6d1d8d74a 100644
--- a/core/arch/arm/dts/stm32mp235f-dk.dts
+++ b/core/arch/arm/dts/stm32mp235f-dk.dts
@@ -45,6 +45,10 @@
 	};
 };
 
+&cpu0 {
+	cpu-supply = <&vddcpu>;
+};
+
 &hash {
 	status = "okay";
 };
@@ -407,6 +411,29 @@
 	};
 };
 
+&rcc {
+	st,c1msrd = <2>;
+	st,clk_opp {
+		st,ck_cpu1 {
+			cfg_1 {
+				hz = <1200000000>;
+				st,pll = <&pll1_cfg_1200Mhz>;
+			};
+
+			cfg_2 {
+				hz = <1500000000>;
+				st,pll = <&pll1_cfg_1500Mhz>;
+			};
+		};
+		st,ck_gpu {
+			cfg_1 {
+				hz = <400000000>;
+				st,pll = <&pll3_cfg_400Mhz>;
+			};
+		};
+	};
+};
+
 &risaf2 {
 	status = "okay";
 };
