From a0db17faf3532638135b09de63c05728a4379880 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 8 Apr 2026 13:29:50 +0200
Subject: [PATCH 284/913] core: arm: psci: define psci_set_system_suspend_mode
 weak function temporary

Implement support of psci_set_system_suspend_mode function temporary to
enable the boot of the board stm32mp1*-ostl.dts from the external device
tree.
The implementation of the function should be moved in the platform
driver later.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git ea048e5731b681adf07128c16eee3e162ea6940a core: arm: psci: define psci_set_system_suspend_mode weak function temporary]
Change-Id: If0ddc2c29801a14e97e47c82237379ef0b1a9e2a
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/sm/psci.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/core/arch/arm/sm/psci.c b/core/arch/arm/sm/psci.c
index aff45bf1d..01228bd09 100644
--- a/core/arch/arm/sm/psci.c
+++ b/core/arch/arm/sm/psci.c
@@ -120,7 +120,12 @@ __weak int psci_node_hw_state(uint32_t cpu_id __unused,
 
 __weak int psci_set_system_suspend_mode(uint32_t mode __unused)
 {
-	return PSCI_RET_NOT_SUPPORTED;
+	switch (mode) {
+	case PSCI_SUSPEND_MODE_PLATFORM_COORDINATED:
+		return PSCI_RET_SUCCESS;
+	default:
+		return PSCI_RET_INVALID_PARAMETERS;
+	}
 }
 
 __weak int psci_system_suspend(uintptr_t entry __unused,
