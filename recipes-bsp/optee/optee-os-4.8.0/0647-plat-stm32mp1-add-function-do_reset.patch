From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Tue, 5 May 2026 10:55:56 +0200
Subject: [PATCH 647/913] plat-stm32mp1: add function do_reset()

Add a new helper function do_reset() to handle the system reset
without dependency with PSCI function.

This patch is a preliminary step for STM32MP25 introduction.

The function do_reset() stops the secondary core and flush the
console before to execute the RCC function stm32_reset_system()
to execute the system reset.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 863509a16895849d7c8f7bf42a277713d7bce2f2 plat-stm32mp1: add function do_reset()]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Signed-off-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Change-Id: I8897749591a45a3139414945df85bb13591922a6
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/349361
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/main.c | 34 +++++++++++++++++++-----------
 1 file changed, 22 insertions(+), 12 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/main.c b/core/arch/arm/plat-stm32mp1/main.c
index 219b2b1a0..3fed36474 100644
--- a/core/arch/arm/plat-stm32mp1/main.c
+++ b/core/arch/arm/plat-stm32mp1/main.c
@@ -25,6 +25,7 @@
 #endif
 #include <io.h>
 #include <kernel/boot.h>
+#include <kernel/delay.h>
 #include <kernel/dt.h>
 #include <kernel/dt_driver.h>
 #include <kernel/misc.h>
@@ -716,27 +717,36 @@ bool stm32mp_supports_second_core(void)
 	}
 }
 
+#define ARM_CNTXCTL_IMASK	BIT(1)
+
+static void stm32mp_mask_timer(void)
+{
+	/* Mask timer interrupts */
+	write_cntp_ctl(read_cntp_ctl() | ARM_CNTXCTL_IMASK);
+	write_cntv_ctl(read_cntv_ctl() | ARM_CNTXCTL_IMASK);
+}
+
 void __noreturn do_reset(const char *str __maybe_unused)
 {
-	struct rstctrl *rstctrl = NULL;
+	stm32mp_mask_timer();
+
+	if (stm32mp_supports_second_core()) {
+		uint32_t target_mask = 0;
+
+		if (get_core_pos() == 0)
+			target_mask = TARGET_CPU1_GIC_MASK;
+		else
+			target_mask = TARGET_CPU0_GIC_MASK;
 
-	if (CFG_TEE_CORE_NB_CORE > 1) {
-		/* Halt execution of other CPUs */
 		interrupt_raise_sgi(interrupt_get_main_chip(),
-				    CFG_HALT_CORES_SGI,
-				    ITR_CPU_MASK_TO_OTHER_CPUS);
+				    CFG_HALT_CORES_SGI, target_mask);
+		/* wait than other core is halted */
 		mdelay(1);
 	}
-
 	IMSG("Forced system reset %s", str);
 	console_flush();
-
-	/* Request system reset to RCC driver */
-	rstctrl = stm32mp_rcc_reset_id_to_rstctrl(MPSYST_R);
-	rstctrl_assert(rstctrl);
+	stm32_reset_system();
 	udelay(100);
-
-	/* Cannot occur */
 	panic();
 }
 
