From 8bb65d39a1f5a51f5eb151fad4f6d57d2f627a7c Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 25 Mar 2026 17:01:28 +0100
Subject: [PATCH 633/913] plat-stm32mp1: stpmic1: alloc the LP configuration
 only if supported regulator

When stpmic1_regu_has_lp_cfg return a error, the regulator have
no lp registers so it is no required to allocate the associated
struct regu_lp_config or to parse the regulator node.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 80f6a2daa75693f1da1fcdc71d86e99037c3b8ee plat-stm32mp1: stpmic1: alloc the LP configuration only if supported regulator]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: Ie9e038e2db18fe185543c5191b4d1e276c211612
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/550697
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 .../plat-stm32mp1/drivers/stm32mp1_stpmic1.c  | 24 ++++++++++---------
 1 file changed, 13 insertions(+), 11 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c b/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c
index 7dddbcaa2..f7c8dad32 100644
--- a/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c
+++ b/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c
@@ -157,6 +157,9 @@ static void dt_get_regu_low_power_config(const void *fdt, const char *regu_name,
 	if (!lp_name)
 		return;
 
+	if (!stpmic1_regu_has_lp_cfg(regu_name))
+		return;
+
 	state = &regu_lp_state[lp_state - STM32_PM_DEFAULT];
 	state->cfg_count++;
 	state->cfg = realloc(state->cfg,
@@ -168,19 +171,18 @@ static void dt_get_regu_low_power_config(const void *fdt, const char *regu_name,
 
 	memset(regu_cfg, 0, sizeof(*regu_cfg));
 
-	if (stpmic1_regu_has_lp_cfg(regu_name)) {
-		if (stpmic1_lp_cfg(regu_name, &regu_cfg->cfg)) {
-			DMSG("Cannot setup low power for regu %s", regu_name);
-			panic();
-		}
-		/*
-		 * Always copy active configuration (Control register)
-		 * to PWRCTRL Control register, even if regu_state_node
-		 * does not exist.
-		 */
-		regu_cfg->flags |= REGU_LP_FLAG_LOAD_PWRCTRL;
+	if (stpmic1_lp_cfg(regu_name, &regu_cfg->cfg)) {
+		EMSG("Cannot setup low power for regu %s", regu_name);
+		panic();
 	}
 
+	/*
+	 * Always copy active configuration (Control register)
+	 * to PWRCTRL Control register, even if regu_state_node
+	 * does not exist.
+	 */
+	regu_cfg->flags |= REGU_LP_FLAG_LOAD_PWRCTRL;
+
 	/* Parse regulator stte node if any */
 	regu_state_node = fdt_subnode_offset(fdt, regu_node, lp_name);
 	if (regu_state_node <= 0)
-- 
2.53.0

