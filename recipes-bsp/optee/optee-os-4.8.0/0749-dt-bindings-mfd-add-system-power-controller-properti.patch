From a8dc974dc9180d9b03117117a30c89262bd41757 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Tue, 23 Jun 2026 11:34:46 +0200
Subject: [PATCH 749/913] dt-bindings: mfd: add system-power-controller
 properties for stpmic

This property indicates that STPMIC is the power supply master of the
system. When present in the OP-TEE device tree, the PMIC driver
performs on system shutdown request a STPMIC software switch off
sequence.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 6cf42c3738a0f78cb0163017df57b2676a8995aa dt-bindings: mfd: add system-power-controller properties for stpmic]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I71c0d6eed50656a4383bfb438e08fd6acb631e00
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/581301
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 documentation/devicetree/bindings/mfd/st,stpmic1.yaml | 6 ++++++
 documentation/devicetree/bindings/mfd/st,stpmic2.yaml | 6 ++++++
 2 files changed, 12 insertions(+)

diff --git a/documentation/devicetree/bindings/mfd/st,stpmic1.yaml b/documentation/devicetree/bindings/mfd/st,stpmic1.yaml
index 2a791aa44..4bd7b51ca 100644
--- a/documentation/devicetree/bindings/mfd/st,stpmic1.yaml
+++ b/documentation/devicetree/bindings/mfd/st,stpmic1.yaml
@@ -26,6 +26,12 @@ properties:
 
   interrupt-controller: true
 
+  system-power-controller:
+    type: boolean
+    description: This indicates that STPMIC is the power supply master of the
+      system. With this flag, the driver will initiate an software switch OFF
+      for system poweroff.
+
   onkey:
     type: object
 
diff --git a/documentation/devicetree/bindings/mfd/st,stpmic2.yaml b/documentation/devicetree/bindings/mfd/st,stpmic2.yaml
index b13668334..a8e723d4a 100644
--- a/documentation/devicetree/bindings/mfd/st,stpmic2.yaml
+++ b/documentation/devicetree/bindings/mfd/st,stpmic2.yaml
@@ -31,6 +31,12 @@ properties:
   interrupts:
     maxItems: 1
 
+  system-power-controller:
+    type: boolean
+    description: This indicates that STPMIC is the power supply master of the
+      system. With this flag, the driver will initiate an software switch OFF
+      for system poweroff.
+
   st,pmic-it-id:
     description: PMIC interruptions ids to forward to the non-secure world
       in the form of OPTEE notifications described by st,notif-it-id.
