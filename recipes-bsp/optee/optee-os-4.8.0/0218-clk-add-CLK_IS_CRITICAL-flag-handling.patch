From d3b81de5153bf24ef0583a64f7794957a48a0ff3 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Fri, 6 Mar 2026 13:27:02 +0100
Subject: [PATCH 218/913] clk: add CLK_IS_CRITICAL flag handling

The CLK_IS_CRITICAL flag determines whether a clock is critical.
Critical clocks are enabled at boot and must never be disabled.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 6dbd28721d2a4fd06e33e6d088fbbf3c0b92f46b clk: add CLK_IS_CRITICAL flag handling]
Change-Id: I3749f212d478d46e8c72d9428dfb58e0d3a78419
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/545785
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/drivers/clk/clk.c     | 5 +++++
 core/include/drivers/clk.h | 1 +
 2 files changed, 6 insertions(+)

diff --git a/core/drivers/clk/clk.c b/core/drivers/clk/clk.c
index 39b2c1926..6289b3071 100644
--- a/core/drivers/clk/clk.c
+++ b/core/drivers/clk/clk.c
@@ -166,6 +166,11 @@ static void clk_disable_no_lock(struct clk *clk)
 	if (!refcount_dec(&clk->enabled_count))
 		return;
 
+	if (clk->flags & CLK_IS_CRITICAL) {
+		EMSG("Attempt to disable critical clock %s", clk->name);
+		return;
+	}
+
 	if (clk->ops->disable)
 		clk->ops->disable(clk);
 
diff --git a/core/include/drivers/clk.h b/core/include/drivers/clk.h
index e5a86bf2a..fc0d88ed7 100644
--- a/core/include/drivers/clk.h
+++ b/core/include/drivers/clk.h
@@ -18,6 +18,7 @@
 #define CLK_SET_RATE_PARENT	BIT(3) /* propagate rate change up to parent */
 #define CLK_SET_RATE_UNGATE	BIT(4) /* clock needs to run to set rate */
 #define CLK_SET_PARENT_PRE_ENABLE	BIT(5) /* enable new parent if needed */
+#define CLK_IS_CRITICAL		BIT(6) /* critical clock, do not gate, ever */
 
 /**
  * struct clk - Clock structure
-- 
2.53.0

