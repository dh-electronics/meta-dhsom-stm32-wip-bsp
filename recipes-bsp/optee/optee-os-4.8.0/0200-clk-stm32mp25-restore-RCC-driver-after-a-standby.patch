@@ -256,6 +259,18 @@ extern const struct clk_ops clk_stm32_composite_ops;
 		.parents = _parents,\
 	}
 
+#define STM32_GATE_PM(_name, _parent, _flags, _gate_id)\
+	struct clk _name = {\
+		.ops = &clk_stm32_gate_pm_ops,\
+		.priv = &(struct clk_stm32_gate_cfg) {\
