From 885f159793b0a66015c3d8d4638c83d6f30909ff Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Mon, 23 Mar 2026 17:13:24 +0100
Subject: [PATCH 200/913] clk: stm32mp25: restore RCC driver after a standby

After a standby we have to restore the clock device tree and restore
all clocks using clock framework.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 627b0e29f541bb2f361288c86db265a8c3017f06 clk: stm32mp25: restore RCC driver after a standby]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: Id274a3f23ee89f547a2cf34897410fa89ad20a9c
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/326482
---
 core/drivers/clk/clk-stm32-core.c |  17 ++-
 core/drivers/clk/clk-stm32-core.h |  15 +++
 core/drivers/clk/clk-stm32mp21.c  | 172 +++++++++++++++++++++++++++
 core/drivers/clk/clk-stm32mp25.c  | 185 +++++++++++++++++++++++++++++-
 4 files changed, 386 insertions(+), 3 deletions(-)

diff --git a/core/drivers/clk/clk-stm32-core.c b/core/drivers/clk/clk-stm32-core.c
index 684773310..955616e94 100644
--- a/core/drivers/clk/clk-stm32-core.c
+++ b/core/drivers/clk/clk-stm32-core.c
@@ -62,7 +62,7 @@ TEE_Result stm32_mux_set_parent(uint16_t mux_id, uint8_t sel)
 }
 
 /* STM32 GATE API */
-static void stm32_gate_endisable(uint16_t gate_id, bool enable)
+void stm32_gate_endisable(uint16_t gate_id, bool enable)
 {
 	struct clk_stm32_priv *priv = clk_stm32_get_priv();
 	const struct gate_cfg *gate = &priv->gates[gate_id];
@@ -398,6 +398,21 @@ const struct clk_ops clk_stm32_gate_ops = {
 	.is_enabled	= clk_stm32_gate_is_enabled,
 };
 
+static void clk_stm32_gate_pm_restore(struct clk *clk)
+{
+	struct clk_stm32_gate_cfg *cfg = clk->priv;
+
+	if (clk_is_enabled(clk))
+		stm32_gate_endisable(cfg->gate_id, true);
+}
+
+const struct clk_ops clk_stm32_gate_pm_ops = {
+	.enable		= clk_stm32_gate_enable,
+	.disable	= clk_stm32_gate_disable,
+	.is_enabled	= clk_stm32_gate_is_enabled,
+	.restore_context = clk_stm32_gate_pm_restore,
+};
+
 static TEE_Result clk_stm32_gate_ready_enable(struct clk *clk)
 {
 	struct clk_stm32_gate_cfg *cfg = clk->priv;
