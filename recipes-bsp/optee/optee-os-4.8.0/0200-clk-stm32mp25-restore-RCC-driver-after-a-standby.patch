+static void __maybe_unused clk_stm32_osc_msi_pm_restore(struct clk *clk)
+{
+	if (!stm32_rcc_has_access_by_id(RCC_RIF_OSCILLATORS))
+		return;
+
+	if (clk_is_enabled(clk) && clk_stm32_osc_enable(clk))
+		panic();
+}
+
