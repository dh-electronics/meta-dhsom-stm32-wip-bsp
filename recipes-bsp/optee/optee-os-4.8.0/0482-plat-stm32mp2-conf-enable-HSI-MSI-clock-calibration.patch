From ff22f18c62d750ec78d14e6ae751e3382ba3ab97 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 21 May 2026 09:24:30 +0200
Subject: [PATCH 482/913] plat-stm32mp2: conf: enable HSI/MSI clock calibration

Enable HSI and MSI clock calibration in the STM32MP1 platform
configuration to improve internal oscillator accuracy.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 748676d04e49784bd1756cee2bce575dc75da7e7 plat-stm32mp2: conf: enable HSI/MSI clock calibration]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I814fa5fc8c1b387f9065e3572df529e25c965c6c
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570767
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp2/conf.mk | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index 5f8e520d5..5b1a9d6f2 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -95,6 +95,7 @@ $(call force,CFG_STM32_PWR_REGUL,n)
 $(call force,CFG_STM32_TAMP,n)
 $(call force,CFG_STM32MP_PROVISIONING,n)
 $(call force,CFG_TA_STM32MP_NVMEM,n)
+$(call force,CFG_STM32MP2_CLK_CAL,n)
 $(call force,CFG_STM32_PSA_SERVICE,y)
 $(call force,CFG_STM32_DEBUG_ACCESS_PTA,n)
 endif
@@ -121,6 +122,12 @@ $(call force,CFG_STM32_STGEN,y)
 $(call force,CFG_STM32_PWR,y)
 CFG_STM32_PWR_REGUL ?= y
 $(call force,CFG_STM32MP_CLK_CORE,y)
+CFG_STM32MP2_CLK_CAL ?= y
+
+ifeq ($(CFG_STM32MP2_CLK_CAL),y)
+$(call force,CFG_STM32_CLKCALIB_PTA,y)
+endif
+
 $(call force,CFG_WITH_ARM_TRUSTED_FW,y)
 $(call force,CFG_WITH_LPAE,y)
 
