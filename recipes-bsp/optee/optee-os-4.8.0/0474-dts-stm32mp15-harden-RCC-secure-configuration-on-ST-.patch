From 8fa5d18dbd914923e00f1715a77619b8d9c1b293 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Fri, 19 Apr 2024 13:42:11 +0200
Subject: [PATCH 474/913] dts: stm32mp15: harden RCC secure configuration on ST
 boards

Enable STM32MP15 RCC secure hardening configuration on ST boards
to assign SoC clocks, reset controllers and PWR regulators to
OP-TEE secure world.

Align internal board to commit 08278885852f ("dts: stm32mp15: harden RCC
secure configuration on ST boards").

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git acba43ac275863e150d2a7b78520e4fe36086bf3 dts: stm32mp15: harden RCC secure configuration on ST boards]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I6c7459ff75db91bdf1a57cbc21311ef10b66d36d
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/569869
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/dts/stm32mp157c-ed1.dts  | 1 -
 core/arch/arm/dts/stm32mp157d-ed1.dts  | 2 ++
 core/arch/arm/dts/stm32mp15xx-dkx.dtsi | 1 -
 3 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp157c-ed1.dts b/core/arch/arm/dts/stm32mp157c-ed1.dts
index 43e345f13..b48111856 100644
--- a/core/arch/arm/dts/stm32mp157c-ed1.dts
+++ b/core/arch/arm/dts/stm32mp157c-ed1.dts
@@ -366,7 +366,6 @@
 
 &rcc {
 	compatible = "st,stm32mp1-rcc-secure";
-	status = "okay";
 
 	st,clksrc = <
 		CLK_MPU_PLL1P
diff --git a/core/arch/arm/dts/stm32mp157d-ed1.dts b/core/arch/arm/dts/stm32mp157d-ed1.dts
index aab872687..5dd2bde69 100644
--- a/core/arch/arm/dts/stm32mp157d-ed1.dts
+++ b/core/arch/arm/dts/stm32mp157d-ed1.dts
@@ -224,6 +224,8 @@
 };
 
 &rcc {
+	compatible = "st,stm32mp1-rcc-secure";
+
 	st,clksrc = <
 		CLK_MPU_PLL1P
 		CLK_AXI_PLL2P
diff --git a/core/arch/arm/dts/stm32mp15xx-dkx.dtsi b/core/arch/arm/dts/stm32mp15xx-dkx.dtsi
index 9368d3ea5..7719d70df 100644
--- a/core/arch/arm/dts/stm32mp15xx-dkx.dtsi
+++ b/core/arch/arm/dts/stm32mp15xx-dkx.dtsi
@@ -503,7 +503,6 @@
 
 &rcc {
 	compatible = "st,stm32mp1-rcc-secure";
-	status = "okay";
 
 	st,clksrc = <
 		CLK_MPU_PLL1P
