From 34daa118ea59c13a8d59a4181839a51dc2e0b16f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Thu, 23 Jul 2026 15:36:25 +0200
Subject: [PATCH 875/913] drivers: stm32_cpu_opp: check bypass parent clock
 before use
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

set_opp() passed clk_get_parent_by_index(cpu_opp.clock, 1) directly to
clk_set_parent() without checking for NULL. When the requested parent
index has no matching parent clock, clk_set_parent() ends up
dereferencing the NULL parent in clk_get_parent_idx()'s error message
path.

Only call clk_set_parent() when a bypass parent clock was found.

Coverity issue: CID 1200576: CERT-C Expression

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 597f2c4e6484f6cee03b6a454540e82b184296c9 drivers: stm32_cpu_opp: check bypass parent clock before use]
Assisted-by: GitHub-Copilot:Claude-Sonnet-5
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Change-Id: Idac31403d5069a65c7dafb7d968617bb3ec1861f
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/592854
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/drivers/stm32_cpu_opp.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/core/drivers/stm32_cpu_opp.c b/core/drivers/stm32_cpu_opp.c
index 385e4368b..02f8ba629 100644
--- a/core/drivers/stm32_cpu_opp.c
+++ b/core/drivers/stm32_cpu_opp.c
@@ -397,6 +397,7 @@ static TEE_Result set_opp(unsigned int opp)
 	unsigned int opp_freq_khz = cpu_opp.dvfs[opp].freq_khz;
 	int opp_volt_uv = cpu_opp.dvfs[opp].volt_uv;
 	int res = TEE_ERROR_GENERIC;
+	struct clk *bypass_parent = NULL;
 
 	if (opp_freq_khz == clk_get_rate(cpu_opp.clock))
 		return TEE_SUCCESS;
@@ -406,8 +407,17 @@ static TEE_Result set_opp(unsigned int opp)
 		overdrive = true;
 
 	/* switch to bypass and disable PLL1 */
-	clk_set_parent(cpu_opp.clock,
-		       clk_get_parent_by_index(cpu_opp.clock, 1));
+	bypass_parent = clk_get_parent_by_index(cpu_opp.clock, 1);
+	if (!bypass_parent) {
+		EMSG("Failed to get bypass clock for OPP %ukHz, %uuV", opp_freq_khz, opp_volt_uv);
+		return res;
+	}
+
+	res = clk_set_parent(cpu_opp.clock, bypass_parent);
+	if (res) {
+		EMSG("Failed to switch to bypass clock for OPP %ukHz, %uuV", opp_freq_khz, opp_volt_uv);
+		return res;
+	}
 
 	/* Change OPP/RM(nominal) when moving OPP Overdrive to Nominal */
 	if (!overdrive)
-- 
