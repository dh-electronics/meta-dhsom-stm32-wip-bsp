From 821ec0b7fad9f526540cc84b598d4c0318d8e8b4 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 27 Apr 2026 15:07:17 +0200
Subject: [PATCH 358/913] plat-stm32mp1: enable CPU opp for STM32MP15

Default enable CFG_STM32_CPU_OPP for stm32mp15.
Since it's already enabled for STM32MP13, move the
activation of the flag in the common part of the
conf.mk

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 3543bcf7b254f9febb1ed8ea11e9d34cbb666bab plat-stm32mp1: enable CPU opp for STM32MP15]
Change-Id: I43e8cf2ab1fb4644ea2a51d11fa3086e193ba752
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index eacd9577c..9786b6b79 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -217,7 +217,6 @@ $(call force,CFG_STM32MP13_CLK,y)
 $(call force,CFG_STM32MP13_REGULATOR_IOD,y)
 $(call force,CFG_TEE_CORE_NB_CORE,1)
 $(call force,CFG_WITH_NSEC_GPIOS,n)
-CFG_STM32_CPU_OPP ?= y
 CFG_STM32MP_OPP_COUNT ?= 3
 # Measured latency on STM32MP13 is around 650uS so set 1mS
 CFG_STM32MP_OPP_LATENCY_US ?= 1000
@@ -302,6 +301,7 @@ endif
 $(call force,CFG_STM32MP1_SCMI_SHM_SIZE,0x1000)
 
 CFG_STM32_BSEC ?= y
+CFG_STM32_CPU_OPP ?= y
 CFG_STM32_CRYP ?= y
 CFG_STM32_ETZPC ?= y
 CFG_STM32_EXTI ?= y
@@ -377,8 +377,6 @@ ifeq ($(CFG_STM32_BSEC_PTA),y)
 $(call force,CFG_STM32_BSEC,y,Required by CFG_STM32_BSEC_PTA)
 endif
 
-# Default disable CPU OPP support
-CFG_STM32_CPU_OPP ?= n
 
 # Force enable SCMI PTA support
 $(call force,CFG_SCMI_PTA,y)
-- 
2.53.0

