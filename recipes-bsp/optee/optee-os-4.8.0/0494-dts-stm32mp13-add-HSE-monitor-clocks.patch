From 40c700252500f0c25fcc668f71f77e5c15665481 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 21 May 2026 10:08:53 +0200
Subject: [PATCH 494/913] dts: stm32mp13: add HSE monitor clocks

Add the HSE and HSI clock phandles to the hse-monitor DT node,
as required by the frequency monitor driver.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 648a29e73cfb2c401f8ab7a016b57585325d209e dts: stm32mp13: add HSE monitor clocks]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I12920053523c4af8d8ab13ce90c89cc9e34a66bd
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570779
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp131.dtsi | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp131.dtsi b/core/arch/arm/dts/stm32mp131.dtsi
index b6eec5515..7f6a5fd27 100644
--- a/core/arch/arm/dts/stm32mp131.dtsi
+++ b/core/arch/arm/dts/stm32mp131.dtsi
@@ -61,6 +61,8 @@
 	hse_monitor: hse-monitor {
 		compatible = "st,freq-monitor";
 		counter = <&lptimer3 1 1 0 0>;
+		clocks = <&rcc CK_HSE>, <&rcc CK_HSI>;
+		clock-names = "hse", "hsi";
 		status = "disabled";
 	};
 
-- 
