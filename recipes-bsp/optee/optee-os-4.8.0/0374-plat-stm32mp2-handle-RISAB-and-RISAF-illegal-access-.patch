From bc2c5c48bee7b2901d293772958e6fa8bcde9266 Mon Sep 17 00:00:00 2001
From: Nicolas Le Bayon <nicolas.le.bayon@foss.st.com>
Date: Tue, 28 Apr 2026 17:19:01 +0200
Subject: [PATCH 374/913] plat-stm32mp2: handle RISAB and RISAF illegal access
 flags

Handle the clearing of the flags in IACR when an illegal access
occurs so that other illegal accesses can be collected.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 87c78316730089342f1961db1bd48b4dc8fd0c0e plat-stm32mp2: handle RISAB and RISAF illegal access flags]
Signed-off-by: Nicolas Le Bayon <nicolas.le.bayon@foss.st.com>
Change-Id: Ib95bb4eaf445c78859016b9563c69050871e5205
---
 core/arch/arm/plat-stm32mp2/main.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/main.c b/core/arch/arm/plat-stm32mp2/main.c
index ec7633341..3ee45aa22 100644
--- a/core/arch/arm/plat-stm32mp2/main.c
+++ b/core/arch/arm/plat-stm32mp2/main.c
@@ -9,6 +9,8 @@
 #include <drivers/stm32_bsec.h>
 #include <drivers/rstctrl.h>
 #include <drivers/stm32_rif.h>
+#include <drivers/stm32_risab.h>
+#include <drivers/stm32_risaf.h>
 #include <drivers/stm32_serc.h>
 #include <drivers/stm32_uart.h>
 #include <drivers/stm32mp_dt_bindings.h>
@@ -139,6 +141,14 @@ void boot_secondary_init_intc(void)
 #ifdef CFG_STM32_RIF
 void stm32_rif_access_violation_action(void)
 {
+#ifdef CFG_STM32_RISAF
+	stm32_risaf_print_erroneous_data();
+	stm32_risaf_clear_illegal_access_flags();
+#endif
+#ifdef CFG_STM32_RISAB
+	stm32_risab_print_erroneous_data();
+	stm32_risab_clear_illegal_access_flags();
+#endif
 }
 #endif /* CFG_STM32_RIF */
 
