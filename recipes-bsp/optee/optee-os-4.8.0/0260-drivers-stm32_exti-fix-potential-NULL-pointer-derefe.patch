From 125864922e334e7c3e3f3b28a00c39112970d1c8 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Wed, 25 Jun 2025 15:06:42 +0200
Subject: [PATCH 260/913] drivers: stm32_exti: fix potential NULL pointer
 dereference

When OP-TEE is executed with M33-TD flavor, the RIF EXTI configuration
is set by Cortex-M33.
In such case the DT of the EXTI controller might not contains the
properties st,glocked and st,protreg

Always allocate the arrays e_cids and c_cids also when the DT has
no RIF properties, as they are used during suspend/resume.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git c5d7ff00e6fcb39f6c1be42565b38e23f80c2015 drivers: stm32_exti: fix potential NULL pointer dereference]
Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: I3e47df042af06d7f62e331b28e87bb97e711bac5
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/470130
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 core/drivers/stm32_exti.c | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/core/drivers/stm32_exti.c b/core/drivers/stm32_exti.c
index d4fae1f32..454a5386b 100644
--- a/core/drivers/stm32_exti.c
+++ b/core/drivers/stm32_exti.c
@@ -412,6 +412,11 @@ static void stm32_exti_rif_parse_dt(struct stm32_exti_pdata *exti,
 	unsigned int i = 0;
 	int len = 0;
 
+	exti->e_cids = calloc(stm32_exti_nbevents(exti), sizeof(uint32_t));
+	exti->c_cids = calloc(stm32_exti_nbcpus(exti), sizeof(uint32_t));
+	if (!exti->e_cids || !exti->c_cids)
+		panic("Out of memory");
+
 	if (fdt_getprop(fdt, node, "st,glocked", NULL))
 		exti->glock = true;
 	else
@@ -423,11 +428,6 @@ static void stm32_exti_rif_parse_dt(struct stm32_exti_pdata *exti,
 		return;
 	}
 
-	exti->e_cids = calloc(stm32_exti_nbevents(exti), sizeof(uint32_t));
-	exti->c_cids = calloc(stm32_exti_nbcpus(exti), sizeof(uint32_t));
-	if (!exti->e_cids || !exti->c_cids)
-		panic("Out of memory");
-
 	conf_data.cid_confs   = exti->e_cids;
 	conf_data.sec_conf    = exti->seccfgr_cache;
 	conf_data.priv_conf   = exti->privcfgr_cache;
-- 
