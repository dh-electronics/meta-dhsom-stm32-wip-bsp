From 3ce3c3963057f47fe6e708d038d8d9228c71ffc6 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Wed, 25 Jun 2025 14:51:18 +0200
Subject: [PATCH 259/913] drivers: stm32_exti: fix check access with RIF for
 M33TD

When OP-TEE is executed on M33-TD flavor, the RIF EXTI configuration is
set by Cortex-M33. The device tree of OP-TEE does not contains the RIF EXTI config.

Fix the access control by reading the values already in the EXTI
registers, instead of using the possibly incomplete values read
from the DT.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 61c78bb13406698c62ac1e3a9d78f6c5023d44f9 drivers: stm32_exti: fix check access with RIF for M33TD]
Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: Ia68ed631a47b1633f6c15eaa1d194183ba60e0ea
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/470128
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/drivers/stm32_exti.c | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/core/drivers/stm32_exti.c b/core/drivers/stm32_exti.c
index 6a68325a9..d4fae1f32 100644
--- a/core/drivers/stm32_exti.c
+++ b/core/drivers/stm32_exti.c
@@ -387,14 +387,16 @@ static TEE_Result stm32_exti_rif_check_access(struct stm32_exti_pdata *exti,
 {
 	unsigned int i = stm32_exti_get_bank(exti_line);
 	uint32_t mask = BIT(exti_line % _EXTI_LINES_PER_BANK);
+	uint32_t privcfgr = io_read32(exti->base + _EXTI_PRIVCFGR(i));
+	uint32_t seccfgr = io_read32(exti->base + _EXTI_SECCFGR(i));
+	uint32_t e_cids = io_read32(exti->base + _EXTI_EnCIDCFGR(exti_line));
 
 	/* only configured as secure and privileged */
-	if (!((exti->seccfgr_cache[i] & exti->privcfgr_cache[i] &
-	       exti->access_mask[i]) & mask))
+	if (!(seccfgr & privcfgr & mask))
 		return TEE_ERROR_ACCESS_DENIED;
 
-	if ((exti->e_cids[exti_line] & _EXTI_CIDCFGR_CFEN) &&
-	    ((exti->e_cids[exti_line] & _EXTI_CIDCFGR_SCID_MASK) !=
+	if ((e_cids & _EXTI_CIDCFGR_CFEN) &&
+	    ((e_cids & _EXTI_CIDCFGR_SCID_MASK) !=
 	     SHIFT_U32(_EXTI_CID1, _EXTI_CIDCFGR_SCID_SHIFT)))
 		return TEE_ERROR_ACCESS_DENIED;
 
