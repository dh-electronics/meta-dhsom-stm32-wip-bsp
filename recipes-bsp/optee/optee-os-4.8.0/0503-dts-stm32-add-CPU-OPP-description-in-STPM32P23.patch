From 86f257b16c9c262f64758f30c91c621526d5fdcc Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 20 May 2026 14:31:53 +0200
Subject: [PATCH 503/913] dts: stm32: add CPU OPP description in STPM32P23

Add the description for CPU operating points for STM32MP23 family.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 6a6d508b38feb5c719b76af255bb3f1d71e0d445 dts: stm32: add CPU OPP description in STPM32P23]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: Ia22371267eeedc952b2f359a0e67fd6040a1af90
---
 core/arch/arm/dts/stm32mp231.dtsi | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp231.dtsi b/core/arch/arm/dts/stm32mp231.dtsi
index 9fae969bd..efcfa0fa4 100644
--- a/core/arch/arm/dts/stm32mp231.dtsi
+++ b/core/arch/arm/dts/stm32mp231.dtsi
@@ -25,6 +25,25 @@
 			device_type = "cpu";
 			reg = <0>;
 			enable-method = "psci";
+			operating-points-v2 = <&cpu0_opp_table>;
+			clocks = <&rcc CK_CPU1>;
+		};
+	};
+
+	cpu0_opp_table: cpu0-opp-table {
+		compatible = "operating-points-v2";
+
+		opp-1200000000 {
+			opp-hz = /bits/ 64 <1200000000>;
+			opp-microvolt = <800000>;
+			opp-supported-hw = <0x3>;
+			st,opp-default;
+		};
+
+		opp-1500000000 {
+			opp-hz = /bits/ 64 <1500000000>;
+			opp-microvolt = <910000>;
+			opp-supported-hw = <0x2>;
 		};
 	};
 
-- 
