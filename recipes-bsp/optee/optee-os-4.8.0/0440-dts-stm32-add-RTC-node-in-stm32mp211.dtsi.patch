From f98deeaa80d2801243950fa3d36a33caa1c8a8f0 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Thu, 21 May 2026 16:16:27 +0200
Subject: [PATCH 440/913] dts: stm32: add RTC node in stm32mp211.dtsi

Add the node of the RTC device

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 5e3fec054ee737d6ea2f43f4cccf629dfb31152b dts: stm32: add RTC node in stm32mp211.dtsi]
Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: I419f4053bba762a51abcfe65cb8d7044fd1b71dd
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570358
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/dts/stm32mp211.dtsi | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index 34a5a20ee..3d171669b 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -946,6 +946,15 @@
 				<&intc GIC_SPI 204 IRQ_TYPE_LEVEL_HIGH>;
 		};
 
+		rtc: rtc@46000000 {
+			compatible = "st,stm32mp25-rtc";
+			reg = <0x46000000 0x400>;
+			clocks = <&rcc CK_BUS_RTC>, <&rcc RTC_CK>;
+			clock-names = "pclk", "rtc_ck";
+			wakeup-source;
+			interrupts-extended = <&exti2 22 IRQ_TYPE_EDGE_RISING>;
+		};
+
 		pinctrl_z: pinctrl@46200000 {
 			#address-cells = <1>;
 			#size-cells = <1>;
-- 
2.53.0

