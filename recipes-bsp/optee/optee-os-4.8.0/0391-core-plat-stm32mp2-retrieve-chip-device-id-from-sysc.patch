From 238fd8709ae41c0e84ca81edaf9722f61b42fbba Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Fri, 31 Jan 2025 11:22:28 +0100
Subject: [PATCH 391/913] core: plat-stm32mp2: retrieve chip device id from
 syscfg for STM32MP2

Chip ID is read from SYSCFG. Add the associated read function
stm32mp_syscfg_get_chip_dev_id() the same way it is already defined for
STM32MP1.

Use the chip device id for authenticated debug certificate validation.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 1c3e0afb1b9f14f06500efe35590378bfd55428c core: plat-stm32mp2: retrieve chip device id from syscfg for STM32MP2]
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Change-Id: Id0b94ce53f5dd687813eb015038ff275fb639837
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/433592
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 .../arm/plat-stm32mp2/drivers/stm32mp25_syscfg.c     | 12 ++++++++++++
 core/arch/arm/plat-stm32mp2/stm32_util.h             |  2 ++
 2 files changed, 14 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/drivers/stm32mp25_syscfg.c b/core/arch/arm/plat-stm32mp2/drivers/stm32mp25_syscfg.c
index 612dd75f2..ded9549e5 100644
--- a/core/arch/arm/plat-stm32mp2/drivers/stm32mp25_syscfg.c
+++ b/core/arch/arm/plat-stm32mp2/drivers/stm32mp25_syscfg.c
@@ -10,6 +10,7 @@
 #include <kernel/panic.h>
 #include <mm/core_memprot.h>
 #include <stm32_sysconf.h>
+#include <stm32_util.h>
 #include <trace.h>
 #include <types_ext.h>
 #include <util.h>
@@ -54,6 +55,10 @@ struct io_pa_va syscfg_base[SYSCON_NB_BANKS] = {
 
 #define SYSCFG_CCSR_READY_TIMEOUT_US		U(1000)
 
+/* SYSCFG device ID register definition */
+#define SYSCFG_IDC			SYSCON_ID(SYSCON_SYSCFG, 0x6400U)
+#define SYSCFG_IDC_DEV_ID_MASK		GENMASK_32(11, 0)
+
 /*
  * SYSCFG IO compensation register offsets (base relative)
  */
@@ -212,3 +217,10 @@ void stm32mp25_syscfg_set_amcr(size_t mm1_size, size_t mm2_size)
 
 	io_clrsetbits32(amcr_addr, SYSCFG_OCTOSPIAMCR_OAM_MASK, amcr);
 }
+
+uint32_t stm32mp_syscfg_get_chip_dev_id(void)
+{
+	vaddr_t addr = stm32mp_syscfg_base(SYSCON_SYSCFG) + SYSCFG_IDC;
+
+	return io_read32(addr) & SYSCFG_IDC_DEV_ID_MASK;
+}
diff --git a/core/arch/arm/plat-stm32mp2/stm32_util.h b/core/arch/arm/plat-stm32mp2/stm32_util.h
index 7306f2401..d5380e308 100644
--- a/core/arch/arm/plat-stm32mp2/stm32_util.h
+++ b/core/arch/arm/plat-stm32mp2/stm32_util.h
@@ -28,4 +28,6 @@ static inline bool stm32_stpmic2_is_present(void)
 	return false;
 }
 #endif
+/* Get device ID from SYSCFG registers */
+uint32_t stm32mp_syscfg_get_chip_dev_id(void);
 #endif /*__STM32_UTIL_H__*/
-- 
2.53.0

