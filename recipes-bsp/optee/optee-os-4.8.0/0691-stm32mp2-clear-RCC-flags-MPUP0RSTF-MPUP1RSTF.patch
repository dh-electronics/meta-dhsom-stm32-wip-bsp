From fa16ee4cc1db695aa93f2bc14eccafac68bc9790 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Tue, 5 May 2026 13:52:22 +0200
Subject: [PATCH 691/913] stm32mp2: clear RCC flags MPUP0RSTF/MPUP1RSTF

The RCC flags MPUP0RSTF/MPUP1RSTF are set by the BOOTROM code when a MPU
processor 1 reset occurred and are expected to be cleared by software.

As the Cortex-A7 Core reset is performed for PSCI CPU_ON request, this
flags in RCC_MP_RSTSCLRR is always equal to 1 when the secondary core
of STM32MP15 is stopped/started by Linux kernel, for example after low
power mode sequence.

This patch clears the reset bit in startup function of each core and
before reset of the secondary core to allow detection of an unexpected
reset request.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git e50f1c28e15a493c152f2ab43e3012e945881c58 stm32mp2: clear RCC flags MPUP0RSTF/MPUP1RSTF]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: Ic0c7d2eaa33f965d1a43df118eb7f02ae8948966
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/548743
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/main.c         | 10 +++++++++-
 core/arch/arm/plat-stm32mp1/pm/low_power.c |  2 ++
 core/include/drivers/stm32mp1_rcc.h        |  3 +++
 3 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/core/arch/arm/plat-stm32mp1/main.c b/core/arch/arm/plat-stm32mp1/main.c
index 3fed36474..e1c97f45c 100644
--- a/core/arch/arm/plat-stm32mp1/main.c
+++ b/core/arch/arm/plat-stm32mp1/main.c
@@ -165,16 +165,24 @@ void boot_primary_init_intc(void)
 	gic_init(GIC_BASE + GICC_OFFSET, GIC_BASE + GICD_OFFSET);
 
 	stm32mp_register_online_cpu();
+
+	/* clear reset flag after core 0 power on */
+	io_write32(stm32_rcc_base() + RCC_MP_RSTSCLRR,
+		   RCC_MP_RSTSCLRR_MPUP0RSTF);
 }
 
+#ifdef CFG_STM32MP15
 void boot_secondary_init_intc(void)
 {
 	gic_init_per_cpu();
 
 	stm32mp_register_online_cpu();
+
+	/* clear reset flag after core 1 power on */
+	io_write32(stm32_rcc_base() + RCC_MP_RSTSCLRR,
+		   RCC_MP_RSTSCLRR_MPUP1RSTF);
 }
 
-#ifdef CFG_STM32MP15
 /*
  * This concerns OP-TEE pager for STM32MP1 to use secure internal
  * RAMs to execute. TZSRAM refers the TZSRAM_BASE/TZSRAM_SIZE
diff --git a/core/arch/arm/plat-stm32mp1/pm/low_power.c b/core/arch/arm/plat-stm32mp1/pm/low_power.c
index 04da30549..48020f182 100644
--- a/core/arch/arm/plat-stm32mp1/pm/low_power.c
+++ b/core/arch/arm/plat-stm32mp1/pm/low_power.c
@@ -504,6 +504,8 @@ void __noreturn stm32_pm_cpu_power_down_wfi(void)
 #ifdef CFG_STM32MP13
 	panic();
 #else
+	/* Clear flag before core 1 reset */
+	io_write32(rcc_base + RCC_MP_RSTSCLRR, RCC_MP_RSTSCLRR_MPUP1RSTF);
 	io_write32(rcc_base + RCC_MP_GRSTCSETR, RCC_MP_GRSTCSETR_MPUP1RST);
 #endif
 	cpu_wfi();
diff --git a/core/include/drivers/stm32mp1_rcc.h b/core/include/drivers/stm32mp1_rcc.h
index ca75f1953..db7f9afd2 100644
--- a/core/include/drivers/stm32mp1_rcc.h
+++ b/core/include/drivers/stm32mp1_rcc.h
@@ -419,6 +419,9 @@
 #define RCC_MP_RSTSCLRR_IWDG2RSTF	BIT(9)
 #define RCC_MP_RSTSCLRR_STDBYRSTF	BIT(11)
 #define RCC_MP_RSTSCLRR_CSTDBYRSTF	BIT(12)
+#define RCC_MP_RSTSCLRR_MPUP0RSTF	BIT(13)
+#define RCC_MP_RSTSCLRR_MPUP1RSTF	BIT(14)
+#define RCC_MP_RSTSCLRR_SPARE		BIT(15)
 
 /* Global Reset Register */
 #define RCC_MP_GRSTCSETR_MPSYSRST	BIT(0)
-- 
2.53.0

