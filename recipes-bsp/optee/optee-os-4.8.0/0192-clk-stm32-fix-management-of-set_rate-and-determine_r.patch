From 22102b542b3c51bde2fb543aecf24602b19ab489 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Mon, 31 Mar 2025 20:02:45 +0200
Subject: [PATCH 192/913] clk: stm32: fix management of set_rate and
 determine_rate

When .determine_rate handler is implemented, the parent clock
and the actual clock are always computed and are applied by
clk_set_rate_no_lock(). Therefore the clock must implement .set_rate
handler instead of relying on CLK_SET_RATE_PARENT flag.

For cpu1/mpu clock it is not the case, so add the required ops set_rate()
to check the parent clock is the expected one after the call of
determine_rate().

Moreover for clocks with determine_rate ops, the flags CLK_SET_RATE_PARENT
is not needed (only used when determine_rate is absent), so we removes
this flags it when is possible.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git b58b2b8cbb7a9c68656d793372d25017091f7af9 clk: stm32: fix management of set_rate and determine_rate]
Change-Id: Iddf9c4df4a439afaa1084938396bf181976bde45
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/447772
Reviewed-by: Gabriel FERNANDEZ <gabriel.fernandez@foss.st.com>
Reviewed-by: Etienne CARRIERE <etienne.carriere@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/drivers/clk/clk-stm32mp21.c | 37 ++++++++++++++++++++++++++++
 core/drivers/clk/clk-stm32mp25.c | 41 ++++++++++++++++++++++++++++++--
 2 files changed, 76 insertions(+), 2 deletions(-)

diff --git a/core/drivers/clk/clk-stm32mp21.c b/core/drivers/clk/clk-stm32mp21.c
index a8878c90d..c35992750 100644
--- a/core/drivers/clk/clk-stm32mp21.c
+++ b/core/drivers/clk/clk-stm32mp21.c
@@ -2818,7 +2818,44 @@ static size_t clk_cpu1_get_parent(struct clk *clk __unused)
 		CA35SS_SSC_CHGCLKREQ_ARM_CHGCLKACK_SHIFT;
 }
 
+static TEE_Result clk_cpu1_determine_rate(struct clk *clk,
+					  struct clk_rate_request *req)
+{
+	struct clk_stm32_priv *priv = clk_stm32_get_priv();
+	struct stm32_clk_platdata *pdata = priv->pdata;
+	struct stm32_clk_opp_cfg *opp = NULL;
+	unsigned long rate = req->rate;
+	struct clk *parent = NULL;
+
+	opp = clk_stm32_get_opp_config(pdata->opp->cpu1_opp, rate);
+	if (!opp)
+		return TEE_ERROR_ITEM_NOT_FOUND;
+
+	/*
+	 * PLL1 is always the source of the ck_cpu1 for OPP description
+	 * ck_flexgen_63 is used for OPP switch
+	 */
+	parent = clk_get_parent_by_index(clk, 0);
+
+	req->best_parent = parent;
+	req->best_parent_rate = req->rate;
+
+	return TEE_SUCCESS;
+}
+
+static TEE_Result clk_cpu1_set_rate(struct clk *clk __unused,
+				    unsigned long rate,
+				    unsigned long parent_rate)
+{
+	if (rate == parent_rate)
+		return TEE_SUCCESS;
+
+	return TEE_ERROR_GENERIC;
+}
+
 static const struct clk_ops clk_stm32_cpu1_ops = {
+	.determine_rate = clk_cpu1_determine_rate,
+	.set_rate = clk_cpu1_set_rate,
 	.get_parent = clk_cpu1_get_parent,
 };
 
diff --git a/core/drivers/clk/clk-stm32mp25.c b/core/drivers/clk/clk-stm32mp25.c
index ce4ecc75a..ac7b59f4e 100644
--- a/core/drivers/clk/clk-stm32mp25.c
+++ b/core/drivers/clk/clk-stm32mp25.c
@@ -2579,7 +2579,7 @@ static TEE_Result clk_stm32_pll1_set_rate(struct clk *clk __unused,
 
 	opp = clk_stm32_get_opp_config(pdata->opp->cpu1_opp, rate);
 	if (!opp)
-		return TEE_ERROR_GENERIC;
+		return TEE_ERROR_ITEM_NOT_FOUND;
 
 	pll_conf = &opp->pll_cfg;
 
@@ -3069,7 +3069,45 @@ static size_t clk_cpu1_get_parent(struct clk *clk __unused)
 		CA35SS_SSC_CHGCLKREQ_ARM_CHGCLKACK_SHIFT;
 }
 
+static TEE_Result clk_cpu1_determine_rate(struct clk *clk,
+					  struct clk_rate_request *req)
+{
+	struct clk_stm32_priv *priv = clk_stm32_get_priv();
+	struct stm32_clk_platdata *pdata = priv->pdata;
+	struct stm32_clk_opp_cfg *opp = NULL;
+	unsigned long rate = req->rate;
+	struct clk *parent = NULL;
+
+	opp = clk_stm32_get_opp_config(pdata->opp->cpu1_opp, rate);
+	if (!opp)
+		return TEE_ERROR_ITEM_NOT_FOUND;
+
+	/*
+	 * PLL1 is always the source of the ck_cpu1 for OPP description.
+	 * ck_flexgen_63 is used for OPP switch.
+         * Therefore compute the rate based on parent 0 that is always PLL1.
+	 */
+	parent = clk_get_parent_by_index(clk, 0);
+
+	req->best_parent = parent;
+	req->best_parent_rate = req->rate;
+
+	return TEE_SUCCESS;
+}
+
+static TEE_Result clk_cpu1_set_rate(struct clk *clk __unused,
+				    unsigned long rate,
+				    unsigned long parent_rate)
+{
+	if (rate == parent_rate)
+		return TEE_SUCCESS;
+
+	return TEE_ERROR_GENERIC;
+}
+
 static const struct clk_ops clk_stm32_cpu1_ops = {
+	.determine_rate = clk_cpu1_determine_rate,
+	.set_rate = clk_cpu1_set_rate,
 	.get_parent = clk_cpu1_get_parent,
 };
 
@@ -3489,7 +3527,6 @@ static STM32_FLEXGEN(ck_flexgen_63, 0, 63);
 static struct clk ck_cpu1 = {
 	.ops		= &clk_stm32_cpu1_ops,
 	.name		= "ck_cpu1",
-	.flags		= CLK_SET_RATE_PARENT,
 	.num_parents	= 2,
 	.parents	= { &ck_pll1, &ck_flexgen_63 },
 };
