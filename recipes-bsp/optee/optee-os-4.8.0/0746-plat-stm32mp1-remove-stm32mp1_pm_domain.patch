From e6dd713f740eefc1230c262cc45b6276d2295637 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 10 Jun 2026 18:34:49 +0200
Subject: [PATCH 746/913] plat-stm32mp1: remove stm32mp1_pm_domain

Remove the enum stm32mp1_pm_domain and use directly the existing
define STM32_SIP_PD.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git a0f134313f22e8101b5104c63f70dfa61ccb51e1 plat-stm32mp1: remove stm32mp1_pm_domain]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I6e78c3be7831529ce3992a2ee231da97f35bc937
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/577547
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 .../plat-stm32mp1/nsec-service/low_power_svc.c   |  6 +++---
 core/arch/arm/plat-stm32mp1/pm/context.h         |  2 +-
 core/arch/arm/plat-stm32mp1/pm/power_config.c    | 16 ++++++++++++++--
 core/arch/arm/plat-stm32mp1/stm32mp_pm.h         |  6 ------
 4 files changed, 18 insertions(+), 12 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/nsec-service/low_power_svc.c b/core/arch/arm/plat-stm32mp1/nsec-service/low_power_svc.c
index e2e9ad766..1519c338c 100644
--- a/core/arch/arm/plat-stm32mp1/nsec-service/low_power_svc.c
+++ b/core/arch/arm/plat-stm32mp1/nsec-service/low_power_svc.c
@@ -23,9 +23,9 @@ uint32_t pm_domain_scv_handler(uint32_t id, uint32_t enable)
 	DMSG("%sable PD %u", enable != 0 ? "En" : "Dis", pd);
 
 	switch (pd) {
-	case STM32MP1_PD_VSW:
-	case STM32MP1_PD_CORE_RET:
-	case STM32MP1_PD_CORE:
+	case STM32_SIP_PD_VSW:
+	case STM32_SIP_PD_CORE_RET:
+	case STM32_SIP_PD_CORE:
 		break;
 	default:
 		return STM32_SIP_SVC_INVALID_PARAMS;
diff --git a/core/arch/arm/plat-stm32mp1/pm/context.h b/core/arch/arm/plat-stm32mp1/pm/context.h
index 33e70c535..14327b8c3 100644
--- a/core/arch/arm/plat-stm32mp1/pm/context.h
+++ b/core/arch/arm/plat-stm32mp1/pm/context.h
@@ -91,7 +91,7 @@ TEE_Result stm32mp_pm_call_bl2_lp_entry(unsigned int soc_mode);
 #endif
 
 #ifdef CFG_STM32_LOWPOWER_SIP
-int stm32mp1_set_pm_domain_state(enum stm32mp1_pm_domain domain, bool status);
+int stm32mp1_set_pm_domain_state(unsigned int domain, bool status);
 #endif
 
 bool stm32mp1_lp_soc_mode_is_supported(uint32_t soc_mode);
diff --git a/core/arch/arm/plat-stm32mp1/pm/power_config.c b/core/arch/arm/plat-stm32mp1/pm/power_config.c
index 4582be166..3f5b75d67 100644
--- a/core/arch/arm/plat-stm32mp1/pm/power_config.c
+++ b/core/arch/arm/plat-stm32mp1/pm/power_config.c
@@ -70,6 +70,14 @@ bool need_to_backup_stop_context(unsigned int soc_mode)
 }
 
 #ifdef CFG_STM32_LOWPOWER_SIP
+#include <stm32mp1_smc.h>
+
+/* STM32MP1 power domain identifiers defined by SMC API */
+#define STM32MP1_PD_VSW			STM32_SIP_PD_VSW
+#define STM32MP1_PD_CORE_RET		STM32_SIP_PD_CORE_RET
+#define STM32MP1_PD_CORE		STM32_SIP_PD_CORE
+#define STM32MP1_PD_MAX_PM_DOMAIN	STM32_SIP_PD_MAX_PM_DOMAIN
+
 /* Boot with all domains ON, false means in use */
 static bool stm32mp1_pm_dom[STM32MP1_PD_MAX_PM_DOMAIN] = {
 	[STM32MP1_PD_VSW] = false,
@@ -80,7 +88,7 @@ static bool stm32mp1_pm_dom[STM32MP1_PD_MAX_PM_DOMAIN] = {
 static bool get_pm_domain_state(uint8_t mode)
 {
 	bool res = true;
-	enum stm32mp1_pm_domain id = STM32MP1_PD_MAX_PM_DOMAIN;
+	unsigned int id = STM32MP1_PD_MAX_PM_DOMAIN;
 
 	while (res && (id > mode)) {
 		id--;
@@ -90,7 +98,7 @@ static bool get_pm_domain_state(uint8_t mode)
 	return res;
 }
 
-int stm32mp1_set_pm_domain_state(enum stm32mp1_pm_domain domain, bool status)
+int stm32mp1_set_pm_domain_state(unsigned int domain, bool status)
 {
 	if (domain >= STM32MP1_PD_MAX_PM_DOMAIN)
 		return -1;
@@ -105,6 +113,10 @@ static void dump_pm_domain_state(uint8_t domain __unused)
 }
 #else /* CFG_STM32_LOWPOWER_SIP */
 
+/* 2 power domains used for low power mode detection by EXTI */
+#define STM32MP1_PD_CORE_RET	0
+#define STM32MP1_PD_CORE	1
+
 #define EXTI_BANK_NR		3U
 #define EXTI_C1IMR(n)		(0x080U + (n) * 0x10U)
 
diff --git a/core/arch/arm/plat-stm32mp1/stm32mp_pm.h b/core/arch/arm/plat-stm32mp1/stm32mp_pm.h
index 4cbf619fa..a03179b85 100644
--- a/core/arch/arm/plat-stm32mp1/stm32mp_pm.h
+++ b/core/arch/arm/plat-stm32mp1/stm32mp_pm.h
@@ -8,12 +8,6 @@
 #define PSCI_MODE_SYSTEM_SUSPEND	0
 #define PSCI_MODE_SYSTEM_OFF		1
 
-enum stm32mp1_pm_domain {
-	STM32MP1_PD_VSW,
-	STM32MP1_PD_CORE_RET,
-	STM32MP1_PD_CORE,
-	STM32MP1_PD_MAX_PM_DOMAIN
-};
 
 #endif /*__STM32MP_PM_H__*/
 
-- 
2.53.0

