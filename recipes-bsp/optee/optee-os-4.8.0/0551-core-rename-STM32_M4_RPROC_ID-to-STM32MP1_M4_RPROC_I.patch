From bb9bf8a824da3e637b9eb86a928ca4468ff1a09a Mon Sep 17 00:00:00 2001
From: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Date: Wed, 29 Apr 2026 09:56:04 +0200
Subject: [PATCH 551/913] core: rename STM32_M4_RPROC_ID to
 STM32MP1_M4_RPROC_ID

Rename the deinition to add information about the SoCa,as done for
STM32MP2_M33_RPROC_ID

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 9585c5350b24c37134c4615c7133ea0f708a50c2 core: rename STM32_M4_RPROC_ID to STM32MP1_M4_RPROC_ID]
Signed-off-by: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Change-Id: I17218dbe639332e383bd881cbde5877783d62de6
---
 core/arch/arm/plat-stm32mp1/scmi_server.c  | 5 +++--
 core/drivers/remoteproc/stm32_remoteproc.c | 2 +-
 core/include/drivers/stm32_remoteproc.h    | 2 +-
 3 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/scmi_server.c b/core/arch/arm/plat-stm32mp1/scmi_server.c
index 04693b2ca..d62bfccfd 100644
--- a/core/arch/arm/plat-stm32mp1/scmi_server.c
+++ b/core/arch/arm/plat-stm32mp1/scmi_server.c
@@ -680,7 +680,8 @@ int32_t plat_scmi_rd_autonomous(unsigned int channel_id, unsigned int scmi_id,
 	if (rd->reset_id == MCU_HOLD_BOOT_R)
 		return SCMI_NOT_SUPPORTED;
 	/* Remoteproc driver may handle all MCU reset controllers */
-	if (rd->reset_id == MCU_R && stm32_rproc_is_secure(STM32_M4_RPROC_ID))
+	if (rd->reset_id == MCU_R &&
+	    stm32_rproc_is_secure(STM32MP1_M4_RPROC_ID))
 		return SCMI_DENIED;
 #endif
 
@@ -714,7 +715,7 @@ int32_t plat_scmi_rd_set_state(unsigned int channel_id, unsigned int scmi_id,
 #ifdef CFG_STM32MP15
 	/* Remoteproc driver may handle all MCU reset controllers */
 	if ((rd->reset_id == MCU_R || rd->reset_id == MCU_HOLD_BOOT_R) &&
-	    stm32_rproc_is_secure(STM32_M4_RPROC_ID))
+	    stm32_rproc_is_secure(STM32MP1_M4_RPROC_ID))
 		return SCMI_DENIED;
 #endif
 
diff --git a/core/drivers/remoteproc/stm32_remoteproc.c b/core/drivers/remoteproc/stm32_remoteproc.c
index 43f61ff20..241b7cc9e 100644
--- a/core/drivers/remoteproc/stm32_remoteproc.c
+++ b/core/drivers/remoteproc/stm32_remoteproc.c
@@ -433,7 +433,7 @@ err:
 }
 
 static const struct stm32_rproc_compat_data stm32_rproc_m4_compat = {
-	.rproc_id = STM32_M4_RPROC_ID,
+	.rproc_id = STM32MP1_M4_RPROC_ID,
 	.ns_loading = false,
 };
 
diff --git a/core/include/drivers/stm32_remoteproc.h b/core/include/drivers/stm32_remoteproc.h
index 439d81e11..27a423fd4 100644
--- a/core/include/drivers/stm32_remoteproc.h
+++ b/core/include/drivers/stm32_remoteproc.h
@@ -11,7 +11,7 @@
 #include <types_ext.h>
 
 /* IDs of the supported remote processors*/
-#define STM32_M4_RPROC_ID 0
+#define STM32MP1_M4_RPROC_ID 0
 
 /*
  * stm32_rproc_get() - get the rproc handle associated to a remote processor ID
-- 
2.53.0

