From 90d7191044e81fcebc5ba3ed496e7325d484be84 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Tue, 3 Mar 2026 11:12:16 +0100
Subject: [PATCH 112/913] dts:stm32: add support of usart2 for stm32mp21

Add usart2 node in stm32mp211.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git caa1d5e8ea76f821c2d2f2edf41ceedca0f315a0 dts:stm32: add support of usart2 for stm32mp21]
Change-Id: I3b08dac5b16bb92ef0cf1d1c70f83d70f02c60c1
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp211.dtsi | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index 5f9519d29..135d73689 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -102,6 +102,15 @@
 			#size-cells = <1>;
 			#access-controller-cells = <1>;
 
+			usart2: serial@400e0000 {
+				compatible = "st,stm32h7-uart";
+				reg = <0x400e0000 0x400>;
+				interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_KER_USART2>;
+				access-controllers = <&rifsc STM32MP21_RIFSC_USART2_ID>;
+				status = "disabled";
+			};
+
 			i2c1: i2c@40170000 {
 				compatible = "st,stm32mp25-i2c";
 				reg = <0x40170000 0x400>;
-- 
2.53.0

