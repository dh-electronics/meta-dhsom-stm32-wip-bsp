From 45e945032bd9feee93de50255a988b11582448cf Mon Sep 17 00:00:00 2001
From: Michel JAOUEN <michel.jaouen@st.com>
Date: Wed, 20 May 2026 14:56:01 +0200
Subject: [PATCH 434/913] dts: stm32mp2: add ipcc1 for soc stm32mp211

add ippc1 for soc stm32mp211

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 36ffd313fa3801f4231dffd89b1b7769c74c5edc dts: stm32mp2: add ipcc1 for soc stm32mp211]
Change-Id: Ib65df66b8a0bec8ab2efe766e4125a91f8ebce50
Signed-off-by: Michel JAOUEN <michel.jaouen@st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/569799
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/dts/stm32mp211.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index c1e82afa4..34a5a20ee 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -122,6 +122,16 @@
 			status = "disabled";
 		};
 
+		ipcc1: mailbox@40490000 {
+			compatible = "st,stm32mp25-ipcc";
+			reg = <0x40490000 0x400>;
+			#mbox-cells = <1>;
+			interrupts = <GIC_SPI 154 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "rx";
+			clocks = <&rcc CK_BUS_IPCC1>;
+			st,proc-id = <0>;
+		};
+
 		rifsc: bus@42080000 {
 			compatible = "st,stm32mp25-rifsc", "simple-bus";
 			reg = <0x42080000 0x1000>;
-- 
2.53.0

