From 33d97ba0324caedf3d7759d0d48b86d166be796c Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Tue, 5 Dec 2023 17:16:49 +0100
Subject: [PATCH 211/913] clk: add round rate ops

Returns the round the given rate for a clock.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git a79b91ade5a35bb068f7987558936bbf8bcfcc30 clk: add round rate ops]
Change-Id: I7080e4f6a954baf60b3477649e7c0b21e9a2cc04
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
---
 core/drivers/clk/clk.c     | 13 +++++++++++++
 core/include/drivers/clk.h | 12 ++++++++++++
 2 files changed, 25 insertions(+)

diff --git a/core/drivers/clk/clk.c b/core/drivers/clk/clk.c
index 893e1357a..0ba28665c 100644
--- a/core/drivers/clk/clk.c
+++ b/core/drivers/clk/clk.c
@@ -385,6 +385,19 @@ TEE_Result clk_get_duty_cycle(struct clk *clk,
 	return TEE_SUCCESS;
 }
 
+unsigned long clk_round_rate(struct clk *clk, unsigned long rate)
+{
+	struct clk *parent = clk->parent;
+
+	if (clk->ops->round_rate)
+		return clk->ops->round_rate(clk, rate, clk->parent->rate);
+
+	if (parent && (clk->flags & CLK_SET_RATE_PARENT))
+		return clk_round_rate(parent, rate);
+
+	return clk->rate;
+}
+
 /* Return updated message buffer position of NULL on failure */
 static __printf(3, 4) char *add_msg(char *cur, char *end, const char *fmt, ...)
 {
diff --git a/core/include/drivers/clk.h b/core/include/drivers/clk.h
index 013f6989d..b1343f2e8 100644
--- a/core/include/drivers/clk.h
+++ b/core/include/drivers/clk.h
@@ -72,6 +72,7 @@ struct clk_duty_cycle {
  * @get_rates_array: Get the supported clock rates as array in ascending order
  * @get_rates_steps: Get support clock rates by min/max/step representation
  * @get_duty_cycle: Get duty cytcle of the clock
+ * @round_rate: Get the closest supported clock rate to a requested rate
  *
  * All clock operations are expected to execute in a interruptible thread
  * context at the exclusion of power management sequence where non secure
@@ -93,6 +94,9 @@ struct clk_ops {
 				      unsigned long *max, unsigned long *step);
 	TEE_Result (*get_duty_cycle)(struct clk *clk,
 				     struct clk_duty_cycle *duty_cycle);
+	unsigned long (*round_rate)(struct clk *clk,
+				    unsigned long rate,
+				    unsigned long parent_rate);
 };
 
 /**
@@ -248,6 +252,14 @@ TEE_Result clk_get_rates_steps(struct clk *clk, unsigned long *min,
 TEE_Result clk_get_duty_cycle(struct clk *clk,
 			      struct clk_duty_cycle *duty_cycle);
 
+/**
+ * clk_round_rate - Round the given rate for a clock
+ * @clk: Clock for which the round rate is need
+ * @rate: The rate which is to be rounded
+ * Returns the closest rate actually supported by the clock.
+ */
+unsigned long clk_round_rate(struct clk *clk, unsigned long rate);
+
 #ifdef CFG_DRIVERS_CLK
 /**
  * clk_print_tree() - Print current clock tree summary to output console
