From 3394f2e83c152938d3e7a63b175131b00ae2ae33 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Fri, 3 Jul 2026 10:03:58 +0200
Subject: [PATCH 784/913] core: REE FS: fix counter misaligment when calling
 ree_fs_closedir_rpc with dirh NULL

Use put_dirh_primitive in ree_fs_closedir_rp() to decrement counter even
if ree_fs_dir is already closed. This align the behaviour of
ree_fs_closedir_rpc() with ree_fs_close().
For the same reasons as ree_fs_close() we need to call
put_dirh_primitive() in ree_fs_closedir_rpc() as there is no call to
get_dirh() and there might be a case where ree_fs_dirh can be NULL.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 1a05020e6b46a57526cb921bc5e3f459fe2c8134 core: REE FS: fix counter misaligment when calling ree_fs_closedir_rpc with dirh NULL]
Fixes: 7ae15736f2ab ("core: ree_fs: fix dirfile handle refcount")
Change-Id: I74d2c156d0a50594339b691d5671203d68401c0b
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/584550
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/tee/tee_ree_fs.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/core/tee/tee_ree_fs.c b/core/tee/tee_ree_fs.c
index b18b995ee..34ac697ba 100644
--- a/core/tee/tee_ree_fs.c
+++ b/core/tee/tee_ree_fs.c
@@ -685,10 +685,11 @@ static void put_dirh_primitive(bool close)
 	 * another thread may get an error or something causing that fop
 	 * to do a put with close=1.
 	 *
-	 * For all fops but ree_fs_close() there's a call to get_dirh() to
-	 * get a new dirh which will open it again if it was closed before.
-	 * But in the ree_fs_close() case there's no call to get_dirh()
-	 * only to this function, put_dirh_primitive(), and in this case
+	 * For all fops but ree_fs_close() and ree_fs_closedir_rpc() there's a
+	 * call to get_dirh() to get a new dirh which will open it again if it
+	 * was closed before. But in the ree_fs_close() and
+	 * ree_fs_closedir_rpc() cases there's no call to get_dirh() only to
+	 * this function, put_dirh_primitive(), and in this case
 	 * ree_fs_dirh may actually be NULL.
 	 */
 	ree_fs_dirh_refcount--;
@@ -1063,7 +1064,7 @@ static void ree_fs_closedir_rpc(struct tee_fs_dir *d)
 	if (d) {
 		mutex_lock(&ree_fs_mutex);
 
-		put_dirh(ree_fs_dirh, false);
+		put_dirh_primitive(false);
 		free(d);
 
 		mutex_unlock(&ree_fs_mutex);
-- 
