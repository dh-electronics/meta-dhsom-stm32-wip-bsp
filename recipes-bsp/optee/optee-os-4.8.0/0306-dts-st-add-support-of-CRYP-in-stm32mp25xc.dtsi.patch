From af0e79dd4a817ba2c4a0920267774514f9664d03 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 13 Apr 2026 17:32:29 +0200
Subject: [PATCH 306/913] dts: st: add support of CRYP in stm32mp25xc.dtsi

Add node cryp1 and cryp2 in stm32mp25xc.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 9eb3595de3f268e4692492f50a94d09570d23dc5 dts: st: add support of CRYP in stm32mp25xc.dtsi]
Change-Id: I484e6b2610ca78985af648037a7185d398b22096
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/557103
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/dts/stm32mp25xc.dtsi | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/core/arch/arm/dts/stm32mp25xc.dtsi b/core/arch/arm/dts/stm32mp25xc.dtsi
index 5e83a6926..8d0c3b91d 100644
--- a/core/arch/arm/dts/stm32mp25xc.dtsi
+++ b/core/arch/arm/dts/stm32mp25xc.dtsi
@@ -4,5 +4,24 @@
  * Author: Alexandre Torgue <alexandre.torgue@foss.st.com> for STMicroelectronics.
  */
 
-/ {
+&rifsc {
+	cryp1: cryp@42030000 {
+		compatible = "st,stm32mp1-cryp";
+		reg = <0x42030000 0x400>;
+		interrupts = <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&rcc CK_BUS_CRYP1>;
+		resets = <&rcc CRYP1_R>;
+		access-controllers = <&rifsc STM32MP25_RIFSC_CRYP1_ID>;
+		status = "disabled";
+	};
+
+	cryp2: cryp@42040000 {
+		compatible = "st,stm32mp1-cryp";
+		reg = <0x42040000 0x400>;
+		interrupts = <GIC_SPI 180 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&rcc CK_BUS_CRYP2>;
+		resets = <&rcc CRYP2_R>;
+		access-controllers = <&rifsc STM32MP25_RIFSC_CRYP2_ID>;
+		status = "disabled";
+	};
 };
-- 
