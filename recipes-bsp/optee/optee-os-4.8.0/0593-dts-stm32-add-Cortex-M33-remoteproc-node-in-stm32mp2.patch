From 74c2d3a5586043069408f67370f202582ce58b3b Mon Sep 17 00:00:00 2001
From: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Date: Tue, 12 May 2026 17:50:00 +0200
Subject: [PATCH 593/913] dts: stm32: add Cortex-M33 remoteproc node in
 stm32mp211.dtsi

Introduces the m33_rproc node under the mlahb simple bus.
This declaration is a aligned with the Linux DT.
The mlahb bus provides memory translation between
the Cortex-M and Cortex-A memory mappings.
For the STM32MP2, no memory translation is needed, and the
dma-ranges is declared accordingly.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git b87e71a8b62a36f72e759510250be52dede4109b dts: stm32: add Cortex-M33 remoteproc node in stm32mp211.dtsi]
Signed-off-by: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Change-Id: I97d6a1d8cd446c37f04f87e5942e1675703a3e54
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570905
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Tested-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
---
 core/arch/arm/dts/stm32mp211.dtsi | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index 451fd3f2c..71c7a8179 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -1072,4 +1072,24 @@
 			status = "disabled";
 		};
 	};
+
+	mlahb: ahb@2 {
+		compatible = "st,mlahb", "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x0 0x0 0xFFFFFFFC>;
+		dma-ranges = <0x00000000 0x0 0x80000000 0x08000000>,
+			     <0x08000000 0x0 0x08000000 0x08000000>,
+			     <0x10000000 0x0 0x80000000 0x10000000>,
+			     <0x20000000 0x0 0x20000000 0xD0000000>;
+		m33_rproc: m33@0 {
+			compatible = "st,stm32mp2-m33";
+			#reset-cells = <1>;
+			reg = <0 0>;
+			resets = <&rcc C2_R>,
+				 <&rcc C2_HOLDBOOT_R>;
+			reset-names = "mcu_rst", "hold_boot";
+			status = "disabled";
+		};
+	};
 };
