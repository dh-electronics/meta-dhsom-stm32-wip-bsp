From 8184bddd9b4090346056365e44e288d1f99e9d51 Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@st.com>
Date: Sat, 9 May 2026 10:33:30 +0200
Subject: [PATCH 617/913] plat-stm32mp2: enable CFG_STM32_IRQ_NOTIF by default

Enable by default CFG_STM32_IRQ_NOTIF on MP2* targets.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git d66ffea378f9fe9cfaddf372bdb7f453c383a084 plat-stm32mp2: enable CFG_STM32_IRQ_NOTIF by default]
Signed-off-by: Etienne Carriere <etienne.carriere@st.com>
---
 core/arch/arm/plat-stm32mp2/conf.mk | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index d21a70f52..d488365bf 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -181,6 +181,7 @@ CFG_STM32_HSEM ?= y
 CFG_STM32_I2C ?= y
 CFG_STM32_IAC ?= y
 CFG_STM32_IPCC ?= y
+CFG_STM32_IRQ_NOTIF ?= y
 CFG_STM32_IWDG ?= y
 CFG_STM32_LPTIMER ?= y
 CFG_STM32_OMM ?= y
