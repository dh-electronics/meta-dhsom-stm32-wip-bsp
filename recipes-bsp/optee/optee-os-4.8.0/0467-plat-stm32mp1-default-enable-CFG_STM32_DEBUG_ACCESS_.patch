From 5f37e341bcfa7c364b8a1f1878a78c9a09636395 Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Wed, 24 Sep 2025 17:11:24 +0200
Subject: [PATCH 467/913] plat-stm32mp1: default enable
 CFG_STM32_DEBUG_ACCESS_PTA

In order to handle request on the debug configuration, default enable
CFG_STM32_DEBUG_ACCESS_PTA to embed the debug access PTA.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git a6ea45c9a0d1c513df26f915212f8f082782bafb plat-stm32mp1: default enable CFG_STM32_DEBUG_ACCESS_PTA]
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Reviewed-by: Etienne Carriere <etienne.carriere@st.com>
(cherry picked from commit b58c69c72b7d90e18babb9ae4663496f5c3dbeab)
Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: I85dae2e37a223aa2bf3073008b69b9c821a18f10
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570791
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index e8fcc1678..75103258a 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -381,6 +381,11 @@ ifeq ($(CFG_STM32_BSEC_PTA),y)
 $(call force,CFG_STM32_BSEC,y,Required by CFG_STM32_BSEC_PTA)
 endif
 
+CFG_STM32_DEBUG_ACCESS_PTA ?= y
+ifeq ($(CFG_STM32_DEBUG_ACCESS_PTA),y)
+$(call force,CFG_STM32_BSEC,y,Mandated by CFG_STM32_DEBUG_ACCESS_PTA)
+endif
+
 # Measured latency on STM32MP13 is around 650uS so set 1mS
 # Set the same latency for STM32MP13 and STM32MP15
 CFG_STM32MP_OPP_LATENCY_US ?= 1000
-- 
