From cdc0441611d102b566a462d2f4d345a49193278c Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Thu, 2 Jul 2026 19:11:26 +0200
Subject: [PATCH 824/913] dt-bindings: memory-controller: add st,protreg
 properties for stm32-fmc-ebi

Add description of the properties "st,protreg" for the firewall
configuration for compatible "st,stm32mp25-fmc2-ebi".

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 202c5eb20c43479f27694913a86b23ee26061d17 dt-bindings: memory-controller: add st,protreg properties for stm32-fmc-ebi]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I50f3372101379abb301225e9545131d43653fc90
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/584312
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 .../memory-controllers/st,stm32-fmc2-ebi.yaml | 69 +++++++++++++++++++
 1 file changed, 69 insertions(+)

diff --git a/documentation/devicetree/bindings/memory-controllers/st,stm32-fmc2-ebi.yaml b/documentation/devicetree/bindings/memory-controllers/st,stm32-fmc2-ebi.yaml
index 706e45eb4..127668d2d 100644
--- a/documentation/devicetree/bindings/memory-controllers/st,stm32-fmc2-ebi.yaml
+++ b/documentation/devicetree/bindings/memory-controllers/st,stm32-fmc2-ebi.yaml
@@ -54,12 +54,81 @@ properties:
     minItems: 1
     maxItems: 2
 
+  st,protreg:
+    minItems: 1
+    maxItems: 6
+    $ref: "/schemas/types.yaml#/definitions/uint32-array"
+    description: |
+      Describes the firewall hardware configuration to apply for a
+      given controller.
+
+      RIFPROT(fmc_ctl_id, sem_list, lock, sec, priv, scid, sem_en, cfen)
+
+      When a field isn't effective, it should be filled with RIF_UNUSED.
+
+        "fmc_ctl_id" The FMC controller number.
+
+        "sem_list" Contains the CID grantlist that can access the controller
+                   (multiple choice allowed) when the controller is configured
+                   in semaphore mode. Mandates CID filtering and semaphore
+                   enabled to be effective.
+          RIF_CID1_BF | RIF_CID4_BF, allows both CID (Compartment ID) 1/4 to
+                                     access the controller according to the RIF
+                                     semaphore rules
+
+        "lock" Specifies whether the RIF configuration is locked until next
+               platform reset for this controller.
+          RIF_UNLOCK, the RIF configuration will not be locked for this
+                      controller
+          RIF_LOCK, the RIF configuration will be locked and will not be
+                    editable until next platform reset for this
+                    controller
+
+        "sec" Configures secure-only access to the controller.
+          RIF_SEC, only secure access is granted to the controller
+          RIF_NSEC, secure/non-secure access is granted to the
+                    controller
+
+        "priv" Configures the privilege level needed to access this
+                controller.
+          RIF_PRIV, only privileged access is granted to the controller
+          RIF_NPRIV, privileged/Unprivileged access is granted to the
+                      controller
+
+        "scid" Configures the static CID that is allowed to access the
+               controller. Note that the static CID configuration is
+               ineffective if the semaphore mode is enabled. Mandates CID
+               filtering enabled to be effective.
+          RIF_CID1 allows CID 1 to access the controller
+          RIF_CID2 allows CID 2 to access the controller ...
+
+        "sem_en" Enable/disable the semaphore mode for this controller.
+                  It mandates CID filtering enabled to be effective.
+          RIF_SEM_EN, semaphore mode enabled
+          RIF_SEM_DIS, semaphore mode disabled
+
+        "cfen" Enable/disable the CID filtering for this controller.
+          RIF_CFEN, enables the CID filtering
+          RIF_CFDIS, disables the CID filtering
+
 patternProperties:
   "^.*@[0-4],[a-f0-9]+$":
     additionalProperties: true
     type: object
     $ref: mc-peripheral-props.yaml#
 
+allOf:
+  - if:
+      not:
+        properties:
+          compatible:
+            contains:
+              enum:
+                - st,stm32mp25-fmc2-ebi
+    then:
+      properties:
+       st,protreg: false
+
 required:
   - "#address-cells"
   - "#size-cells"
-- 
