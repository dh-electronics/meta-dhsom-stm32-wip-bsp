From 849737764ddaba007f0299efb82c90f0796c4239 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Wed, 13 May 2026 17:45:27 +0200
Subject: [PATCH 423/913] dts: stm32: enable HPDMA on stm32mp215f-dk

Enable the hpdma1, hpdma2 and hpdma3 nodes on stm32mp215f-dk so that RIF
and AXI address remapping are configured, since HPDMA is a RIF-aware
peripheral.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git bf621ba5827af56640dd05873d47e86df950954c dts: stm32: enable HPDMA on stm32mp215f-dk]
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Change-Id: Iaf8014456615e35516f92169778f5aa4200c12c2
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/567637
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/dts/stm32mp215f-dk.dts | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp215f-dk.dts b/core/arch/arm/dts/stm32mp215f-dk.dts
index f98f091c8..5c5cef401 100644
--- a/core/arch/arm/dts/stm32mp215f-dk.dts
+++ b/core/arch/arm/dts/stm32mp215f-dk.dts
@@ -48,6 +48,18 @@
 	status = "okay";
 };
 
+&hpdma1 {
+	status = "okay";
+};
+
+&hpdma2 {
+	status = "okay";
+};
+
+&hpdma3 {
+	status = "okay";
+};
+
 &i2c3 {
 	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&i2c3_pins_a>;
-- 
2.53.0

