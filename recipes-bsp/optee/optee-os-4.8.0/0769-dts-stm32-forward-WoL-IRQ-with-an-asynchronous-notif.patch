From a868a7c5eab43b3f07ef5cb12215676024d6ef71 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Tue, 7 Jul 2026 14:40:09 +0200
Subject: [PATCH 769/913] dts: stm32: forward WoL IRQ with an asynchronous
 notification

Add the eth1-mdint node using the "st,stm32-irq-notifier" compatible so
that the Ethernet Wake-on-LAN interrupt (EXTI 56) is forwarded to the
Linux kernel as an asynchronous notification. The IRQ covers all WoL
events.

The "st,notif-it-id" property forwards the interrupt to the kernel with
the ID 3.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 28ef8da17f46164773e35f5a47e65ae9d25113b2 dts: stm32: forward WoL IRQ with an asynchronous notification]
Change-Id: I54926987241f088c1d98231e016ab33b28f816a7
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/586229
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Christophe ROULLIER <christophe.roullier@foss.st.com>
---
 core/arch/arm/dts/stm32mp135f-dk.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp135f-dk.dts b/core/arch/arm/dts/stm32mp135f-dk.dts
index 143a16eff..f5f5cae2f 100644
--- a/core/arch/arm/dts/stm32mp135f-dk.dts
+++ b/core/arch/arm/dts/stm32mp135f-dk.dts
@@ -32,6 +32,14 @@
 		stdout-path = "serial0:115200n8";
 	};
 
+	eth1-mdint {
+		compatible = "st,stm32-irq-notifier";
+		interrupts-extended = <&exti 56 IRQ_TYPE_EDGE_FALLING>;
+		st,notif-it-id = <3>;
+		wakeup-source;
+		status = "okay";
+	};
+
 	memory@c0000000 {
 		device_type = "memory";
 		reg = <0xc0000000 0x20000000>;
-- 
2.53.0

