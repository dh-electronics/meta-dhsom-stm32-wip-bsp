From e230533f7d5e591697be1daa775a136c028725db Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Tue, 23 Jun 2026 11:40:46 +0200
Subject: [PATCH 748/913] plat-stm32mp: add STM32_PM_SWITCH_OFF define

A a new define, platform independent, to indicate to driver
the shutdown power level (i.e. the lowest power level).

This define will be used for STPMIC2 driver, used on STPM32MP1 and
STM32MP2 series.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 0457b2c8fcf54cbb94ded08d661d5dc7dae44174 plat-stm32mp: add STM32_PM_SWITCH_OFF define]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: If85125cfc827cff4eb3f708237d15af0adde97b3
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/581300
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/plat-stm32mp1/stm32mp_pm.h | 2 ++
 core/arch/arm/plat-stm32mp2/stm32mp_pm.h | 3 +++
 2 files changed, 5 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/stm32mp_pm.h b/core/arch/arm/plat-stm32mp1/stm32mp_pm.h
index d44f3bf42..0729f4309 100644
--- a/core/arch/arm/plat-stm32mp1/stm32mp_pm.h
+++ b/core/arch/arm/plat-stm32mp1/stm32mp_pm.h
@@ -12,6 +12,8 @@
 
 /* Default configuration for PMIC (first level with alternate setting)*/
 #define STM32_PM_DEFAULT		STM32_PM_CSTOP_ALLOW_LP_STOP
+/* Power OFF configuration for PMIC */
+ #define STM32_PM_SWITCH_OFF		STM32_PM_SHUTDOWN
 
 #endif /*__STM32MP_PM_H__*/
 
diff --git a/core/arch/arm/plat-stm32mp2/stm32mp_pm.h b/core/arch/arm/plat-stm32mp2/stm32mp_pm.h
index d8ac02dc4..dfd24733b 100644
--- a/core/arch/arm/plat-stm32mp2/stm32mp_pm.h
+++ b/core/arch/arm/plat-stm32mp2/stm32mp_pm.h
@@ -32,4 +32,7 @@
 #define PM_D2_LPLV_LEVEL        4
 #define PM_MAX_LEVEL            5
 
+/* Power OFF configuration for PMIC driver */
+#define STM32_PM_SWITCH_OFF	PM_MAX_LEVEL
+
 #endif /*__STM32MP_PM_H__*/
-- 
