From bde1f657ddeaed5fc0a2d57fff07cc50af0145eb Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Tue, 14 Apr 2026 14:04:54 +0200
Subject: [PATCH 475/913] core: pta: stm32: add stm32 clock calibration service

Calibration driver embeds a PTA that can trigger a clock calibration when
called.
A daemon should be used to call this PTA periodically.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 02fc26e0ef0cc3fe344f0fc590cc496dbffaee54 core: pta: stm32: add stm32 clock calibration service]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I12b7c7d54af6c70e62bcc38fbf7eedfbd72dad40
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570760
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/pta/stm32mp/clock_calibration_pta.c | 49 ++++++++++++++++++++++++
 core/pta/stm32mp/sub.mk                  |  1 +
 lib/libutee/include/stm32_pta_calib.h    | 17 ++++++++
 3 files changed, 67 insertions(+)
 create mode 100644 core/pta/stm32mp/clock_calibration_pta.c
 create mode 100644 lib/libutee/include/stm32_pta_calib.h

diff --git a/core/pta/stm32mp/clock_calibration_pta.c b/core/pta/stm32mp/clock_calibration_pta.c
new file mode 100644
index 000000000..221820f3c
--- /dev/null
+++ b/core/pta/stm32mp/clock_calibration_pta.c
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (C) 2026, STMicroelectronics - All Rights Reserved
+ */
+
+#include <kernel/pseudo_ta.h>
+#include <kernel/user_access.h>
+#include <kernel/user_mode_ctx.h>
+#include <kernel/user_ta.h>
+#include <stm32_pta_calib.h>
+#include <stm32_util.h>
+
+typedef TEE_Result (*ta_func)(struct ts_session *s, uint32_t param_types,
+			      TEE_Param params[TEE_NUM_PARAMS]);
+
+void __weak stm32mp_start_clock_calibration(void)
+{
+}
+
+static TEE_Result request_calibration(struct ts_session *s __unused,
+				      uint32_t param_types __unused,
+				      TEE_Param params[TEE_NUM_PARAMS] __unused)
+{
+	stm32mp_start_clock_calibration();
+
+	return TEE_SUCCESS;
+}
+
+static const ta_func ta_funcs[] = {
+	[PTA_CALIB_REQUEST] = request_calibration,
+};
+
+static TEE_Result calib_invoke_command(void *sess_ctx __unused, uint32_t cmd_id,
+				       uint32_t param_types,
+				       TEE_Param params[TEE_NUM_PARAMS])
+{
+	struct ts_session *s = ts_get_calling_session();
+
+	DMSG("Invoking calibration command");
+
+	if (cmd_id < ARRAY_SIZE(ta_funcs) && ta_funcs[cmd_id])
+		return ta_funcs[cmd_id](s, param_types, params);
+
+	return TEE_ERROR_NOT_IMPLEMENTED;
+}
+
+pseudo_ta_register(.uuid = PTA_CALIB_UUID, .name = "calib",
+		   .flags = PTA_DEFAULT_FLAGS,
+		   .invoke_command_entry_point = calib_invoke_command);
diff --git a/core/pta/stm32mp/sub.mk b/core/pta/stm32mp/sub.mk
index 41805250b..afa575d74 100644
--- a/core/pta/stm32mp/sub.mk
+++ b/core/pta/stm32mp/sub.mk
@@ -1,3 +1,4 @@
 srcs-$(CFG_STM32_BSEC_PTA) += bsec_pta.c
+srcs-$(CFG_STM32_CLKCALIB_PTA) += clock_calibration_pta.c
 srcs-$(CFG_STM32_DEBUG_ACCESS_PTA) += debug_access_pta.c
 srcs-$(CFG_REMOTEPROC_PTA) += remoteproc_pta.c
diff --git a/lib/libutee/include/stm32_pta_calib.h b/lib/libutee/include/stm32_pta_calib.h
new file mode 100644
index 000000000..235672651
--- /dev/null
+++ b/lib/libutee/include/stm32_pta_calib.h
@@ -0,0 +1,17 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (C) 2026, STMicroelectronics - All Rights Reserved
+ */
+
+#ifndef __PTA_CALIB_H
+#define __PTA_CALIB_H
+
+#define PTA_CALIB_UUID	{ 0xee4e317c, 0x568b, 0x485f, { \
+			  0xb0, 0xb3, 0xd4, 0x92, 0x42, 0x6c, 0x47, 0x96 } }
+
+/* See request_calibration() */
+#define PTA_CALIB_REQUEST		0
+
+void stm32mp_start_clock_calibration(void);
+
+#endif /*__PTA_CALIB_H*/
