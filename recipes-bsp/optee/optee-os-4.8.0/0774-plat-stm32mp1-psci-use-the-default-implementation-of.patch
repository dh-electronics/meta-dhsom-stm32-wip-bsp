From 9537efb2afa86e9c43cfab133dd1912a38b1169f Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Fri, 19 Jun 2026 14:45:27 +0200
Subject: [PATCH 774/913] plat-stm32mp1: psci: use the default implementation
 of psci_system_reset()

Use the default implementation of psci_system_reset() since it's doing a
platform reset similarly to do_reset().
The platform function do_reset() will be use as the implementation for
psci_system_reset() in the next commit.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 1f1139789f835bdaa35e686cee60e961bf6eabb7 plat-stm32mp1: psci: use the default implementation of psci_system_reset()]
Change-Id: Idcce9ce5db0e42f5f71105efa2938f039126c12d
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/580488
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/pm/psci.c | 7 -------
 1 file changed, 7 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/pm/psci.c b/core/arch/arm/plat-stm32mp1/pm/psci.c
index d0e09c686..c6a090f5d 100644
--- a/core/arch/arm/plat-stm32mp1/pm/psci.c
+++ b/core/arch/arm/plat-stm32mp1/pm/psci.c
@@ -30,7 +30,6 @@
 #include <sm/pm.h>
 #include <sm/psci.h>
 #include <sm/std_smc.h>
-#include <stm32_util.h>
 #include <stm32mp_pm.h>
 #include <string.h>
 #include <trace.h>
@@ -450,12 +449,6 @@ void __noreturn psci_system_off(void)
 	__psci_system_off();
 }
 
-/* Override default psci_system_reset() with platform specific sequence */
-void __noreturn psci_system_reset(void)
-{
-	do_reset("PSCI");
-}
-
 /* Override default psci_cpu_on() with platform supported features */
 int psci_features(uint32_t psci_fid)
 {
