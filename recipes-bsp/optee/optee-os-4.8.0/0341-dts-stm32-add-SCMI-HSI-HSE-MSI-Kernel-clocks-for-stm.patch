From ad7927b45439800cd2467674aa7e61d917d21084 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Fri, 17 Apr 2026 09:08:27 +0200
Subject: [PATCH 341/913] dts: stm32: add SCMI HSI/HSE/MSI Kernel clocks for
 stm32mp23x

Adds CK_SCMI_HSI_KER_CK, CK_SCMI_HSE_KER_CK and CK_SCMI_MSI_KER_CK clocks

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git a8d7b857b9d18b352bdd68b7e98b00d85d11cc60 dts: stm32: add SCMI HSI/HSE/MSI Kernel clocks for stm32mp23x]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I55d8c87ff6d4c929ecf8b93fdd12a0e947e35c64
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/408609
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/558628
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi b/core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi
index 56f0095b5..b351b9891 100644
--- a/core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi
+++ b/core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi
@@ -683,6 +683,24 @@
 						domain-name = "ck_icn_m_etr";
 						clocks = <&rcc CK_KER_ETR>;
 					};
+
+					clock@7d {
+						reg = <CK_SCMI_HSI_KER_CK>;
+						domain-name = "hsi_ker_ck";
+						clocks = <&rcc HSI_KER_CK>;
+					};
+
+					clock@7e {
+						reg = <CK_SCMI_HSE_KER_CK>;
+						domain-name = "hse_ker_ck";
+						clocks = <&rcc HSE_KER_CK>;
+					};
+
+					clock@7f {
+						reg = <CK_SCMI_MSI_KER_CK>;
+						domain-name = "msi_ker_ck";
+						clocks = <&rcc MSI_KER_CK>;
+					};
 				};
 			};
 
