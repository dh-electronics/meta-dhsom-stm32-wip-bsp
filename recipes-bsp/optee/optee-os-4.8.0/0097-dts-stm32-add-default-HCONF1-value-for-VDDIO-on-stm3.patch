From b2b20d544ff4474f458aa5fd617f52f34f82198f Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Fri, 27 Feb 2026 14:44:22 +0100
Subject: [PATCH 097/913] dts: stm32: add default HCONF1 value for VDDIO on
 stm32mp235f-dk board

Add the default initialization values for stm32mp25 DK board.
Update the shadow default value to allow the system
to freeze the watchdog in stop or standby

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git e4bbc17df1930e62dff03c7baccf0496d929e135 dts: stm32: add default HCONF1 value for VDDIO on stm32mp235f-dk board]
Change-Id: I12a26add9f88336735a99dd0957cbcfe9f253723
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp235f-dk.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp235f-dk.dts b/core/arch/arm/dts/stm32mp235f-dk.dts
index 1e6efdad8..9da1a199a 100644
--- a/core/arch/arm/dts/stm32mp235f-dk.dts
+++ b/core/arch/arm/dts/stm32mp235f-dk.dts
@@ -35,6 +35,14 @@
 		device_type = "memory";
 		reg = <0x0 0x80000000 0x0 0x80000000>;
 	};
+
+	shadow-prov {
+		compatible = "st,provisioning";
+		hconf1_prov {
+			nvmem-cells = <&hconf1_otp>;
+			st,shadow-value = <0x00018DB6>;
+		};
+	};
 };
 
 &hpdma1 {
-- 
2.53.0

