From 24e03297de08a368420df40866e5c981fa59b2c8 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 15 Oct 2025 15:23:33 +0200
Subject: [PATCH 038/913] dt-bindings: update YAML documentation for
 fixed-clock

Add properties for RCC oscillator:
- st,bypass
- st,digbypass
- st,css
- st,drive

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 76523d43a31ae0310fd0eb8678cad9fadbc75c45 dt-bindings: update YAML documentation for fixed-clock]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I5571c50b388d9d991d0c8081ca19c3785b712b00
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/486993
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 .../devicetree/bindings/clock/fixed-clock.yaml | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/documentation/devicetree/bindings/clock/fixed-clock.yaml b/documentation/devicetree/bindings/clock/fixed-clock.yaml
index 90fb10660..2e59a1072 100644
--- a/documentation/devicetree/bindings/clock/fixed-clock.yaml
+++ b/documentation/devicetree/bindings/clock/fixed-clock.yaml
@@ -35,6 +35,24 @@ properties:
   clock-output-names:
     maxItems: 1
 
+  st,bypass:
+    type: boolean
+    description: configures the oscillator bypass mode for LSE and HSE
+                  (HSEBYP, LSEBYP)
+  st,digbypass:
+    type: boolean
+    description: configures the bypass mode as full-swing digital
+                  signal (DIGBYP)
+  st,css:
+    type: boolean
+    description: activates the clock security system (HSECSSON, LSECSSON)
+
+  st,drive:
+    type: int
+    description: (only for LSE) contains the value of the drive for the
+                  oscillator
+    enum: [0, 1, 2, 3]
+
 required:
   - compatible
   - "#clock-cells"
-- 
