From 8c317654d715f2243f75fdf59be3a6949fcda098 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Thu, 25 Jun 2026 12:54:54 +0200
Subject: [PATCH 760/913] drivers: crypto: stm32_cryp: wait for busy bit before
 saving context

The save_context() function was checking the BUSY flag and immediately
returning TEE_ERROR_BAD_STATE if it was set, instead of waiting for
the hardware to clear it.

Replace the early error return with a call to wait_end_busy() so the
driver properly waits for the CRYP peripheral to complete its current
operation before saving the context.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git d1a36fcddb123d5172d33fac3a7d294bf4ea7d8c drivers: crypto: stm32_cryp: wait for busy bit before saving context]
Change-Id: Iab664009e5a48b77d5da2427814de76a45a01f80
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/582162
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 core/drivers/crypto/stm32/stm32_cryp.c | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/core/drivers/crypto/stm32/stm32_cryp.c b/core/drivers/crypto/stm32/stm32_cryp.c
index 94bb0ca57..93f87dcea 100644
--- a/core/drivers/crypto/stm32/stm32_cryp.c
+++ b/core/drivers/crypto/stm32/stm32_cryp.c
@@ -445,9 +445,12 @@ static TEE_Result cryp_prepare_key(struct stm32_cryp_context *ctx)
 
 static TEE_Result save_context(struct stm32_cryp_context *ctx)
 {
+	TEE_Result res = TEE_ERROR_GENERIC;
+
 	/* Device should not be in a processing phase */
-	if (io_read32(ctx->base + _CRYP_SR) & _CRYP_SR_BUSY)
-		return TEE_ERROR_BAD_STATE;
+	res = wait_end_busy(ctx->base);
+	if (res)
+		return res;
 
 	/* Disable the CRYP peripheral */
 	io_clrbits32(ctx->base + _CRYP_CR, _CRYP_CR_CRYPEN);
-- 
