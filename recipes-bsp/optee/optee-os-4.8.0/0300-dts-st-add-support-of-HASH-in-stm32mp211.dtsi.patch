From 4dbae85d52d3b1fd848d2f4a7db43c0f89e53075 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 13 Apr 2026 15:56:15 +0200
Subject: [PATCH 300/913] dts: st: add support of HASH in stm32mp211.dtsi

Add node hash1 and hash2 in stm32mp211.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 167b76e0cf133e166c24a7c9a503cb5efa9f56f9 dts: st: add support of HASH in stm32mp211.dtsi]
Change-Id: I0bb5bcf79dc3ab189854a49512be51749c793435
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/557097
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 core/arch/arm/dts/stm32mp211.dtsi | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index 49712c961..2544366af 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -133,6 +133,16 @@
 				status = "disabled";
 			};
 
+			hash2: hash@42010000  {
+				compatible = "st,stm32mp13-hash";
+				reg = <0x42010000  0x400>;
+				interrupts = <GIC_SPI 178 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_BUS_HASH2>;
+				resets = <&rcc HASH2_R>;
+				access-controllers = <&rifsc STM32MP21_RIFSC_HASH2_ID>;
+				status = "disabled";
+			};
+
 			rng2: rng@42020000 {
 				compatible = "st,stm32mp21-rng";
 				reg = <0x42020000 0x400>;
@@ -142,6 +152,16 @@
 				resets = <&rcc RNG2_R>;
 			};
 
+			hash1: hash@42030400 {
+				compatible = "st,stm32mp13-hash";
+				reg = <0x42030400  0x400>;
+				interrupts = <GIC_SPI 132 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_BUS_HASH1>;
+				resets = <&rcc HASH1_R>;
+				access-controllers = <&rifsc STM32MP21_RIFSC_HASH1_ID>;
+				status = "disabled";
+			};
+
 			rng1: rng@42030800 {
 				compatible = "st,stm32mp21-rng";
 				reg = <0x42030800 0x400>;
-- 
2.53.0

