From 4179ad185aefface95ee2db89489948b219046f0 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Fri, 19 May 2023 17:30:21 +0200
Subject: [PATCH 291/913] plat-stm32mp2: conf: enable SAES for stm32mp2
 platforms

Default enables stm32_saes and crypto framework for stm32mp2 platforms.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git f184391410469f4bd7d653cdeb97e3b47f13eb07 plat-stm32mp2: conf: enable SAES for stm32mp2 platforms]
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Change-Id: Ia2dfcdb6373e34b86832118704afb902bd71dfe2
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/361856
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Gatien CHEVALLIER <gatien.chevallier@st.com>
---
 core/arch/arm/plat-stm32mp2/conf.mk | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index bf4a9b8fb..f0a51d876 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -158,6 +158,7 @@ CFG_STM32_RISAB ?= y
 CFG_STM32_RISAF ?= y
 CFG_STM32_RNG ?= y
 CFG_STM32_RTC ?= y
+CFG_STM32_SAES ?= y
 CFG_STM32_SERC ?= y
 CFG_STM32_TAMP ?= y
 CFG_STM32_UART ?= y
@@ -193,6 +194,11 @@ CFG_STM32_EARLY_CONSOLE_UART ?= 2
 # Default disable external DT support
 CFG_EXTERNAL_DT ?= n
 
+# If any crypto driver is enabled, enable the crypto-framework layer
+ifeq ($(call cfg-one-enabled, CFG_STM32_SAES),y)
+$(call force,CFG_STM32_CRYPTO_DRIVER,y)
+endif
+
 # Default enable HWRNG PTA support
 CFG_HWRNG_PTA ?= y
 ifeq ($(CFG_HWRNG_PTA),y)
