From 76d0ef9a55c19895638ffe79a8cfb26c42edffe2 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Wed, 15 Apr 2026 11:23:18 +0200
Subject: [PATCH 338/913] dts: stm32: add SCMI HSI/HSE/MSI Kernel clocks for
 stm32mp25x

Adds CK_SCMI_HSI_KER_CK, CK_SCMI_HSE_KER_CK and CK_SCMI_MSI_KER_CK clocks.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 561bd56cf0820b1e2ab52948f917deb43f0504e6 dts: stm32: add SCMI HSI/HSE/MSI Kernel clocks for stm32mp25x]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I49b2484649aeec9692d274695a00a3a564d0cb26
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/406046
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/558625
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi b/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
index 56f0095b5..b351b9891 100644
--- a/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
+++ b/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
@@ -683,6 +683,24 @@
 						domain-name = "ck_icn_m_etr";
 						clocks = <&rcc CK_KER_ETR>;
 					};
+
+					clock@7d {
+						reg = <CK_SCMI_HSI_KER_CK>;
+						domain-name = "hsi_ker_ck";
+						clocks = <&rcc HSI_KER_CK>;
+					};
+
+					clock@7e {
+						reg = <CK_SCMI_HSE_KER_CK>;
+						domain-name = "hse_ker_ck";
+						clocks = <&rcc HSE_KER_CK>;
+					};
+
+					clock@7f {
+						reg = <CK_SCMI_MSI_KER_CK>;
+						domain-name = "msi_ker_ck";
+						clocks = <&rcc MSI_KER_CK>;
+					};
 				};
 			};
 
