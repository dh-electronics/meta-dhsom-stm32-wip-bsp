From 811435e97ee5399d32994996030e85c949673a1e Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 20 May 2026 18:30:43 +0200
Subject: [PATCH 505/913] dt-bindings: soc: stm32: describe GPU

Describe the bindings for STM GPU  for STM32MP23 and STM32MP25 family
including OPP description.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 94f3ca88b88253c53d3cdae547f439da8694ddda dt-bindings: soc: stm32: describe GPU]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I15c23fe5fae2cc8004a593c7ecc49515ec2f8980
---
 .../bindings/soc/stm32/vivante,gc.yaml        | 70 +++++++++++++++++++
 1 file changed, 70 insertions(+)
 create mode 100644 documentation/devicetree/bindings/soc/stm32/vivante,gc.yaml

diff --git a/documentation/devicetree/bindings/soc/stm32/vivante,gc.yaml b/documentation/devicetree/bindings/soc/stm32/vivante,gc.yaml
new file mode 100644
index 000000000..6ec7a6542
--- /dev/null
+++ b/documentation/devicetree/bindings/soc/stm32/vivante,gc.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/stm32/vivante,gc#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: STM32 GPU bindings
+
+maintainers:
+  - Pascal Paillet <p.paillet@foss.st.com>
+
+properties:
+  compatible:
+    const: "st,stm32-gpu"
+
+  "#address-cells":
+    const: 1
+
+  "#size-cells":
+    const: 1
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+
+  gpu-supply:
+    description: "Power supply for the GPU"
+    $ref: "/schemas/regulator/regulator.yaml#"
+
+  operating-points-v2:
+    description: "Operating points for the GPU"
+    $ref: "/schemas/opp/opp-v2.yaml#"
+
+required:
+  - compatible
+  - clocks
+  - gpu-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/clock/stm32mp25-clks.h>
+    gpu0: gpu@48280000 {
+      compatible = "vivante,gc";
+      gpu-supply = <&vddgpu>;
+      clocks = <&rcc CK_BUS_GPU>;
+      operating-points-v2 = <&gpu0_opp_table>;
+    };
+
+    gpu0_opp_table: gpu0-opp-table {
+      compatible = "operating-points-v2";
+
+      opp-800000000 {
+        opp-hz = /bits/ 64 <800000000>;
+        opp-microvolt = <800000>;
+        opp-supported-hw = <0x3>;
+        st,opp-default;
+      };
+
+      opp-900000000 {
+        opp-hz = /bits/ 64 <900000000>;
+        opp-microvolt = <1200000>;
+        opp-supported-hw = <0x2>;
+      };
+    };
+
+...
-- 
