From 9bf6f4d9e3b565a57004efa89cdef25a0f82b693 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Fri, 29 Aug 2025 14:52:23 +0200
Subject: [PATCH 780/913] drivers: scmi-msg: enable extended support for duty
 cycle manangement

On clock attribute command set the extended bit support for duty cycle
management.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 2772c07cb13345dc87fea02c99b7841d44426c64 drivers: scmi-msg: enable extended support for duty cycle manangement]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I338815f98382e35ee27e499de83bfcee3dbae4e5
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/579140
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 core/drivers/scmi-msg/clock.c | 2 ++
 core/drivers/scmi-msg/clock.h | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/core/drivers/scmi-msg/clock.c b/core/drivers/scmi-msg/clock.c
index 50558292d..6cfbce3f6 100644
--- a/core/drivers/scmi-msg/clock.c
+++ b/core/drivers/scmi-msg/clock.c
@@ -162,6 +162,8 @@ static void scmi_clock_attributes(struct scmi_msg *msg)
 	return_values.attributes = plat_scmi_clock_get_state(msg->channel_id,
 							     clock_id);
 
+	return_values.attributes |= SCMI_CLOCK_ATTRIBUTES_EXTENDED_SUPPORT;
+
 	scmi_write_response(msg, &return_values, sizeof(return_values));
 }
 
diff --git a/core/drivers/scmi-msg/clock.h b/core/drivers/scmi-msg/clock.h
index dea90c854..c9b287875 100644
--- a/core/drivers/scmi-msg/clock.h
+++ b/core/drivers/scmi-msg/clock.h
@@ -55,6 +55,8 @@ struct scmi_clock_attributes_a2p {
 
 #define SCMI_CLOCK_NAME_LENGTH_MAX	16
 
+#define SCMI_CLOCK_ATTRIBUTES_EXTENDED_SUPPORT		BIT(27)
+
 struct scmi_clock_attributes_p2a {
 	int32_t status;
 	uint32_t attributes;
-- 
2.53.0

