 #endif
 
 bool stm32mp1_lp_soc_mode_is_supported(uint32_t soc_mode);
-uint32_t stm32mp1_get_lp_soc_mode(uint32_t psci_mode);
+uint32_t stm32mp1_get_lp_soc_mode(void);
 
