From 73e9f8ff54d45469be9b512eec0fd81d7fe877e8 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Tue, 28 Apr 2026 11:12:59 +0200
Subject: [PATCH 357/913] drivers: stm32_cpu_opp: add support of STM32MP15 for
 cpu OPP

Call stm32mp1_clk_compute_all_pll1_settings for
stm32mp15 to configure all PLL1 settings
available.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 8d5fbaefac44ab95b6e899825ff978364d8b050f drivers: stm32_cpu_opp: add support of STM32MP15 for cpu OPP]
Change-Id: I326f4693fe0d61af8a0f2a8f5d943eddcfd1e4c3
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/drivers/stm32_cpu_opp.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/core/drivers/stm32_cpu_opp.c b/core/drivers/stm32_cpu_opp.c
index 311781410..891083504 100644
--- a/core/drivers/stm32_cpu_opp.c
+++ b/core/drivers/stm32_cpu_opp.c
@@ -445,6 +445,7 @@ stm32_cpu_init(const void *fdt, int node, const void *compat_data __unused)
 	int len = 0;
 	uint32_t phandle = 0;
 	TEE_Result res = TEE_SUCCESS;
+	uint16_t __maybe_unused cpu_voltage = 0;
 
 	cuint = fdt_getprop(fdt, node, "operating-points-v2", &len);
 	if (!cuint || len != sizeof(uint32_t)) {
@@ -463,6 +464,13 @@ stm32_cpu_init(const void *fdt, int node, const void *compat_data __unused)
 	phandle = fdt32_to_cpu(*cuint);
 	opp_node = fdt_node_offset_by_phandle(fdt, phandle);
 
+#ifdef CFG_STM32MP15
+	cpu_voltage = regulator_get_voltage(cpu_opp.regul);
+
+	if (stm32mp1_clk_compute_all_pll1_settings(fdt, opp_node, cpu_voltage))
+		panic();
+#endif
+
 	return stm32_cpu_opp_get_dt_subnode(fdt, opp_node);
 }
 
