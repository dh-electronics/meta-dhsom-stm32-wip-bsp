From 6d834d6b02f7f070f00482785068de86eda8d694 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Thu, 18 Jan 2024 12:07:31 +0100
Subject: [PATCH 343/913] plat-stm32mp2: conf: enable TA PKCS11

Default enable CFG_PKCS11_TA for STM32MP2.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 854a1d8df6b56b4443c6e73123ffe445d0be8ee7 plat-stm32mp2: conf: enable TA PKCS11]
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Change-Id: Ifc882ec404989d499da65e9e752e9eaea16fb69a
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/352418
Reviewed-by: Etienne CARRIERE <etienne.carriere@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 core/arch/arm/plat-stm32mp2/conf.mk | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index 91761e629..5f49bbd15 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -259,6 +259,9 @@ $(call force,CFG_STM32_BSEC_PTA,y,Mandated by CFG_TA_STM32MP_NVMEM)
 CFG_IN_TREE_EARLY_TAS += stm32mp_nvmem/1a8342cc-81a5-4512-99fe-9e2b3e37d626
 endif
 
+# Default enable PKCS11 TA to have PKCS11 tests built in OP-TEE Test
+CFG_PKCS11_TA ?= y
+
 # Provisioning support for shadow
 CFG_STM32MP_PROVISIONING ?= y
 ifeq ($(CFG_STM32MP_PROVISIONING),y)
