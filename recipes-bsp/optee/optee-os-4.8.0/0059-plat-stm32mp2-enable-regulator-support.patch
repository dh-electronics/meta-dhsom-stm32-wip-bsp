From a71d8c5acaa9edeed51f438b66a5e264e0476c8e Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Thu, 11 Jan 2024 16:41:27 +0100
Subject: [PATCH 059/913] plat-stm32mp2: enable regulator support

Enables regulator support on stm32mp2 platform.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 4c2892e50d593874467da1c00cc33c597e18c4b0 plat-stm32mp2: enable regulator support]
Change-Id: I6b8161935d0a1dde01793749261c37c750fe93e3
---
 core/arch/arm/plat-stm32mp2/conf.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index ec4a8c2b0..7bf0657e6 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -70,6 +70,7 @@ $(call force,CFG_DRIVERS_CLK,y)
 $(call force,CFG_DRIVERS_CLK_DT,y)
 $(call force,CFG_DRIVERS_GPIO,y)
 $(call force,CFG_DRIVERS_PINCTRL,y)
+$(call force,CFG_DRIVERS_REGULATOR,y)
 $(call force,CFG_DT,y)
 $(call force,CFG_GIC,y)
 $(call force,CFG_HALT_CORES_SGI,15)
@@ -132,6 +133,9 @@ CFG_STM32_SERC ?= y
 CFG_STM32_TAMP ?= y
 CFG_STM32_UART ?= y
 
+CFG_REGULATOR_FIXED ?= y
+CFG_REGULATOR_GPIO ?= y
+
 # Default RTC accuracy, higher accuracy means higher power consumption
 CFG_STM32_RTC_HIGH_ACCURACY ?= n
 
@@ -139,6 +143,7 @@ CFG_SCMI_PTA ?= y
 CFG_SCMI_SCPFW ?= y
 CFG_SCMI_SCPFW_FROM_DT ?= y
 CFG_SCMI_SERVER_CLOCK_CONSUMER ?= y
+CFG_SCMI_SERVER_REGULATOR_CONSUMER ?= y
 CFG_SCMI_SERVER_RESET_CONSUMER ?= y
 # Default enable some test facitilites
 CFG_ENABLE_EMBEDDED_TESTS ?= y
-- 
2.53.0

