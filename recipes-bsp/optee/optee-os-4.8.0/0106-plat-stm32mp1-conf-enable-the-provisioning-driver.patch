From cb3954e02e65fbd136bc2ddc2ef387f2af5054e3 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Tue, 12 Mar 2024 17:30:43 +0100
Subject: [PATCH 106/913] plat-stm32mp1: conf: enable the provisioning driver

Enable the provisioning driver on stm32mp1.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 784daf90dcf7fe7d553a517e2368bb7386185496 plat-stm32mp1: conf: enable the provisioning driver]
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/366594
Change-Id: Iefada19b978b8f1dba368adb668897b02c5eb2c6
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/372974
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index 8fe32f32d..a81522c03 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -307,6 +307,7 @@ CFG_STM32_RTC ?= y
 CFG_STM32_SAES ?= y
 CFG_STM32_TAMP ?= y
 CFG_STM32_UART ?= y
+CFG_STM32MP_PROVISIONING ?= y
 CFG_STPMIC1 ?= y
 CFG_TZC400 ?= y
 
@@ -326,6 +327,12 @@ $(call force,CFG_STM32_I2C,y)
 $(call force,CFG_STM32_GPIO,y)
 endif
 
+# Provisioning support for BSEC shadow OTP is dedicated to insecure
+# development configuration only.
+ifeq ($(CFG_STM32MP_PROVISIONING),y)
+$(call force,CFG_INSECURE,y,Required by CFG_STM32MP_PROVISIONING)
+endif
+
 # If any crypto driver is enabled, enable the crypto-framework layer
 ifeq ($(call cfg-one-enabled, CFG_STM32_CRYP \
 	                      CFG_STM32_HASH \
-- 
