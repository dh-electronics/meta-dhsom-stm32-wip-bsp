From cbe61ecd786caea54dd44f1e90323b4180409742 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 7 May 2026 11:16:56 +0200
Subject: [PATCH 481/913] plat-stm32mp1: conf: enable HSI/CSI clock calibration

Enable HSI and CSI clock calibration in the STM32MP1 platform
configuration to improve internal oscillator accuracy.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 7dca92de6c2ca1c556fc33cf43abd4da13d25b39 plat-stm32mp1: conf: enable HSI/CSI clock calibration]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I3e15689eb4e37a4ad2d2462bc9aa1540dd33884b
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570766
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index 9cd918f4b..3afa05562 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -299,6 +299,7 @@ endif
 $(call force,CFG_STM32MP1_SCMI_SHM_SIZE,0x1000)
 
 CFG_STM32_BSEC ?= y
+CFG_STM32MP1_CLK_CAL ?= y
 CFG_STM32_CPU_OPP ?= y
 CFG_STM32_CRYP ?= y
 CFG_STM32_ETZPC ?= y
@@ -326,6 +327,10 @@ CFG_STM32_RTC_HIGH_ACCURACY ?= n
 CFG_DRIVERS_I2C ?= $(CFG_STM32_I2C)
 CFG_REGULATOR_GPIO ?= $(CFG_STM32_GPIO)
 
+ifeq ($(CFG_STM32MP1_CLK_CAL),y)
+$(call force,CFG_STM32_CLKCALIB_PTA,y)
+endif
+
 CFG_WITH_SOFTWARE_PRNG ?= n
 ifneq ($(CFG_WITH_SOFTWARE_PRNG),y)
 $(call force,CFG_STM32_RNG,y,Required by HW RNG when CFG_WITH_SOFTWARE_PRNG=n)
