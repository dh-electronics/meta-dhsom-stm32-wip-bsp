From a95ba5ccfcb255f75f82fdd8f3cca4edd8562ff9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Thu, 23 Jul 2026 15:26:58 +0200
Subject: [PATCH 870/913] core: boot: replace assert-only NULL checks with real
 checks in pager init
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

assert() compiles to a no-op when NDEBUG is defined, so several
assert()-only guards in init_pager_runtime() did not protect against
a failed allocation in release builds:

- hashes (malloc()) was passed to asan_memcpy_unchecked(), which
  dereferences it.
- mm from nex_phys_mem_ta_alloc() was passed to tee_mm_get_smem() (via
  phys_to_virt()), which dereferences it.
- mm from the tee_mm_alloc2() call for the pager alias area was passed
  to tee_pager_set_alias_area(), which dereferences it.
- mm from the tee_mm_alloc2() call for the pageable area was passed to
  ro_paged_alloc() and tee_mm_get_smem(), both dereferencing it.

Replace all four assert()-only guards with explicit NULL checks that
panic() unconditionally.

Coverity issue: CID 1200635: CERT-C Expression
Coverity issue: CID 1200723: CERT-C POSIX
Coverity issue: CID 1200730: CERT-C Expression
Coverity issue: CID 1200790: CERT-C Error Handling

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 1cab81722d2d153bed3ea9f2eee143f1dcba40be core: boot: replace assert-only NULL checks with real checks in pager init]
Assisted-by: GitHub-Copilot:Claude-Sonnet-5
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Change-Id: I792ae0580e965efdf01f1e5aa662cec7b3401503
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/592846
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/kernel/boot.c | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/core/arch/arm/kernel/boot.c b/core/arch/arm/kernel/boot.c
index 1cce85204..e3d9700ee 100644
--- a/core/arch/arm/kernel/boot.c
+++ b/core/arch/arm/kernel/boot.c
@@ -511,7 +511,8 @@ static void init_pager_runtime(unsigned long pageable_part)
 	hashes = malloc(hash_size);
 	IMSG_RAW("\n");
 	IMSG("Pager is enabled. Hashes: %zu bytes", hash_size);
-	assert(hashes);
+	if (!hashes)
+		panic();
 	asan_memcpy_unchecked(hashes, tmp_hashes, hash_size);
 
 	/*
@@ -523,7 +524,8 @@ static void init_pager_runtime(unsigned long pageable_part)
 	carve_out_asan_mem();
 
 	mm = nex_phys_mem_ta_alloc(pageable_size);
-	assert(mm);
+	if (!mm)
+		panic();
 	paged_store = phys_to_virt(tee_mm_get_smem(mm),
 				   MEM_AREA_SEC_RAM_OVERALL, pageable_size);
 	/*
@@ -582,7 +584,8 @@ static void init_pager_runtime(unsigned long pageable_part)
 			   (vaddr_t)core_virt_mem_pool.lo +
 			   core_virt_mem_pool.size - TZSRAM_SIZE,
 			   TZSRAM_SIZE);
-	assert(mm);
+	if (!mm)
+		panic();
 	tee_pager_set_alias_area(mm);
 
 	/*
@@ -591,7 +594,8 @@ static void init_pager_runtime(unsigned long pageable_part)
 	 */
 	mm = tee_mm_alloc2(&core_virt_mem_pool, VCORE_UNPG_RX_PA,
 			   (vaddr_t)(__pageable_start - VCORE_UNPG_RX_PA));
-	assert(mm);
+	if (!mm)
+		panic();
 
 	/*
 	 * Allocate virtual memory for the pageable area and let the pager
@@ -599,7 +603,8 @@ static void init_pager_runtime(unsigned long pageable_part)
 	 */
 	mm = tee_mm_alloc2(&core_virt_mem_pool, (vaddr_t)__pageable_start,
 			   pageable_size);
-	assert(mm);
+	if (!mm)
+		panic();
 	fobj = ro_paged_alloc(mm, hashes, paged_store);
 	assert(fobj);
 	tee_pager_add_core_region(tee_mm_get_smem(mm), PAGED_REGION_TYPE_RO,
