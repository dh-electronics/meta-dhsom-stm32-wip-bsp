From 7332ad276c7c89f9b516ec8ccc787fcecbcafa0b Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 27 Apr 2026 15:31:42 +0200
Subject: [PATCH 356/913] drivers: clk: stm32mp15: use CFG_STM32MP_OPP_COUNT to
 define the number of operationg points

Use CFG_STM32MP_OPP_COUNT defined in conf.mk
instead of PLAT_MAX_OPP_NB defined in plat data to
align with STM32MP13 and be compliant with the
driver stm32_cpu_opp which requires to define
CFG_STM32MP_OPP_COUNT.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 1c7a6928a4a6473157d8b19ff2b068b33efa4c9d drivers: clk: stm32mp15: use CFG_STM32MP_OPP_COUNT to define the number of operationg points]
Change-Id: Ia75b2a1f68f52a0cde7e15491c4d1fc4f286f111
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 1 +
 core/drivers/clk/clk-stm32mp15.c    | 2 +-
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index 077f2d3f6..eacd9577c 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -236,6 +236,7 @@ $(call force,CFG_STM32_SAES,n)
 $(call force,CFG_STM32MP1_RSTCTRL,y)
 $(call force,CFG_STM32MP15_CLK,y)
 $(call force,CFG_STM32MP_CLK_CORE,y)
+CFG_STM32MP_OPP_COUNT ?= 2
 CFG_CORE_RESERVED_SHM ?= n
 CFG_MULTI_CORE_HALTING ?= y
 CFG_TEE_CORE_NB_CORE ?= 2
diff --git a/core/drivers/clk/clk-stm32mp15.c b/core/drivers/clk/clk-stm32mp15.c
index e2fc4f909..716b105a2 100644
--- a/core/drivers/clk/clk-stm32mp15.c
+++ b/core/drivers/clk/clk-stm32mp15.c
@@ -32,7 +32,7 @@
 #include "clk-stm32-core.h"
 
 #ifdef CFG_STM32_CPU_OPP
-#define MAX_OPP		PLAT_MAX_OPP_NB
+#define MAX_OPP		CFG_STM32MP_OPP_COUNT
 #else
 #define MAX_OPP		(2U)
 #endif
-- 
