From b536e2d6d42daccf1e6d6b51cc909e7f1e91f18f Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Fri, 20 Mar 2026 17:23:28 +0100
Subject: [PATCH 185/913] clk: stm32mp25: remove support of st,clksrc

Remove support of st,clksrc in device tree for OPP configuration node.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 82bd4f6df47941ed98497bce2107dc4d378d29ec clk: stm32mp25: remove support of st,clksrc]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I0f24999e3685b1e250c97c8d6fbc2552d9532af2
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/393484
---
 core/drivers/clk/clk-stm32mp25.c | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/core/drivers/clk/clk-stm32mp25.c b/core/drivers/clk/clk-stm32mp25.c
index 0a39706ff..23276e6a8 100644
--- a/core/drivers/clk/clk-stm32mp25.c
+++ b/core/drivers/clk/clk-stm32mp25.c
@@ -178,7 +178,6 @@ struct stm32_osci_dt_cfg {
 
 struct stm32_clk_opp_cfg {
 	uint32_t frq;
-	uint32_t src;
 	struct stm32_pll_dt_cfg pll_cfg;
 };
 
@@ -1309,9 +1308,6 @@ static int stm32_clk_parse_fdt_opp(const void *fdt, int node,
 		if (fdt_read_uint32(fdt, subnode, "hz", &opp_cfg->frq))
 			panic("hz property is mandatory");
 
-		if (fdt_read_uint32(fdt, subnode, "st,clksrc", &opp_cfg->src))
-			panic("st,clksrc property is mandatory");
-
 		ret = clk_stm32_parse_pll_fdt(fdt, subnode, &opp_cfg->pll_cfg);
 		if (ret < 0)
 			return ret;
-- 
2.53.0

