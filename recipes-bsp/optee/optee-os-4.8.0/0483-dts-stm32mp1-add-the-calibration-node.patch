From d640f025267645f646abeb69882563683f4b95dc Mon Sep 17 00:00:00 2001
From: Lionel Debieve <lionel.debieve@foss.st.com>
Date: Thu, 7 Oct 2021 15:59:06 +0200
Subject: [PATCH 483/913] dts: stm32mp1: add the calibration node

Add the node to manage the calibration at soc level.
It defines the timer used by default with the correct entries.
Calib disabled at soc level.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git ef7efa168e03ec3f5f45ad08070ffe0199b1049d dts: stm32mp1: add the calibration node]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I414a6e7dae58d06fafd3d98e7119588d7ee994ae
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570768
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp131.dtsi | 16 ++++++++++++++++
 core/arch/arm/dts/stm32mp151.dtsi | 16 ++++++++++++++++
 2 files changed, 32 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp131.dtsi b/core/arch/arm/dts/stm32mp131.dtsi
index 9b52e976b..b6eec5515 100644
--- a/core/arch/arm/dts/stm32mp131.dtsi
+++ b/core/arch/arm/dts/stm32mp131.dtsi
@@ -116,6 +116,22 @@
 
 	};
 
+	osc_calibration: osc-calibration {
+		compatible = "st,osc-calibration";
+
+		csi_calibration: csi-calibration {
+			compatible = "st,csi-cal";
+			counter = <&timers12 0 2>;
+			status = "disabled";
+		};
+
+		hsi_calibration: hsi-calibration {
+			compatible = "st,hsi-cal";
+			counter = <&timers12 0 1>;
+			status = "disabled";
+		};
+	};
+
 	scmi_regu: scmi-regu {
 		compatible = "st,scmi-regulator-consumer";
 		#address-cells = <1>;
diff --git a/core/arch/arm/dts/stm32mp151.dtsi b/core/arch/arm/dts/stm32mp151.dtsi
index 35f7a80ac..4d720606b 100644
--- a/core/arch/arm/dts/stm32mp151.dtsi
+++ b/core/arch/arm/dts/stm32mp151.dtsi
@@ -139,6 +139,22 @@
 		status = "disabled";
 	};
 
+	osc_calibration: osc-calibration {
+		compatible = "st,osc-calibration";
+
+		csi_calibration: csi-calibration {
+			compatible = "st,csi-cal";
+			counter = <&timers15 0 8>;
+			status = "disabled";
+		};
+
+		hsi_calibration: hsi-calibration {
+			compatible = "st,hsi-cal";
+			counter = <&timers15 0 7>;
+			status = "disabled";
+		};
+	};
+
 	soc {
 		compatible = "simple-bus";
 		#address-cells = <1>;
-- 
2.53.0

