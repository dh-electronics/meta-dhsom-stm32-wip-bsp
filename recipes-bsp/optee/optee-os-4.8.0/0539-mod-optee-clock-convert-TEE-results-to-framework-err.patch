From 40b130bde7d6f87749fc0d9e949c05c921b13a91 Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Wed, 24 Jan 2024 07:59:29 +0100
Subject: [PATCH 539/913] mod/optee/clock: convert TEE results to framework
 error statuses

Use scmi_tee_result_to_fwk_status() to convert TEE results into
framework errors in module OP-TEE clock.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git b687c4dfbe1db3f142a149db0633232c0e00618f mod/optee/clock: convert TEE results to framework error statuses]
Change-Id: I0878539e1ed3714fcc86113f636f88d18d9735ca
Signed-off-by: Theo GOUREAU <theo.goureau-ext@st.com>
---
 .../common/module/clock/src/mod_optee_clock.c    | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/core/lib/scmi-server/SCP-firmware/product/optee/common/module/clock/src/mod_optee_clock.c b/core/lib/scmi-server/SCP-firmware/product/optee/common/module/clock/src/mod_optee_clock.c
index 23af994f0..1e41128e7 100644
--- a/core/lib/scmi-server/SCP-firmware/product/optee/common/module/clock/src/mod_optee_clock.c
+++ b/core/lib/scmi-server/SCP-firmware/product/optee/common/module/clock/src/mod_optee_clock.c
@@ -207,6 +207,8 @@ static int get_range(fwk_id_t dev_id, struct mod_clock_range *range)
             range->min = clk_get_rate(ctx->clk);
             range->max = range->min;
             range->rate_count = 1;
+        } else if (res != TEE_SUCCESS) {
+            return scmi_tee_result_to_fwk_status(res);
         }
 
         range->rate_type = MOD_CLOCK_RATE_TYPE_CONTINUOUS;
@@ -216,7 +218,7 @@ static int get_range(fwk_id_t dev_id, struct mod_clock_range *range)
 
         return FWK_SUCCESS;
     } else if (res != TEE_SUCCESS) {
-        return FWK_E_DEVICE;
+        return scmi_tee_result_to_fwk_status(res);
     }
 
     range->rate_type = MOD_CLOCK_RATE_TYPE_DISCRETE;
@@ -252,10 +254,8 @@ static int set_rate(
     }
 
     res = clk_set_rate(ctx->clk, rate);
-    if (res == TEE_ERROR_NOT_SUPPORTED) {
-        return FWK_E_SUPPORT;
-    } else if (res != TEE_SUCCESS) {
-        return FWK_E_DEVICE;
+    if (res) {
+        return scmi_tee_result_to_fwk_status(res);
     }
 
     FWK_LOG_DEBUG(
@@ -295,7 +295,7 @@ static int get_rate_from_index(
         *rate = clk_get_rate(ctx->clk);
         return FWK_SUCCESS;
     } else if (res != TEE_SUCCESS) {
-        return FWK_E_DEVICE;
+        return scmi_tee_result_to_fwk_status(res);
     }
 
     if (rate_index > rate_count) {
@@ -347,7 +347,7 @@ static int get_duty_cycle(fwk_id_t dev_id, uint32_t *num, uint32_t *den)
         /* Assume a 50% duty cycle */
         duty = (struct clk_duty_cycle){ .num = 1, .den = 2 };
     } else if (res != TEE_SUCCESS) {
-        return FWK_E_DEVICE;
+        return scmi_tee_result_to_fwk_status(res);
     }
 
     *num = duty.num;
@@ -417,7 +417,7 @@ static int optee_clock_element_init(
         if (ctx->enabled) {
             res = clk_enable(ctx->clk);
             if (res) {
-                return FWK_E_DEVICE;
+                return scmi_tee_result_to_fwk_status(res);
             }
         }
     }
