From 04be7ed93b736428df8557b6211879f828216e2b Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Fri, 14 Feb 2025 14:33:55 +0100
Subject: [PATCH 541/913] arch/optee: fix CFG_SCPFW_MOD_* for product modules

Build directive CFG_SCPFW_MOD_PSU_OPTEE_REGULATOR refer to product
specific modules in SCP-firmware hence this directive must be defined in
the product CMakeLists.txt files, not in the arch/none/optee/CMakeLists.txt
file.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git e766651aa379752a4cecdf252280285665e42f9f arch/optee: fix CFG_SCPFW_MOD_* for product modules]
Change-Id: I4e0bb38b17131da8786d9d76710c60a0d9994182
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
---
 core/lib/scmi-server/SCP-firmware/arch/none/optee/CMakeLists.txt | 1 -
 1 file changed, 1 deletion(-)

diff --git a/core/lib/scmi-server/SCP-firmware/arch/none/optee/CMakeLists.txt b/core/lib/scmi-server/SCP-firmware/arch/none/optee/CMakeLists.txt
index 44b606cfc..2457495b2 100644
--- a/core/lib/scmi-server/SCP-firmware/arch/none/optee/CMakeLists.txt
+++ b/core/lib/scmi-server/SCP-firmware/arch/none/optee/CMakeLists.txt
@@ -17,7 +17,6 @@ set (CFG_SCPFW_MOD_MSG_SMT n)
 set (CFG_SCPFW_MOD_OPTEE_CONSOLE n)
 set (CFG_SCPFW_MOD_OPTEE_CLOCK n)
 set (CFG_SCPFW_MOD_OPTEE_MBX n)
-set (CFG_SCPFW_MOD_PSU_OPTEE_REGULATOR n)
 set (CFG_SCPFW_MOD_OPTEE_RESET n)
 set (CFG_SCPFW_MOD_OPTEE_SMT n)
 set (CFG_SCPFW_MOD_OPTEE_VOLTD_REGULATOR n)
-- 
