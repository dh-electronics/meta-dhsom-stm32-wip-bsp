From fdc32597ef3e356345f8c02a5ffa71a6b4c2f879 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Cl=C3=A9ment=20Le=20Goffic?= <clement.legoffic@foss.st.com>
Date: Thu, 2 May 2024 13:49:03 +0200
Subject: [PATCH 116/913] dts: stm32: add console to stm32mp215f-dk
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Enable usart2 on stm32mp215f-dk.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git e7a5c0c14ccf447025c63151ce3faf1d776e4912 dts: stm32: add console to stm32mp215f-dk]
Change-Id: I6ada936b11ee1566b8345bc453bf3e73c0ce417e
Signed-off-by: Clément Le Goffic <clement.legoffic@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/377758
Domain-Review: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
---
 core/arch/arm/dts/stm32mp215f-dk.dts | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp215f-dk.dts b/core/arch/arm/dts/stm32mp215f-dk.dts
index ff97fd063..f75e1849e 100644
--- a/core/arch/arm/dts/stm32mp215f-dk.dts
+++ b/core/arch/arm/dts/stm32mp215f-dk.dts
@@ -12,12 +12,22 @@
 #include "stm32mp21xf.dtsi"
 #include "stm32mp215f-dk-ca35tdcid-rcc.dtsi"
 #include "stm32mp215f-dk-ca35tdcid-rif.dtsi"
+#include "stm32mp21-pinctrl.dtsi"
 #include "stm32mp21-st-scmi-cfg.dtsi"
+#include "stm32mp21xxan-pinctrl.dtsi"
 
 / {
 	model = "STMicroelectronics STM32MP215F-DK Discovery Board";
 	compatible = "st,stm32mp215f-dk", "st,stm32mp215";
 
+	aliases {
+		serial0 = &usart2;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
 	memory@80000000 {
 		device_type = "memory";
 		reg = <0x0 0x80000000 0x0 0x80000000>;
@@ -332,3 +342,10 @@
 		};
 	};
 };
+
+&usart2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&usart2_pins_a>;
+	status = "okay";
+};
+
-- 
