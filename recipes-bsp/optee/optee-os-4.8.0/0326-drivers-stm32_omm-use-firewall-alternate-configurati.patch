From cd9519131d0bf6c419b67f2659b679e23bedce0c Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Thu, 4 Jul 2024 10:04:20 +0200
Subject: [PATCH 326/913] drivers: stm32_omm: use firewall alternate
 configuration APIs

Drivers apply alternate configurations, use:
firewall_dt_get_alternate_conf() and firewall_set_alternate_conf()
to apply OSPI RIF configuration after driver management.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 05af0c3b85a6bca8accd2c3a5e9c8212b5193d14 drivers: stm32_omm: use firewall alternate configuration APIs]
Change-Id: I5a85da011447695ed87f82d1b8ca80008bc182c9
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/391366
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/drivers/stm32_omm.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/core/drivers/stm32_omm.c b/core/drivers/stm32_omm.c
index 487a7668a..931f9f2a2 100644
--- a/core/drivers/stm32_omm.c
+++ b/core/drivers/stm32_omm.c
@@ -7,6 +7,7 @@
 #include <config.h>
 #include <drivers/clk.h>
 #include <drivers/clk_dt.h>
+#include <drivers/firewall_device.h>
 #include <drivers/rstctrl.h>
 #include <drivers/stm32_gpio.h>
 #include <io.h>
@@ -76,6 +77,7 @@ struct stm32_omm_pdata {
 	struct pinctrl_state *pinctrl_s;
 	struct stm32_ospi_pdata ospi_d[OSPI_NB];
 	struct stm32_mm_region region;
+	struct firewall_alt_conf *firewall_conf;
 	vaddr_t base;
 	uint32_t mux;
 	uint32_t cssel_ovr;
@@ -128,6 +130,10 @@ static TEE_Result stm32_omm_parse_fdt(const void *fdt, int node)
 	if (res && res != TEE_ERROR_ITEM_NOT_FOUND)
 		return res;
 
+	res = firewall_dt_get_alternate_conf(fdt, node, "default",
+					     &omm_d->firewall_conf);
+	if (res)
+		return res;
 	omm_d->mux = fdt_read_uint32_default(fdt, node, "st,omm-mux", 0);
 	omm_d->req2ack = fdt_read_uint32_default(fdt, node,
 						 "st,omm-req2ack-ns", 0);
@@ -321,6 +327,9 @@ static void stm32_omm_setup(void)
 	stm32_omm_configure();
 	if (omm_d->pinctrl_d && pinctrl_apply_state(omm_d->pinctrl_d))
 		panic();
+
+	if (firewall_set_alternate_conf(omm_d->firewall_conf))
+		panic();
 }
 
 static void stm32_omm_suspend(void)
-- 
2.53.0

