From d112415bd04a3a8289b9d0302b5266d1bff2862b Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 4 Mar 2026 09:46:23 +0100
Subject: [PATCH 121/913] dts: stm32: add node stgen on stm32mp21

Add support of STGEN on stm32mp21 in stm32mp211.dtsi

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 0d583f27cc17c87278dc02fbbc4667b54625b4aa dts: stm32: add node stgen on stm32mp21]
Change-Id: I9ffff922a56247b87ace120f59d758f6e3123d6e
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp211.dtsi | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index 704151bb3..41c4a69c2 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -488,5 +488,12 @@
 				status = "disabled";
 			};
 		};
+
+		stgenc: stgen@48080000 {
+			compatible = "st,stm32mp25-stgen";
+			reg = <0x48080000 0x1000>;
+			clocks = <&rcc CK_BUS_STGEN>, <&rcc CK_KER_STGEN>;
+			clock-names = "bus", "stgen_clk";
+		};
 	};
 };
-- 
