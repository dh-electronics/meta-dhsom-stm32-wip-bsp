From 2f0709f2e9f3ebe48eed01d6c5df7c2823330e2e Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 13 Apr 2026 17:26:58 +0200
Subject: [PATCH 304/913] dts: st: define pka node in stm32mp23xc.dtsi

Add node pka in stm32mp23xc.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git da595ecc1f0384f7036544187b7e7fd165bbcb11 dts: st: define pka node in stm32mp23xc.dtsi]
Change-Id: I70603103158eebd023eedac6a1ca4e8f8db4b217
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/557101
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/dts/stm32mp23xc.dtsi | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp23xc.dtsi b/core/arch/arm/dts/stm32mp23xc.dtsi
index 2269cd331..4ffbd8836 100644
--- a/core/arch/arm/dts/stm32mp23xc.dtsi
+++ b/core/arch/arm/dts/stm32mp23xc.dtsi
@@ -35,4 +35,15 @@
 		access-controllers = <&rifsc STM32MP25_RIFSC_SAES_ID>;
 		status = "disabled";
 	};
+
+	pka: pka@42060000 {
+		compatible = "st,stm32mp13-pka64";
+		reg = <0x42060000 0x2000>;
+		interrupts = <GIC_SPI 146 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&rcc CK_BUS_PKA>, <&rcc CK_BUS_RNG>;
+		clock-names = "bus", "rng";
+		resets = <&rcc PKA_R>;
+		access-controllers = <&rifsc STM32MP25_RIFSC_PKA_ID>;
+		status = "disabled";
+	};
 };
