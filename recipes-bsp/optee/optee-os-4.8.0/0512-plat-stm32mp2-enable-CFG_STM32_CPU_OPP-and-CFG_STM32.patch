From a994d6a2667869bff6553f0195ce8e128d31fa4e Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Tue, 19 May 2026 18:32:48 +0200
Subject: [PATCH 512/913] plat-stm32mp2: enable CFG_STM32_CPU_OPP and
 CFG_STM32_GPU_OPP

Enable by default the OPP drivers on MP2* targets with
CFG_STM32_CPU_OPP and CFG_STM32_GPU_OPP.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git b83034760e666166ce27e9271da23c105bf06d04 plat-stm32mp2: enable CFG_STM32_CPU_OPP and CFG_STM32_GPU_OPP]
Change-Id: I946b0bc65ba7973bea10e9dafb020979498d9066
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
---
 core/arch/arm/plat-stm32mp2/conf.mk | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index 0fed1bcf9..de523bf8f 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -91,6 +91,8 @@ $(call force,CFG_SCMI_SERVER_CLOCK_CONSUMER,n)
 $(call force,CFG_SCMI_SERVER_REGULATOR_CONSUMER,n)
 $(call force,CFG_SCMI_SERVER_RESET_CONSUMER,n)
 $(call force,CFG_STM32_BSEC_WRITE,n)
+$(call force,CFG_STM32_CPU_OPP,n)
+$(call force,CFG_STM32_GPU_OPP,n)
 $(call force,CFG_STM32_PWR_REGUL,n)
 $(call force,CFG_STM32_TAMP,n)
 $(call force,CFG_STM32MP_PROVISIONING,n)
@@ -165,10 +167,12 @@ CFG_STM32MP_OPP_COUNT ?= 3
 
 CFG_STM32_BSEC3 ?= y
 CFG_STM32_BSEC_WRITE ?= y
+CFG_STM32_CPU_OPP ?= y
 CFG_STM32_CRYP ?= y
 CFG_STM32_EXTI ?= y
 CFG_STM32_FMC ?= y
 CFG_STM32_GPIO ?= y
+CFG_STM32_GPU_OPP ?= y
 CFG_STM32_HASH ?= y
 CFG_STM32_HPDMA ?= y
 CFG_STM32_HSEM ?= y
-- 
