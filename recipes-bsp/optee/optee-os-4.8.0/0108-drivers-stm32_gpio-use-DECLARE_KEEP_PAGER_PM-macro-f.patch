From 2ffdb34d9679fa15705a145993487f29552216e8 Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Wed, 11 Sep 2024 18:14:12 +0200
Subject: [PATCH 108/913] drivers: stm32_gpio: use DECLARE_KEEP_PAGER_PM macro
 for power ops

Downstream 957d1ca66ab0 restricted to stm32_gpio.c

Replace DECLARE_KEEP_PAGER() directives with DECLARE_KEEP_PAGER_PM()
for resources that need to be unpaged for PM sequence support. This
change covers the resources used by generic core and stm32mp15
platforms.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git d4652b41a726e510af1ffda69f290da8d24142d7 drivers: stm32_gpio: use DECLARE_KEEP_PAGER_PM macro for power ops]
Change-Id: I4e847ab0a19e5b290b083ef8e0a5aa436b32840f
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/392007
---
 core/drivers/stm32_gpio.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/core/drivers/stm32_gpio.c b/core/drivers/stm32_gpio.c
index e6d385273..a907a5aba 100644
--- a/core/drivers/stm32_gpio.c
+++ b/core/drivers/stm32_gpio.c
@@ -17,6 +17,7 @@
 #include <dt-bindings/gpio/stm32mp_gpio.h>
 #include <dt-bindings/pinctrl/stm32-pinfunc.h>
 #include <io.h>
+#include <keep.h>
 #include <kernel/dt.h>
 #include <kernel/boot.h>
 #include <kernel/panic.h>
@@ -811,7 +812,7 @@ static TEE_Result consumed_gpios_pm(enum pm_op op,
 
 	return TEE_SUCCESS;
 }
-DECLARE_KEEP_PAGER(consumed_gpios_pm);
+DECLARE_KEEP_PAGER_PM(consumed_gpios_pm);
 
 static TEE_Result stm32_gpio_get_dt(struct dt_pargs *pargs, void *data,
 				    struct gpio **out_gpio)
@@ -1616,7 +1617,7 @@ stm32_gpio_sec_config_pm(enum pm_op op, unsigned int pm_hint,
 
 	return ret;
 }
-DECLARE_KEEP_PAGER(stm32_gpio_sec_config_pm);
+DECLARE_KEEP_PAGER_PM(stm32_gpio_sec_config_pm);
 
 /*
  * Several pinctrl nodes can be probed. Their bank will be put in the unique
-- 
