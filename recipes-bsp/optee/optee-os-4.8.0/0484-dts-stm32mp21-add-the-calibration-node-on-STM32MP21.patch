From 26dcb7af4382b16dbceea9c2c7803920de85f77d Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 7 May 2026 08:26:21 +0200
Subject: [PATCH 484/913] dts: stm32mp21: add the calibration node on STM32MP21

Add the node to manage the calibration at soc level.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 7a813ec3ac590d229033fc36156b9c6fa082c7f4 dts: stm32mp21: add the calibration node on STM32MP21]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I453efe5ce8bfcaccbdde480e3cbc1ca8e20c99ff
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570769
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/dts/stm32mp211.dtsi | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index b40f7af2f..73a272c06 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -633,6 +633,18 @@
 				 <&clk_lsi>, <&clk_msi>, <&clk_i2sin>;
 			clock-names = "clk-hse", "clk-hsi", "clk-lse",
 				      "clk-lsi", "clk-msi", "clk-i2sin";
+
+			hsi_calibration: hsi-calibration {
+				compatible = "st,hsi-cal";
+				st,cal_hsi_dev = <31>;
+				st,cal_hsi_ref = <1953>;
+				status = "disabled";
+			};
+
+			msi_calibration: msi-calibration {
+				compatible = "st,msi-cal";
+				status = "disabled";
+			};
 		};
 
 		pwr: pwr@44210000 {
-- 
2.53.0

