index 000000000..17bc94da3
--- /dev/null
+++ b/core/lib/scmi-server/SCP-firmware/product/tfm/stm32mp2/module/stm32_pd/include/mod_stm32_pd.h
@@ -0,0 +1,30 @@
+/*
