+target_sources(${SCP_MODULE_TARGET}
+               PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src/mod_tfm_smt.c")
+
+target_link_libraries(${SCP_MODULE_TARGET} PRIVATE module-scmi)
