+const static int agent_type[] = {
+    [STM32MP25_AGENT_ID_M33_NS] = SCMI_AGENT_TYPE_MANAGEMENT,
+    [STM32MP25_AGENT_ID_CA35] = SCMI_AGENT_TYPE_OSPM,
+    [STM32MP25_AGENT_ID_CA35_BL31] = SCMI_AGENT_TYPE_PSCI
+};
