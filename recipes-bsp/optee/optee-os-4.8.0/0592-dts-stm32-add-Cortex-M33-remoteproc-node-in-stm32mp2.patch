From 03abd7e28e9d438cc2e3a16c985be393904c72a0 Mon Sep 17 00:00:00 2001
From: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Date: Tue, 12 May 2026 17:49:38 +0200
Subject: [PATCH 592/913] dts: stm32: add Cortex-M33 remoteproc node in
 stm32mp231.dtsi

Introduces the m33_rproc node under the mlahb simple bus.
This declaration is a aligned with the Linux DT.
The mlahb bus provides memory translation between
the Cortex-M and Cortex-A memory mappings.
For the STM32MP2, no memory translation is needed, and the
dma-ranges is declared accordingly.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 591eb0aa6a683e969aac1312637028e299f0439b dts: stm32: add Cortex-M33 remoteproc node in stm32mp231.dtsi]
Signed-off-by: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Change-Id: I40b72d355a937eae6f131331df48a90cb47cbca8
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570904
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
---
 core/arch/arm/dts/stm32mp231.dtsi | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp231.dtsi b/core/arch/arm/dts/stm32mp231.dtsi
index 80bd846ba..5e3229228 100644
--- a/core/arch/arm/dts/stm32mp231.dtsi
+++ b/core/arch/arm/dts/stm32mp231.dtsi
@@ -1140,4 +1140,25 @@
 			status = "disabled";
 		};
 	};
+
+	mlahb: ahb@1 {
+		compatible = "st,mlahb", "simple-bus";
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges = <0x0 0x0 0x0 0xFFFFFFFC>;
+		dma-ranges = <0x00000000 0x0 0x80000000 0x08000000>,
+			     <0x08000000 0x0 0x08000000 0x08000000>,
+			     <0x10000000 0x0 0x80000000 0x10000000>,
+			     <0x20000000 0x0 0x20000000 0xD0000000>;
+
+		m33_rproc: m33@0 {
+			compatible = "st,stm32mp2-m33";
+			#reset-cells = <1>;
+			reg = <0 0>;
+			resets = <&rcc C2_R>,
+				 <&rcc C2_HOLDBOOT_R>;
+			reset-names = "mcu_rst", "hold_boot";
+			status = "disabled";
+		};
+	};
 };
