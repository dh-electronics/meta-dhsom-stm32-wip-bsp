From 7fc9ed68aa17234c706275f9b944d7f1a77f3c96 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Fri, 13 Jun 2025 15:57:01 +0200
Subject: [PATCH 703/913] plat-stm32mp1: tzc400: reconfigure only when context
 had been lost

If not, the region0 is reconfigured during LP-STOP2 or STOP2, which is not
useful as the configuration is still valid.

And re-configuring with a valid context could produce this issue:
tzc_it_handler:81 TZC permission failure
dump_fail_filter:420 Permission violation on filter 0
dump_fail_filter:425 Violation @0xc2193d80, non-secure privileged write,
	AXI ID 480
Panic

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 7e556a7ccdf965330aead717a5a3602ec346cf61 plat-stm32mp1: tzc400: reconfigure only when context had been lost]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: Ibcc8f89f5e418b07d67498dd198372fcfba5a4c8
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/501262
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Reviewed-by: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/plat-stm32mp1/plat_tzc400.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/plat_tzc400.c b/core/arch/arm/plat-stm32mp1/plat_tzc400.c
index a1ac2cf49..2a5b3a448 100644
--- a/core/arch/arm/plat-stm32mp1/plat_tzc400.c
+++ b/core/arch/arm/plat-stm32mp1/plat_tzc400.c
@@ -446,14 +446,16 @@ static TEE_Result stm32mp_tzc_parse_fdt(struct tzc_device *tzc_dev,
 	return TEE_SUCCESS;
 }
 
-static TEE_Result stm32mp1_tzc_pm(enum pm_op op,
-				  unsigned int pm_hint __unused,
+static TEE_Result stm32mp1_tzc_pm(enum pm_op op, unsigned int pm_hint,
 				  const struct pm_callback_handle *hdl)
 {
 	unsigned int i = 0;
 	struct tzc_device *tzc_dev =
 		(struct tzc_device *)PM_CALLBACK_GET_HANDLE(hdl);
 
+	if (!PM_HINT_IS_STATE(pm_hint, CONTEXT))
+		return TEE_SUCCESS;
+
 	if (op == PM_OP_RESUME) {
 		stm32mp_tzc_region0(true);
 
