From 2f71e6fa7f49a724ba8ef349b580cdee144ac420 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Tue, 24 Mar 2026 11:21:43 +0100
Subject: [PATCH 359/913] plat-stm32mp1: conf: set 1ms for OPP latency on
 STM32MP15

Set the same OPP latency on STM32MP13 and STM32MP15 of 1ms.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 529a3182f57c76eadab89b7b5b4a35f94c0b7efe plat-stm32mp1: conf: set 1ms for OPP latency on STM32MP15]
Change-Id: I74e08e17ec1fd4fecf02d7225f3ff739b61511af
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index 9786b6b79..dedb8f117 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -218,8 +218,6 @@ $(call force,CFG_STM32MP13_REGULATOR_IOD,y)
 $(call force,CFG_TEE_CORE_NB_CORE,1)
 $(call force,CFG_WITH_NSEC_GPIOS,n)
 CFG_STM32MP_OPP_COUNT ?= 3
-# Measured latency on STM32MP13 is around 650uS so set 1mS
-CFG_STM32MP_OPP_LATENCY_US ?= 1000
 CFG_STM32_ADC ?= y
 CFG_WITH_PAGER ?= n
 endif # CFG_STM32MP13
@@ -377,6 +375,9 @@ ifeq ($(CFG_STM32_BSEC_PTA),y)
 $(call force,CFG_STM32_BSEC,y,Required by CFG_STM32_BSEC_PTA)
 endif
 
+# Measured latency on STM32MP13 is around 650uS so set 1mS
+# Set the same latency for STM32MP13 and STM32MP15
+CFG_STM32MP_OPP_LATENCY_US ?= 1000
 
 # Force enable SCMI PTA support
 $(call force,CFG_SCMI_PTA,y)
-- 
2.53.0

