From 2b2ff329f27a33a7da3de8afcf0e3becb8789fa9 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Mon, 8 Jun 2026 13:48:07 +0200
Subject: [PATCH 732/913] plat-stm32mp1: conf: disable DYN_CONFIG

With this config, the stack pointer will be allocated in a virtual space.
stm32mp_pm_call_bl2_lp_entry() disables the MMU, the cache and jumps
into TF-A to manipulate the stack pointer. Stack pointer should be
allocated in 1 for 1 memory space.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git d4b6292873061f2c807a7eeae8ece74cebf5afda plat-stm32mp1: conf: disable DYN_CONFIG]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: I63553fd5d9d7b0c0ae9bd1dfc4db43879c7da697
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/576477
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index dec6a02a2..af7352f6f 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -191,6 +191,11 @@ CFG_EXTERNAL_DT ?= n
 
 include core/arch/arm/cpu/cortex-a7.mk
 
+# Disable DYN_CONFIG to avoid issues during low power sequences:
+# stm32mp_pm_call_bl2_lp_entry() needs the stack pointer to be mapped
+# 1 for 1 and not in a virtual space.
+$(call force,CFG_DYN_CONFIG,n)
+
 $(call force,CFG_ARM_GIC_PM,y)
 $(call force,CFG_DRIVERS_CLK,y)
 $(call force,CFG_DRIVERS_CLK_DT,y)
-- 
2.53.0

