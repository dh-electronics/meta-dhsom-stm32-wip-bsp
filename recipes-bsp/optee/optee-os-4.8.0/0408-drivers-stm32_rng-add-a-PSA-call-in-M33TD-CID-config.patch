From d77a97151c99b3bcabd599ab4d0729943fbafe63 Mon Sep 17 00:00:00 2001
From: Michel JAOUEN <michel.jaouen@st.com>
Date: Mon, 10 Feb 2025 15:56:57 +0100
Subject: [PATCH 408/913] drivers: stm32_rng: add a PSA call in M33TD CID
 config

On some M33TD CID config (i.e stm32mp2xx) rng IP is not accessible
by optee. A psa call is used.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git e73773b311bac7a1186ee0ada970655112c12d87 drivers: stm32_rng: add a PSA call in M33TD CID config]
Change-Id: I0eb961678294a4bb2e81d3bc51636b2509b35741
Signed-off-by: Michel JAOUEN <michel.jaouen@st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/437597
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
(cherry picked from commit 2bad82c20cd671ed8cadebe7b7e42aac62f49e63)
---
 core/drivers/stm32_rng.c | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/core/drivers/stm32_rng.c b/core/drivers/stm32_rng.c
index edf756d01..2a724317a 100644
--- a/core/drivers/stm32_rng.c
+++ b/core/drivers/stm32_rng.c
@@ -18,6 +18,7 @@
 #include <kernel/thread.h>
 #include <libfdt.h>
 #include <mm/core_memprot.h>
+#include <psa/crypto.h>
 #include <rng_support.h>
 #include <stdbool.h>
 #include <stm32_util.h>
@@ -465,14 +466,22 @@ void plat_rng_init(void)
 	uint8_t seed[RNG_FIFO_BYTE_DEPTH] = { };
 
 	if (!stm32_rng) {
-		__plat_rng_init();
-		DMSG("PRNG seeded without RNG");
-		return;
-	}
+		if (IS_ENABLED(CFG_STM32_PSA_SERVICE)) {
 
+			if (psa_generate_random(seed, sizeof(seed)) !=
+			    PSA_SUCCESS)
+				panic();
+			goto init;
+		} else {
+			__plat_rng_init();
+			DMSG("PRNG seeded without RNG");
+			return;
+		}
+	}
 	if (stm32_rng_read(seed, sizeof(seed)))
 		panic();
 
+init:
 	if (crypto_rng_init(seed, sizeof(seed)))
 		panic();
 
-- 
