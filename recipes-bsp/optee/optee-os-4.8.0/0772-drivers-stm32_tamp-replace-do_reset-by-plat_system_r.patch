From cc6b6cbcc5e3d38d901575ffa0db939395b6d3d4 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Fri, 12 Jun 2026 11:22:08 +0200
Subject: [PATCH 772/913] drivers: stm32_tamp: replace do_reset() by
 plat_system_reset()

Replace do_reset() that is defined in stm32_util.h by the generic
function plat_system_reset() defined in boot.h

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 55d2b8302c74fb4345e1f1cfc814018efb67d668 drivers: stm32_tamp: replace do_reset() by plat_system_reset()]
Change-Id: Iffb28a1740f8e9082b0e598aa322cf0eceb9be60
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/578197
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/drivers/stm32_tamp.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/core/drivers/stm32_tamp.c b/core/drivers/stm32_tamp.c
index a5f088f07..bec3d82cf 100644
--- a/core/drivers/stm32_tamp.c
+++ b/core/drivers/stm32_tamp.c
@@ -28,6 +28,7 @@
 #endif /* defined(CFG_STM32MP25) || defined(CFG_STM32MP23) || defined(CFG_STM32MP21) */
 #include <drivers/stm32mp_dt_bindings.h>
 #include <io.h>
+#include <kernel/boot.h>
 #include <kernel/dt.h>
 #include <kernel/dt_driver.h>
 #include <kernel/interrupt.h>
@@ -1102,7 +1103,7 @@ static enum itr_return stm32_tamp_it_handler(struct itr_handler *h __unused)
 				stm32_tamp_handle_lse_tamper();
 
 			if (ret & TAMP_CB_RESET)
-				do_reset("Internal tamper event detected");
+				plat_system_reset("Internal tamper event");
 		}
 		i++;
 	}
@@ -1127,7 +1128,7 @@ static enum itr_return stm32_tamp_it_handler(struct itr_handler *h __unused)
 					     _TAMP_SCR_ETAMP(id));
 
 			if (ret & TAMP_CB_RESET)
-				do_reset("External tamper event detected");
+				plat_system_reset("External tamper event");
 		}
 		i++;
 	}
-- 
