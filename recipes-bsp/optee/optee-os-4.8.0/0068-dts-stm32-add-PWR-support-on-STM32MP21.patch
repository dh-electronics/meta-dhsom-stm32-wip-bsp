From 8abf9bbfc5a29671b569fe17170e702d801db419 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 29 Oct 2025 13:11:00 +0100
Subject: [PATCH 068/913] dts: stm32: add PWR support on STM32MP21

Add node PWR in stm32mp211.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 011d50c7eac5a3764fbc70d9356515f78f4e311b dts: stm32: add PWR support on STM32MP21]
Change-Id: Iac0913ea8df5d100c6e25dc9a26b54a114e97a78
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp211.dtsi | 41 +++++++++++++++++++++++++++++++
 1 file changed, 41 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index 5949c6d05..d4169df96 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -176,6 +176,47 @@
 				      "clk-lsi", "clk-msi", "clk-i2sin";
 		};
 
+		pwr: pwr@44210000 {
+			compatible = "st,stm32mp21-pwr";
+			reg = <0x44210000 0x400>;
+			status = "disabled";
+
+			vdda18adc: vdda18adc {
+				compatible = "st,stm32mp21-pwr-regu";
+				regulator-name = "vdda18adc";
+				status = "disabled";
+			};
+
+			vddio1: vddio1 {
+				compatible = "st,stm32mp21-pwr-regu";
+				regulator-name = "vddio1";
+				st,iocomp = <8 7>;
+				status = "disabled";
+			};
+
+			vddio2: vddio2 {
+				compatible = "st,stm32mp21-pwr-regu";
+				regulator-name = "vddio2";
+				st,iocomp = <8 7>;
+				status = "disabled";
+			};
+
+			vddio3: vddio3 {
+				compatible = "st,stm32mp21-pwr-regu";
+				regulator-name = "vddio3";
+				st,iocomp = <8 7>;
+				status = "disabled";
+			};
+
+			vddio: vddio {
+				compatible = "st,stm32mp21-pwr-regu";
+				regulator-name = "vddio";
+				st,iocomp = <8 7>;
+				regulator-always-on;
+				status = "disabled";
+			};
+		};
+
 		syscfg: syscon@44230000 {
 			reg = <0x44230000 0x10000>;
 			status = "disabled";
-- 
2.53.0

