From 10df0131ae09dec2e248261393a088c6500f3309 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Thu, 28 Nov 2024 09:03:12 +0100
Subject: [PATCH 195/913] clk: stm32mp21: configure STGEN flexgen in .enable
 ops

STGEN flexgen is skipped during RCC probe to prevent misalignment
between stgen_clk frequency and STGEN register.
In .enable ops, reparent flexgen33 clock to the clock source found in
the device tree.
This allow the driver stm32_stgen driver to align the STGEN
configuration just after the configuration of the STGEN flexgen.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git f715128319a126261a06943b317211f6fe61732a clk: stm32mp21: configure STGEN flexgen in .enable ops]
Change-Id: I902107056c7174ff866d6f9c7b897b4d4cb7a121
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/416439
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/426777
---
 core/drivers/clk/clk-stm32mp21.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/core/drivers/clk/clk-stm32mp21.c b/core/drivers/clk/clk-stm32mp21.c
index 3b7994687..ccb191b65 100644
--- a/core/drivers/clk/clk-stm32mp21.c
+++ b/core/drivers/clk/clk-stm32mp21.c
@@ -2766,6 +2766,7 @@ static TEE_Result clk_stm32_flexgen_enable(struct clk *clk)
 	 * flexgen configuration.
 	 */
 	if (channel == FLEX_STGEN) {
+		struct clk *stgen_src = NULL;
 		unsigned int clk_src = U(0);
 		unsigned int pdiv = U(0);
 		unsigned int fdiv = U(0);
@@ -2780,7 +2781,12 @@ static TEE_Result clk_stm32_flexgen_enable(struct clk *clk)
 		flexclkgen_config_channel(channel, clk_src, pdiv, fdiv);
 
 		/* Update parent */
-		clk->parent = clk_get_parent_by_index(clk, clk_src);
+		stgen_src = clk_get_parent_by_index(clk, clk_src);
+		ret = clk_reparent(clk, stgen_src);
+		if (ret) {
+			EMSG("Failed to configured the STGEN flexgen");
+			return ret;
+		}
 	}
 
 	io_setbits32(rcc_base + RCC_FINDIV0CFGR + (0x4 * channel),
-- 
