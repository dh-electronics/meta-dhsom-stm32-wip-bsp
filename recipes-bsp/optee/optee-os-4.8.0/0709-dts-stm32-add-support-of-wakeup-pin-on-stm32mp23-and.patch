From c5590709fc2963ddc6b580ed14d20129dc1899d7 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Thu, 7 May 2026 11:52:45 +0200
Subject: [PATCH 709/913] dts: stm32: add support of wakeup pin on stm32mp23
 and configure PMIC IRQ on stm32mp235f-dk

Add pwr IRQ on STM32mp23 and use PWR through EXTI.
Add wake-up pin support on stm32mp23.
Add PMIC IRQ and configure wakeup button on stm32mp235f-dk.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 044a0ee9e62047d55f538a4d44fbdadad82b8e42 dts: stm32: add support of wakeup pin on stm32mp23 and configure PMIC IRQ on stm32mp235f-dk]
Change-Id: I65723021d0318956dc7f9b78db1a48c20f88a604
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp231.dtsi    | 17 +++++++++++------
 core/arch/arm/dts/stm32mp235f-dk.dts |  2 ++
 2 files changed, 13 insertions(+), 6 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp231.dtsi b/core/arch/arm/dts/stm32mp231.dtsi
index 5e3229228..9448850cd 100644
--- a/core/arch/arm/dts/stm32mp231.dtsi
+++ b/core/arch/arm/dts/stm32mp231.dtsi
@@ -696,6 +696,10 @@
 		pwr: pwr@44210000 {
 			compatible = "st,stm32mp25-pwr";
 			reg = <0x44210000 0x400>;
+			interrupts = <GIC_SPI 226 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+			wakeup-gpios = <0>, <0>, <0>, <0>, <0>, <0>;
 			status = "disabled";
 
 			vdd33ucpd: vdd33ucpd {
@@ -755,6 +759,7 @@
 
 		exti1: interrupt-controller@44220000 {
 			compatible = "st,stm32mp1-exti";
+			wakeup-parent = <&pwr>;
 			interrupt-controller;
 			#interrupt-cells = <2>;
 			reg = <0x44220000 0x400>;
@@ -811,12 +816,12 @@
 				<&intc GIC_SPI 208 IRQ_TYPE_LEVEL_HIGH>,
 				<&intc GIC_SPI 210 IRQ_TYPE_LEVEL_HIGH>,	/* EXTI_50 */
 				<0>,
-				<0>,
-				<0>,
-				<0>,
-				<0>,
-				<0>,
-				<0>,
+				<&pwr 0 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr 1 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr 2 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr 3 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr 4 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr 5 IRQ_TYPE_EDGE_FALLING>,
 				<0>,
 				<&intc GIC_SPI 171 IRQ_TYPE_LEVEL_HIGH>,
 				<0>,						/* EXTI_60 */
diff --git a/core/arch/arm/dts/stm32mp235f-dk.dts b/core/arch/arm/dts/stm32mp235f-dk.dts
index e792fae82..5a6a747d7 100644
--- a/core/arch/arm/dts/stm32mp235f-dk.dts
+++ b/core/arch/arm/dts/stm32mp235f-dk.dts
@@ -7,6 +7,7 @@
 /dts-v1/;
 
 #include <dt-bindings/clock/stm32mp25-clksrc.h>
+#include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/mfd/st,stpmic2.h>
 #include <dt-bindings/regulator/st,stm32mp25-regulator.h>
 #include <dt-bindings/tamper/st,stm32mp25-tamp.h>
@@ -363,6 +364,7 @@
 
 &pwr {
 	status = "okay";
+	wakeup-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>, <0>, <0>, <0>, <0>, <0>;
 
 	vdd33ucpd: vdd33ucpd {
 		status = "okay";
-- 
2.53.0

