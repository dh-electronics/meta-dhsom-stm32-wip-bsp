diff --git a/core/lib/scmi-server/include/scmi_agent_configuration.h b/core/lib/scmi-server/include/scmi_agent_configuration.h
index ce117101b..19cd7d06f 100644
--- a/core/lib/scmi-server/include/scmi_agent_configuration.h
+++ b/core/lib/scmi-server/include/scmi_agent_configuration.h
@@ -73,6 +73,18 @@ struct scmi_perfd {
 	unsigned int opp_id;
 };
 
+/*
+ * struct scmi_pd - Description of a power domain resource
+ * @name: Domain name
+ * @clk: Clock controlled by the power domain or NULL
+ * @regu: Voltage regulator controlled by the power domain or NULL
+ */
+struct scmi_pd {
+	const char *name;
+	struct clk *clk;
+	struct regulator *regu;
+};
+
 /*
  * struct scpfw_channel_config - SCMI channel resources
  * @name: Channel name
@@ -85,6 +97,8 @@ struct scmi_perfd {
  * @voltd_count: Number of cells of @voltd
