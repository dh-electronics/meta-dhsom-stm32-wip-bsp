From 8fe2a96cb302dd9a2016d7c90b172c28c22f9888 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 20 May 2026 13:43:11 +0200
Subject: [PATCH 464/913] dts: stm32: add reboot mode in stm32mp151.dtsi

reboot mode is a consumer of nvmem cell

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 98e9804c41734ac8eeaacfb2b7f5e430789830be dts: stm32: add reboot mode in stm32mp151.dtsi]
Change-Id: I4afb361d7403e0ad0aaaa78cb6efbf4287c934a9
Signed-off-by: Simeon Marijon <simeon.marijon@foss.st.com>
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/569768
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/dts/stm32mp151.dtsi | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp151.dtsi b/core/arch/arm/dts/stm32mp151.dtsi
index 80b903328..35f7a80ac 100644
--- a/core/arch/arm/dts/stm32mp151.dtsi
+++ b/core/arch/arm/dts/stm32mp151.dtsi
@@ -545,6 +545,20 @@
 					reg = <0x60 0x20>;
 				};
 			};
+
+			reboot_mode: reboot-mode {
+				compatible = "nvmem-reboot-mode";
+				nvmem-cells = <&boot_mode>;
+				nvmem-cell-names = "reboot-mode";
+				mode-normal = <0x00>;
+				mode-fastboot = <0x01>;
+				mode-recovery = <0x02>;
+				mode-stm32cubeprogrammer = <0x03>;
+				mode-ums_mmc0 = <0x10>;
+				mode-ums_mmc1 = <0x11>;
+				mode-ums_mmc2 = <0x12>;
+				mode-romcode_serial = <0xff>;
+			};
 		};
 
 		/*
