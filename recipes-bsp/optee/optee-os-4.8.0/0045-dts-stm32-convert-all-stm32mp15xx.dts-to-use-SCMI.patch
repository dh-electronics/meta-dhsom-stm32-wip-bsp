From 5a76e21e112bc2849bf6a960228682d8a6d4c625 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Thu, 5 Mar 2026 16:00:31 +0100
Subject: [PATCH 045/913] dts: stm32: convert all stm32mp15xx.dts to use SCMI

SCMI is the default configuration used in OSTL for STM32MP15.
Move all modification from xx-scmi.dts board to xx.dts board and remove
the file xx-scmi.dts as they are not supported.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git f62e9bab82f7ed56ed8a5e96c9ef65677575fdec dts: stm32: convert all stm32mp15xx.dts to use SCMI]
Change-Id: I7815f716ccf40aeb65f59674244210a8b90088f4
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp157a-dk1-scmi.dts | 33 -----------------
 core/arch/arm/dts/stm32mp157a-dk1.dts      |  5 +++
 core/arch/arm/dts/stm32mp157c-dk2-scmi.dts | 34 -----------------
 core/arch/arm/dts/stm32mp157c-dk2.dts      |  5 +++
 core/arch/arm/dts/stm32mp157c-ed1-scmi.dts | 43 ----------------------
 core/arch/arm/dts/stm32mp157c-ed1.dts      |  5 ++-
 core/arch/arm/dts/stm32mp157c-ev1-scmi.dts | 17 ---------
 core/arch/arm/dts/stm32mp15xx-dkx.dtsi     |  2 +-
 core/arch/arm/plat-stm32mp1/conf.mk        | 24 ++----------
 9 files changed, 18 insertions(+), 150 deletions(-)
 delete mode 100644 core/arch/arm/dts/stm32mp157a-dk1-scmi.dts
 delete mode 100644 core/arch/arm/dts/stm32mp157c-dk2-scmi.dts
 delete mode 100644 core/arch/arm/dts/stm32mp157c-ed1-scmi.dts
 delete mode 100644 core/arch/arm/dts/stm32mp157c-ev1-scmi.dts

diff --git a/core/arch/arm/dts/stm32mp157a-dk1-scmi.dts b/core/arch/arm/dts/stm32mp157a-dk1-scmi.dts
deleted file mode 100644
index 2d0cad2ca..000000000
--- a/core/arch/arm/dts/stm32mp157a-dk1-scmi.dts
+++ /dev/null
@@ -1,33 +0,0 @@
-// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
-/*
- * Copyright (C) STMicroelectronics 2023-2024
- */
-
-/dts-v1/;
-
-#include "stm32mp157a-dk1.dts"
-
-/ {
-	model = "STMicroelectronics STM32MP157A-DK1 SCMI Discovery Board";
-	compatible = "st,stm32mp157a-dk1-scmi", "st,stm32mp157";
-};
-
-&etzpc {
-	st,decprot =
-		<DECPROT(STM32MP1_ETZPC_USART1_ID, DECPROT_NS_RW, DECPROT_UNLOCK)>,
-		<DECPROT(STM32MP1_ETZPC_SPI6_ID, DECPROT_NS_RW, DECPROT_UNLOCK)>,
-		<DECPROT(STM32MP1_ETZPC_I2C4_ID, DECPROT_NS_RW, DECPROT_UNLOCK)>,
-		<DECPROT(STM32MP1_ETZPC_I2C6_ID, DECPROT_NS_RW, DECPROT_UNLOCK)>,
-		<DECPROT(STM32MP1_ETZPC_RNG1_ID, DECPROT_NS_RW, DECPROT_UNLOCK)>,
-		<DECPROT(STM32MP1_ETZPC_HASH1_ID, DECPROT_NS_RW, DECPROT_UNLOCK)>,
-		<DECPROT(STM32MP1_ETZPC_DDRCTRL_ID, DECPROT_NS_R_S_W, DECPROT_LOCK)>,
-		<DECPROT(STM32MP1_ETZPC_DDRPHYC_ID, DECPROT_NS_R_S_W, DECPROT_LOCK)>,
-		<DECPROT(STM32MP1_ETZPC_STGENC_ID, DECPROT_S_RW, DECPROT_LOCK)>,
-		<DECPROT(STM32MP1_ETZPC_BKPSRAM_ID, DECPROT_S_RW, DECPROT_LOCK)>,
-		<DECPROT(STM32MP1_ETZPC_IWDG1_ID, DECPROT_S_RW, DECPROT_LOCK)>;
-};
-
-&rcc {
-	compatible = "st,stm32mp1-rcc-secure";
-	status = "okay";
-};
diff --git a/core/arch/arm/dts/stm32mp157a-dk1.dts b/core/arch/arm/dts/stm32mp157a-dk1.dts
