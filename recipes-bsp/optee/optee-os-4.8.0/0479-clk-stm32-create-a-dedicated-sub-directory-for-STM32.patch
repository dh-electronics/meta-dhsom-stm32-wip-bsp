rename to core/drivers/clk/stm32/clk-stm32mp13.c
diff --git a/core/drivers/clk/clk-stm32mp15.c b/core/drivers/clk/stm32/clk-stm32mp15.c
similarity index 100%
rename from core/drivers/clk/clk-stm32mp15.c
rename to core/drivers/clk/stm32/clk-stm32mp15.c
