 create mode 100644 core/drivers/clk/stm32/sub.mk

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index 75103258a..9cd918f4b 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -192,6 +192,7 @@ $(call force,CFG_DRIVERS_CLK_DT,y)
 $(call force,CFG_DRIVERS_GPIO,y)
 $(call force,CFG_DRIVERS_PINCTRL,y)
 $(call force,CFG_DRIVERS_REGULATOR,y)
+$(call force,CFG_DRIVERS_STM32_CLK,y)
 $(call force,CFG_GIC,y)
 $(call force,CFG_INIT_CNTVOFF,y)
 $(call force,CFG_PSCI_ARM32,y)
diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index 6e340ed00..5f8e520d5 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -109,6 +109,7 @@ $(call force,CFG_DRIVERS_GPIO,y)
 $(call force,CFG_DRIVERS_MAILBOX,y)
 $(call force,CFG_DRIVERS_PINCTRL,y)
 $(call force,CFG_DRIVERS_REGULATOR,y)
+$(call force,CFG_DRIVERS_STM32_CLK,y)
 $(call force,CFG_DT,y)
 $(call force,CFG_GIC,y)
 $(call force,CFG_HALT_CORES_SGI,15)
