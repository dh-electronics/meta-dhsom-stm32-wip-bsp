new file mode 100644
index 000000000..57fec704f
--- /dev/null
+++ b/core/drivers/clk/stm32/sub.mk
@@ -0,0 +1,6 @@
+srcs-$(CFG_STM32MP_CLK_CORE) += clk-stm32-core.c
