From 8216ea18e7a609c3e9b7a78ea8dfcabbdbb4f95b Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 29 Oct 2025 11:54:26 +0100
Subject: [PATCH 079/913] plat-stm32mp2: conf: enable SCP SCMI regulator

Enable module OPTEE_VOLTD_REGULATOR, SCMI_VOLTAGE_DOMAIN and
VOLTAGE_DOMAIN for stm32mp2 plateform.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git bf577adc987f3466b069e159c3ebecc6a6f12974 plat-stm32mp2: conf: enable SCP SCMI regulator]
Change-Id: I42fd36cf3386dd909f56def2d8e3b2437bdc9a94
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/lib/scmi-server/conf-optee-stm32mp2.mk | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/core/lib/scmi-server/conf-optee-stm32mp2.mk b/core/lib/scmi-server/conf-optee-stm32mp2.mk
index 414cd3922..5c31beed9 100644
--- a/core/lib/scmi-server/conf-optee-stm32mp2.mk
+++ b/core/lib/scmi-server/conf-optee-stm32mp2.mk
@@ -4,12 +4,16 @@ $(call force,CFG_SCPFW_MOD_OPTEE_CLOCK,y)
 $(call force,CFG_SCPFW_MOD_OPTEE_CONSOLE,y)
 $(call force,CFG_SCPFW_MOD_OPTEE_MBX,y)
 $(call force,CFG_SCPFW_MOD_OPTEE_RESET,y)
+$(call force,CFG_SCPFW_MOD_OPTEE_VOLTD_REGULATOR,y)
 $(call force,CFG_SCPFW_MOD_RESET_DOMAIN,y)
 $(call force,CFG_SCPFW_MOD_SCMI,y)
 $(call force,CFG_SCPFW_MOD_SCMI_CLOCK,y)
 $(call force,CFG_SCPFW_MOD_SCMI_RESET_DOMAIN,y)
+$(call force,CFG_SCPFW_MOD_SCMI_VOLTAGE_DOMAIN,y)
 # Info level is sufficient for scp-firmware
 CFG_SCPFW_LOG_LEVEL ?= 1
 
+$(call force,CFG_SCPFW_MOD_VOLTAGE_DOMAIN,y)
+
 $(call force,CFG_SCPFW_NOTIFICATION,n)
 $(call force,CFG_SCPFW_FAST_CHANNEL,n)
