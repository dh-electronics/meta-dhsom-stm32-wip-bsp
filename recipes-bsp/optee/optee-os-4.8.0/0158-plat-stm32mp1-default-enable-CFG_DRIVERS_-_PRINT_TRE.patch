From 9f18124d43e8b250189667d9f7a9b0a0bc7c7113 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 19 Mar 2026 09:08:08 +0100
Subject: [PATCH 158/913] plat-stm32mp1: default enable
 CFG_DRIVERS_*_PRINT_TREE

Default enable CFG_DRIVERS_REGULATOR_PRINT_TREE and
CFG_DRIVERS_CLK_PRINT_TREE upon CFG_WITH_STATS as the feature
allows to print the device trees through the statistics PTA
service.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 4e77679246549135b11353b2fe72ce83a1f0235f plat-stm32mp1: default enable CFG_DRIVERS_*_PRINT_TREE]
Change-Id: I14f27da3ba29e96ec9dbe40c33c2f2e1b457e220
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index 180ccd9b8..9aa180ed4 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -434,6 +434,8 @@ CFG_WERROR ?= y
 
 # Default enable software fallback on crypto drivers
 CFG_STM32_SAES_SW_FALLBACK ?= y
+CFG_DRIVERS_CLK_PRINT_TREE ?= $(CFG_WITH_STATS)
+CFG_DRIVERS_REGULATOR_PRINT_TREE ?= $(CFG_WITH_STATS)
 
 # Enable OTP update with BSEC driver
 CFG_STM32_BSEC_WRITE ?= y
-- 
2.53.0

