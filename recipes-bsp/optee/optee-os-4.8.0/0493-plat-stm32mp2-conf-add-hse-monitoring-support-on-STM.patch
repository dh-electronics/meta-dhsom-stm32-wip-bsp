From b2b99a2daebc7ff66267e51b975253dd6c5dba07 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 7 May 2026 15:47:34 +0200
Subject: [PATCH 493/913] plat-stm32mp2: conf: add hse monitoring support on
 STM32MP2

Add the possibility to detect HSE over frequency detection
on STM32MP2 devices.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git b2a2553dd18bdbb9f717d7d5daed9252dad6deb9 plat-stm32mp2: conf: add hse monitoring support on STM32MP2]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: Ic70aa0da61cad057c34887061218adf2bc138616
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570778
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/plat-stm32mp2/conf.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index 5b1a9d6f2..0fed1bcf9 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -117,6 +117,7 @@ $(call force,CFG_HALT_CORES_SGI,15)
 $(call force,CFG_INIT_CNTVOFF,y)
 $(call force,CFG_SCMI_SCPFW_PRODUCT,stm32mp2)
 $(call force,CFG_SECURE_TIME_SOURCE_CNTPCT,y)
+$(call force,CFG_STM32_HSE_MONITORING,y)
 $(call force,CFG_STM32_SHARED_IO,y)
 $(call force,CFG_STM32_STGEN,y)
 $(call force,CFG_STM32_PWR,y)
@@ -220,6 +221,10 @@ CFG_STM32_EARLY_CONSOLE_UART ?= 2
 # Default disable external DT support
 CFG_EXTERNAL_DT ?= n
 
+ifeq ($(CFG_STM32_HSE_MONITORING),y)
+$(call force,CFG_STM32_LPTIMER,y)
+endif
+
 # If any crypto driver is enabled, enable the crypto-framework layer
 ifeq ($(call cfg-one-enabled, CFG_STM32_CRYP CFG_STM32_HASH CFG_STM32_PKA \
 			      CFG_STM32_SAES ),y)
-- 
2.53.0

