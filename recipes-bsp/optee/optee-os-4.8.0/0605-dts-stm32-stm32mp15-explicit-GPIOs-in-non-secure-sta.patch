From d6c8144362850b954fe5f95460920f290ba4bb85 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 1 Jun 2026 14:15:26 +0200
Subject: [PATCH 605/913] dts: stm32: stm32mp15: explicit GPIOs in non-secure
 state

Explicitly state that the GPIO controlling the SD card voltage
controller is non-secure, unless what the board panics with an error
message like:
E/TC:0 0 stm32_gpio_get_dt:779 node regulator-sd_switch requests secure GPIO F14 that cannot be secured

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git b46611b4e863936d23aeea938e4b1d59c2ac9d0f dts: stm32: stm32mp15: explicit GPIOs in non-secure state]
Change-Id: I791c561da8ce9d355d9d9dd33bb2df3ff5fb1de9
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/573255
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/dts/stm32mp157c-ed1.dts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp157c-ed1.dts b/core/arch/arm/dts/stm32mp157c-ed1.dts
index 0b59c2584..e6281206e 100644
--- a/core/arch/arm/dts/stm32mp157c-ed1.dts
+++ b/core/arch/arm/dts/stm32mp157c-ed1.dts
@@ -11,6 +11,7 @@
 #include "stm32mp15xxaa-pinctrl.dtsi"
 #include <dt-bindings/clock/stm32mp1-clksrc.h>
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/gpio/stm32mp_gpio.h>
 #include <dt-bindings/mfd/st,stpmic1.h>
 #include <dt-bindings/soc/stm32mp-provisioning.h>
 
@@ -83,11 +84,10 @@
 		regulator-type = "voltage";
 		regulator-always-on;
 
-		gpios = <&gpiof 14 GPIO_ACTIVE_HIGH>;
+		gpios = <&gpiof 14 (GPIO_ACTIVE_HIGH | GPIO_STM32_NSEC)>;
 		gpios-states = <0>;
 		states = <1800000 0x1>,
 			 <2900000 0x0>;
-		status = "disabled";
 	};
 
 	vin: vin {
-- 
2.53.0

