From 57f0eddc34eeef7027f521caac7ea72378d30db7 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 16 Apr 2026 15:54:49 +0200
Subject: [PATCH 490/913] clk: stm32: add hse clock monitoring feature

- setup hse monitoring while boot_final level
- register stm32_hse_over_frequency handler on lptimer alarm

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 4942cc279fad5cb0461cb128b5cf2d41235c64d7 clk: stm32: add hse clock monitoring feature]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: Ia58d289c535e18cc549bd1284368731f278e5af2
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570775
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 .../clk/stm32/clk-stm32mp-hse-monitoring.c    | 93 +++++++++++++++++++
 core/drivers/clk/stm32/sub.mk                 |  2 +
 2 files changed, 95 insertions(+)
 create mode 100644 core/drivers/clk/stm32/clk-stm32mp-hse-monitoring.c

diff --git a/core/drivers/clk/stm32/clk-stm32mp-hse-monitoring.c b/core/drivers/clk/stm32/clk-stm32mp-hse-monitoring.c
new file mode 100644
index 000000000..a8d406cdc
--- /dev/null
+++ b/core/drivers/clk/stm32/clk-stm32mp-hse-monitoring.c
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: BSD-2-Clause
+/*
+ * Copyright (c) 2017-2022, STMicroelectronics
+ * Copyright (c) 2016-2018, Linaro Limited
+ */
+
+#include <drivers/clk_dt.h>
+#include <drivers/counter.h>
+#include <kernel/boot.h>
+#include <kernel/pm.h>
+
+/* Percent rate of HSE event */
+#define HSE_THRESHOLD_PERCENT	110
+#define FREQ_MONITOR_COMPAT	"st,freq-monitor"
+
+static void stm32_hse_over_frequency(void *priv,
+				     enum counter_event_type event __unused)
+{
+	uint32_t __maybe_unused *ticks = priv;
+
+	EMSG("HSE over frequency detected: nb ticks:%"PRIu32, *ticks);
+}
+DECLARE_KEEP_PAGER(stm32_hse_over_frequency);
+
+static TEE_Result stm32_hse_monitoring(void)
+{
+	struct counter_device *counter = NULL;
+	struct clk *hse_clk = NULL;
+	struct clk *hsi_clk = NULL;
+	unsigned long hse = 0;
+	unsigned long hsi_cal = 0;
+	uint32_t ticks = 0;
+	void *fdt = NULL;
+	void *config = NULL;
+	int node = -1;
+	TEE_Result res = TEE_ERROR_GENERIC;
+
+	fdt = get_embedded_dt();
+	if (!fdt)
+		panic();
+
+	node = fdt_node_offset_by_compatible(fdt, 0, FREQ_MONITOR_COMPAT);
+	if (node == -FDT_ERR_NOTFOUND)
+		return TEE_SUCCESS;
+	if (node < 0)
+		panic();
+
+	if (fdt_get_status(fdt, node) == DT_STATUS_DISABLED)
+		return TEE_SUCCESS;
+
+	res = clk_dt_get_by_name(fdt, node, "hse", &hse_clk);
+	if  (res)
+		return res;
+
+	res = clk_dt_get_by_name(fdt, node, "hsi", &hsi_clk);
+	if  (res)
+		return res;
+
+	hse = clk_get_rate(hse_clk);
+	hsi_cal = clk_get_rate(hsi_clk);
+
+	/*
+	 * hsi_cal is based on hsi & DIVISOR
+	 * DIVISOR is fixed (1024)
+	 */
+	hsi_cal /= 1024;
+
+	ticks = (hse / 100) * HSE_THRESHOLD_PERCENT;
+	ticks /= hsi_cal;
+
+	DMSG("HSE:%luHz HSI cal:%luHz event:%"PRIu32, hse, hsi_cal, ticks);
+
+	counter = fdt_counter_get(fdt, node, &config);
+	assert(counter && config);
+
+	res = counter_set_threshold(counter, ticks);
+	if  (res)
+		return res;
+
+	res = counter_enable_event(counter, COUNTER_EVENT_THRESHOLD,
+				   stm32_hse_over_frequency,
+				   (void *)&ticks);
+	if  (res)
+		return res;
+
+	res = counter_start(counter, config);
+	if  (res)
+		return res;
+
+	return TEE_SUCCESS;
+}
+
+driver_init_late(stm32_hse_monitoring);
diff --git a/core/drivers/clk/stm32/sub.mk b/core/drivers/clk/stm32/sub.mk
index feb07deaa..d7b3ed6f9 100644
--- a/core/drivers/clk/stm32/sub.mk
+++ b/core/drivers/clk/stm32/sub.mk
@@ -6,3 +6,5 @@ srcs-$(CFG_STM32MP25_CLK) += clk-stm32mp25.c clk-stm32-rcc.c
 
 srcs-$(CFG_STM32MP1_CLK_CAL) += clk-stm32mp1-cal.c
 srcs-$(CFG_STM32MP2_CLK_CAL) += clk-stm32mp2-cal.c
+
+srcs-$(CFG_STM32_HSE_MONITORING) += clk-stm32mp-hse-monitoring.c
