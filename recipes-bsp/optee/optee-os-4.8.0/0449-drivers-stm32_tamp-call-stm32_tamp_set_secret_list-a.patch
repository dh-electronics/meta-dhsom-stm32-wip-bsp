From 0a66dba6f9fb974d398b531ac765fc3052e674a6 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 26 Mar 2025 14:14:20 +0100
Subject: [PATCH 449/913] drivers: stm32_tamp: call
 stm32_tamp_set_secret_list() after applying rif configuration

The function stm32_tamp_set_secret_list() access to register
TAMP_ERCFGR.
TAMP_ERCFGR access rights are linked to the configuration written in
TAMP_R0CIDCFGR. Before accessing TAMP_ERCFGR we need to set config from
the DT in TAMP_R0CIDCFGR in case the current configuration is invalid.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 7d51421b065226fa623283847f456ae043a0a8bb drivers: stm32_tamp: call stm32_tamp_set_secret_list() after applying rif configuration]
Change-Id: I97d7abcd5b12d02b8898fccf84db337920a918a2
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/446775
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/drivers/stm32_tamp.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/core/drivers/stm32_tamp.c b/core/drivers/stm32_tamp.c
index 958779af1..e354505c9 100644
--- a/core/drivers/stm32_tamp.c
+++ b/core/drivers/stm32_tamp.c
@@ -211,6 +211,10 @@
 #define _TAMP_OR_STM32MP25_IN5RMP_PF6	0U
 #define _TAMP_OR_STM32MP25_IN5RMP_PZ4	BIT(2)
 
+/* _TAMP_ERCFGR bit fields */
+#define _TAMP_ERCFGR_ERCFG0		BIT(0)
+#define _TAMP_ERCFGR_ERCFG_MASK		BIT(0)
+
 /* _TAMP_HWCFGR2 bit fields */
 #define _TAMP_HWCFGR2_TZ		GENMASK_32(11, 8)
 #define _TAMP_HWCFGR2_OR		GENMASK_32(7, 0)
@@ -851,6 +855,18 @@ static TEE_Result stm32_tamp_set_secure_bkpregs(void)
 	return TEE_SUCCESS;
 }
 
+static void stm32_tamp_set_secret_list(uint32_t secret_list_conf)
+{
+	vaddr_t base = get_base();
+
+	if (stm32_tamp_dev->pdata.compat &&
+	    (stm32_tamp_dev->pdata.compat->tags & TAMP_HAS_REGISTER_ERCFGR)) {
+		io_clrsetbits32(base + _TAMP_ERCFGR,
+				_TAMP_ERCFGR_ERCFG_MASK,
+				secret_list_conf & _TAMP_ERCFGR_ERCFG_MASK);
+	}
+}
+
 static void stm32_tamp_set_secure(uint32_t mode)
 {
 	vaddr_t base = get_base();
@@ -2201,6 +2217,14 @@ static TEE_Result stm32_tamp_probe(const void *fdt, int node,
 					 _TAMP_PRIVCFG_BKPWPRIV);
 	}
 
+	/*
+	 * Select extra IP to add in the deleted/blocked IP in case of
+	 * tamper event
+	 *
+	 * No IP added.
+	 */
+	stm32_tamp_set_secret_list(0);
+
 	if (!(stm32_tamp_dev->pdata.compat->tags & TAMP_HAS_RIF_SUPPORT) ||
 	    stm32_tamp_dev->pdata.is_tdcid) {
 		res = stm32_tamp_set_secure_bkpregs();
-- 
