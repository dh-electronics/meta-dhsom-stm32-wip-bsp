From c7d0c37ce1a11f1ccd68f52b56e4fddd82674e23 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 13 Apr 2026 15:58:44 +0200
Subject: [PATCH 301/913] dts: st: define hash node in stm32mp231.dtsi

Add node hash in stm32mp231.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 6a88545b95d52c3535ac85258f497c01f0070ffe dts: st: define hash node in stm32mp231.dtsi]
Change-Id: I03b34c38948eefe922dbc04bacb15b78f7343782
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/557098
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/dts/stm32mp231.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp231.dtsi b/core/arch/arm/dts/stm32mp231.dtsi
index 30efcfceb..c2f984604 100644
--- a/core/arch/arm/dts/stm32mp231.dtsi
+++ b/core/arch/arm/dts/stm32mp231.dtsi
@@ -210,6 +210,16 @@
 				status = "disabled";
 			};
 
+			hash: hash@42010000  {
+				compatible = "st,stm32mp13-hash";
+				reg = <0x42010000  0x400>;
+				interrupts = <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_BUS_HASH>;
+				resets = <&rcc HASH_R>;
+				access-controllers = <&rifsc STM32MP25_RIFSC_HASH_ID>;
+				status = "disabled";
+			};
+
 			rng: rng@42020000 {
 				compatible = "st,stm32mp25-rng";
 				reg = <0x42020000 0x400>;
-- 
2.53.0

