From ffb8081f2e98e0b77898ebe1132caeba58d81b8e Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Fri, 15 May 2026 15:37:53 +0200
Subject: [PATCH 702/913] plat-stm32mp1: conf: enable async notif on STM32MP15

Enable async notif in GIC PPI 15 on STM32MP15 platforms.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 73e2b7cbe68b378fae3938fa1813605d97940363 plat-stm32mp1: conf: enable async notif on STM32MP15]
Change-Id: Iba21d3a1910fbecb29362d861740bbc6d08d6f11
Signed-off-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index daa2c3b21..dec6a02a2 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -233,6 +233,8 @@ endif # CFG_STM32MP13
 
 ifeq ($(CFG_STM32MP15),y)
 $(call force,CFG_BOOT_SECONDARY_REQUEST,y)
+$(call force,CFG_CORE_ASYNC_NOTIF,y)
+$(call force,CFG_CORE_ASYNC_NOTIF_GIC_INTID,31)
 $(call force,CFG_DRIVERS_CLK_FIXED,y)
 $(call force,CFG_DDR_LOWPOWER,y)
 $(call force,CFG_HALT_CORES_SGI,15)
-- 
2.53.0

