index 324f584d7..9fae969bd 100644
--- a/core/arch/arm/dts/stm32mp231.dtsi
+++ b/core/arch/arm/dts/stm32mp231.dtsi
@@ -28,6 +28,14 @@
 		};
 	};
 
+	hse_monitor: hse-monitor {
+		compatible = "st,freq-monitor";
+		counter = <&lptimer1 1 5 1 1>;
+		clocks = <&rcc HSE_CK>, <&rcc HSI_CK>;
+		clock-names = "hse", "hsi";
+		status = "disabled";
