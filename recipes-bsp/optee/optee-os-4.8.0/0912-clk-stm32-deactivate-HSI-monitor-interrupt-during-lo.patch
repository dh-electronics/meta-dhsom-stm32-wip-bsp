From ad5f8bace2f20e5da707066b4b62cd1a5bc3821a Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Tue, 13 Oct 2026 18:27:04 +0200
Subject: [PATCH 912/913] clk: stm32: deactivate HSI monitor interrupt during
 low power

Disable HSI clock period monitor interrupt during low power period
as this interruption is not marked as a wake-up interrupt.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git e7f999a40ee2f81337a8cf74023f03a356da5d6f clk: stm32: deactivate HSI monitor interrupt during low power]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I769dda074045e8b947470963f713b909dfd8417f
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/624636
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/drivers/clk/stm32/clk-stm32mp2-cal.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/core/drivers/clk/stm32/clk-stm32mp2-cal.c b/core/drivers/clk/stm32/clk-stm32mp2-cal.c
index 4d11276af..88fb45427 100644
--- a/core/drivers/clk/stm32/clk-stm32mp2-cal.c
+++ b/core/drivers/clk/stm32/clk-stm32mp2-cal.c
@@ -535,6 +535,11 @@ stm32mp2_calib_pm(enum pm_op op, unsigned int pm_hint,
 			/* Only RCC_HSIFMONCR register need to be restored */
 			stm32mp2_clk_hsi_restore_pm(clk_cal);
 
+		/* Enable HSI clock period monitor interrupt */
+		if (clk_cal->irq_cal.itr)
+			interrupt_enable(clk_cal->irq_cal.itr->chip,
+					 clk_cal->irq_cal.itr->it);
+
 		return TEE_SUCCESS;
 	}
 	/* SUSPEND */
@@ -542,6 +547,10 @@ stm32mp2_calib_pm(enum pm_op op, unsigned int pm_hint,
 		struct stm32mp2_clk_cal *clk_cal = &osc_cal_device[i];
 		struct stm32_calib_config *data = &clk_cal->data;
 
+		/* Disable HSI clock period monitor interrupt */
+		if (clk_cal->irq_cal.itr)
+			interrupt_disable(clk_cal->irq_cal.itr->chip,
+					  clk_cal->irq_cal.itr->it);
 		if (data->is_used)
 			data->init_done = false;
 	}
-- 
