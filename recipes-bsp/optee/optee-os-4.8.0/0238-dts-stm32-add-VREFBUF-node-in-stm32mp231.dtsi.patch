From d4fe66f2d09a62322e4f30c154a9b261d0de9491 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Fri, 27 Mar 2026 15:44:16 +0100
Subject: [PATCH 238/913] dts: stm32: add VREFBUF node in stm32mp231.dtsi

Add VREFBUF node definition in stm32mp231.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git cfbabcf5e8be129ec4a58e45d0e2a8e7aae2b41e dts: stm32: add VREFBUF node in stm32mp231.dtsi]
Change-Id: Ib3f8346932b749310cac043fb6dc63126c5ab2dd
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp231.dtsi | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp231.dtsi b/core/arch/arm/dts/stm32mp231.dtsi
index 4f54e3a89..30efcfceb 100644
--- a/core/arch/arm/dts/stm32mp231.dtsi
+++ b/core/arch/arm/dts/stm32mp231.dtsi
@@ -387,6 +387,17 @@
 			};
 		};
 
+		vrefbuf: vrefbuf@44060000 {
+			compatible = "st,stm32mp25-vrefbuf";
+			reg = <0x44060000 0x8>;
+			regulator-name = "vrefbuf";
+			regulator-min-microvolt = <1210000>;
+			regulator-max-microvolt = <1500000>;
+			clocks = <&rcc CK_BUS_VREF>;
+			vdda-supply = <&vdda18adc>;
+			status = "disabled";
+		};
+
 		serc: serc@44080000 {
 			compatible = "st,stm32mp25-serc";
 			reg = <0x44080000 0x1000>;
-- 
