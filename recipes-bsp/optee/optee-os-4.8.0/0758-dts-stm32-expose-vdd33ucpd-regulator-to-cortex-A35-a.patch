From a2d02d10236d1381d3accfcbce030ff88fb977c4 Mon Sep 17 00:00:00 2001
From: Christian Bruel <christian.bruel@foss.st.com>
Date: Thu, 18 Jun 2026 09:35:40 +0200
Subject: [PATCH 758/913] dts: stm32: expose vdd33ucpd regulator to cortex-A35
 agent for stm32mp25

Due to the move of the UCPD driver to the Linux kernel, the CC lines
PHYs need to enable the vdd33ucpd regulator.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git ba07d45c36042af2ea3691aea8f73eda27de127e dts: stm32: expose vdd33ucpd regulator to cortex-A35 agent for stm32mp25]
Signed-off-by: Christian Bruel <christian.bruel@foss.st.com>
Change-Id: I4405994906702840e33c031c69cc6d21b7c2b44d
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/580867
Tested-by: Gabriel FERNANDEZ <gabriel.fernandez@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Gabriel FERNANDEZ <gabriel.fernandez@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi b/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
index cce228d4a..b4854de3c 100644
--- a/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
+++ b/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
@@ -829,6 +829,11 @@
 						voltd-supply = <&vddio4>;
 					};
 
+					regulator@5 {
+						reg = <VOLTD_SCMI_UCPD>;
+						voltd-supply = <&vdd33ucpd>;
+					};
+
 					regulator@7 {
 						reg = <VOLTD_SCMI_ADC>;
 						voltd-supply = <&vdda18adc>;
-- 
