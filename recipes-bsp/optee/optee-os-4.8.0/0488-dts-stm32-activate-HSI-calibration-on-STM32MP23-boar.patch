From 7004a3bc2eb6ff21143ff7a6bfe5b2a9755cc9de Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Fri, 23 Feb 2024 09:16:14 +0100
Subject: [PATCH 488/913] dts: stm32: activate HSI calibration on STM32MP23
 boards

Default enable HSI (High Speed Internal oscillator) calibration. This
internal oscillator tends to derive over time so calibration is needed.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 9892086c160a1d1b04f98af990e42f03b749e44d dts: stm32: activate HSI calibration on STM32MP23 boards]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: Ib980ddd68dee33a89a8097e343a5638b20baf74b
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570773
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp235f-dk.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp235f-dk.dts b/core/arch/arm/dts/stm32mp235f-dk.dts
index 6fecd024d..efb22196d 100644
--- a/core/arch/arm/dts/stm32mp235f-dk.dts
+++ b/core/arch/arm/dts/stm32mp235f-dk.dts
@@ -65,6 +65,10 @@
 	status = "okay";
 };
 
+&hsi_calibration {
+	status = "okay";
+};
+
 &i2c7 {
 	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&i2c7_pins_a>;
-- 
2.53.0

