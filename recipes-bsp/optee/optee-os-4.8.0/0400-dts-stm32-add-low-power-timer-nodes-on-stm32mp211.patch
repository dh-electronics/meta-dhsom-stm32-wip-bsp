From 753d5376b59c646b5f50750c075580335f5cccf4 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 6 May 2026 11:03:07 +0200
Subject: [PATCH 400/913] dts: stm32: add low-power timer nodes on stm32mp211

Add low-power timer (LPTimer) 1 to 5 support on STM32MP21 SoC.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git d0e0f586b3d7137e4c4f46fb56a7adfd5d09ed5e dts: stm32: add low-power timer nodes on stm32mp211]
Change-Id: I0de93c5f919edf0ca25e7610f3f4c1ea2c4c389e
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/564268
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Fabrice GASNIER <fabrice.gasnier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Fabrice GASNIER <fabrice.gasnier@foss.st.com>
---
 core/arch/arm/dts/stm32mp211.dtsi | 170 ++++++++++++++++++++++++++++++
 1 file changed, 170 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index 6f815f744..f903f5c5a 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -102,6 +102,74 @@
 			#size-cells = <1>;
 			#access-controller-cells = <1>;
 
+			lptimer1: timer@40090000 {
+				compatible = "st,stm32mp21-lptimer";
+				reg = <0x40090000 0x400>;
+				interrupts = <GIC_SPI 149 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_KER_LPTIM1>;
+				clock-names = "mux";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				access-controllers = <&rifsc STM32MP21_RIFSC_LPTIM1_ID>;
+				status = "disabled";
+
+				counter {
+					compatible = "st,stm32mp21-lptimer-counter";
+					status = "disabled";
+				};
+
+				pwm {
+					compatible = "st,stm32mp21-pwm-lp";
+					#pwm-cells = <3>;
+					status = "disabled";
+				};
+
+				timer {
+					compatible = "st,stm32mp21-lptimer-timer";
+					status = "disabled";
+				};
+
+				trigger@0 {
+					compatible = "st,stm32mp21-lptimer-trigger";
+					reg = <0>;
+					status = "disabled";
+				};
+			};
+
+			lptimer2: timer@400a0000 {
+				compatible = "st,stm32mp21-lptimer";
+				reg = <0x400a0000 0x400>;
+				interrupts = <GIC_SPI 180 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_KER_LPTIM2>;
+				clock-names = "mux";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				access-controllers = <&rifsc STM32MP21_RIFSC_LPTIM2_ID>;
+				status = "disabled";
+
+				counter {
+					compatible = "st,stm32mp21-lptimer-counter";
+					status = "disabled";
+				};
+
+				pwm {
+					compatible = "st,stm32mp21-pwm-lp";
+					#pwm-cells = <3>;
+					status = "disabled";
+				};
+
+				timer {
+					compatible = "st,stm32mp21-lptimer-timer";
+					status = "disabled";
+				};
+
+				trigger@1 {
+					compatible = "st,stm32mp21-lptimer-trigger";
+					reg = <1>;
+					status = "disabled";
+				};
+			};
+
 			usart2: serial@400e0000 {
 				compatible = "st,stm32h7-uart";
 				reg = <0x400e0000 0x400>;
@@ -257,6 +325,108 @@
 				access-controllers = <&rifsc STM32MP21_RIFSC_I2C3_ID>;
 				status = "disabled";
 			};
+
+			lptimer3: timer@46050000 {
+				compatible = "st,stm32mp21-lptimer";
+				reg = <0x46050000 0x400>;
+				interrupts = <GIC_SPI 181 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_KER_LPTIM3>;
+				clock-names = "mux";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				access-controllers = <&rifsc STM32MP21_RIFSC_LPTIM3_ID>;
+				status = "disabled";
+
+				counter {
+					compatible = "st,stm32mp21-lptimer-counter";
+					status = "disabled";
+				};
+
+				pwm {
+					compatible = "st,stm32mp21-pwm-lp";
+					#pwm-cells = <3>;
+					status = "disabled";
+				};
+
+				timer {
+					compatible = "st,stm32mp21-lptimer-timer";
+					status = "disabled";
+				};
+
+				trigger@2 {
+					compatible = "st,stm32mp21-lptimer-trigger";
+					reg = <2>;
+					status = "disabled";
+				};
+			};
+
+			lptimer4: timer@46060000 {
+				compatible = "st,stm32mp21-lptimer";
+				reg = <0x46060000 0x400>;
+				interrupts = <GIC_SPI 182 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_KER_LPTIM4>;
+				clock-names = "mux";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				access-controllers = <&rifsc STM32MP21_RIFSC_LPTIM4_ID>;
+				status = "disabled";
+
+				counter {
+					compatible = "st,stm32mp21-lptimer-counter";
+					status = "disabled";
+				};
+
+				pwm {
+					compatible = "st,stm32mp21-pwm-lp";
+					#pwm-cells = <3>;
+					status = "disabled";
+				};
+
+				timer {
+					compatible = "st,stm32mp21-lptimer-timer";
+					status = "disabled";
+				};
+
+				trigger@3 {
+					compatible = "st,stm32mp21-lptimer-trigger";
+					reg = <3>;
+					status = "disabled";
+				};
+			};
+
+			lptimer5: timer@46070000 {
+				compatible = "st,stm32mp21-lptimer";
+				reg = <0x46070000 0x400>;
+				interrupts = <GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&rcc CK_KER_LPTIM5>;
+				clock-names = "mux";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				access-controllers = <&rifsc STM32MP21_RIFSC_LPTIM5_ID>;
+				status = "disabled";
+
+				counter {
+					compatible = "st,stm32mp21-lptimer-counter";
+					status = "disabled";
+				};
+
+				pwm {
+					compatible = "st,stm32mp21-pwm-lp";
+					#pwm-cells = <3>;
+					status = "disabled";
+				};
+
+				timer {
+					compatible = "st,stm32mp21-lptimer-timer";
+					status = "disabled";
+				};
+
+				trigger@4 {
+					compatible = "st,stm32mp21-lptimer-trigger";
+					reg = <4>;
+					status = "disabled";
+				};
+			};
 		};
 
 		iac: iac@42090000 {
