From d14bb64549187941b5f5a0ea0c6790164619c364 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Wed, 13 May 2026 17:14:52 +0200
Subject: [PATCH 420/913] dts: stm32: update hpdma nodes in stm32mp231.dtsi

Align STM32MP23 hdpma nodes with Linux kernel:
- replace compatible st,stm32-dma with st,stm32mp25-dma,
- update #dma-cells: Linux stm32-dma3 bindings and driver use 3 cells.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 665cb7d84e1b86e337c957ee2b168b780414fef2 dts: stm32: update hpdma nodes in stm32mp231.dtsi]
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Change-Id: I17c5060bf6861fd8c8b271aacd62ea66739a5a9b
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/567634
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/dts/stm32mp231.dtsi | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp231.dtsi b/core/arch/arm/dts/stm32mp231.dtsi
index 14bc3f11a..ffb6193a6 100644
--- a/core/arch/arm/dts/stm32mp231.dtsi
+++ b/core/arch/arm/dts/stm32mp231.dtsi
@@ -96,29 +96,29 @@
 		ranges = <0x0 0x0 0x0 0x80000000>;
 
 		hpdma1: dma-controller@40400000 {
-			compatible = "st,stm32-dma3";
+			compatible = "st,stm32mp25-dma3";
 			reg = <0x40400000 0x1000>;
 			clocks = <&rcc CK_BUS_HPDMA1>;
 			resets = <&rcc HPDMA1_R>;
-			#dma-cells = <4>;
+			#dma-cells = <3>;
 			status = "disabled";
 		};
 
 		hpdma2: dma-controller@40410000 {
-			compatible = "st,stm32-dma3";
+			compatible = "st,stm32mp25-dma3";
 			reg = <0x40410000 0x1000>;
 			clocks = <&rcc CK_BUS_HPDMA2>;
 			resets = <&rcc HPDMA2_R>;
-			#dma-cells = <4>;
+			#dma-cells = <3>;
 			status = "disabled";
 		};
 
 		hpdma3: dma-controller@40420000 {
-			compatible = "st,stm32-dma3";
+			compatible = "st,stm32mp25-dma3";
 			reg = <0x40420000 0x1000>;
 			clocks = <&rcc CK_BUS_HPDMA3>;
 			resets = <&rcc HPDMA3_R>;
-			#dma-cells = <4>;
+			#dma-cells = <3>;
 			status = "disabled";
 		};
 
