From 48d07901cc804e877c470e316e8dc1148e382679 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Wed, 25 Mar 2026 17:21:08 +0100
Subject: [PATCH 209/913] drivers: clk: don't mix error codes in stm32mp25
 driver

Don't mix error codes in stm32mp25 clock driver: some function return
a TEE_Result value, some return a 0/-1 integer value.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 618948218a16ea8bf65b9a231388f976418b8a2a drivers: clk: don't mix error codes in stm32mp25 driver]
Change-Id: I205bfa666a9132e5ab8c27d3786f16f0d66f821c
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/390716
Tested-by: Gabriel FERNANDEZ <gabriel.fernandez@foss.st.com>
Reviewed-by: Gabriel FERNANDEZ <gabriel.fernandez@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/drivers/clk/clk-stm32mp25.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/core/drivers/clk/clk-stm32mp25.c b/core/drivers/clk/clk-stm32mp25.c
index 7863db54e..fdfe1ab72 100644
--- a/core/drivers/clk/clk-stm32mp25.c
+++ b/core/drivers/clk/clk-stm32mp25.c
@@ -1086,8 +1086,9 @@ stm32_clk_oscillators_wait_lse_ready(struct clk_stm32_priv *priv __unused,
 	int ret = 0;
 
 	if (stm32_rcc_has_access_by_id(RCC_RIF_OSCILLATORS)) {
-		if (osci->freq)
-			ret = stm32_gate_wait_ready(osc_data->gate_id, true);
+		if (osci->freq &&
+		    stm32_gate_wait_ready(osc_data->gate_id, true))
+			ret = -1;
 	}
 
 	return ret;
@@ -1886,8 +1887,8 @@ static int clk_stm32_pll_set_mux(struct clk_stm32_priv *priv __unused,
 
 	if (stm32_mux_set_parent(mux, sel))
 		return -1;
-	else
-		return 0;
+
+	return 0;
 }
 
 static int clk_stm32_pll_check_mux(struct clk_stm32_priv *priv __unused,
-- 
2.53.0

