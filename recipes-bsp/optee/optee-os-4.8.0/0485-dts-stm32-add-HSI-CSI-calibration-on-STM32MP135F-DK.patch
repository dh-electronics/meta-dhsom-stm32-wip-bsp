From a920b032a7f258d5a4ef8248495f69601d5f45ce Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 7 May 2026 08:04:41 +0200
Subject: [PATCH 485/913] dts: stm32: add HSI/CSI calibration on STM32MP135F-DK

Default enables HSI/CSI calibration on STM32MP135F-DK boards.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 9140a31def69a2233b24f21194e4d4d5d5441e00 dts: stm32: add HSI/CSI calibration on STM32MP135F-DK]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I8325b71fb1221d6bd3100753e3e04e483d645cfc
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570770
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp135f-dk.dts | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp135f-dk.dts b/core/arch/arm/dts/stm32mp135f-dk.dts
index d4d01634d..f9beed27c 100644
--- a/core/arch/arm/dts/stm32mp135f-dk.dts
+++ b/core/arch/arm/dts/stm32mp135f-dk.dts
@@ -341,6 +341,16 @@
 	st,non-secure-otp-provisioning;
 };
 
+&osc_calibration {
+	csi-calibration {
+		status = "okay";
+	};
+
+	hsi-calibration {
+		status = "okay";
+	};
+};
+
 &pka {
 	status = "okay";
 };
@@ -595,6 +605,14 @@
 	};
 };
 
+&timers12 {
+	status = "okay";
+
+	counter {
+		status = "okay";
+	};
+};
+
 &tzc400 {
 	memory-region = <&optee_framebuffer>;
 };
-- 
