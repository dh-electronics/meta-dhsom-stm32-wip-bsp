From 0dccddbb019afc6fc926aa7615e688caa85e350e Mon Sep 17 00:00:00 2001
From: Lionel Debieve <lionel.debieve@foss.st.com>
Date: Wed, 8 Dec 2021 15:48:19 +0100
Subject: [PATCH 005/913] plat-stm32mp1: conf: enable the WERROR check

Add by default the WERROR to check and block the build
when an error is detected.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 1612e7f9ebddf0eecc2eb13f6222c7710e03a037 plat-stm32mp1: conf: enable the WERROR check]
Signed-off-by: Lionel Debieve <lionel.debieve@foss.st.com>
Change-Id: I78fa1846a60b772d9fed24f69e010a7559a22c4a
---
 core/arch/arm/plat-stm32mp1/conf.mk | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index f474c7a72..f1f6f0f9b 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -359,6 +359,7 @@ endif
 # Default enable some test facitilites
 CFG_ENABLE_EMBEDDED_TESTS ?= y
 CFG_WITH_STATS ?= y
+CFG_WERROR ?= y
 
 # Default enable software fallback on crypto drivers
 CFG_STM32_SAES_SW_FALLBACK ?= y
