From 9c8372121abb8fb87a30b06983938242176efbb3 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Tue, 14 Oct 2025 10:03:54 +0200
Subject: [PATCH 018/913] plat-stm32mp2: add external device tree support

Adds the possibility to use and external repository for device tree source
files for this platform. By default, this external path is set to
external-dt/optee.

If a device tree is not found in OP-TEE source code, search it in the
external repository, if any.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git f5fc06d9124df5c3b4f8594f7352061b771d467f plat-stm32mp2: add external device tree support]
Change-Id: Id891626c44ee2e893ee2467bd59f1df8d885f8fb
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp2/conf.mk | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index e9c9e2112..9c11ae5e8 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -13,6 +13,19 @@ flavorlist-MP25 = $(flavor_dts_file-257F_DK) \
 # List of all DTS for this PLATFORM
 ALL_DTS = $(flavorlist-MP21) $(flavorlist-MP23) $(flavorlist-MP25)
 
+# Check if device-tree exist in OP-TEE source code, else search it in external
+# device tree repository
+ifeq ($(wildcard $(arch-dir)/dts/$(CFG_EMBED_DTB_SOURCE_FILE)),)
+# External device tree default path
+CFG_EXT_DTS ?= $(arch-dir)/dts/external-dt/optee
+ifneq ($(wildcard $(CFG_EXT_DTS)/$(CFG_EMBED_DTB_SOURCE_FILE)),)
+override dts-source-path := $(CFG_EXT_DTS)
+-include $(CFG_EXT_DTS)/conf.mk
+else
+$(error Cannot find DTS file $(CFG_EXT_DTS)/$(CFG_EMBED_DTB_SOURCE_FILE))
+endif
+endif
+
 ifneq ($(PLATFORM_FLAVOR),)
 ifeq ($(flavor_dts_file-$(PLATFORM_FLAVOR)),)
 $(error Invalid platform flavor $(PLATFORM_FLAVOR))
