From 280bb48c9e1b850c6bb9d1662b0a2f8bc5ca29f4 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 14 Jan 2026 19:11:48 +0100
Subject: [PATCH 169/913] drivers: clk: stm32mp13: simplify stm32_clock_pm

Remove static variable standby_prepared in stm32_clock_pm() as
standby exit information is provided by pm_hint CONTEXT flags.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 7fad2dc12e44264ed4bff451a5fc606bc0be2f0d drivers: clk: stm32mp13: simplify stm32_clock_pm]
Fixes: 60621b6b6a1d ("stm32mp1: use generic PM_HINT and associated macro")
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I150dfb382d859983a99e105d02e57a5e9fc2477d
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/524723
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Gabriel FERNANDEZ <gabriel.fernandez@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/drivers/clk/clk-stm32mp13.c | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/core/drivers/clk/clk-stm32mp13.c b/core/drivers/clk/clk-stm32mp13.c
index 8d7a723fe..7a01fd0e8 100644
--- a/core/drivers/clk/clk-stm32mp13.c
+++ b/core/drivers/clk/clk-stm32mp13.c
@@ -3362,20 +3362,16 @@ static void __maybe_unused stm32_clock_resume(void)
 static TEE_Result stm32_clock_pm(enum pm_op op, unsigned int pm_hint,
 				 const struct pm_callback_handle *hdl __unused)
 {
-	static int standby_prepared;
-
 	if (op == PM_OP_SUSPEND) {
 		if (PM_HINT_IS_STATE(pm_hint, CONTEXT)) {
 			stm32_clock_suspend();
-			standby_prepared = 1;
 		} else {
 			stm32mp1_clk_save_context_for_stop();
-			standby_prepared = 0;
 		}
 		clear_rcc_reset_status();
 	} else {
 		/* back from standby */
-		if (standby_prepared)
+		if (PM_HINT_IS_STATE(pm_hint, CONTEXT))
 			stm32_clock_resume();
 		else
 			stm32mp1_clk_restore_context_for_stop();
-- 
