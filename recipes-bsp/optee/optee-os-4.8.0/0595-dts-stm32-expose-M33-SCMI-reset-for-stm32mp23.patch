From 13df907e5e90cffc6d6359ba56ca0319643a8fc4 Mon Sep 17 00:00:00 2001
From: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Date: Tue, 12 May 2026 15:53:47 +0200
Subject: [PATCH 595/913] dts: stm32: expose M33 SCMI reset for stm32mp23

Expose the CPU2 reset and hold boot managed by the stm32_remoteproc
controller.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 4468957d11552d3f4ce0b37b49fc11ff86bcf9cd dts: stm32: expose M33 SCMI reset for stm32mp23]
Signed-off-by: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Change-Id: I20b304a3b909b2cdfbb3f23da92035c9e65707bb
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570907
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
---
 core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi b/core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi
index cb018983a..f4a9207a4 100644
--- a/core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi
+++ b/core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi
@@ -728,6 +728,18 @@
 					#address-cells = <1>;
 					#size-cells = <0>;
 
+					reset@1 {
+						reg = <RST_SCMI_C2_R>;
+						domain-name = "c2";
+						resets = <&m33_rproc 0>;
+					};
+
+					reset@3 {
+						reg = <RST_SCMI_C2_HOLDBOOT_R>;
+						domain-name = "c2_holdboot";
+						resets = <&m33_rproc 1>;
+					};
+
 					reset@4 {
 						reg = <RST_SCMI_FMC>;
 						domain-name = "fmc";
-- 
2.53.0

