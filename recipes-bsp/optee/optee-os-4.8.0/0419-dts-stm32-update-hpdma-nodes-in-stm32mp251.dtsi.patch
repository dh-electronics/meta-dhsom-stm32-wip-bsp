From 551da77274d82b484634cc237b68daa5fd5308a5 Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Wed, 13 May 2026 17:13:59 +0200
Subject: [PATCH 419/913] dts: stm32: update hpdma nodes in stm32mp251.dtsi

Align STM32MP25 hdpma nodes with Linux kernel:
- replace compatible st,stm32-dma with st,stm32mp25-dma,
- update #dma-cells: Linux stm32-dma3 bindings and driver use 3 cells.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git d683d5e9c3573d26ee2af19989c57d1937ff5bb9 dts: stm32: update hpdma nodes in stm32mp251.dtsi]
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Change-Id: I7e0ab0c534d48c988af67dc72ce21736f4e15879
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/567633
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp251.dtsi | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp251.dtsi b/core/arch/arm/dts/stm32mp251.dtsi
index 8fd9302f5..ce12fd7e7 100644
--- a/core/arch/arm/dts/stm32mp251.dtsi
+++ b/core/arch/arm/dts/stm32mp251.dtsi
@@ -96,29 +96,29 @@
 		ranges = <0x0 0x0 0x0 0x80000000>;
 
 		hpdma1: dma-controller@40400000 {
-			compatible = "st,stm32-dma3";
+			compatible = "st,stm32mp25-dma3";
 			reg = <0x40400000 0x1000>;
 			clocks = <&rcc CK_BUS_HPDMA1>;
 			resets = <&rcc HPDMA1_R>;
-			#dma-cells = <4>;
+			#dma-cells = <3>;
 			status = "disabled";
 		};
 
 		hpdma2: dma-controller@40410000 {
-			compatible = "st,stm32-dma3";
+			compatible = "st,stm32mp25-dma3";
 			reg = <0x40410000 0x1000>;
 			clocks = <&rcc CK_BUS_HPDMA2>;
 			resets = <&rcc HPDMA2_R>;
-			#dma-cells = <4>;
+			#dma-cells = <3>;
 			status = "disabled";
 		};
 
 		hpdma3: dma-controller@40420000 {
-			compatible = "st,stm32-dma3";
+			compatible = "st,stm32mp25-dma3";
 			reg = <0x40420000 0x1000>;
 			clocks = <&rcc CK_BUS_HPDMA3>;
 			resets = <&rcc HPDMA3_R>;
-			#dma-cells = <4>;
+			#dma-cells = <3>;
 			status = "disabled";
 		};
 
-- 
