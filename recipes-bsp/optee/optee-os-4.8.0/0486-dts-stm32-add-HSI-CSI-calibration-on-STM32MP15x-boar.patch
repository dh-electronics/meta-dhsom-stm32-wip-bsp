+++ b/core/arch/arm/dts/stm32mp157c-ed1.dts
@@ -359,6 +359,16 @@
 	status = "disabled";
 };
 
+&osc_calibration {
+	csi-calibration {
+		status = "okay";
+	};
+
+	hsi-calibration {
+		status = "okay";
+	};
+};
+
 &pwr_regulators {
 	vdd-supply = <&vdd>;
 	vdd_3v3_usbfs-supply = <&vdd_usb>;
