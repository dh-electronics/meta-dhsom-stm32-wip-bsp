From 69f3b6d264442e1cfc7a822728e7402307cf2dc1 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 29 Oct 2025 13:41:35 +0100
Subject: [PATCH 073/913] dts: stm32: expose PWR regulator with SCMI to Linux
 for stm32mp215f-dk

Add PWR regulator to SCMI agent@1 in stm32mp21-st-scmi-cfg.dtsi so Linux
can access these regulators.
Also export PMIC regulators to Linux for stm32mp215f-dk

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git abc95b7dca419f7257db61b8ec60aa7033540f8d dts: stm32: expose PWR regulator with SCMI to Linux for stm32mp215f-dk]
Change-Id: I3f3c60db553ec48e4c2929d734a92d2af2a27781
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp21-st-scmi-cfg.dtsi  | 30 +++++++++++++++++++
 .../arm/dts/stm32mp215f-dk-ca35tdcid-rif.dtsi | 18 +++++++++++
 core/arch/arm/dts/stm32mp215f-dk.dts          | 29 ++++++++++++++++++
 3 files changed, 77 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp21-st-scmi-cfg.dtsi b/core/arch/arm/dts/stm32mp21-st-scmi-cfg.dtsi
index 10cc64fbe..97e893733 100644
--- a/core/arch/arm/dts/stm32mp21-st-scmi-cfg.dtsi
+++ b/core/arch/arm/dts/stm32mp21-st-scmi-cfg.dtsi
@@ -6,6 +6,7 @@
  * boards when CA35 is TDCID
  */
 
+#include <dt-bindings/regulator/st,stm32mp21-regulator.h>
 #include <dt-bindings/scmi/scmi-clock.h>
 
 / {
@@ -702,6 +703,35 @@
 					};
 				};
 			};
+
+			scmi_regulator: protocol@17 {
+				reg = <0x17>;
+
+				regulators {
+					#address-cells = <1>;
+					#size-cells = <0>;
+
+					regulator@0 {
+						reg = <VOLTD_SCMI_VDDIO1>;
+						voltd-supply = <&vddio1>;
+					};
+
+					regulator@1 {
+						reg = <VOLTD_SCMI_VDDIO2>;
+						voltd-supply = <&vddio2>;
+					};
+
+					regulator@2 {
+						reg = <VOLTD_SCMI_VDDIO3>;
+						voltd-supply = <&vddio3>;
+					};
+
+					regulator@3 {
+						reg = <VOLTD_SCMI_ADC>;
+						voltd-supply = <&vdda18adc>;
+					};
+				};
+			};
 		};
 	};
 };
diff --git a/core/arch/arm/dts/stm32mp215f-dk-ca35tdcid-rif.dtsi b/core/arch/arm/dts/stm32mp215f-dk-ca35tdcid-rif.dtsi
index 99ddf42b4..904c0fa63 100644
--- a/core/arch/arm/dts/stm32mp215f-dk-ca35tdcid-rif.dtsi
+++ b/core/arch/arm/dts/stm32mp215f-dk-ca35tdcid-rif.dtsi
@@ -205,3 +205,21 @@
 		RIMUPROT(RIMU_ID(12), RIF_CID0, RIF_NSEC, RIF_PRIV, RIF_CIDSEL_M)
 	>;
 };
+
+&pwr {
+	st,protreg = <
+		RIFPROT(RIF_PWR_RESOURCE(0), RIF_UNUSED, RIF_UNLOCK, RIF_SEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN)
+		RIFPROT(RIF_PWR_RESOURCE(1), RIF_UNUSED, RIF_UNLOCK, RIF_SEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN)
+		RIFPROT(RIF_PWR_RESOURCE(2), RIF_UNUSED, RIF_UNLOCK, RIF_SEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN)
+		RIFPROT(RIF_PWR_RESOURCE(3), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_CID2, RIF_SEM_DIS, RIF_CFEN)
+		RIFPROT(RIF_PWR_RESOURCE(4), RIF_UNUSED, RIF_UNLOCK, RIF_SEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN)
+		RIFPROT(RIF_PWR_RESOURCE(5), RIF_UNUSED, RIF_UNLOCK, RIF_SEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN)
+		RIFPROT(RIF_PWR_RESOURCE(6), RIF_UNUSED, RIF_UNLOCK, RIF_SEC, RIF_PRIV, RIF_CID1, RIF_SEM_DIS, RIF_CFEN)
+		RIFPROT(RIF_PWR_RESOURCE_WIO(1), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_DIS, RIF_CFDIS)
+		RIFPROT(RIF_PWR_RESOURCE_WIO(2), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_DIS, RIF_CFDIS)
+		RIFPROT(RIF_PWR_RESOURCE_WIO(3), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_DIS, RIF_CFDIS)
+		RIFPROT(RIF_PWR_RESOURCE_WIO(4), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_DIS, RIF_CFDIS)
+		RIFPROT(RIF_PWR_RESOURCE_WIO(5), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_DIS, RIF_CFDIS)
+		RIFPROT(RIF_PWR_RESOURCE_WIO(6), RIF_UNUSED, RIF_UNLOCK, RIF_NSEC, RIF_NPRIV, RIF_UNUSED, RIF_SEM_DIS, RIF_CFDIS)
+	>;
+};
diff --git a/core/arch/arm/dts/stm32mp215f-dk.dts b/core/arch/arm/dts/stm32mp215f-dk.dts
index 4374ab503..1a01a3058 100644
--- a/core/arch/arm/dts/stm32mp215f-dk.dts
+++ b/core/arch/arm/dts/stm32mp215f-dk.dts
@@ -294,3 +294,32 @@
 	};
 };
 
+
+&scmi_regulator {
+	regulators {
+		regulator@5 {
+			reg = <VOLTD_SCMI_STPMIC_BUCK1>;
+			voltd-supply = <&vddcore>;
+		};
+
+		regulator@f {
+			reg = <VOLTD_SCMI_STPMIC_LDO4>;
+			voltd-supply = <&vdd3v3_usb>;
+		};
+
+		regulator@10 {
+			reg = <VOLTD_SCMI_STPMIC_LDO5>;
+			voltd-supply = <&vdd_flash>;
+		};
+
+		regulator@11 {
+			reg = <VOLTD_SCMI_STPMIC_LDO6>;
+			voltd-supply = <&vdda_1v8>;
+		};
+
+		regulator@15 {
+			reg = <VOLTD_SCMI_STPMIC_GPO1>;
+			voltd-supply = <&v3v3>;
+		};
+	};
+};
-- 
2.53.0

