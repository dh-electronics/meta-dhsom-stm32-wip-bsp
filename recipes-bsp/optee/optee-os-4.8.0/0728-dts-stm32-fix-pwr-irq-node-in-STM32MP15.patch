From 511a0af77742df9d6a23abfebf27ff49a6115662 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Tue, 2 Jun 2026 11:24:45 +0200
Subject: [PATCH 728/913] dts: stm32: fix pwr irq node in STM32MP15

Add missing reg for pwr_irq nodes.
This patch solves a DTC warning:
   /soc/pwr@50001010: missing or empty reg/ranges property

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 1f017ae2e07a5717539eee9d858cc88b5a90aca5 dts: stm32: fix pwr irq node in STM32MP15]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: Ic7956b5d4752179deb95445894c65b794ad2f80f
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/573550
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/dts/stm32mp151.dtsi | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/arch/arm/dts/stm32mp151.dtsi b/core/arch/arm/dts/stm32mp151.dtsi
index 9b6b97083..24d5ffe4b 100644
--- a/core/arch/arm/dts/stm32mp151.dtsi
+++ b/core/arch/arm/dts/stm32mp151.dtsi
@@ -211,6 +211,7 @@
 
 		pwr_irq: pwr@50001010 {
 			compatible = "st,stm32mp1-pwr-irq";
+			reg = <0x50001010 0x4>;
 			interrupts = <GIC_SPI 149 IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-controller;
 			#interrupt-cells = <2>;
-- 
2.53.0

