From 22481def2a16699bfacd0c232b5d34c0d92e5320 Mon Sep 17 00:00:00 2001
From: Lionel Debieve <lionel.debieve@foss.st.com>
Date: Wed, 17 Nov 2021 10:02:21 +0100
Subject: [PATCH 138/913] drivers: clk: stm32mp15: fix incorrect pll dt parsing

Fix an issue while looking for the PLL as the node
used must not be reused in the next loop.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git e6d6b74727b350a008ea53935daf93b93564f20a drivers: clk: stm32mp15: fix incorrect pll dt parsing]
Signed-off-by: Lionel Debieve <lionel.debieve@foss.st.com>
Change-Id: If790fee54691408abf31144290f9476264f10617
---
 core/drivers/clk/clk-stm32mp15.c | 9 +++++----
 1 file changed, 5 insertions(+), 4 deletions(-)

diff --git a/core/drivers/clk/clk-stm32mp15.c b/core/drivers/clk/clk-stm32mp15.c
index 3bcf1220b..a7c3ac771 100644
--- a/core/drivers/clk/clk-stm32mp15.c
+++ b/core/drivers/clk/clk-stm32mp15.c
@@ -1131,14 +1131,15 @@ static TEE_Result stm32mp1_clk_fdt_init(const void *fdt, int node)
 	}
 	for (i = (enum stm32mp1_pll_id)0; i < _PLL_NB; i++) {
 		char name[] = "st,pll@X";
+		int subnode = -1;
 
 		snprintf(name, sizeof(name), "st,pll@%d", i);
-		node = fdt_subnode_offset(fdt, node, name);
-		if (node < 0)
+		subnode = fdt_subnode_offset(fdt, node, name);
+		if (subnode < 0)
 			continue;
 
-		if (fdt_getprop(fdt, node, "cfg", &len) ||
-		    fdt_getprop(fdt, node, "frac", &len)) {
+		if (fdt_getprop(fdt, subnode, "cfg", &len) ||
+		    fdt_getprop(fdt, subnode, "frac", &len)) {
 			DMSG("Ignore PLL%u configurations from DT", i);
 			ignored++;
 		}
-- 
