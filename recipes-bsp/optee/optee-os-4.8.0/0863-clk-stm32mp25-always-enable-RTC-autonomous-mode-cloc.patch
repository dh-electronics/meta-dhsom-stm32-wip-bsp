From 0f43275770318ae1d04be4f67fcc4608d40a9e55 Mon Sep 17 00:00:00 2001
From: Christophe Kerello <christophe.kerello@foss.st.com>
Date: Wed, 12 Aug 2026 17:29:07 +0200
Subject: [PATCH 863/913] clk: stm32mp25: always enable RTC autonomous mode
 clock

RTCAMEN must be set for the low power Standby1 mode, in order to avoid a
race condition with the ROM code of Rev.X.

Mark the clock as critical so that clk_stm32_register_clocks() enables it
at RCC probe time and refuses any later disable, which keeps RTCAMEN set.

The flag is conditioned by CLK_IS_CRITICAL_TDCID because on CM33 TDCID
configurations the bit is set by the M33 TDCID firmware instead.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git b1cbf467608acccd21c0af719d56849ecb8585b4 clk: stm32mp25: always enable RTC autonomous mode clock]
Change-Id: I0b68012abf0830079923972032987ffd143d32e0
Signed-off-by: Christophe Kerello <christophe.kerello@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/600040
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Christophe KERELLO <christophe.kerello@st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Tested-by: Christophe KERELLO <christophe.kerello@st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/drivers/clk/stm32/clk-stm32mp25.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/core/drivers/clk/stm32/clk-stm32mp25.c b/core/drivers/clk/stm32/clk-stm32mp25.c
index 409fde9bd..d98e503b4 100644
--- a/core/drivers/clk/stm32/clk-stm32mp25.c
+++ b/core/drivers/clk/stm32/clk-stm32mp25.c
@@ -3894,8 +3894,8 @@ static RIF_GATE(ck_icn_p_gpioz_am, &ck_icn_p_gpioz, 0, GATE_GPIOZAM,
 		RCC_RIF_GPIOZ);
 static RIF_GATE(ck_icn_p_rtc, &ck_icn_ls_mcu, CLK_IS_CRITICAL_TDCID, GATE_RTC,
 		RCC_RIF_RTC_TAMP);
-static RIF_GATE(ck_icn_p_rtc_am, &ck_icn_p_rtc, 0, GATE_RTCAM,
-		RCC_RIF_RTC_TAMP);
+static RIF_GATE(ck_icn_p_rtc_am, &ck_icn_p_rtc, CLK_IS_CRITICAL_TDCID,
+		GATE_RTCAM, RCC_RIF_RTC_TAMP);
 static RIF_COMPOSITE(ck_rtc, 4, PARENT(&ck_off, &ck_lse, &ck_lsi, &ck_hse_rtc),
 		     0, GATE_RTCCK, NO_DIV, MUX_RTC, RCC_RIF_RTC_TAMP);
 static RIF_GATE(ck_icn_p_bsec, &ck_icn_apb3, CLK_IS_CRITICAL_TDCID, GATE_BSEC,
