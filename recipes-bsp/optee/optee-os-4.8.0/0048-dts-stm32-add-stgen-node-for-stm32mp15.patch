From 263463291a30e1c58c93652ca75ea4d03437e53e Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 4 Mar 2026 17:08:14 +0100
Subject: [PATCH 048/913] dts: stm32: add stgen node for stm32mp15

Add stgen node in stm32mp151.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 47cd80c90f0611b03768b1db168e361218107804 dts: stm32: add stgen node for stm32mp15]
Change-Id: Iad2002551d6a9c10f108a023dff010f2887a0582
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp151.dtsi | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp151.dtsi b/core/arch/arm/dts/stm32mp151.dtsi
index 9462770ce..a4b0b99a5 100644
--- a/core/arch/arm/dts/stm32mp151.dtsi
+++ b/core/arch/arm/dts/stm32mp151.dtsi
@@ -1982,6 +1982,12 @@
 				access-controllers = <&etzpc STM32MP1_ETZPC_I2C6_ID>;
 				status = "disabled";
 			};
+
+			stgen: stgen@5c008000 {
+				compatible = "st,stm32-stgen";
+				reg = <0x5C008000 0x1000>;
+				access-controllers = <&etzpc STM32MP1_ETZPC_STGENC_ID>;
+			};
 		};
 	};
 
