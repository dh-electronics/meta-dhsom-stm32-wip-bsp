From 7c3376a91ce5e38255b52cdff134ae722ce7b861 Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Tue, 5 May 2026 13:46:58 +0200
Subject: [PATCH 600/913] dts: stm32: Set display pixel clock to 10 Mhz

Increase the PLL8 tol 600Mhz to get a frequency of 10Mhz for the ltdc
pixel clock.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git e5298150ef1731965ecbb212fd829dcae650c519 dts: stm32: Set display pixel clock to 10 Mhz]
Change-Id: I08ef61bbb87174c988cb5733aef994b6d1aebdf5
Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/563864
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/dts/stm32mp215f-dk-ca35tdcid-rcc.dtsi | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp215f-dk-ca35tdcid-rcc.dtsi b/core/arch/arm/dts/stm32mp215f-dk-ca35tdcid-rcc.dtsi
index 66a4f96c5..99a179745 100644
--- a/core/arch/arm/dts/stm32mp215f-dk-ca35tdcid-rcc.dtsi
+++ b/core/arch/arm/dts/stm32mp215f-dk-ca35tdcid-rcc.dtsi
@@ -65,7 +65,7 @@
 		FLEXGEN_CFG(24, XBAR_SRC_PLL7, 0, 16)
 		FLEXGEN_CFG(25, XBAR_SRC_PLL7, 0, 16)
 		FLEXGEN_CFG(26, XBAR_SRC_PLL4, 0, 11)
-		FLEXGEN_CFG(27, XBAR_SRC_PLL8, 0, 3)
+		FLEXGEN_CFG(27, XBAR_SRC_PLL8, 0, 59)
 		FLEXGEN_CFG(29, XBAR_SRC_PLL5, 0, 1)
 		FLEXGEN_CFG(30, XBAR_SRC_HSE_KER, 0, 1)
 		FLEXGEN_CFG(31, XBAR_SRC_PLL5, 0, 19)
@@ -168,10 +168,10 @@
 	};
 
 	pll8: st,pll-8 {
-		st,pll = <&pll8_cfg_594MHz>;
+		st,pll = <&pll8_cfg_600MHz>;
 
-		pll8_cfg_594MHz: pll8-cfg-594MHz {
-			cfg = <297 5 1 4>;
+		pll8_cfg_600MHz: pll8-cfg-600MHz {
+			cfg = <300 5 1 4>;
 			src = <MUX_CFG(MUX_MUXSEL4, MUXSEL_HSE)>;
 		};
 	};
