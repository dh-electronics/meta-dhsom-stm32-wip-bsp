From 7ce159cfe83f20f0d0f4ba29d8b92e0e085e53ea Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Fri, 27 Mar 2026 15:45:10 +0100
Subject: [PATCH 239/913] dts: stm32: add VREFBUF node in stm32mp211.dtsi

Add VREFBUF node definition in stm32mp211.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git c28506036de0554dd8b113c2e44f0001897e557f dts: stm32: add VREFBUF node in stm32mp211.dtsi]
Change-Id: I00bd71461b9325ea477015e85d61d11d60f4c946
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp211.dtsi | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index c9c99c2f4..9100adc4b 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -314,6 +314,18 @@
 			};
 		};
 
+		vrefbuf: vrefbuf@44060000 {
+			compatible = "st,stm32mp25-vrefbuf";
+			reg = <0x44060000 0x8>;
+			regulator-name = "vrefbuf";
+			regulator-min-microvolt = <1210000>;
+			regulator-max-microvolt = <1500000>;
+			clocks = <&rcc CK_BUS_VREF>;
+			vdda-supply = <&vdda18adc>;
+			status = "disabled";
+		};
+
+
 		rcc: clock-controller@44200000 {
 			compatible = "st,stm32mp21-rcc", "syscon";
 			reg = <0x44200000 0x10000>;
-- 
2.53.0

