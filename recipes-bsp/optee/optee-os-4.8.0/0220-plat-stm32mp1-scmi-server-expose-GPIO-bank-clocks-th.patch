From 1b64e91cfad3b1706cd7027607e017b0741cfd83 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Mon, 24 Nov 2025 15:24:09 +0100
Subject: [PATCH 220/913] plat-stm32mp1: scmi-server: expose GPIO bank clocks
 thru SCMI.

Expose CK_SCMI_GPIO[A-K] thru SCMI.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git ea4ed8df3f195b4bb8082aaf44c80262366590fe plat-stm32mp1: scmi-server: expose GPIO bank clocks thru SCMI.]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: I6177ed0d29b4cae0f720cb00cf34b36ef89b2324
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/511978
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/scmi_server.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/scmi_server.c b/core/arch/arm/plat-stm32mp1/scmi_server.c
index e33d811b3..547bf78cd 100644
--- a/core/arch/arm/plat-stm32mp1/scmi_server.c
+++ b/core/arch/arm/plat-stm32mp1/scmi_server.c
@@ -237,6 +237,17 @@ static struct stm32_scmi_clk stm32_scmi_clock[] = {
 			   STM32MP1_ETZPC_SPI6_ID),
 	CLOCK_CELL_DECPROT(CK_SCMI_USART1, USART1_K, "usart1_k", false,
 			   STM32MP1_ETZPC_USART1_ID),
+	CLOCK_CELL(CK_SCMI_GPIOA, GPIOA, "gpioa", false),
+	CLOCK_CELL(CK_SCMI_GPIOB, GPIOB, "gpiob", false),
+	CLOCK_CELL(CK_SCMI_GPIOC, GPIOC, "gpioc", false),
+	CLOCK_CELL(CK_SCMI_GPIOD, GPIOD, "gpiod", false),
+	CLOCK_CELL(CK_SCMI_GPIOE, GPIOE, "gpioe", false),
+	CLOCK_CELL(CK_SCMI_GPIOF, GPIOF, "gpiof", false),
+	CLOCK_CELL(CK_SCMI_GPIOG, GPIOG, "gpiog", false),
+	CLOCK_CELL(CK_SCMI_GPIOH, GPIOH, "gpioh", false),
+	CLOCK_CELL(CK_SCMI_GPIOI, GPIOI, "gpioi", false),
+	CLOCK_CELL(CK_SCMI_GPIOJ, GPIOJ, "gpioj", false),
+	CLOCK_CELL(CK_SCMI_GPIOK, GPIOK, "gpiok", false),
 };
 #endif
 
