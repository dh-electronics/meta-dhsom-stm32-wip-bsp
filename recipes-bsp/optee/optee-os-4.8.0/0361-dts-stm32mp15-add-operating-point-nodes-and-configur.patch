From f50abab9cdbb0302dca6fba83bd5d0f2265ac5d0 Mon Sep 17 00:00:00 2001
From: Pascal Paillet <p.paillet@st.com>
Date: Fri, 23 Feb 2024 18:30:55 +0100
Subject: [PATCH 361/913] dts: stm32mp15: add operating point nodes and
 configuration

Add the OPP table configuration for the STM32MP15 platform
and its associated configuration depending to SoC version.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 765c382bc34158fc809f6db7ef3c6091820ba322 dts: stm32mp15: add operating point nodes and configuration]
Change-Id: I7fb56d83514bca921f522cc09d9fd0033608fab7
Signed-off-by: Pascal Paillet <p.paillet@st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/362692
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/429933
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/451432
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/561941
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp151.dtsi  | 23 +++++++++++++++++++++++
 core/arch/arm/dts/stm32mp15xd.dtsi |  1 -
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/core/arch/arm/dts/stm32mp151.dtsi b/core/arch/arm/dts/stm32mp151.dtsi
index 9dc8c52fd..8a13fca5e 100644
--- a/core/arch/arm/dts/stm32mp151.dtsi
+++ b/core/arch/arm/dts/stm32mp151.dtsi
@@ -21,6 +21,11 @@
 			clock-frequency = <650000000>;
 			device_type = "cpu";
 			reg = <0>;
+			clocks = <&rcc CK_MPU>;
+			clock-names = "cpu";
+			operating-points-v2 = <&cpu0_opp_table>;
+			nvmem-cells = <&part_number_otp>;
+			nvmem-cell-names = "part_number";
 		};
 	};
 
@@ -31,6 +36,24 @@
 		interrupt-parent = <&intc>;
 	};
 
+	cpu0_opp_table: cpu0-opp-table {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-650000000 {
+			opp-hz = /bits/ 64 <650000000>;
+			opp-microvolt = <1200000>;
+			opp-supported-hw = <0x3>;
+			st,opp-default;
+		};
+
+		opp-800000000 {
+			opp-hz = /bits/ 64 <800000000>;
+			opp-microvolt = <1350000>;
+			opp-supported-hw = <0x2>;
+		};
+	};
+
 	psci {
 		compatible = "arm,psci-1.0";
 		method = "smc";
diff --git a/core/arch/arm/dts/stm32mp15xd.dtsi b/core/arch/arm/dts/stm32mp15xd.dtsi
index 0de05027d..591936874 100644
--- a/core/arch/arm/dts/stm32mp15xd.dtsi
+++ b/core/arch/arm/dts/stm32mp15xd.dtsi
@@ -3,4 +3,3 @@
