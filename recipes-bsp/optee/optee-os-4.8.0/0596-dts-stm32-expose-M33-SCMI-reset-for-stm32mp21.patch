From fd2080be3be69f6e6cec9d8e513709b2eaacf765 Mon Sep 17 00:00:00 2001
From: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Date: Tue, 12 May 2026 15:54:21 +0200
Subject: [PATCH 596/913] dts: stm32: expose M33 SCMI reset for stm32mp21

Expose the CPU2 reset and hold boot managed by the stm32_remoteproc
controller.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 387dcdbe522c3783118cbcb484b6ba6535a7b87d dts: stm32: expose M33 SCMI reset for stm32mp21]
Signed-off-by: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Change-Id: I18939355b5ebbd2dffe61162159cb7511346f44c
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570908
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Tested-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/dts/stm32mp21-st-scmi-cfg.dtsi | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp21-st-scmi-cfg.dtsi b/core/arch/arm/dts/stm32mp21-st-scmi-cfg.dtsi
index 684c7f666..3ffe3aa62 100644
--- a/core/arch/arm/dts/stm32mp21-st-scmi-cfg.dtsi
+++ b/core/arch/arm/dts/stm32mp21-st-scmi-cfg.dtsi
@@ -684,6 +684,18 @@
 					#address-cells = <1>;
 					#size-cells = <0>;
 
+					reset@1 {
+						reg = <RST_SCMI_C2_R>;
+						domain-name = "c2";
+						resets = <&m33_rproc 0>;
+					};
+
+					reset@3 {
+						reg = <RST_SCMI_C2_HOLDBOOT_R>;
+						domain-name = "c2_holdboot";
+						resets = <&m33_rproc 1>;
+					};
+
 					reset@4 {
 						reg = <RST_SCMI_FMC>;
 						domain-name = "fmc";
-- 
