From 911abb38e5ed3886ae8e329e97939730c125fb79 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Wed, 17 Jun 2026 09:01:14 +0200
Subject: [PATCH 762/913] mk/compile.mk: only check unique_unit_address on
 enabled nodes

Some nodes can have the same unit address in a SoC DTSI file but it's
still expected to only have one node enabled at the same time in the
board device tree.
For example on STM32MP15 :
        - spi2: spi@4000b000
        - i2s2: audio-controller@4000b000

So update the DTC command line to disable the warning
"unique_unit_address". Also enable the warning
"unique_unit_address_if_enabled" to check if 2 nodes with the same
address are enabled in a board.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 6732f80c44a059a9a55592eeab5409754753e18c mk/compile.mk: only check unique_unit_address on enabled nodes]
This is bassed on the kernel patch :
Link: https://lore.kernel.org/r/20211203183517.11390-1-semen.protsenko@linaro.org
Change-Id: I4307f8cc7054e5fc2de866233a22ec59cafbd4c2
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/579643
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 mk/compile.mk | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/mk/compile.mk b/mk/compile.mk
index 7f2ad05c0..717441723 100644
--- a/mk/compile.mk
+++ b/mk/compile.mk
@@ -274,7 +274,8 @@ dtb-cppflags-$2 := -Icore/include/ -I$(arch-dir)/dts -x assembler-with-cpp \
 		   -E -ffreestanding $$(CPPFLAGS) \
 		   -MD -MF $$(dtb-predep-$2) -MP -MT $$(dtb-predts-$2)
 
-dtb-dtcflags-$2	:= $$(DTC_FLAGS) -I dts -O dtb -Wno-unit_address_vs_reg \
+dtb-dtcflags-$2	:= $$(DTC_FLAGS) -I dts -O dtb -Wno-unit_address_vs_reg  \
+		   -Wno-unique_unit_address -Wunique_unit_address_if_enabled \
 		   -d $$(dtb-dep-$2)
 
 -include $$(dtb-dep-$2)
