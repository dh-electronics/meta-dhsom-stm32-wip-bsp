From 6ac815a6b95ca46f34d444f3a667d697a802f550 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 13 Apr 2026 17:33:08 +0200
Subject: [PATCH 307/913] dts: st: define saes node in stm32mp25xc.dtsi

Add node saes in stm32mp25xc.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git f4f79cb71bb59bcee64624aa93c42368561d4952 dts: st: define saes node in stm32mp25xc.dtsi]
Change-Id: Icadac10fe2ded6c29c083f4364e6472bae2d9a36
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/557104
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/dts/stm32mp25xc.dtsi | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp25xc.dtsi b/core/arch/arm/dts/stm32mp25xc.dtsi
index 8d0c3b91d..b8739d557 100644
--- a/core/arch/arm/dts/stm32mp25xc.dtsi
+++ b/core/arch/arm/dts/stm32mp25xc.dtsi
@@ -24,4 +24,15 @@
 		access-controllers = <&rifsc STM32MP25_RIFSC_CRYP2_ID>;
 		status = "disabled";
 	};
+
+	saes: saes@42050000 {
+		compatible = "st,stm32mp13-saes";
+		reg = <0x42050000 0x400>;
+		interrupts = <GIC_SPI 179 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&rcc CK_BUS_SAES>, <&rcc CK_BUS_RNG>;
+		clock-names = "bus", "rng";
+		resets = <&rcc SAES_R>;
+		access-controllers = <&rifsc STM32MP25_RIFSC_SAES_ID>;
+		status = "disabled";
+	};
 };
-- 
