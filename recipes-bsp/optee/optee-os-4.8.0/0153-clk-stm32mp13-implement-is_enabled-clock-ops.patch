From 505e9beff1103b452bb99da222ccb13308863a6d Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Fri, 7 Oct 2022 14:07:22 +0200
Subject: [PATCH 153/913] clk: stm32mp13: implement 'is_enabled' clock ops

Now we are able to have hardware gate status of a clock.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 55f1ad36fa9969b62d1d85df075d1587bbcc045d clk: stm32mp13: implement 'is_enabled' clock ops]
Change-Id: Ibea9c5a88487662f17e8f52ec9bea9a2384dcd03
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
---
 core/drivers/clk/clk-stm32-core.c | 17 +++++++++++++++++
 core/drivers/clk/clk-stm32-core.h |  1 +
 core/drivers/clk/clk-stm32mp13.c  |  4 ++++
 3 files changed, 22 insertions(+)

diff --git a/core/drivers/clk/clk-stm32-core.c b/core/drivers/clk/clk-stm32-core.c
index b3ea2d39c..8daefc9d9 100644
--- a/core/drivers/clk/clk-stm32-core.c
+++ b/core/drivers/clk/clk-stm32-core.c
@@ -385,9 +385,17 @@ static void clk_stm32_gate_disable(struct clk *clk)
 	stm32_gate_disable(cfg->gate_id);
 }
 
+static bool clk_stm32_gate_is_enabled(struct clk *clk)
+{
+	struct clk_stm32_gate_cfg *cfg = clk->priv;
+
+	return stm32_gate_is_enabled(cfg->gate_id);
+}
+
 const struct clk_ops clk_stm32_gate_ops = {
 	.enable		= clk_stm32_gate_enable,
 	.disable	= clk_stm32_gate_disable,
+	.is_enabled	= clk_stm32_gate_is_enabled,
 };
 
 static TEE_Result clk_stm32_gate_ready_enable(struct clk *clk)
@@ -408,6 +416,7 @@ static void clk_stm32_gate_ready_disable(struct clk *clk)
 const struct clk_ops clk_stm32_gate_ready_ops = {
 	.enable		= clk_stm32_gate_ready_enable,
 	.disable	= clk_stm32_gate_ready_disable,
+	.is_enabled	= clk_stm32_gate_is_enabled,
 };
 
 /* STM32 DIV clock operators */
@@ -494,6 +503,13 @@ void clk_stm32_composite_gate_disable(struct clk *clk)
 	stm32_gate_disable(cfg->gate_id);
 }
 
+bool clk_stm32_composite_gate_is_enabled(struct clk *clk)
+{
+	struct clk_stm32_composite_cfg *cfg = clk->priv;
+
+	return stm32_gate_is_enabled(cfg->gate_id);
+}
+
 const struct clk_ops clk_stm32_composite_ops = {
 	.get_parent	= clk_stm32_composite_get_parent,
 	.set_parent	= clk_stm32_composite_set_parent,
@@ -501,6 +517,7 @@ const struct clk_ops clk_stm32_composite_ops = {
 	.set_rate	= clk_stm32_composite_set_rate,
 	.enable		= clk_stm32_composite_gate_enable,
 	.disable	= clk_stm32_composite_gate_disable,
+	.is_enabled	= clk_stm32_composite_gate_is_enabled,
 };
 
 TEE_Result clk_stm32_set_parent_by_index(struct clk *clk, size_t pidx)
diff --git a/core/drivers/clk/clk-stm32-core.h b/core/drivers/clk/clk-stm32-core.h
index 7e08ad2ca..0d6a3cba0 100644
--- a/core/drivers/clk/clk-stm32-core.h
+++ b/core/drivers/clk/clk-stm32-core.h
@@ -154,6 +154,7 @@ TEE_Result clk_stm32_composite_set_rate(struct clk *clk, unsigned long rate,
 					unsigned long parent_rate);
 TEE_Result clk_stm32_composite_gate_enable(struct clk *clk);
 void clk_stm32_composite_gate_disable(struct clk *clk);
+bool clk_stm32_composite_gate_is_enabled(struct clk *clk);
 
 TEE_Result clk_stm32_set_parent_by_index(struct clk *clk, size_t pidx);
 
diff --git a/core/drivers/clk/clk-stm32mp13.c b/core/drivers/clk/clk-stm32mp13.c
index 2c203b310..d43b62f10 100644
--- a/core/drivers/clk/clk-stm32mp13.c
+++ b/core/drivers/clk/clk-stm32mp13.c
@@ -1789,6 +1789,7 @@ static const struct clk_ops clk_stm32_pll_ops = {
 	.get_rate	= clk_stm32_pll_get_rate,
 	.enable		= clk_stm32_pll_enable,
 	.disable	= clk_stm32_pll_disable,
+	.is_enabled	= clk_stm32_pll_is_enabled,
 };
 
 static TEE_Result
@@ -1811,6 +1812,7 @@ static const struct clk_ops clk_stm32_composite_duty_cycle_ops = {
 	.set_rate	= clk_stm32_composite_set_rate,
 	.enable		= clk_stm32_composite_gate_enable,
 	.disable	= clk_stm32_composite_gate_disable,
+	.is_enabled	= clk_stm32_composite_gate_is_enabled,
 	.get_duty_cycle	= clk_stm32_composite_get_duty_cycle,
 };
 
@@ -1888,12 +1890,14 @@ static const struct clk_ops clk_stm32_pll1_ops = {
 	.get_rate	= clk_stm32_pll_get_rate,
 	.enable		= clk_stm32_pll_enable,
 	.disable	= clk_stm32_pll_disable,
+	.is_enabled	= clk_stm32_pll_is_enabled,
 };
 
 static const struct clk_ops clk_stm32_pll1p_ops = {
 	.get_rate	= clk_stm32_composite_get_rate,
 	.enable		= clk_stm32_composite_gate_enable,
 	.disable	= clk_stm32_composite_gate_disable,
+	.is_enabled	= clk_stm32_composite_gate_is_enabled,
 };
 
 static const struct clk_ops clk_stm32_mpu_ops = {
-- 
