From 9e0e653b144c926757032ddc3a8330a135239878 Mon Sep 17 00:00:00 2001
From: Cheick Traore <cheick.traore-ext@st.com>
Date: Fri, 13 Sep 2024 14:46:34 +0200
Subject: [PATCH 350/913] drivers: stm32_uart: add support for resume and
 suspend on UART

Add a callback function to retrieve and save the values of the main
UART registers during suspend and update the UART registers with these
saved values during resume.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git fc134d69e8139988e45f49a4699fd3980a425424 drivers: stm32_uart: add support for resume and suspend on UART]
Change-Id: I1dac6dfe264042cbaeae7524707d31d9ae1e3e0b
Signed-off-by: Cheick Traore <cheick.traore-ext@st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/391967
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/501256
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Alain VOLMAT <alain.volmat@st.com>
---
 core/drivers/stm32_uart.c         | 44 +++++++++++++++++++++++++++++++
 core/include/drivers/stm32_uart.h |  5 ++++
 2 files changed, 49 insertions(+)

diff --git a/core/drivers/stm32_uart.c b/core/drivers/stm32_uart.c
index 6f84fc3a7..439d8a36d 100644
--- a/core/drivers/stm32_uart.c
+++ b/core/drivers/stm32_uart.c
@@ -15,6 +15,7 @@
 #include <kernel/delay.h>
 #include <kernel/dt.h>
 #include <kernel/panic.h>
+#include <kernel/pm.h>
 #include <libfdt.h>
 #include <stm32_util.h>
 #include <util.h>
@@ -232,6 +233,47 @@ static bool uart_is_for_console(void *fdt, int node, char **params)
 	return uart_console_node == node;
 }
 
+static TEE_Result stm32_uart_pm(enum pm_op op, uint32_t pm_hint,
+				const struct pm_callback_handle *pm_handle)
+{
+	struct stm32_uart_pdata *pd = pm_handle->handle;
+	vaddr_t uart_base = io_pa_or_va(&pd->base, 1);
+	TEE_Result res = TEE_ERROR_BAD_PARAMETERS;
+
+	if (!PM_HINT_IS_STATE(pm_hint, CONTEXT))
+		return TEE_SUCCESS;
+
+	switch (op) {
+	case PM_OP_SUSPEND:
+		pd->brr = io_read32(uart_base + UART_REG_BRR);
+		pd->presc = io_read32(uart_base + UART_REG_PRESC);
+		pd->cr1 = io_read32(uart_base + UART_REG_CR1);
+		pd->cr2 = io_read32(uart_base + UART_REG_CR2);
+		pd->cr3 = io_read32(uart_base + UART_REG_CR3);
+		res = TEE_SUCCESS;
+		break;
+	case PM_OP_RESUME:
+		/* Disable UART to set CR2, CR3, BRR and PRESC saved values. */
+		io_write32(uart_base + UART_REG_CR1, 0);
+		io_write32(uart_base + UART_REG_CR2, pd->cr2);
+		io_write32(uart_base + UART_REG_CR3, pd->cr3);
+		io_write32(uart_base + UART_REG_BRR, pd->brr);
+		io_write32(uart_base + UART_REG_PRESC, pd->presc);
+		/*
+		 * Set CR1 saved value.
+		 * It also enables UART, if UART was enabled before suspend.
+		 */
+		io_write32(uart_base + UART_REG_CR1, pd->cr1);
+		res = TEE_SUCCESS;
+		break;
+	default:
+		break;
+	}
+
+	return res;
+}
+DECLARE_KEEP_PAGER_PM(stm32_uart_pm);
+
 static TEE_Result stm32_uart_probe(const void *fdt, int node,
 				   const void *compt_data __unused)
 {
@@ -254,6 +296,8 @@ static TEE_Result stm32_uart_probe(const void *fdt, int node,
 		register_serial_console(&pd->chip);
 	}
 
+	register_pm_core_service_cb(stm32_uart_pm, pd, "stm32-uart");
+
 out:
 	if (res)
 		free(pd);
diff --git a/core/include/drivers/stm32_uart.h b/core/include/drivers/stm32_uart.h
index 824356370..a6b1f9dd0 100644
--- a/core/include/drivers/stm32_uart.h
+++ b/core/include/drivers/stm32_uart.h
@@ -18,6 +18,11 @@ struct stm32_uart_pdata {
 	struct serial_chip chip;
 	struct clk *clock;
 	struct pinctrl_state *pinctrl;
+	uint32_t brr;
+	uint32_t presc;
+	uint32_t cr1;
+	uint32_t cr2;
+	uint32_t cr3;
 };
 
