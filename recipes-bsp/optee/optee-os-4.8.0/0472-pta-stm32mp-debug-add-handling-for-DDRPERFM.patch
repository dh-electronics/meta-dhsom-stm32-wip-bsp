From c86516534235f5ff58266545e1b49fae187ee7ad Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Fri, 22 May 2026 14:06:57 +0200
Subject: [PATCH 472/913] pta: stm32mp: debug: add handling for DDRPERFM

On STM32MP23 and STM32MP25 the access to the debug peripheral
DDRPERF depends on access of RCC resource 104 from non-secure.

Let the debug access PTA to query for DDRPERFM access.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 85a3f121aa20261ad25802a3cfc1e226591c66b4 pta: stm32mp: debug: add handling for DDRPERFM]
Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: Ie095853635fd194b8f8e6897a06c810aa187d396
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570741
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/pta/stm32mp/debug_access_pta.c            | 5 +++++
 lib/libutee/include/pta_stm32mp_debug_access.h | 2 ++
 2 files changed, 7 insertions(+)

diff --git a/core/pta/stm32mp/debug_access_pta.c b/core/pta/stm32mp/debug_access_pta.c
index 792f82eb3..0da2dc5c9 100644
--- a/core/pta/stm32mp/debug_access_pta.c
+++ b/core/pta/stm32mp/debug_access_pta.c
@@ -3,6 +3,7 @@
  * Copyright (C) 2026, STMicroelectronics - All Rights Reserved
  */
 
+#include <stm32_util.h>
 #include <drivers/stm32_bsec.h>
 #include <kernel/pseudo_ta.h>
 #include <kernel/user_ta.h>
@@ -33,6 +34,10 @@ static TEE_Result pta_dbg_grant_dbg_access(uint32_t param_types,
 		if (!stm32_bsec_coresight_is_enabled())
 			return TEE_ERROR_ACCESS_DENIED;
 		break;
+	case PTA_STM32_DEBUG_DDRPERFM_DBG_PROFILE:
+		if (!stm32_rcc_ddrperfm_is_enabled())
+			return TEE_ERROR_ACCESS_DENIED;
+		break;
 	default:
 		return TEE_ERROR_NOT_SUPPORTED;
 	}
diff --git a/lib/libutee/include/pta_stm32mp_debug_access.h b/lib/libutee/include/pta_stm32mp_debug_access.h
index 262340eab..433592428 100644
--- a/lib/libutee/include/pta_stm32mp_debug_access.h
+++ b/lib/libutee/include/pta_stm32mp_debug_access.h
@@ -15,6 +15,8 @@ enum stm32_pta_dbg_profile {
 	PTA_STM32_DEBUG_PERIPHERAL_DBG_PROFILE = 0,
 	/* Hardware Debug Port (HDP) support (internal signals observation) */
 	PTA_STM32_DEBUG_HDP_DBG_PROFILE = 1,
+	/* DDR Performance Monitoring (DDRPERFM) support */
+	PTA_STM32_DEBUG_DDRPERFM_DBG_PROFILE = 2,
 };
 
 /**
