From 6f3aede911e942ad1861030bacc15c4301bbfc7c Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 7 May 2026 08:10:56 +0200
Subject: [PATCH 487/913] dts: stm32: activate HSI calibration on STM32MP25
 boards

Default enable HSI (High Speed Internal oscillator) calibration. This
internal oscillator tends to derive over time so calibration is needed.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git bb0ec29709edb3585d4062790dfd4cae56f8ec18 dts: stm32: activate HSI calibration on STM32MP25 boards]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I310188ff86638612e6f4266efd6b73f28d9136d4
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570772
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp257f-dk.dts  | 4 ++++
 core/arch/arm/dts/stm32mp257f-ev1.dts | 4 ++++
 2 files changed, 8 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp257f-dk.dts b/core/arch/arm/dts/stm32mp257f-dk.dts
index 6777f25fc..906d46338 100644
--- a/core/arch/arm/dts/stm32mp257f-dk.dts
+++ b/core/arch/arm/dts/stm32mp257f-dk.dts
@@ -66,6 +66,10 @@
 	status = "okay";
 };
 
+&hsi_calibration {
+	status = "okay";
+};
+
 &i2c7 {
 	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&i2c7_pins_a>;
diff --git a/core/arch/arm/dts/stm32mp257f-ev1.dts b/core/arch/arm/dts/stm32mp257f-ev1.dts
index 7f52a0066..16210a87f 100644
--- a/core/arch/arm/dts/stm32mp257f-ev1.dts
+++ b/core/arch/arm/dts/stm32mp257f-ev1.dts
@@ -65,6 +65,10 @@
 	status = "okay";
 };
 
+&hsi_calibration {
+	status = "okay";
+};
+
 &i2c7 {
 	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&i2c7_pins_a>;
-- 
