From 32c6096918bc5626eb6b8e3e3ace8440b968d902 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Fri, 17 Apr 2026 09:04:47 +0200
Subject: [PATCH 339/913] dts: stm32: add SCMI autonomous clock management for
 stm32mp25x

Adds CK_SCMI_GPIOZ_AM, CK_SCMI_LPDMA_AM, CK_SCMI_RTC_AM and
CK_SCMI_IPCC2_AM SCMI clocks.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git cbb6c03686d35c37980597b921ca66a991eac36b dts: stm32: add SCMI autonomous clock management for stm32mp25x]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I69c3d9f05256c46235166edc4ed2e91ec4a39a2a
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/406048
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/558626
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi | 24 ++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi b/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
index b351b9891..f1af3e840 100644
--- a/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
+++ b/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
@@ -701,6 +701,30 @@
 						domain-name = "msi_ker_ck";
 						clocks = <&rcc MSI_KER_CK>;
 					};
+
+					clock@80 {
+						reg = <CK_SCMI_GPIOZ_AM>;
+						domain-name = "ck_gpioz_am";
+						clocks = <&rcc CK_GPIOZ_AM>;
+					};
+
+					clock@81 {
+						reg = <CK_SCMI_IPCC2_AM>;
+						domain-name = "ck_ipcc2_am";
+						clocks = <&rcc CK_IPCC2_AM>;
+					};
+
+					clock@82 {
+						reg = <CK_SCMI_LPDMA_AM>;
+						domain-name = "ck_lpdma_am";
+						clocks = <&rcc CK_LPDMA_AM>;
+					};
+
+					clock@83 {
+						reg = <CK_SCMI_RTC_AM>;
+						domain-name = "ck_rtc_am";
+						clocks = <&rcc CK_RTC_AM>;
+					};
 				};
 			};
 
