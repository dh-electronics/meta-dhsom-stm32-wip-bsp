From 594811e2f4bd11cde7176dda7d11fd1471869093 Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Wed, 24 Sep 2025 17:10:58 +0200
Subject: [PATCH 469/913] plat-stm32mp2: default enable
 CFG_STM32_DEBUG_ACCESS_PTA in A35TD

In order to handle request on the debug configuration, when not in
M33TDCID mode, default enable CFG_STM32_DEBUG_ACCESS_PTA to embed
the debug access PTA.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 35063eb147ebe9ec5046ca3b9fbae6837b242de7 plat-stm32mp2: default enable CFG_STM32_DEBUG_ACCESS_PTA in A35TD]
Change-Id: Ic6311869d329705389be0bbc686bc23b4bf007e8
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/493445
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570737
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp2/conf.mk | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index e6b68ef84..6e340ed00 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -96,6 +96,7 @@ $(call force,CFG_STM32_TAMP,n)
 $(call force,CFG_STM32MP_PROVISIONING,n)
 $(call force,CFG_TA_STM32MP_NVMEM,n)
 $(call force,CFG_STM32_PSA_SERVICE,y)
+$(call force,CFG_STM32_DEBUG_ACCESS_PTA,n)
 endif
 
 $(call force,CFG_ARM_GIC_PM,y)
@@ -271,6 +272,12 @@ ifeq ($(CFG_STM32_BSEC_PTA),y)
 $(call force,CFG_STM32_BSEC3,y,Mandated by CFG_STM32_BSEC_PTA)
 endif
 
+# Enable Debug Access PTA
+CFG_STM32_DEBUG_ACCESS_PTA ?= y
+ifeq ($(CFG_STM32_DEBUG_ACCESS_PTA),y)
+$(call force,CFG_STM32_BSEC3,y,Mandated by CFG_STM32_DEBUG_ACCESS_PTA)
+endif
+
 # Enable Early TA NVMEM for provisioning management
 CFG_TA_STM32MP_NVMEM ?= y
 ifeq ($(CFG_TA_STM32MP_NVMEM),y)
-- 
