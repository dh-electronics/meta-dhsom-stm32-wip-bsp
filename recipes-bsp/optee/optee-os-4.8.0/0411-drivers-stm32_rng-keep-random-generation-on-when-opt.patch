From f94f25c2ef7e11922aab3ef815408a5eae32481d Mon Sep 17 00:00:00 2001
From: Olivier BIDEAU <olivier.bideau@st.com>
Date: Tue, 16 Jan 2024 10:22:43 +0100
Subject: [PATCH 411/913] drivers: stm32_rng: keep random generation on when
 optee is in sysram

This patch allows to maintain the random generation
when suspending the platform with optee in sysram.

In this case the RNG is needed to allow context encryption
before storing it in DDR.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git e742e8e52a57df59226ff3efc526f0f0402d2f8b drivers: stm32_rng: keep random generation on when optee is in sysram]
Signed-off-by: Olivier BIDEAU <olivier.bideau@st.com>
Change-Id: Ie8f8de1a261eccad8eaa96c9990d54968188d168
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/351510
Reviewed-by: Etienne CARRIERE <etienne.carriere@foss.st.com>
Domain-Review: Gatien CHEVALLIER <gatien.chevallier@st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/drivers/stm32_rng.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/core/drivers/stm32_rng.c b/core/drivers/stm32_rng.c
index 980218f9f..bfd0e1196 100644
--- a/core/drivers/stm32_rng.c
+++ b/core/drivers/stm32_rng.c
@@ -567,7 +567,9 @@ static TEE_Result stm32_rng_pm_suspend(void)
 		if (io_read32(rng_base + RNG_CR) & RNG_CR_CONDRST)
 			panic();
 	} else {
+#ifndef CFG_STM32MP1_OPTEE_IN_SYSRAM
 		io_clrbits32(rng_base + RNG_CR, RNG_CR_RNGEN);
+#endif
 	}
 
 	return TEE_SUCCESS;
@@ -795,7 +797,8 @@ DEFINE_DT_DRIVER(stm32_rng_dt_driver) = {
 
 static TEE_Result stm32_rng_release(void)
 {
-	if (stm32_rng && IS_ENABLED(CFG_WITH_SOFTWARE_PRNG)) {
+	if (stm32_rng && IS_ENABLED(CFG_WITH_SOFTWARE_PRNG) &&
+	    !IS_ENABLED(CFG_STM32MP1_OPTEE_IN_SYSRAM)) {
 		DMSG("Release RNG driver");
 		free(stm32_rng);
 		stm32_rng = NULL;
-- 
