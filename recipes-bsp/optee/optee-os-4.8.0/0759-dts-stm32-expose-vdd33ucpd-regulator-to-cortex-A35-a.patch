From 3aafbf438aa22bde3c75cf0e74ea431d7eddc9a2 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Mon, 22 Jun 2026 14:13:08 +0200
Subject: [PATCH 759/913] dts: stm32: expose vdd33ucpd regulator to cortex-A35
 agent for stm32mp23

Due to the move of the UCPD driver to the Linux kernel, the CC lines
PHYs need to enable the vdd33ucpd regulator.
need to enable this the vdd33ucpd regulator

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 980aa6f75921af3014ab9838890be61b8175784c dts: stm32: expose vdd33ucpd regulator to cortex-A35 agent for stm32mp23]
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Change-Id: I226805ffa2188b7cd02ce72db7740fd6f425b2b9
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/580992
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi b/core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi
index f4a9207a4..15f3b8db4 100644
--- a/core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi
+++ b/core/arch/arm/dts/stm32mp23-st-scmi-cfg.dtsi
@@ -799,6 +799,11 @@
 						voltd-supply = <&vddio4>;
 					};
 
+					regulator@5 {
+						reg = <VOLTD_SCMI_UCPD>;
+						voltd-supply = <&vdd33ucpd>;
+					};
+
 					regulator@7 {
 						reg = <VOLTD_SCMI_ADC>;
 						voltd-supply = <&vdda18adc>;
-- 
2.53.0

