From ad17716b497c4d6674c958e5d9a809f24a63c61c Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Mon, 25 May 2026 17:12:48 +0200
Subject: [PATCH 523/913] dts: stm32: declare ipcc1 as mbox provider on
 stm32mp231

Add mbox-cells property on ipcc1 in stm32mp231.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git cb7fc07232576607d6673dcb99258f781fca13f4 dts: stm32: declare ipcc1 as mbox provider on stm32mp231]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: I6318e91ed559d96876a834e8abc2831d3c0c0351
---
 core/arch/arm/dts/stm32mp231.dtsi | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/arch/arm/dts/stm32mp231.dtsi b/core/arch/arm/dts/stm32mp231.dtsi
index efcfa0fa4..a5aecc578 100644
--- a/core/arch/arm/dts/stm32mp231.dtsi
+++ b/core/arch/arm/dts/stm32mp231.dtsi
@@ -152,6 +152,7 @@
 		ipcc1: mailbox@40490000 {
 			compatible = "st,stm32mp25-ipcc";
 			reg = <0x40490000 0x400>;
+			#mbox-cells = <1>;
 			interrupts = <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-names = "rx";
 			clocks = <&rcc CK_BUS_IPCC1>;
-- 
2.53.0

