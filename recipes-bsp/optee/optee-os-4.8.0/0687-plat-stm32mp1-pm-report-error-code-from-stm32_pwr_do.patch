From 7ba4363b30325bc8ed15ec499138ec7ddb63a358 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Thu, 4 Dec 2025 15:24:54 +0100
Subject: [PATCH 687/913] plat-stm32mp1: pm: report error code from
 stm32_pwr_down_wfi()

stm32_pwr_down_wfi() may return -1 if system is not in the right condition
to go down in low power. Report this error code PSCI caller to let him
handle this.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 5fd1d1f2690225223de38dd5fe881b1ee8c06283 plat-stm32mp1: pm: report error code from stm32_pwr_down_wfi()]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: If437855aecc90109a4e78bedd9969e5e9e42afe4
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/515753
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/pm/context.c | 12 +++++++--
 core/arch/arm/plat-stm32mp1/pm/psci.c    | 34 +++++++++++++++---------
 2 files changed, 32 insertions(+), 14 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/pm/context.c b/core/arch/arm/plat-stm32mp1/pm/context.c
index 3a4d75713..c595b2782 100644
--- a/core/arch/arm/plat-stm32mp1/pm/context.c
+++ b/core/arch/arm/plat-stm32mp1/pm/context.c
@@ -35,6 +35,8 @@
 
 #define TRAINING_AREA_SIZE		64
 
+#define PM_MAILBOX_LOW_POWER_EP_ERROR	-1
+
 /*
  * STANDBY_CONTEXT_MAGIC  - V1 and V2 are not supported by OP-TEE
  *
@@ -581,7 +583,8 @@ void stm32mp_pm_shutdown_context(unsigned int soc_mode)
 TEE_Result stm32mp_pm_call_bl2_lp_entry(unsigned int soc_mode)
 {
 	struct pm_mailbox *mailbox = NULL;
-	void (*stm32_pwr_down_wfi)(bool is_cstop, unsigned int soc_mode) = NULL;
+	int (*stm32_pwr_down_wfi)(bool is_cstop, unsigned int soc_mode) = NULL;
+	int ret = 1;
 
 	clk_enable(pm_clocks.bkpsram);
 
@@ -602,13 +605,18 @@ TEE_Result stm32mp_pm_call_bl2_lp_entry(unsigned int soc_mode)
 	/* Clean again the cache after disabling the cache */
 	dcache_op_all(DCACHE_OP_CLEAN_INV);
 
-	(*stm32_pwr_down_wfi)(true, soc_mode);
+	ret = (*stm32_pwr_down_wfi)(true, soc_mode);
 
 	/* Enable Cache & MMU */
 	write_sctlr(read_sctlr() | SCTLR_C | SCTLR_M);
 
 	clk_disable(pm_clocks.bkpsram);
 
+	if (ret == PM_MAILBOX_LOW_POWER_EP_ERROR)
+		return TEE_ERROR_BAD_STATE;
+	else if (ret)
+		return TEE_ERROR_GENERIC;
+
 	return TEE_SUCCESS;
 }
 #endif /* CFG_STM32MP1_OPTEE_IN_SYSRAM */
diff --git a/core/arch/arm/plat-stm32mp1/pm/psci.c b/core/arch/arm/plat-stm32mp1/pm/psci.c
index 5a8c19393..240805004 100644
--- a/core/arch/arm/plat-stm32mp1/pm/psci.c
+++ b/core/arch/arm/plat-stm32mp1/pm/psci.c
@@ -237,6 +237,7 @@ int psci_cpu_off(void)
 /* Start non-pageable section */
 static int enter_cstop_suspend(unsigned int soc_mode)
 {
+	TEE_Result __maybe_unused ret = TEE_ERROR_GENERIC;
 	int rc = 1;
 
 	if (read_isr())
@@ -245,7 +246,10 @@ static int enter_cstop_suspend(unsigned int soc_mode)
 	stm32_enter_cstop(soc_mode);
 
 #ifndef CFG_STM32MP1_OPTEE_IN_SYSRAM
-	if (stm32mp_pm_call_bl2_lp_entry(soc_mode) == TEE_SUCCESS)
+	ret = stm32mp_pm_call_bl2_lp_entry(soc_mode);
+	if (ret == TEE_ERROR_BAD_STATE)
+		rc = -1;
+	else if (ret == TEE_SUCCESS)
 		rc = 0;
 #else
 	if (need_to_backup_cpu_context(soc_mode)) {
@@ -570,17 +574,19 @@ static void stm32_cpu_standby(void)
 }
 DECLARE_KEEP_PAGER(stm32_cpu_standby);
 
-static void stm32_pwr_domain_suspend(unsigned int soc_mode)
+static int stm32_pwr_domain_suspend(unsigned int soc_mode)
 {
 	size_t other_pos = stm32_get_pos_other();
+	int ret = PSCI_RET_INTERNAL_FAILURE;
 	uint32_t exceptions = 0;
 	uint32_t scr = 0;
+	int rc = 1;
 
 	exceptions = may_spin_lock(&cstop_lock);
 	if (core_state[other_pos] != CORE_OFF &&
 	    cstop_cpux_state[other_pos] != STATE_AUTO_CSTOP_ENTRY) {
 		may_spin_unlock(&cstop_lock, exceptions);
-		return;
+		return PSCI_RET_DENIED;
 	}
 
 	cstop_enter = STATE_AUTO_CSTOP_ENTRY;
@@ -590,7 +596,12 @@ static void stm32_pwr_domain_suspend(unsigned int soc_mode)
 	scr = read_scr();
 	write_scr(scr | SCR_IRQ | SCR_FIQ);
 
-	plat_suspend((uint32_t)soc_mode);
+	rc = plat_suspend((uint32_t)soc_mode);
+	if (rc == -1)
+		ret = PSCI_RET_DENIED;
+	else if (rc == 0)
+		ret = PSCI_RET_SUCCESS;
+
 	interrupt_ack_sgi(interrupt_get_main_chip(),
 			  GIC_SEC_SGI_6,
 			  TARGET_CPUX_GIC_MASK(other_pos));
@@ -598,6 +609,8 @@ static void stm32_pwr_domain_suspend(unsigned int soc_mode)
 	write_scr(scr);
 	set_locked(&cstop_enter, STATE_NONE);
 	sev();
+
+	return ret;
 }
 
 /*
@@ -622,7 +635,7 @@ int __weak __psci_cpu_suspend(uint32_t power_state,
 	uint32_t state_id = 0;
 	uint32_t state_type = 0;
 	uint32_t power_level __maybe_unused = 0;
-	int ret = PSCI_RET_INVALID_PARAMETERS;
+	int ret = PSCI_RET_INTERNAL_FAILURE;
 
 	state_id = (power_state & PSCI_POWER_STATE_ID_MASK) >>
 		   PSCI_POWER_STATE_ID_SHIFT;
@@ -635,7 +648,7 @@ int __weak __psci_cpu_suspend(uint32_t power_state,
 	     power_level, state_type, state_id);
 
 	if (state_type != PSCI_POWER_STATE_TYPE_STANDBY)
-		return ret;
+		return PSCI_RET_INVALID_PARAMETERS;
 
 	switch (state_id) {
 	case STM32_STATE_ID_CPU_PWRDN:
@@ -643,16 +656,13 @@ int __weak __psci_cpu_suspend(uint32_t power_state,
 		ret = PSCI_RET_SUCCESS;
 		break;
 	case STM32_STATE_ID_STOP1:
-		stm32_pwr_domain_suspend(STM32_PM_CSTOP_ALLOW_STOP);
-		ret = PSCI_RET_SUCCESS;
+		ret = stm32_pwr_domain_suspend(STM32_PM_CSTOP_ALLOW_STOP);
 		break;
 	case STM32_STATE_ID_LP_STOP1:
-		stm32_pwr_domain_suspend(STM32_PM_CSTOP_ALLOW_LP_STOP);
-		ret = PSCI_RET_SUCCESS;
+		ret = stm32_pwr_domain_suspend(STM32_PM_CSTOP_ALLOW_LP_STOP);
 		break;
 	case STM32_STATE_ID_LPLV_STOP1:
-		stm32_pwr_domain_suspend(STM32_PM_CSTOP_ALLOW_LPLV_STOP);
-		ret = PSCI_RET_SUCCESS;
+		ret = stm32_pwr_domain_suspend(STM32_PM_CSTOP_ALLOW_LPLV_STOP);
 		break;
 	default:
 	}
-- 
2.53.0

