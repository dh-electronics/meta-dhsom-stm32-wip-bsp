From 39f2bc716d6bf75f8ffeda5496712f7c8e29c26a Mon Sep 17 00:00:00 2001
From: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Date: Tue, 12 May 2026 15:52:54 +0200
Subject: [PATCH 594/913] dts: stm32: expose M33 SCMI reset for stm32mp25

Expose the CPU2 reset and hold boot managed by the stm32_remoteproc
controller.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 395732a4f3fbc2bcd2d574c2861738ae9cccbd24 dts: stm32: expose M33 SCMI reset for stm32mp25]
Signed-off-by: Arnaud Pouliquen <arnaud.pouliquen@foss.st.com>
Change-Id: I041648fa4aad2145ebe25b9912d60383fbb8d10f
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570906
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
Tested-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Arnaud POULIQUEN <arnaud.pouliquen@st.com>
---
 core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi b/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
index 0e203d371..cce228d4a 100644
--- a/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
+++ b/core/arch/arm/dts/stm32mp25-st-scmi-cfg.dtsi
@@ -758,6 +758,18 @@
 					#address-cells = <1>;
 					#size-cells = <0>;
 
+					reset@1 {
+						reg = <RST_SCMI_C2_R>;
+						domain-name = "c2";
+						resets = <&m33_rproc 0>;
+					};
+
+					reset@3 {
+						reg = <RST_SCMI_C2_HOLDBOOT_R>;
+						domain-name = "c2_holdboot";
+						resets = <&m33_rproc 1>;
+					};
+
 					reset@4 {
 						reg = <RST_SCMI_FMC>;
 						domain-name = "fmc";
-- 
