From 1107bb7fffcf75c55a558b71bc3787e5eabe4892 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Fri, 10 Jul 2026 14:33:34 +0200
Subject: [PATCH 844/913] plat-stm32mp1: remove empty flavor from platform
 banner

PLATFORM_FLAVOR prints an empty value in the stm32mp1 banner. Drop
logging of PLATFORM_FLAVOR and keep printing the device tree file, which
carries equivalent or better platform information.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 161efa1b7c2aca3df48654115016a98199688e02 plat-stm32mp1: remove empty flavor from platform banner]
Change-Id: I27ce387145f6c7aabcbf3a1eaf05c2212891b07b
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/587464
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/plat-stm32mp1/main.c | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/main.c b/core/arch/arm/plat-stm32mp1/main.c
index fd09d5012..61c6a2ccc 100644
--- a/core/arch/arm/plat-stm32mp1/main.c
+++ b/core/arch/arm/plat-stm32mp1/main.c
@@ -75,9 +75,7 @@ register_phys_mem(MEM_AREA_ROM_SEC, TEE_RAM_START, TEE_RAM_PH_SIZE);
 
 static TEE_Result platform_banner(void)
 {
-	IMSG("Platform stm32mp1: flavor %s - DT %s",
-		ID2STR(PLATFORM_FLAVOR),
-		ID2STR(CFG_EMBED_DTB_SOURCE_FILE));
+	IMSG("Platform stm32mp1: DT %s", ID2STR(CFG_EMBED_DTB_SOURCE_FILE));
 	IMSG("OP-TEE ST profile: %s", TO_STR(CFG_STM32MP_PROFILE));
 
 	return TEE_SUCCESS;
-- 
2.53.0

