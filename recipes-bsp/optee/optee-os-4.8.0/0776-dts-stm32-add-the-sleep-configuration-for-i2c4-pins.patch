From 6f1eb528cafead87da30045d2792a5738dcc7c7d Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Mon, 15 Jun 2026 17:55:46 +0200
Subject: [PATCH 776/913] dts: stm32: add the sleep configuration for i2c4 pins

Alignment with stm32mp157c-ed1.dts/stm32mp15xx-dkx.dtsi

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git d7b9ad8fc1661870248762134e8fbed373021e7a dts: stm32: add the sleep configuration for i2c4 pins]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: Iad9ef3965423c3740ff5760a638e7096a7d50814
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/579263
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/dts/stm32mp157d-ed1.dts | 3 ++-
 core/arch/arm/dts/stm32mp157f-ed1.dts | 3 ++-
 2 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp157d-ed1.dts b/core/arch/arm/dts/stm32mp157d-ed1.dts
index 054bc739d..37acb7627 100644
--- a/core/arch/arm/dts/stm32mp157d-ed1.dts
+++ b/core/arch/arm/dts/stm32mp157d-ed1.dts
@@ -92,8 +92,9 @@
 
 &i2c4 {
 	compatible = "st,stm32mp15-i2c-non-secure";
-	pinctrl-names = "default";
+	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&i2c4_pins_a>;
+	pinctrl-1 = <&i2c4_sleep_pins_a>;
 	i2c-scl-rising-time-ns = <185>;
 	i2c-scl-falling-time-ns = <20>;
 	clock-frequency = <400000>;
diff --git a/core/arch/arm/dts/stm32mp157f-ed1.dts b/core/arch/arm/dts/stm32mp157f-ed1.dts
index 5c420248e..4aec1bfce 100644
--- a/core/arch/arm/dts/stm32mp157f-ed1.dts
+++ b/core/arch/arm/dts/stm32mp157f-ed1.dts
@@ -98,8 +98,9 @@
 
 &i2c4 {
 	compatible = "st,stm32mp15-i2c-non-secure";
-	pinctrl-names = "default";
+	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&i2c4_pins_a>;
+	pinctrl-1 = <&i2c4_sleep_pins_a>;
 	i2c-scl-rising-time-ns = <185>;
 	i2c-scl-falling-time-ns = <20>;
 	clock-frequency = <400000>;
-- 
2.53.0

