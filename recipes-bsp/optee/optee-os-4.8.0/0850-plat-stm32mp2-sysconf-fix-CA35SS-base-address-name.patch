From 80185a33a895e23080e778afdae2d0f366b283da Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Thu, 10 Sep 2026 17:39:40 +0200
Subject: [PATCH 850/913] plat: stm32mp2: sysconf: fix CA35SS base address name

Align base address name with the reference manual for Arm Cortex-A35 :
CA35SS_BASE

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 7a3d6791266875a842f43870d1706d8fe1b6e041 plat: stm32mp2: sysconf: fix CA35SS base address name]
Change-Id: Ibb454bbf5e6a6cd992326730117fe71505020d19
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/610765
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/plat-stm32mp2/drivers/stm32mp25_syscfg.c | 2 +-
 core/arch/arm/plat-stm32mp2/platform_config.h          | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp2/drivers/stm32mp25_syscfg.c b/core/arch/arm/plat-stm32mp2/drivers/stm32mp25_syscfg.c
index ded9549e5..930977ae7 100644
--- a/core/arch/arm/plat-stm32mp2/drivers/stm32mp25_syscfg.c
+++ b/core/arch/arm/plat-stm32mp2/drivers/stm32mp25_syscfg.c
@@ -38,7 +38,7 @@
 
 struct io_pa_va syscfg_base[SYSCON_NB_BANKS] = {
 	{ .pa = SYSCFG_BASE },
-	{ .pa = A35SSC_BASE }
+	{ .pa = CA35SS_BASE }
 };
 
 /* IO compensation CCR registers bit definition */
diff --git a/core/arch/arm/plat-stm32mp2/platform_config.h b/core/arch/arm/plat-stm32mp2/platform_config.h
index caf26a21c..8e126634e 100644
--- a/core/arch/arm/plat-stm32mp2/platform_config.h
+++ b/core/arch/arm/plat-stm32mp2/platform_config.h
@@ -82,7 +82,7 @@
 #define STGEN_BASE			0x48080000
 #define FMC_BASE			0x48200000
 #define PCIE_BASE			0x48400000
-#define A35SSC_BASE			0x48800000
+#define CA35SS_BASE			0x48800000
 #define GIC_BASE			0x4ac00000
 #define DDR_BASE			UL(0x80000000)
 
-- 
2.53.0

