From 269c63d421b2af5bbfe5759d22dbd6b471e22b18 Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Thu, 23 May 2024 15:00:33 +0200
Subject: [PATCH 336/913] plat-stm32mp1: print configuration profile

Print stm32mp configuration profile at info level.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git c76930918f74c688a2aa75a5dcf034d47eb99084 plat-stm32mp1: print configuration profile]
Change-Id: Ifcff5a8fe1d726c3c87c4ca5b225680d82561384
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/382114
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/main.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/main.c b/core/arch/arm/plat-stm32mp1/main.c
index e8d7ec94a..b5f285695 100644
--- a/core/arch/arm/plat-stm32mp1/main.c
+++ b/core/arch/arm/plat-stm32mp1/main.c
@@ -33,6 +33,7 @@
 #include <stm32_util.h>
 #include <string.h>
 #include <trace.h>
+#include <util.h>
 
 register_phys_mem_pgdir(MEM_AREA_IO_NSEC, APB1_BASE, APB1_SIZE);
 register_phys_mem_pgdir(MEM_AREA_IO_NSEC, APB2_BASE, APB2_SIZE);
@@ -63,6 +64,7 @@ static TEE_Result platform_banner(void)
 	IMSG("Platform stm32mp1: flavor %s - DT %s",
 		ID2STR(PLATFORM_FLAVOR),
 		ID2STR(CFG_EMBED_DTB_SOURCE_FILE));
+	IMSG("OP-TEE ST profile: %s", TO_STR(CFG_STM32MP_PROFILE));
 
 	return TEE_SUCCESS;
 }
