From 5ae14b4d241e8684afd7ac199d53a469067e6cca Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 13 Apr 2026 15:55:08 +0200
Subject: [PATCH 299/913] dts: st: define pka node in stm32mp21xc.dtsi

Add node pka in stm32mp21xc.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git eb564597f69dae79840405c45a9bc4062669f894 dts: st: define pka node in stm32mp21xc.dtsi]
Change-Id: I1c32506120569a598356e2a6a7aa544363bbef49
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/557096
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
---
 core/arch/arm/dts/stm32mp21xc.dtsi | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp21xc.dtsi b/core/arch/arm/dts/stm32mp21xc.dtsi
index a1fbfccc2..5d35554ef 100644
--- a/core/arch/arm/dts/stm32mp21xc.dtsi
+++ b/core/arch/arm/dts/stm32mp21xc.dtsi
@@ -35,4 +35,15 @@
 		access-controllers = <&rifsc STM32MP21_RIFSC_SAES_ID>, <&rifsc STM32MP21_RIFSC_RNG1_ID>;
 		status = "disabled";
 	};
+
+	pka: pka@42032000 {
+		compatible = "st,stm32mp13-pka64";
+		reg = <0x42032000 0x2000>;
+		interrupts = <GIC_SPI 133 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&rcc CK_BUS_PKA>, <&rcc CK_BUS_RNG1>;
+		clock-names = "bus", "rng";
+		resets = <&rcc PKA_R>;
+		access-controllers = <&rifsc STM32MP21_RIFSC_PKA_ID>, <&rifsc STM32MP21_RIFSC_RNG1_ID>;
+		status = "disabled";
+	};
 };
