From 428b063fa3da462002a7fe1917e613f6aac57f4b Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Thu, 23 Jul 2026 15:29:28 +0200
Subject: [PATCH 869/913] clk: stm32: check stm32mp_rcc_clock_id_to_clk() for
 NULL before use
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

clk_stm32_clock_frequency_calculator_get_ref(), stm32mp2_clk_init_hsi_cal()
and stm32mp2_clk_init_msi_cal() all pass the result of
stm32mp_rcc_clock_id_to_clk() directly to clk_get_rate() without
checking for NULL, causing a NULL pointer dereference if the
requested clock id has no matching struct clk.

Add a NULL check with panic() in each of the three functions.

Coverity issue: CID 1199910: CERT-C Expression
Coverity issue: CID 1200211: CERT-C Expression
Coverity issue: CID 1200368: CERT-C Expression

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 9c251e8337a4e058631c8798baf2ea3c63f7b7cf clk: stm32: check stm32mp_rcc_clock_id_to_clk() for NULL before use]
Assisted-by: GitHub-Copilot:Claude-Sonnet-5
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Change-Id: I68ef928fbebb962663f7b3ed706c850d3d12dd96
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/592845
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/drivers/clk/stm32/clk-stm32mp2-cal.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/core/drivers/clk/stm32/clk-stm32mp2-cal.c b/core/drivers/clk/stm32/clk-stm32mp2-cal.c
index 85315d9a5..5f036d31b 100644
--- a/core/drivers/clk/stm32/clk-stm32mp2-cal.c
+++ b/core/drivers/clk/stm32/clk-stm32mp2-cal.c
@@ -172,6 +172,9 @@ static unsigned long clk_stm32_clock_frequency_calculator_get_ref(void)
 		break;
 	}
 
+	if (!clk)
+		panic();
+
 	return clk_get_rate(clk);
 }
 
@@ -645,6 +648,9 @@ static TEE_Result stm32mp2_clk_init_hsi_cal(struct stm32_calib_pdata *pdata)
 	struct stm32_calib *data = calib_tab[HSI_CAL];
 	TEE_Result res = TEE_ERROR_GENERIC;
 
+	if (!hsi_clk)
+		panic();
+
 	data->ref_freq = clk_get_rate(hsi_clk);
 	data->cal_ref = stm32mp2_clk_hsi_get_cal();
 
@@ -690,6 +696,9 @@ stm32mp2_clk_init_msi_cal(struct stm32_calib_pdata *pdata __unused)
 	struct clk *msi_clk = stm32mp_rcc_clock_id_to_clk(MSI_CK);
 	struct stm32_calib *data = calib_tab[MSI_CAL];
 
+	if (!msi_clk)
+		panic();
+
 	data->ref_freq = clk_get_rate(msi_clk);
 	data->cal_ref = stm32mp2_clk_msi_get_cal();
 	trim_table_init(data);
-- 
