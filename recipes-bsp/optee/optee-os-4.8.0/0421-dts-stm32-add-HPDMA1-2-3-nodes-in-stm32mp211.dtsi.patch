From 57fe9f1ca37a212522fa736ac925ec4278a6417e Mon Sep 17 00:00:00 2001
From: Amelie Delaunay <amelie.delaunay@foss.st.com>
Date: Wed, 13 May 2026 17:20:30 +0200
Subject: [PATCH 421/913] dts: stm32: add HPDMA1/2/3 nodes in stm32mp211.dtsi

Add HPDMA1/2/3 nodes and default disable them.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 9cf6e9c2c48e0786d35a44eaf65ac4c58df33a76 dts: stm32: add HPDMA1/2/3 nodes in stm32mp211.dtsi]
Signed-off-by: Amelie Delaunay <amelie.delaunay@foss.st.com>
Change-Id: I2eeb4f3195e30f877be7b55c39269df2ca3e9298
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/567635
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/dts/stm32mp211.dtsi | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index f903f5c5a..c1e82afa4 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -95,6 +95,33 @@
 		interrupt-parent = <&intc>;
 		ranges = <0x0 0x0 0x0 0x80000000>;
 
+		hpdma1: dma-controller@40400000 {
+			compatible = "st,stm32mp21-dma3";
+			reg = <0x40400000 0x1000>;
+			clocks = <&rcc CK_BUS_HPDMA1>;
+			#dma-cells = <3>;
+			st,syscfg-arcr = <&syscfg 0x2050 0x1>;
+			status = "disabled";
+		};
+
+		hpdma2: dma-controller@40410000 {
+			compatible = "st,stm32mp21-dma3";
+			reg = <0x40410000 0x1000>;
+			clocks = <&rcc CK_BUS_HPDMA2>;
+			#dma-cells = <3>;
+			st,syscfg-arcr = <&syscfg 0x2050 0x2>;
+			status = "disabled";
+		};
+
+		hpdma3: dma-controller@40420000 {
+			compatible = "st,stm32mp21-dma3";
+			reg = <0x40420000 0x1000>;
+			clocks = <&rcc CK_BUS_HPDMA3>;
+			#dma-cells = <3>;
+			st,syscfg-arcr = <&syscfg 0x2050 0x4>;
+			status = "disabled";
+		};
+
 		rifsc: bus@42080000 {
 			compatible = "st,stm32mp25-rifsc", "simple-bus";
 			reg = <0x42080000 0x1000>;
-- 
2.53.0

