From 743656765e7fa0c7da7ef5417766b30049e8a769 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 9 Apr 2025 15:35:17 +0200
Subject: [PATCH 194/913] clk: stm32mp21: add support of CPU1 set parent

Add the support of CPU1 set parent to force bypass on CA35SS clock
before voltage switch.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 11fcdfb5752942f2e5883ff204c908e31ec924da clk: stm32mp21: add support of CPU1 set parent]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I68fb1c2ca256e9ed5552103784eba4d582c33182
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/451536
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/drivers/clk/clk-stm32mp21.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/core/drivers/clk/clk-stm32mp21.c b/core/drivers/clk/clk-stm32mp21.c
index c35992750..3b7994687 100644
--- a/core/drivers/clk/clk-stm32mp21.c
+++ b/core/drivers/clk/clk-stm32mp21.c
@@ -2818,6 +2818,15 @@ static size_t clk_cpu1_get_parent(struct clk *clk __unused)
 		CA35SS_SSC_CHGCLKREQ_ARM_CHGCLKACK_SHIFT;
 }
 
+static TEE_Result clk_cpu1_set_parent(struct clk *clk __unused, size_t pidx)
+{
+	if (pidx == 1)
+		stm32mp2_a35_ss_on_bypass();
+	/* For other pidx, switch to parent is managed in PLL1 set rate */
+
+	return TEE_SUCCESS;
+}
+
 static TEE_Result clk_cpu1_determine_rate(struct clk *clk,
 					  struct clk_rate_request *req)
 {
@@ -2856,6 +2865,7 @@ static TEE_Result clk_cpu1_set_rate(struct clk *clk __unused,
 static const struct clk_ops clk_stm32_cpu1_ops = {
 	.determine_rate = clk_cpu1_determine_rate,
 	.set_rate = clk_cpu1_set_rate,
+	.set_parent = clk_cpu1_set_parent,
 	.get_parent = clk_cpu1_get_parent,
 };
 
