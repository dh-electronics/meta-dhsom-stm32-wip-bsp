From 4511da324102ad8502ad1592adab09900085300d Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 21 May 2026 09:26:08 +0200
Subject: [PATCH 489/913] dts: stm32: activate HSI calibration on
 STM32MP215f-dk board

Default enable HSI (High Speed Internal oscillator) calibration. This
internal oscillator tends to derive over time so calibration is needed.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git b935f80c351dba54a90437102326c8bb40cb3f7b dts: stm32: activate HSI calibration on STM32MP215f-dk board]
Change-Id: I71483276f1c03959c72d1beba138279a122f4f9a
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570774
---
 core/arch/arm/dts/stm32mp215f-dk.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp215f-dk.dts b/core/arch/arm/dts/stm32mp215f-dk.dts
index 5c5cef401..61ff1268f 100644
--- a/core/arch/arm/dts/stm32mp215f-dk.dts
+++ b/core/arch/arm/dts/stm32mp215f-dk.dts
@@ -60,6 +60,10 @@
 	status = "okay";
 };
 
+&hsi_calibration {
+	status = "okay";
+};
+
 &i2c3 {
 	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&i2c3_pins_a>;
-- 
2.53.0

