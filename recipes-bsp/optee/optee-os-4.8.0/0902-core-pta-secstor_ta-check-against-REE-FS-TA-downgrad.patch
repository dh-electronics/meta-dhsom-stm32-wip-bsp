 core/include/kernel/ree_fs_ta.h | 16 ++++++++++++++++
 core/kernel/ree_fs_ta.c         |  9 +++++++++
 core/pta/secstor_ta_mgmt.c      | 10 ++++++++++
 3 files changed, 35 insertions(+)
 create mode 100644 core/include/kernel/ree_fs_ta.h

diff --git a/core/include/kernel/ree_fs_ta.h b/core/include/kernel/ree_fs_ta.h
new file mode 100644
index 000000000..ae196f136
--- /dev/null
+++ b/core/include/kernel/ree_fs_ta.h
@@ -0,0 +1,16 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (c) 2026, Qualcomm Technologies, Inc. and/or its subsidiaries.
+ */
+
+#ifndef __KERNEL_REE_FS_TA_H
+#define __KERNEL_REE_FS_TA_H
+
+#include <types_ext.h>
+#include <tee_api_types.h>
+
+TEE_Result ree_fs_check_update_ta_version(const uint8_t uuid[sizeof(TEE_UUID)],
+					  uint32_t version);
+
+
+#endif /*__KERNEL_REE_FS_TA_H*/
diff --git a/core/kernel/ree_fs_ta.c b/core/kernel/ree_fs_ta.c
index 94f8a5eac..3bd13fb82 100644
--- a/core/kernel/ree_fs_ta.c
+++ b/core/kernel/ree_fs_ta.c
@@ -39,6 +39,7 @@
 #include <crypto/crypto.h>
 #include <fault_mitigation.h>
 #include <initcall.h>
+#include <kernel/ree_fs_ta.h>
 #include <kernel/thread.h>
 #include <kernel/ts_store.h>
 #include <kernel/user_access.h>
@@ -189,6 +190,14 @@ out:
 	return res;
 }
 
+
+TEE_Result ree_fs_check_update_ta_version(const uint8_t uuid[sizeof(TEE_UUID)],
+                                          uint32_t version)
+{
+	return check_update_version(ta_ver_db, uuid, version);
+}
+
+
 /*
  * Load a TA via RPC with UUID defined by input param @uuid. The virtual
  * address of the raw TA binary is received in out parameter @ta.
diff --git a/core/pta/secstor_ta_mgmt.c b/core/pta/secstor_ta_mgmt.c
index b8dc9283c..8633a6c73 100644
--- a/core/pta/secstor_ta_mgmt.c
+++ b/core/pta/secstor_ta_mgmt.c
@@ -4,6 +4,7 @@
  */
 
 #include <kernel/pseudo_ta.h>
+#include <kernel/ree_fs_ta.h>
 #include <tee/tadb.h>
 #include <pta_secstor_ta_mgmt.h>
 #include <signed_hdr.h>
@@ -123,6 +124,15 @@ static TEE_Result install_ta(struct shdr *shdr, const uint8_t *nw,
 		goto err_ta_finalize;
 	}
 
+	/*
+	 * This might increase the recorded version, do it only after we've
+	 * verified that the signature and hash are OK to make sure it's a
+	 * valid version.
+	 */
+	res = ree_fs_check_update_ta_version(bs_ta.uuid, bs_ta.ta_version);
+	if (res)
+		goto err_ta_finalize;
+
 	crypto_hash_free_ctx(hash_ctx);
 	free(buf);
 	return tee_tadb_ta_close_and_commit(ta);
