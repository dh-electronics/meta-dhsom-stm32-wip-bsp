From 70784836fcee14775ef42d2da4d14bdf026eeb92 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 13 Apr 2026 17:26:27 +0200
Subject: [PATCH 303/913] dts: st: define saes node in stm32mp23xc.dtsi

Add node saes in stm32mp23xc.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git b1f175c985b35d8db5da9b410c2f3444bf582a95 dts: st: define saes node in stm32mp23xc.dtsi]
Change-Id: Ibc99b16f786ae7f0293823e2b5a334627c8d0080
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/557100
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/dts/stm32mp23xc.dtsi | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp23xc.dtsi b/core/arch/arm/dts/stm32mp23xc.dtsi
index 138c36ca7..2269cd331 100644
--- a/core/arch/arm/dts/stm32mp23xc.dtsi
+++ b/core/arch/arm/dts/stm32mp23xc.dtsi
@@ -24,4 +24,15 @@
 		access-controllers = <&rifsc STM32MP25_RIFSC_CRYP2_ID>;
 		status = "disabled";
 	};
+
+	saes: saes@42050000 {
+		compatible = "st,stm32mp13-saes";
+		reg = <0x42050000 0x400>;
+		interrupts = <GIC_SPI 179 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&rcc CK_BUS_SAES>, <&rcc CK_BUS_RNG>;
+		clock-names = "bus", "rng";
+		resets = <&rcc SAES_R>;
+		access-controllers = <&rifsc STM32MP25_RIFSC_SAES_ID>;
+		status = "disabled";
+	};
 };
