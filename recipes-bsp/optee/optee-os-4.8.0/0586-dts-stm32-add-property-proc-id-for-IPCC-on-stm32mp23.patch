From 2a4ec9868ae392cb6496f12d5b361cdf9a3fd479 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Thu, 28 May 2026 11:39:20 +0200
Subject: [PATCH 586/913] dts: stm32: add property proc-id for IPCC on
 stm32mp23 and stm32mp25

Add missing properties proc-id for IPCC1 and IPCC2 in stm32mp231.dtsi
and stm32mp251.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 59c9bf0146c89283514d3c44bb006219571972fb dts: stm32: add property proc-id for IPCC on stm32mp23 and stm32mp25]
Change-Id: I2b18af1da1d95482d18ef21435c6fb320f95f2de
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/572320
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Michel JAOUEN <michel.jaouen@st.com>
Reviewed-by: Michel JAOUEN <michel.jaouen@st.com>
---
 core/arch/arm/dts/stm32mp231.dtsi | 1 +
 core/arch/arm/dts/stm32mp251.dtsi | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp231.dtsi b/core/arch/arm/dts/stm32mp231.dtsi
index a5aecc578..e348b11bf 100644
--- a/core/arch/arm/dts/stm32mp231.dtsi
+++ b/core/arch/arm/dts/stm32mp231.dtsi
@@ -156,6 +156,7 @@
 			interrupts = <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-names = "rx";
 			clocks = <&rcc CK_BUS_IPCC1>;
+			st,proc-id = <0>;
 			status = "disabled";
 		};
 
diff --git a/core/arch/arm/dts/stm32mp251.dtsi b/core/arch/arm/dts/stm32mp251.dtsi
index ec6faee5d..03f8cf7df 100644
--- a/core/arch/arm/dts/stm32mp251.dtsi
+++ b/core/arch/arm/dts/stm32mp251.dtsi
@@ -156,6 +156,7 @@
 			interrupts = <GIC_SPI 173 IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-names = "rx";
 			clocks = <&rcc CK_BUS_IPCC1>;
+			st,proc-id = <0>;
 			status = "disabled";
 		};
 
@@ -1216,6 +1217,7 @@
 			compatible = "st,stm32mp25-ipcc";
 			reg = <0x46250000 0x400>;
 			clocks = <&rcc CK_BUS_IPCC2>;
+			st,proc-id = <1>;
 			status = "disabled";
 		};
 
-- 
