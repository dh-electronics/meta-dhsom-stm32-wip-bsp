From 215299cce9df2d6ee0be8432bb14f9bd36358ff9 Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Tue, 19 Dec 2023 09:54:51 +0100
Subject: [PATCH 127/913] drivers: gic: use GIC_HIGHEST_NS_PRIORITY macro

Use existing macro GIC_HIGHEST_NS_PRIORITY where applicable.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 8b83976c361c25c4cbf02addaa0a0e50f37ef0bb drivers: gic: use GIC_HIGHEST_NS_PRIORITY macro]
Change-Id: Ie36f250933c9d3b657ae4ad4c0cd308cc53acb69
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
---
 core/drivers/gic.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/core/drivers/gic.c b/core/drivers/gic.c
index ac8f80f71..a68ed03e4 100644
--- a/core/drivers/gic.c
+++ b/core/drivers/gic.c
@@ -395,10 +395,10 @@ static void init_gic_per_cpu(struct gic_data *gd)
 	 * allow the Non-secure world to adjust the priority mask itself
 	 */
 #if defined(CFG_ARM_GICV3)
-	write_icc_pmr(0x80);
+	write_icc_pmr(GIC_HIGHEST_NS_PRIORITY);
 	write_icc_igrpen1(1);
 #else
-	io_write32(gd->gicc_base + GICC_PMR, 0x80);
+	io_write32(gd->gicc_base + GICC_PMR, GIC_HIGHEST_NS_PRIORITY);
 
 	/* Enable GIC */
 	io_write32(gd->gicc_base + GICC_CTLR,
@@ -684,11 +684,11 @@ static void gic_init_setup(struct gic_data __maybe_unused *gd)
 	 * allow the Non-secure world to adjust the priority mask itself
 	 */
 #if defined(CFG_ARM_GICV3)
-	write_icc_pmr(0x80);
+	write_icc_pmr(GIC_HIGHEST_NS_PRIORITY);
 	write_icc_igrpen1(1);
 	io_setbits32(gd->gicd_base + GICD_CTLR, GICD_CTLR_ENABLEGRP1S);
 #else
-	io_write32(gd->gicc_base + GICC_PMR, 0x80);
+	io_write32(gd->gicc_base + GICC_PMR, GIC_HIGHEST_NS_PRIORITY);
 
 	/* Enable GIC */
 	io_write32(gd->gicc_base + GICC_CTLR, GICC_CTLR_FIQEN |
