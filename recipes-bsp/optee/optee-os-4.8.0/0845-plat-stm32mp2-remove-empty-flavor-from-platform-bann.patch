From e36d6ca6bb7d8528ffcc14126b965e4ec6166fef Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Fri, 10 Jul 2026 14:33:49 +0200
Subject: [PATCH 845/913] plat-stm32mp2: remove empty flavor from platform
 banner

PLATFORM_FLAVOR prints an empty value in the stm32mp2 banner. Drop
logging of PLATFORM_FLAVOR and keep printing the device tree file, which
carries equivalent or better platform information.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 6483edfa97f6d681abe5d56b4a6a596ff040db31 plat-stm32mp2: remove empty flavor from platform banner]
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Change-Id: I663aeedeb4e404c7377d67f2141f4f2d642898f9
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/587465
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 core/arch/arm/plat-stm32mp2/main.c | 4 +---
 1 file changed, 1 insertion(+), 3 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp2/main.c b/core/arch/arm/plat-stm32mp2/main.c
index 7f59e7354..dc804cbb4 100644
--- a/core/arch/arm/plat-stm32mp2/main.c
+++ b/core/arch/arm/plat-stm32mp2/main.c
@@ -76,9 +76,7 @@ register_phys_mem(MEM_AREA_RAM_SEC, SRAM1_BASE, SIZE_4K);
 
 static TEE_Result platform_banner(void)
 {
-	IMSG("Platform stm32mp2: flavor %s - DT %s", ID2STR(PLATFORM_FLAVOR),
-	     ID2STR(CFG_EMBED_DTB_SOURCE_FILE));
-
+	IMSG("Platform stm32mp2: DT %s", ID2STR(CFG_EMBED_DTB_SOURCE_FILE));
 	IMSG("OP-TEE ST profile: %s", TO_STR(CFG_STM32MP_PROFILE));
 
 	return TEE_SUCCESS;
-- 
2.53.0

