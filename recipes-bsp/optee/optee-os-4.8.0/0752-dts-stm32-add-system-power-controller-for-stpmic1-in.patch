Change-Id: I434f923eede310ceab0f86c3b3783541865c5977
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/581303
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp135f-dk.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/arch/arm/dts/stm32mp135f-dk.dts b/core/arch/arm/dts/stm32mp135f-dk.dts
index 59f792f7c..55b4b9eec 100644
