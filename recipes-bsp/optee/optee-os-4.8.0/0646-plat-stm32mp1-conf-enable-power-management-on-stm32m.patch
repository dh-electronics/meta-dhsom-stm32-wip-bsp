From f6176dba05634d44f44159e5f2a24d6365cc97e8 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Tue, 5 May 2026 10:45:46 +0200
Subject: [PATCH 646/913] plat-stm32mp1: conf: enable power management on
 stm32mp1

Add the power management support on STM32MP1 platform.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 6f65dd7baf9d55bce21fbaf6ba9073e80bb76cb0 plat-stm32mp1: conf: enable power management on stm32mp1]
Change-Id: I033ce22da62a2377b155bbfc04b8291fbddb2062
Signed-off-by: Lionel Debieve <lionel.debieve@foss.st.com>
Signed-off-by: Pascal Paillet <p.paillet@st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/358376
Reviewed-by: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index fc2583db8..505babcf3 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -195,6 +195,7 @@ $(call force,CFG_DRIVERS_REGULATOR,y)
 $(call force,CFG_DRIVERS_STM32_CLK,y)
 $(call force,CFG_GIC,y)
 $(call force,CFG_INIT_CNTVOFF,y)
+$(call force,CFG_PM_ARM32,y)
 $(call force,CFG_PSCI_ARM32,y)
 $(call force,CFG_REGULATOR_FIXED,y)
 $(call force,CFG_SCMI_MSG_PERF_DOMAIN,y)
@@ -216,6 +217,7 @@ $(call force,CFG_STM32_VREFBUF,y)
 $(call force,CFG_STM32MP_CLK_CORE,y)
 $(call force,CFG_STM32MP1_OPTEE_IN_SYSRAM,n)
 $(call force,CFG_STM32MP1_RSTCTRL,y)
+$(call force,CFG_STM32MP1_SCMI_SIP,n)
 $(call force,CFG_STM32MP13_CLK,y)
 $(call force,CFG_STM32MP13_REGULATOR_IOD,y)
 $(call force,CFG_TEE_CORE_NB_CORE,1)
@@ -228,6 +230,7 @@ endif # CFG_STM32MP13
 ifeq ($(CFG_STM32MP15),y)
 $(call force,CFG_BOOT_SECONDARY_REQUEST,y)
 $(call force,CFG_DRIVERS_CLK_FIXED,y)
+$(call force,CFG_DDR_LOWPOWER,y)
 $(call force,CFG_HALT_CORES_SGI,15)
 $(call force,CFG_SECONDARY_INIT_CNTFRQ,y)
 $(call force,CFG_STM32_IRQ_NOTIF,y)
@@ -430,6 +433,9 @@ CFG_STM32_TAMP_NVRAM ?= y
 # Default enable PKCS11 TA to have PKCS11 tests built in OP-TEE Test
 CFG_PKCS11_TA ?= y
 
+# Default use stm32mp1 PM mailbox context version 3
+CFG_STM32MP1_PM_CONTEXT_VERSION ?= 3
+
 ifneq ($(CFG_WITH_SOFTWARE_PRNG),y)
 CFG_HWRNG_PTA ?= y
 endif
-- 
