From e737fc572df71affe1b819f650fbb616c7f7012d Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Thu, 25 Apr 2024 10:01:25 +0200
Subject: [PATCH 437/913] core: pta: ask for enumeration

Add a .ask_for_enumeration operation for PTAs that know at boot time
whether they can operate (registered dependencies) or not.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git de4fe41126671d6b8efd8dfcca91bbd91bdad839 core: pta: ask for enumeration]
Change-Id: Ia2133952399ea9df0333eba51b3a7d82bf70a62d
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/377161
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570353
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/include/kernel/pseudo_ta.h | 1 +
 core/pta/device.c               | 7 ++++++-
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/core/include/kernel/pseudo_ta.h b/core/include/kernel/pseudo_ta.h
index 4eef0f47d..ce1cf9d6a 100644
--- a/core/include/kernel/pseudo_ta.h
+++ b/core/include/kernel/pseudo_ta.h
@@ -40,6 +40,7 @@ struct pseudo_ta_head {
 	TEE_Result (*invoke_command_entry_point)(void *pSessionContext,
 			uint32_t nCommandID, uint32_t nParamTypes,
 			TEE_Param pParams[TEE_NUM_PARAMS]);
+	bool (*ask_for_enumeration)(void);
 };
 
 #define pseudo_ta_register(...)	\
diff --git a/core/pta/device.c b/core/pta/device.c
index 21c13bd94..f1652c298 100644
--- a/core/pta/device.c
+++ b/core/pta/device.c
@@ -63,8 +63,13 @@ static TEE_Result get_devices(uint32_t types,
 	buf =  params[0].memref.buffer;
 	blen = params[0].memref.size;
 
-	SCATTERED_ARRAY_FOREACH(ta, pseudo_tas, struct pseudo_ta_head)
+	SCATTERED_ARRAY_FOREACH(ta, pseudo_tas, struct pseudo_ta_head) {
+		/* PTA may dynamically request not be enumerated */
+		if (ta->ask_for_enumeration && !ta->ask_for_enumeration())
+			continue;
+
 		add_ta(ta->flags, &ta->uuid, buf, blen, &pos, rflags);
+	}
 
 	if (stmm_get_uuid())
 		add_ta(TA_FLAG_DEVICE_ENUM_TEE_STORAGE_PRIVATE,
-- 
2.53.0

