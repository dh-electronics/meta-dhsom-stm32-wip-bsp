From 08416c7164be73b17e9a13ea4f1472e824cc0dae Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Thu, 21 May 2026 09:27:38 +0200
Subject: [PATCH 492/913] plat-stm32mp1: conf: add hse monitoring support on
 STM32MP1

Add the possibility to detect HSE over frequency detection on STM32MP1
devices.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 8622dfd4cbc48512b6e6eaa91c87c52740811c30 plat-stm32mp1: conf: add hse monitoring support on STM32MP1]
Signed-off-by: Lionel Debieve <lionel.debieve@foss.st.com>
Change-Id: I5934c610fed66615aca48bc884636733e8c6ad0f
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/286272
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/570777
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index 3afa05562..c5baeeefc 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -200,6 +200,7 @@ $(call force,CFG_REGULATOR_FIXED,y)
 $(call force,CFG_SCMI_MSG_PERF_DOMAIN,y)
 $(call force,CFG_SECURE_TIME_SOURCE_CNTPCT,y)
 $(call force,CFG_SM_PLATFORM_HANDLER,y)
+$(call force,CFG_STM32_HSE_MONITORING,y)
 $(call force,CFG_STM32_SHARED_IO,y)
 
 ifeq ($(CFG_STM32MP13),y)
@@ -355,6 +356,9 @@ ifeq ($(call cfg-one-enabled, CFG_STM32_CRYP \
 $(call force,CFG_STM32_CRYPTO_DRIVER,y)
 endif
 
+ifeq ($(CFG_STM32_HSE_MONITORING),y)
+$(call force,CFG_STM32_LPTIMER,y)
+endif
 
 ifeq ($(call cfg-one-enabled, CFG_STM32_LPTIMER CFG_STM32_TIM),y)
 $(call force,CFG_COUNTER_DRIVER,y)
