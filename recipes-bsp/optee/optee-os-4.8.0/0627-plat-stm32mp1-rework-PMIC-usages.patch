From 1a0f125cf9c231bd75c2c50aeff28cf0c4e8942a Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Tue, 5 May 2026 13:09:29 +0200
Subject: [PATCH 627/913] plat-stm32mp1: rework PMIC usages

Rework the way the PMICs are used by the platform.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git b3890234c321e36beaf34e04a0f33b32db959580 plat-stm32mp1: rework PMIC usages]
Change-Id: Ic833e67cc10ccc69c37fcc45d9e7e7b12a952321
Signed-off-by: Pascal Paillet <p.paillet@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/389285
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 .../arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c |  2 +-
 core/arch/arm/plat-stm32mp1/main.c               |  5 -----
 core/arch/arm/plat-stm32mp1/stm32_util.h         | 16 ++++++++++++++--
 3 files changed, 15 insertions(+), 8 deletions(-)

diff --git a/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c b/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c
index 7d960735c..0bca20d9f 100644
--- a/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c
+++ b/core/arch/arm/plat-stm32mp1/drivers/stm32mp1_stpmic1.c
@@ -84,7 +84,7 @@ static bool pmic_is_secure(void)
 	return pmic_status == DT_STATUS_OK_SEC;
 }
 
-bool stm32mp_with_pmic(void)
+bool stm32_stpmic1_is_present(void)
 {
 	return pmic_status != -1;
 }
diff --git a/core/arch/arm/plat-stm32mp1/main.c b/core/arch/arm/plat-stm32mp1/main.c
index 5fc47e002..a945685ca 100644
--- a/core/arch/arm/plat-stm32mp1/main.c
+++ b/core/arch/arm/plat-stm32mp1/main.c
@@ -434,11 +434,6 @@ void plat_bsec_get_static_cfg(struct stm32_bsec_static_cfg *cfg)
 	cfg->max_id = STM32MP1_OTP_MAX_ID;
 }
 
-bool __weak stm32mp_with_pmic(void)
-{
-	return false;
-}
-
 uint32_t may_spin_lock(unsigned int *lock)
 {
 	if (!lock || !cpu_mmu_enabled())
diff --git a/core/arch/arm/plat-stm32mp1/stm32_util.h b/core/arch/arm/plat-stm32mp1/stm32_util.h
index 769dd9f31..b8f103b97 100644
--- a/core/arch/arm/plat-stm32mp1/stm32_util.h
+++ b/core/arch/arm/plat-stm32mp1/stm32_util.h
@@ -8,6 +8,7 @@
 
 #include <assert.h>
 #include <drivers/clk.h>
+#include <drivers/stm32mp1_stpmic1.h>
 #include <drivers/stm32mp1_rcc_util.h>
 #include <kernel/panic.h>
 #include <stdbool.h>
@@ -43,8 +44,19 @@ TEE_Result stm32mp_syscfg_erase_sram3(void);
 /* Platform util for the GIC */
 vaddr_t get_gicd_base(void);
 
-/* Platform util for PMIC support */
-bool stm32mp_with_pmic(void);
+#ifdef CFG_STPMIC1
+bool stm32_stpmic1_is_present(void);
+#else
+static inline bool stm32_stpmic1_is_present(void)
+{
+	return false;
+}
+#endif
+
+static inline bool stm32mp_with_pmic(void)
+{
+	return stm32_stpmic1_is_present();
+}
 
 /* Power management service */
 #ifdef CFG_PSCI_ARM32
-- 
2.53.0

