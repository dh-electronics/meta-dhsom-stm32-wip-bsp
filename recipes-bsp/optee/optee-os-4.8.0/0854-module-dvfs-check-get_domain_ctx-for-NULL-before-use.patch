From 4b784ad9bb3371142b21a10367c36d92b8166de9 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Maxime=20M=C3=A9r=C3=A9?= <maxime.mere@foss.st.com>
Date: Thu, 23 Jul 2026 15:31:27 +0200
Subject: [PATCH 854/913] module: dvfs: check get_domain_ctx() for NULL before
 use
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

dvfs_start(), dvfs_element_init(), dvfs_process_bind_request() and
dvfs_bind_element() all dereferenced the result of get_domain_ctx()
without checking for NULL, unlike most other call sites in this file,
causing a NULL pointer dereference for an invalid domain_id.

Return FWK_E_PARAM in all four functions when ctx is NULL.

Coverity issue: CID 1199905: CERT-C Expression
Coverity issue: CID 1200162: CERT-C Expression
Coverity issue: CID 1200251: CERT-C Expression

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 512440fbf4096b672ae31bbbff62911c4b989abf module: dvfs: check get_domain_ctx() for NULL before use]
Assisted-by: GitHub-Copilot:Claude-Sonnet-5
Signed-off-by: Maxime Méré <maxime.mere@foss.st.com>
Change-Id: I55da039597024b794e0dcce779de07c5e02f26b4
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/SCP-firmware/+/592827
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Valentin CARON <valentin.caron@foss.st.com>
Domain-Review: Valentin CARON <valentin.caron@foss.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
Tested-by: Valentin CARON <valentin.caron@foss.st.com>
---
 .../SCP-firmware/module/dvfs/src/mod_dvfs.c       | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/core/lib/scmi-server/SCP-firmware/module/dvfs/src/mod_dvfs.c b/core/lib/scmi-server/SCP-firmware/module/dvfs/src/mod_dvfs.c
index d47fab8d6..5d03ae02b 100644
--- a/core/lib/scmi-server/SCP-firmware/module/dvfs/src/mod_dvfs.c
+++ b/core/lib/scmi-server/SCP-firmware/module/dvfs/src/mod_dvfs.c
@@ -1005,6 +1005,9 @@ static int dvfs_start(fwk_id_t id)
     status = dvfs_get_sustained_opp(id, &sustained_opp);
     if (status == FWK_SUCCESS) {
         ctx = get_domain_ctx(id);
+        if (ctx == NULL) {
+            return FWK_E_PARAM;
+        }
         ctx->request.set_source_id = true;
         status = dvfs_set_level_start(ctx, 0, &sustained_opp, true, 0);
     }
@@ -1033,6 +1036,10 @@ static int dvfs_element_init(
 {
     struct mod_dvfs_domain_ctx *ctx = get_domain_ctx(domain_id);
 
+    if (ctx == NULL) {
+        return FWK_E_PARAM;
+    }
+
     fwk_assert(sub_element_count == 0);
 
     ctx->domain_id = domain_id;
@@ -1053,6 +1060,10 @@ static int dvfs_bind_element(fwk_id_t domain_id, unsigned int round)
     int status;
     const struct mod_dvfs_domain_ctx *ctx = get_domain_ctx(domain_id);
 
+    if (ctx == NULL) {
+        return FWK_E_PARAM;
+    }
+
     /* Bind to the power supply module */
     status = fwk_module_bind(
         ctx->config->psu_id, mod_psu_api_id_device, &ctx->apis.psu);
@@ -1140,6 +1151,10 @@ static int dvfs_process_bind_request(
     case MOD_DVFS_API_IDX_CNTRL_DRV:
         *api = &dvfs_driver_api;
         domain_ctx = get_domain_ctx(target_id);
+        if (domain_ctx == NULL) {
+            return FWK_E_PARAM;
+        }
+
         domain_ctx->bound_id = source_id;
         status = FWK_SUCCESS;
         break;
-- 
