From e93ab9f55fb5adab597840f6a6d6817e67b98af5 Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Tue, 23 Jun 2026 11:59:24 +0200
Subject: [PATCH 756/913] dt-bindings: regulator: remove system_off_soc_mode in
 stm32mp1 pwr node

Remove support for the proprietary "system_off_soc_mode" property in
the PWR node.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 77b94e44f2ae8ce3d643cdbdb57b93ae5a631d9f dt-bindings: regulator: remove system_off_soc_mode in stm32mp1 pwr node]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I08043216404483f6dbc4338314a27412ceb11ca4
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/581306
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/include/dt-bindings/power/stm32mp1-power.h        |  3 +--
 .../bindings/regulator/st,stm32mp1-pwr-reg.yaml        | 10 +---------
 2 files changed, 2 insertions(+), 11 deletions(-)

diff --git a/core/include/dt-bindings/power/stm32mp1-power.h b/core/include/dt-bindings/power/stm32mp1-power.h
index ff85c14bf..424a3de2c 100644
--- a/core/include/dt-bindings/power/stm32mp1-power.h
+++ b/core/include/dt-bindings/power/stm32mp1-power.h
@@ -14,7 +14,6 @@
 #define STM32_PM_CSTANDBY_ALLOW_LPLV_STOP2	4
 #define STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_SR	5
 #define STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_OFF	6
-#define STM32_PM_SHUTDOWN			7
-#define STM32_PM_MAX_SOC_MODE			8
+#define STM32_PM_MAX_SOC_MODE			7
 
 #endif /* DT_BINDINGS_STM32MP1_POWER_H */
diff --git a/documentation/devicetree/bindings/regulator/st,stm32mp1-pwr-reg.yaml b/documentation/devicetree/bindings/regulator/st,stm32mp1-pwr-reg.yaml
index 226dc851f..cf4e00428 100644
--- a/documentation/devicetree/bindings/regulator/st,stm32mp1-pwr-reg.yaml
+++ b/documentation/devicetree/bindings/regulator/st,stm32mp1-pwr-reg.yaml
@@ -33,15 +33,8 @@ properties:
         STM32_PM_CSTOP_ALLOW_LPLV_STOP : cstop allowing lplv-stop
         STM32_PM_CSTANDBY_ALLOW_LPLV_STOP2 : cstandby allowing lp-stop2 for STM32MP13
         STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_SR : cstandby allowing standby with DDR in self-refresh
-    $ref: "/schemas/types.yaml#/definitions/uint32"
-
-  system_off_soc_mode:
-    description: |
-      Mode used for shutdown. The possible values are
-        STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_OFF: standby with DDR off
-        STM32_PM_SHUTDOWN: pmic swith off
     minItems: 1
-    maxItems: 8
+    maxItems: 6
     $ref: "/schemas/types.yaml#/definitions/uint32"
 
   vdd-supply:
@@ -97,7 +90,6 @@ examples:
         STM32_PM_CSTOP_ALLOW_LP_STOP
         STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_SR
       >;
-      system_off_soc_mode = <STM32_PM_CSTANDBY_ALLOW_STANDBY_DDR_OFF>;
       vdd-supply = <&vdd>;
       vdd_3v3_usbfs-supply = <&vdd_usb>;
     };
-- 
2.53.0

