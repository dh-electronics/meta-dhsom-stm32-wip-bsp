From 668e3a7e4d2e3ce0a583c3292599ba9dc8396e54 Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Mon, 25 Oct 2021 10:23:18 +0200
Subject: [PATCH 160/913] clk: stm32mp13: add round rate

Use round_rate ops (need for lcd IP)

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 6629003bd219964d8abdc85c3b996c8e4b66b388 clk: stm32mp13: add round rate]
Change-Id: Ib2983756f2e95425037c61b0a80bf4c5471ccaf2
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
---
 core/drivers/clk/clk-stm32mp13.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/core/drivers/clk/clk-stm32mp13.c b/core/drivers/clk/clk-stm32mp13.c
index 7c93dc45d..8b25f1ab1 100644
--- a/core/drivers/clk/clk-stm32mp13.c
+++ b/core/drivers/clk/clk-stm32mp13.c
@@ -1808,6 +1808,24 @@ clk_stm32_composite_get_duty_cycle(struct clk *clk,
 	return TEE_SUCCESS;
 }
 
+static unsigned long clk_stm32_composite_round_rate(struct clk *clk,
+						    unsigned long rate,
+						    unsigned long prate)
+{
+	struct clk_stm32_priv *priv = clk_stm32_get_priv();
+	struct clk_stm32_composite_cfg *cfg = clk->priv;
+	const struct div_cfg *divider = &priv->div[cfg->div_id];
+	unsigned int div = 0U;
+
+	if (cfg->div_id == NO_DIV)
+		return 0UL;
+
+	div = MIN(UDIV_ROUND_NEAREST((uint64_t)prate, rate),
+		  MASK_WIDTH_SHIFT(divider->width, 0) + 1);
+
+	return UDIV_ROUND_NEAREST((uint64_t)prate, div);
+}
+
 static const struct clk_ops clk_stm32_composite_duty_cycle_ops = {
 	.get_parent	= clk_stm32_composite_get_parent,
 	.set_parent	= clk_stm32_composite_set_parent,
@@ -1816,6 +1834,7 @@ static const struct clk_ops clk_stm32_composite_duty_cycle_ops = {
 	.enable		= clk_stm32_composite_gate_enable,
 	.disable	= clk_stm32_composite_gate_disable,
 	.is_enabled	= clk_stm32_composite_gate_is_enabled,
+	.round_rate	= clk_stm32_composite_round_rate,
 	.get_duty_cycle	= clk_stm32_composite_get_duty_cycle,
 };
 
