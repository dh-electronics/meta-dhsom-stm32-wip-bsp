From b38537eae5ee1aacae5c4569e67553235df3aedb Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Thu, 2 Jul 2026 19:08:04 +0200
Subject: [PATCH 783/913] dt-bindings: regulator: add OP-TEE non secure
 compatible for stm32mp15-i2c

Add support of compatible "st,stm32mp15-i2c-non-secure" which allows
I2C to be probed as non-secure by OP-TEE.

NOT_UPSTREAMABLE

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 16c5a635d10e08e99bf5d0b5b0035cb76f42ef39 dt-bindings: regulator: add OP-TEE non secure compatible for stm32mp15-i2c]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: Id2916b961a094646b19c33dd871ec39cb6bc5278
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/584306
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
---
 documentation/devicetree/bindings/i2c/st,stm32-i2c.yaml | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/documentation/devicetree/bindings/i2c/st,stm32-i2c.yaml b/documentation/devicetree/bindings/i2c/st,stm32-i2c.yaml
index 457bb0702..65ed8fa69 100644
--- a/documentation/devicetree/bindings/i2c/st,stm32-i2c.yaml
+++ b/documentation/devicetree/bindings/i2c/st,stm32-i2c.yaml
@@ -19,6 +19,8 @@ allOf:
               - st,stm32f7-i2c
               - st,stm32mp13-i2c
               - st,stm32mp15-i2c
+              # This compatible allows I2C to be probed as non-secure by OP-TEE
+              - st,stm32mp15-i2c-non-secure
               - st,stm32mp25-i2c
     then:
       properties:
@@ -73,6 +75,8 @@ properties:
       - st,stm32f7-i2c
       - st,stm32mp13-i2c
       - st,stm32mp15-i2c
+      # This compatible allows I2C to be probed as non-secure by OP-TEE
+      - st,stm32mp15-i2c-non-secure
       - st,stm32mp25-i2c
 
   reg:
