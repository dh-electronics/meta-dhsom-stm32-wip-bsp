From b9005e07a05b1f48f53137e726e8f5b1a3fb661a Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Thu, 16 Jul 2026 15:43:46 +0200
Subject: [PATCH 853/913] drivers: stm32_uart: fix baud-rate computation

This algorithm does not work when it should use oversampling = 8.

mantissa = SHIFT_U32(uartdiv / oversampling, UART_REG_BRR_M_SHIFT);
=>  Bitshit uartdiv value of 1 left.

fraction = uartdiv % oversampling;
=> Does not bitshit uartdiv of 1 right as explained in the reference manual

Fix that by using one mask and simple condition.

Fix also the impossible condition:
if (i == ARRAY_SIZE(presc))
As "i" goes from 0 to ARRAY_SIZE - 1.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 9772dc568cee2f29d88b1d84aa54e1438160251c drivers: stm32_uart: fix baud-rate computation]
Fixes: 5bffd336d0 ("drivers: stm32_uart: configure UART baudrate register")
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: I0b495d84084ea7279c2754a50c670786915707af
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/588852
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Amelie DELAUNAY <amelie.delaunay@foss.st.com>
---
 core/drivers/stm32_uart.c | 20 ++++++++------------
 1 file changed, 8 insertions(+), 12 deletions(-)

diff --git a/core/drivers/stm32_uart.c b/core/drivers/stm32_uart.c
index 8cc6957f8..05d824bf0 100644
--- a/core/drivers/stm32_uart.c
+++ b/core/drivers/stm32_uart.c
@@ -63,7 +63,7 @@
 #define UART_REG_CR1_FIFOEN		BIT(29)
 
 #define UART_MAX_PRESC			256
-#define UART_REG_BRR_M_SHIFT		4
+#define UART_REG_BRR_OVER8_MASK		GENMASK_32(3, 0)
 #define UART_REG_BRR_MASK		GENMASK_32(15, 0)
 
 static bool loc_chip_clk_is_enabled(struct serial_chip *chip)
@@ -154,11 +154,8 @@ static TEE_Result stm32_uart_update_baudrate(struct stm32_uart_pdata *pd,
 	uint64_t clk_rate = 0;
 	uint32_t brr = 0;
 	uint32_t baudrate = 0;
-	uint32_t mantissa = 0;
 	uint32_t uartdiv = 0;
-	uint32_t fraction = 0;
 	unsigned int i = 0;
-	int oversampling = 0;
 	uint32_t over8 = 0;
 	vaddr_t uart_base = io_pa_or_va(&pd->base, 1);
 	uint32_t presc[] = { 1, 2, 6, 8, 10, 12, 16, 32, 64, 128, 256 };
@@ -171,20 +168,19 @@ static TEE_Result stm32_uart_update_baudrate(struct stm32_uart_pdata *pd,
 
 	for (i = 0; i < ARRAY_SIZE(presc); i++) {
 		uartdiv = UDIV_ROUND_NEAREST(clk_rate, baudrate * presc[i]);
+
 		if (uartdiv < 16) {
-			oversampling = 8;
-			uartdiv = uartdiv * 2;
+			uartdiv *= 2;
 			over8 = UART_REG_CR1_OVER8;
+			brr = (uartdiv & ~UART_REG_BRR_OVER8_MASK) |
+			      ((uartdiv & UART_REG_BRR_OVER8_MASK) >> 1);
 		} else {
-			oversampling = 16;
+			brr = uartdiv;
 		}
-		mantissa = SHIFT_U32(uartdiv / oversampling,
-				     UART_REG_BRR_M_SHIFT);
-		fraction = uartdiv % oversampling;
-		brr = mantissa | fraction;
+
 		if (brr <= UART_REG_BRR_MASK)
 			break;
-		if (i == ARRAY_SIZE(presc))
+		if (i == ARRAY_SIZE(presc) - 1)
 			return TEE_ERROR_GENERIC;
 	}
 	io_write32(uart_base + UART_REG_BRR, brr);
-- 
