From 9c51314e477c3cc7702652c5cca3738de2c54d65 Mon Sep 17 00:00:00 2001
From: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Date: Mon, 13 Apr 2026 17:33:45 +0200
Subject: [PATCH 308/913] dts: st: define pka node in stm32mp25xc.dtsi

Add node pka in stm32mp25xc.dtsi.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 584b5b4fbf21d33459369a19433ae52ea886c54f dts: st: define pka node in stm32mp25xc.dtsi]
Change-Id: Ia8cb20a06c333bea94f299798a69f2e61cb900e2
Signed-off-by: Thomas Bourgoin <thomas.bourgoin@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/557105
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/dts/stm32mp25xc.dtsi | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp25xc.dtsi b/core/arch/arm/dts/stm32mp25xc.dtsi
index b8739d557..babd21b89 100644
--- a/core/arch/arm/dts/stm32mp25xc.dtsi
+++ b/core/arch/arm/dts/stm32mp25xc.dtsi
@@ -35,4 +35,15 @@
 		access-controllers = <&rifsc STM32MP25_RIFSC_SAES_ID>;
 		status = "disabled";
 	};
+
+	pka: pka@42060000 {
+		compatible = "st,stm32mp13-pka64";
+		reg = <0x42060000 0x2000>;
+		interrupts = <GIC_SPI 146 IRQ_TYPE_LEVEL_HIGH>;
+		clocks = <&rcc CK_BUS_PKA>, <&rcc CK_BUS_RNG>;
+		clock-names = "bus", "rng";
+		resets = <&rcc PKA_R>;
+		access-controllers = <&rifsc STM32MP25_RIFSC_PKA_ID>;
+		status = "disabled";
+	};
 };
-- 
