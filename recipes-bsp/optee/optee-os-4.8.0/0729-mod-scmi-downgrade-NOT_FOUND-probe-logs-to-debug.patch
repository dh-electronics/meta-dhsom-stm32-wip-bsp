From 14fb07c509593e6536c53f7d246424ae18f67aba Mon Sep 17 00:00:00 2001
From: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Date: Wed, 27 May 2026 09:06:45 +0200
Subject: [PATCH 729/913] mod/scmi: downgrade NOT_FOUND probe logs to debug

Treat PROTOCOL_MESSAGE_ATTRIBUTES returning SCMI_NOT_FOUND as a normal
optional-command probe result and avoid logging it as an error.

AI-assisted correction by GitHub Copilot (GPT-5.3-Codex).

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git cd30bdec52b26695f61ee30bff3def367ba4c5c3 mod/scmi: downgrade NOT_FOUND probe logs to debug]
Change-Id: I015ba498e2604ef4a99f9d1aabfedd91c7581485
Signed-off-by: Gabriel Fernandez <gabriel.fernandez@foss.st.com>
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/SCP-firmware/+/571749
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 .../SCP-firmware/module/scmi/src/mod_scmi.c   | 39 ++++++++++++++-----
 1 file changed, 29 insertions(+), 10 deletions(-)

diff --git a/core/lib/scmi-server/SCP-firmware/module/scmi/src/mod_scmi.c b/core/lib/scmi-server/SCP-firmware/module/scmi/src/mod_scmi.c
index 10111ef68..129f3f8d6 100644
--- a/core/lib/scmi-server/SCP-firmware/module/scmi/src/mod_scmi.c
+++ b/core/lib/scmi-server/SCP-firmware/module/scmi/src/mod_scmi.c
@@ -348,21 +348,40 @@ static int respond(fwk_id_t service_id, const void *payload, size_t size)
      * holds an SCMI status code. This is the case for all the SCMI commands
      * specified so far, but it is not explicitly stated (yet) in the
      * specification it should be like that for all commands.
+     *
+     * PROTOCOL_MESSAGE_ATTRIBUTES returning SCMI_NOT_FOUND is spec-compliant
+     * behaviour when an optional command is not supported: log at DEBUG level
+     * only to avoid misleading error output during feature probing.
      */
     if ((payload != NULL) && (*((int32_t *)payload) < SCMI_SUCCESS)) {
+        if ((ctx->scmi_message_id == MOD_SCMI_PROTOCOL_MESSAGE_ATTRIBUTES) &&
+            (*((int32_t *)payload) == (int32_t)SCMI_NOT_FOUND)) {
+#if FWK_LOG_LEVEL <= FWK_LOG_LEVEL_DEBUG
+            FWK_LOG_DEBUG(
+                "[SCMI] %s: %s [%" PRIu16
+                " (0x%x:0x%x)] unsupported optional cmd (%d)",
+                service_name,
+                message_type_name,
+                ctx->scmi_token,
+                ctx->scmi_protocol_id,
+                ctx->scmi_message_id,
+                *((int *)payload));
+#endif
+        } else {
 #if FWK_LOG_LEVEL <= FWK_LOG_LEVEL_ERROR
-        FWK_LOG_ERR(
-            "[SCMI] %s: %s [%" PRIu16 " (0x%x:0x%x)] returned error (%d)",
-            service_name,
-            message_type_name,
-            ctx->scmi_token,
-            ctx->scmi_protocol_id,
-            ctx->scmi_message_id,
-            *((int *)payload));
+            FWK_LOG_ERR(
+                "[SCMI] %s: %s [%" PRIu16 " (0x%x:0x%x)] returned error (%d)",
+                service_name,
+                message_type_name,
+                ctx->scmi_token,
+                ctx->scmi_protocol_id,
+                ctx->scmi_message_id,
+                *((int *)payload));
 #else
-        (void)service_name;
-        (void)message_type_name;
+            (void)service_name;
+            (void)message_type_name;
 #endif
+        }
     } else {
 #if FWK_LOG_LEVEL <= FWK_LOG_LEVEL_DEBUG
         FWK_LOG_DEBUG(
-- 
