From 0214ba00dff19e348aafafa0711923a89036ab0f Mon Sep 17 00:00:00 2001
From: Patrick Delaunay <patrick.delaunay@foss.st.com>
Date: Wed, 24 Jun 2026 14:31:46 +0200
Subject: [PATCH 779/913] Add missing st,regulator-sink-source for DDR
 regulators LDO3

Add the "st,regulator-sink-source" indication in device tree for
VTT_DDR = LDO3 of DDR4 powered by STPMIC25 as it was done for STPMIC1
and as it is already done in TF-A.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git daf3f381aff7f312177b293947e056ae348e6db5 Add missing st,regulator-sink-source for DDR regulators LDO3]
Signed-off-by: Patrick Delaunay <patrick.delaunay@foss.st.com>
Change-Id: I6216e1efa37f0f9228ddef49101adc52c53869da
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/581728
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp257f-ev1.dts | 1 +
 1 file changed, 1 insertion(+)

diff --git a/core/arch/arm/dts/stm32mp257f-ev1.dts b/core/arch/arm/dts/stm32mp257f-ev1.dts
index 196ea7e92..6f609d509 100644
--- a/core/arch/arm/dts/stm32mp257f-ev1.dts
+++ b/core/arch/arm/dts/stm32mp257f-ev1.dts
@@ -273,6 +273,7 @@
 			vtt_ddr: ldo3 {
 				regulator-name = "vtt_ddr";
 				regulator-always-on;
+				st,regulator-sink-source;
 				st,pwrctrl-sel = <1>;
 				st,pwrctrl-enable;
 
-- 
