From 9da255dee521787186575d3c3f70a4b8e7a186db Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Fri, 24 Nov 2023 08:57:36 +0100
Subject: [PATCH 604/913] dts: stm32mp15: disable non-secure IWDG2 on ST boards

Disable non-secure IWDG2 watchdog device in ST boards
stm32mp157c-ed1 and stm32mp157c-ev1. This watchdog is fully under
control of the non-secure world and OP-TEE is not expected to
interfere with it.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 05b2968475a63423f4d9a2c064fba6bf82f88fa6 dts: stm32mp15: disable non-secure IWDG2 on ST boards]
Change-Id: I366abf67b686a0b182a649c4efc7af46dfc49b61
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
[etienne: cherry-picked from c825ffc94e2e878c70f0339a7bdf88bd39644f75]
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/573254
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Tested-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp157c-ed1.dts | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp157c-ed1.dts b/core/arch/arm/dts/stm32mp157c-ed1.dts
index e2df2155b..0b59c2584 100644
--- a/core/arch/arm/dts/stm32mp157c-ed1.dts
+++ b/core/arch/arm/dts/stm32mp157c-ed1.dts
@@ -346,8 +346,7 @@
 
 &iwdg2 {
 	timeout-sec = <32>;
-	status = "okay";
-	secure-status = "disabled";
+	status = "disabled";
 };
 
 &m4_rproc {
