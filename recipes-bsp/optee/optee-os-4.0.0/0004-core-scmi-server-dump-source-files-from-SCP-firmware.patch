+static int pd_report_power_state_transition(fwk_id_t pd_id, unsigned int state)
+{
+    const struct pd_ctx *pd =
+                        &mod_pd_ctx.pd_ctx_table[fwk_id_get_element_idx(pd_id)];
+
+    return report_power_state_transition(pd, state);
+}
