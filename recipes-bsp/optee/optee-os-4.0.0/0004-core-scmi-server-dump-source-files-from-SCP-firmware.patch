+static const fwk_id_t mod_scmi_notification_id_initialized =
+    FWK_ID_NOTIFICATION_INIT(
+        FWK_MODULE_IDX_SCMI,
+        MOD_SCMI_NOTIFICATION_IDX_INITIALIZED);
+
+/*!
+ * \}
+ */
+
+/*!
+ * \}
+ */
