+static const unsigned int
+    base_payload_size_table[MOD_SCMI_BASE_COMMAND_COUNT] = {
+        [MOD_SCMI_PROTOCOL_VERSION] = 0,
+        [MOD_SCMI_PROTOCOL_ATTRIBUTES] = 0,
+        [MOD_SCMI_PROTOCOL_MESSAGE_ATTRIBUTES] =
