+ *
+ * \retval ::FWK_SUCCESS The agent count was returned.
+ * \retval ::FWK_E_PARAM The parameter `agent_count` is equal to `NULL`.
+ */
+int mod_scmi_from_protocol_get_agent_count(unsigned int *agent_count);
+
+/*!
