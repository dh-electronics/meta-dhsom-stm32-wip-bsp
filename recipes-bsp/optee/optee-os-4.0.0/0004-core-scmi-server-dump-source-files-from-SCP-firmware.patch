+/* Functions specific to the driver input API */
+
+static int pd_reset(fwk_id_t pd_id, bool response_requested)
+{
+    struct fwk_event_light req;
+    struct pd_ctx *pd;
+
+    pd = &mod_pd_ctx.pd_ctx_table[fwk_id_get_element_idx(pd_id)];
