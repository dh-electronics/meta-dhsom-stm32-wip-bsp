+    fwk_id_get_element_idx_ExpectAndReturn(dep_dom_id, DVFS_ELEMENT_IDX_1);
+    fwk_id_get_sub_element_idx_ExpectAndReturn(dep_dom_id, 1);
+    fwk_id_get_element_idx_ExpectAndReturn(dep_dom_id, DVFS_ELEMENT_IDX_1);
+
+    fwk_id_get_element_idx_ExpectAndReturn(dep_dom_id, DVFS_ELEMENT_IDX_1);
