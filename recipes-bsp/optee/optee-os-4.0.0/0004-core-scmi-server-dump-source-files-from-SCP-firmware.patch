+    OPTEE_CLOCK_ELT(CLK_IDX_SCMI_AXI),
+    OPTEE_CLOCK_ELT(CLK_IDX_SCMI_BSEC),
+    OPTEE_CLOCK_ELT(CLK_IDX_SCMI_CRYP1),
