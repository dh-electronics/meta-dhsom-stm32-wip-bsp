+FWK_WEAK int _platform_init(void *params)
+{
+    return FWK_SUCCESS;
+}
+
+/*
+ * Error handler for failures that occur during early initialization.
+ */
+void panic(void)
+{
+    while (true)
+        wfi();
+}
