+ * voltage domain name.
+ */
+enum stpmic1_regu {
+    STPMIC1_REGU_BUCK1,
+    STPMIC1_REGU_BUCK2,
+    STPMIC1_REGU_BUCK3,
+    STPMIC1_REGU_BUCK4,
+    STPMIC1_REGU_LDO1,
+    STPMIC1_REGU_LDO2,
+    STPMIC1_REGU_LDO3,
