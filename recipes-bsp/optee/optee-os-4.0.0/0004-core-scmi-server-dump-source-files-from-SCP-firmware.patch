+int mod_scmi_from_protocol_get_agent_id(
+    fwk_id_t service_id,
+    unsigned int *agent_id);
+
+/*!
+ * \brief Get the type of the agent given its identifier.
+ *
+ * \details This API can be used by SCMI protocols to check the validity
