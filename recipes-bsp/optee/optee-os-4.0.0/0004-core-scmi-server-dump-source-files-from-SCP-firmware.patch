+#define LOG_LEVEL_NONE U(0)
+#define LOG_LEVEL_ERROR U(10)
+#define LOG_LEVEL_NOTICE U(20)
+#define LOG_LEVEL_WARNING U(30)
+#define LOG_LEVEL_INFO U(40)
+#define LOG_LEVEL_VERBOSE U(50)
+
+#endif /* DEBUG_H */
diff --git a/core/lib/scmi-server/SCP-firmware/arch/arm/armv8-a/include/lib/mmio.h b/core/lib/scmi-server/SCP-firmware/arch/arm/armv8-a/include/lib/mmio.h
