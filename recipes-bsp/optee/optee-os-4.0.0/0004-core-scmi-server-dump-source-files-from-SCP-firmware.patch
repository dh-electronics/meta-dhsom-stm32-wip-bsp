+
+#define I2C_ISR_MASK          0x02FF
+#define I2C_ISR_SHIFT         0
+#define I2C_ISR_ARBLOST_MASK  0x0200
+#define I2C_ISR_ARBLOST_SHIFT 9
+#define I2C_ISR_RXUNF_MASK    0x0080
