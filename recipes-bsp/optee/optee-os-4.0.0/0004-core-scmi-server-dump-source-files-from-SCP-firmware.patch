+    MOD_SENSOR_TRIP_POINT_MODE_POSITIVE,
+    MOD_SENSOR_TRIP_POINT_MODE_NEGATIVE,
+    MOD_SENSOR_TRIP_POINT_MODE_TRANSITION
+};
+
