+    perf_plugins_ctx.dep_id_table[SCMI_PERF_ELEMENT_IDX_1] =
+        FWK_ID_SUB_ELEMENT(FWK_MODULE_IDX_DVFS, DVFS_ELEMENT_IDX_1, 0);
