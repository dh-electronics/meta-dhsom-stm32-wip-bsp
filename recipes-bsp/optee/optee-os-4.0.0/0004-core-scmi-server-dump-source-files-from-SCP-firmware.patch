diff --git a/core/lib/scmi-server/SCP-firmware/module/scmi_sensor_req/src/mod_scmi_sensor_req.c b/core/lib/scmi-server/SCP-firmware/module/scmi_sensor_req/src/mod_scmi_sensor_req.c
