+    const uint32_t *payload);
+static int scmi_base_protocol_message_attributes_handler(
+    fwk_id_t service_id,
+    const uint32_t *payload);
+static int scmi_base_discover_vendor_handler(
+    fwk_id_t service_id,
+    const uint32_t *payload);
+static int scmi_base_discover_sub_vendor_handler(
+    fwk_id_t service_id,
