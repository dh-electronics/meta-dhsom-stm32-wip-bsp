+
+#ifndef MOD_CDNS_I2C_H
+#define MOD_CDNS_I2C_H
+
+#include <internal/cdns_i2c.h>
+
+#include <fwk_id.h>
+#include <fwk_macros.h>
+#include <fwk_module_idx.h>
+
+#include <stdbool.h>
