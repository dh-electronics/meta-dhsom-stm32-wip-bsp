+    this_dom.level[0] = 5;
+    this_dom.max_limit[0] = 9;
+    this_dom.min_limit[0] = 1;
+
+    phy_dom.level[0] = 5;
+    phy_dom.max_limit[0] = 10;
+    phy_dom.min_limit[0] = 1;
+
+    domain_aggregate(&this_dom, &phy_dom);
