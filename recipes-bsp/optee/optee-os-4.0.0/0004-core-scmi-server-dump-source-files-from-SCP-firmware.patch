+    fwk_optional_id_is_defined_ExpectAndReturn(domains[0].phy_group_id, false);
+    fwk_optional_id_is_defined_ExpectAndReturn(domains[0].phy_group_id, false);
+    fwk_optional_id_is_defined_ExpectAndReturn(domains[0].phy_group_id, false);
