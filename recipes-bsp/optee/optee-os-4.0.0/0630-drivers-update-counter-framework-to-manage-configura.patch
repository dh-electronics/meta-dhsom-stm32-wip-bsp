+#ifdef CFG_EMBED_DTB
+static uint32_t get_param(const void *params, unsigned int step)
+{
+	const fdt32_t *param_dt = (fdt32_t *)params;
+
+	assert(param_dt);
+
+	return fdt32_to_cpu(*(param_dt + step));
+}
+#else
+static uint32_t get_param(const void *params, unsigned int step)
+{
+	const uint32_t *tim_param = (uint32_t *)params;
+
+	assert(tim_param);
+
+	return tim_params[step];
+}
+#endif
