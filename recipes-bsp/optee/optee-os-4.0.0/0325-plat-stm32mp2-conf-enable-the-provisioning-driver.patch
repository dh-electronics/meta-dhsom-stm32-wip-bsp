From 0024a8707cecd52faa6980c4a4c78f25d9a71055 Mon Sep 17 00:00:00 2001
From: Lionel Debieve <lionel.debieve@foss.st.com>
Date: Thu, 22 Sep 2022 18:41:40 +0200
Subject: [PATCH 0325/1695] plat-stm32mp2: conf: enable the provisioning driver

Enable the provisioning driver on stm32mp2.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git ba4a2bb9636f01e87cc84a05b280ce5e0ebd4f53 plat-stm32mp2: conf: enable the provisioning driver]
Signed-off-by: Lionel Debieve <lionel.debieve@foss.st.com>
Change-Id: Ifb198d72ff19712db16f4b77598263a8e6b82f8d
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/267533
---
 core/arch/arm/plat-stm32mp2/conf.mk | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index 68d29cbe2..00e73404e 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -110,6 +110,13 @@ $(call force,CFG_STM32_BSEC_PTA,y,Mandated by CFG_TA_STM32MP_NVMEM)
 CFG_IN_TREE_EARLY_TAS += stm32mp_nvmem/1a8342cc-81a5-4512-99fe-9e2b3e37d626
 endif
 
+# Provisioning support for BSEC shadow OTP is dedicated to insecure development
+# configuration only.
+CFG_STM32MP_PROVISIONING ?= y
+ifeq ($(CFG_STM32MP_PROVISIONING),y)
+$(call force,CFG_WARN_INSECURE,y,Required by CFG_STM32MP_PROVISIONING)
+endif
+
 # Optional behavior upon receiving illegal access events
 CFG_STM32_PANIC_ON_IAC_EVENT ?= y
 ifeq ($(CFG_TEE_CORE_DEBUG),y)
-- 
2.47.2

