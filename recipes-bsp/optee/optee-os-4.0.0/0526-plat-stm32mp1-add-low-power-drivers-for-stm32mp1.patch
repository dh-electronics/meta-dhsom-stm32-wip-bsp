+#include <arm.h>
 #include <arm32_macros.S>
 #include <asm.S>
 
@@ -21,7 +21,33 @@ FUNC plat_cpu_reset_early , :
 	mov_imm	r1, STM32MP1_NSACR_PRESERVE_MASK
