From a4380623995b55c3f3bee0e466e15ac27768c621 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Wed, 12 Oct 2022 19:40:04 +0200
Subject: [PATCH 0213/1695] dts: stm32: add stm32mp25 UART console pins

Add pins for USART2 to support console.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 6c191296edf6cae3b5745663cce39b1808c4e34f dts: stm32: add stm32mp25 UART console pins]
Change-Id: I476051e3dba767d5105257649f0bca5b331b3e15
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
---
 core/arch/arm/dts/stm32mp25-pinctrl.dtsi | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp25-pinctrl.dtsi b/core/arch/arm/dts/stm32mp25-pinctrl.dtsi
index 5bd27767f..0d417080b 100644
--- a/core/arch/arm/dts/stm32mp25-pinctrl.dtsi
+++ b/core/arch/arm/dts/stm32mp25-pinctrl.dtsi
@@ -5,3 +5,17 @@
  */
 #include <dt-bindings/pinctrl/stm32-pinfunc.h>
 
+&pinctrl {
+	usart2_pins_a: usart2-0 {
+		pins1 {
+			pinmux = <STM32_PINMUX('A', 4, AF6)>; /* USART2_TX */
+			bias-disable;
+			drive-push-pull;
+			slew-rate = <0>;
+		};
+		pins2 {
+			pinmux = <STM32_PINMUX('A', 8, AF8)>; /* USART2_RX */
+			bias-disable;
+		};
+	};
+};
-- 
