 core/arch/arm/dts/stm32mp211.dtsi | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp211.dtsi b/core/arch/arm/dts/stm32mp211.dtsi
index bf354fc06..dc8c246d1 100644
--- a/core/arch/arm/dts/stm32mp211.dtsi
+++ b/core/arch/arm/dts/stm32mp211.dtsi
@@ -631,6 +631,11 @@
 			#address-cells = <1>;
 			#size-cells = <1>;
 
+			uid_otp@14 {
+				/* 0x14 -> otp5 */
+				reg = <0x14 0xc>;
+			};
+
 			part_number_otp@24 {
 				reg = <0x24 0x4>;
 			};
