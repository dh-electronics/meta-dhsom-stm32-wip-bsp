---
 core/arch/arm/dts/stm32mp231.dtsi | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp231.dtsi b/core/arch/arm/dts/stm32mp231.dtsi
index 0d521d3be..78dee4da3 100644
--- a/core/arch/arm/dts/stm32mp231.dtsi
+++ b/core/arch/arm/dts/stm32mp231.dtsi
@@ -2780,6 +2780,12 @@
 				st,non-secure-otp-provisioning;
 			};
 
+			oem_rproc_enc_key: oem_rproc_enc_key@540 {
+				/* 0x540 -> otp336 */
+				reg = <0x540 0x20>;
+				st,non-secure-otp-provisioning;
+			};
+
 			oem_enc_key_2: otp360@5a0 {
 				reg = <0x5a0 0x10>;
 				st,non-secure-otp-provisioning;
