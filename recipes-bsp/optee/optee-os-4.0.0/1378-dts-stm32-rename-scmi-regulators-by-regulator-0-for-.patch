From 15351d58008121a44e264a5d57a810e9f6766f6d Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Mon, 18 Nov 2024 15:05:45 +0100
Subject: [PATCH 1378/1695] dts: stm32: rename scmi regulators by regulator@0
 for stm32mp21x boards

Use a scmi regulator node name coherent with scmi binding:
protocol@17{
	regulators {
		regulator@0 {
		};
		[...]
	};
};

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 1b99c199c93075a8a8b7b40fff92bfdda8c1cf29 dts: stm32: rename scmi regulators by regulator@0 for stm32mp21x boards]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: I3ba6c0aedae89585b38589ba4b2c76b2b4555672
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/419311
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/dts/stm32mp215f-dk.dts | 46 ++++++++++++++++------------
 1 file changed, 26 insertions(+), 20 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp215f-dk.dts b/core/arch/arm/dts/stm32mp215f-dk.dts
index b472290cd..29f5936e9 100644
--- a/core/arch/arm/dts/stm32mp215f-dk.dts
+++ b/core/arch/arm/dts/stm32mp215f-dk.dts
@@ -337,26 +337,32 @@
 	status = "okay";
 };
 
-&scmi_regu {
-	scmi_vddcore: voltd-vddcore {
-		reg = <VOLTD_SCMI_STPMIC_BUCK1>;
-		voltd-supply = <&vddcore>;
-	};
-	scmi_vdd3v3_usb: voltd-vdd3v3-usb {
-		reg = <VOLTD_SCMI_STPMIC_LDO4>;
-		voltd-supply = <&vdd3v3_usb>;
-	};
-	scmi_vdd_flash: voltd-vdd-flash {
-		reg = <VOLTD_SCMI_STPMIC_LDO5>;
-		voltd-supply = <&vdd_flash>;
-	};
-	scmi_vdda_1v8: voltd-vdda-1v8 {
-		reg = <VOLTD_SCMI_STPMIC_LDO6>;
-		voltd-supply = <&vdda_1v8>;
-	};
-	scmi_v3v3: voltd-v3v3 {
-		reg = <VOLTD_SCMI_STPMIC_GPO1>;
-		voltd-supply = <&v3v3>;
+&scmi_regulator {
+	regulators {
+		regulator@5 {
+			reg = <VOLTD_SCMI_STPMIC_BUCK1>;
+			voltd-supply = <&vddcore>;
+		};
+
+		regulator@f {
+			reg = <VOLTD_SCMI_STPMIC_LDO4>;
+			voltd-supply = <&vdd3v3_usb>;
+		};
+
+		regulator@10 {
+			reg = <VOLTD_SCMI_STPMIC_LDO5>;
+			voltd-supply = <&vdd_flash>;
+		};
+
+		regulator@11 {
+			reg = <VOLTD_SCMI_STPMIC_LDO6>;
+			voltd-supply = <&vdda_1v8>;
+		};
+
+		regulator@15 {
+			reg = <VOLTD_SCMI_STPMIC_GPO1>;
+			voltd-supply = <&v3v3>;
+		};
 	};
 };
 
-- 
2.47.2

