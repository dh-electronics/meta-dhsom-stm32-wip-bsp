---
 core/arch/arm/plat-stm32mp1/main.c       | 35 ++++++++++++++++++++++++
 core/arch/arm/plat-stm32mp1/stm32_util.h |  3 ++
 2 files changed, 38 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/main.c b/core/arch/arm/plat-stm32mp1/main.c
index 05394f844..a4de4bd4a 100644
--- a/core/arch/arm/plat-stm32mp1/main.c
+++ b/core/arch/arm/plat-stm32mp1/main.c
@@ -17,6 +17,7 @@
 #include <drivers/stm32mp_dt_bindings.h>
 #include <io.h>
 #include <kernel/boot.h>
+#include <kernel/delay.h>
 #include <kernel/dt.h>
 #include <kernel/misc.h>
 #include <kernel/panic.h>
@@ -618,3 +619,37 @@ bool stm32mp_supports_second_core(void)
 		return true;
 	}
 }
+
+#define ARM_CNTXCTL_IMASK	BIT(1)
+
+static void stm32mp_mask_timer(void)
+{
+	/* Mask timer interrupts */
+	write_cntp_ctl(read_cntp_ctl() | ARM_CNTXCTL_IMASK);
+	write_cntv_ctl(read_cntv_ctl() | ARM_CNTXCTL_IMASK);
+}
+
+void __noreturn do_reset(const char *str __maybe_unused)
+{
+	stm32mp_mask_timer();
+
+	if (stm32mp_supports_second_core()) {
+		uint32_t target_mask = 0;
+
+		if (get_core_pos() == 0)
+			target_mask = TARGET_CPU1_GIC_MASK;
+		else
+			target_mask = TARGET_CPU0_GIC_MASK;
+
+		interrupt_raise_sgi(interrupt_get_main_chip(),
+				    CFG_HALT_CORES_ON_PANIC_SGI,
+				    target_mask);
+		/* wait than other core is halted */
+		mdelay(1);
+	}
+	IMSG("Forced system reset %s", str);
+	console_flush();
+	stm32_reset_system();
+	udelay(100);
+	panic();
+}
diff --git a/core/arch/arm/plat-stm32mp1/stm32_util.h b/core/arch/arm/plat-stm32mp1/stm32_util.h
index 4488fcec3..b39c4f277 100644
--- a/core/arch/arm/plat-stm32mp1/stm32_util.h
+++ b/core/arch/arm/plat-stm32mp1/stm32_util.h
@@ -315,4 +315,7 @@ static inline void stm32mp_register_gpioz_pin_count(size_t count __unused)
 {
 }
 #endif /* CFG_STM32MP1_SHARED_RESOURCES */
+
+void __noreturn do_reset(const char *str);
+
 #endif /*__STM32_UTIL_H__*/
