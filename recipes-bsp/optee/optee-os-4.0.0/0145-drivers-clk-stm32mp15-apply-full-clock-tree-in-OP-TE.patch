-	if (fdt_getprop(fdt, node, "st,clksrc", &len)) {
-		DMSG("Ignore source clocks configuration from DT");
-		ignored++;
-	}
-	if (fdt_getprop(fdt, node, "st,clkdiv", &len)) {
-		DMSG("Ignore clock divisors configuration from DT");
-		ignored++;
