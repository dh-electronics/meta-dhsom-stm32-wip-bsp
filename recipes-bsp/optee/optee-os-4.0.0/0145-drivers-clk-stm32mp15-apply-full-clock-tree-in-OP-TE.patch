-	for (i = (enum stm32mp1_pll_id)0; i < _PLL_NB; i++) {
-		char name[] = "st,pll@X";
-		int subnode = -1;
-
-		snprintf(name, sizeof(name), "st,pll@%d", i);
-		subnode = fdt_subnode_offset(fdt, node, name);
-		if (subnode < 0)
-			continue;
