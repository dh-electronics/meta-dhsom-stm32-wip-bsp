-            0x50, 0x53, 0x41, 0x20, 0x41, 0x44, 0x41, 0x43, 0x20, 0x31, 0x2E, 0x30,
-            /* Separator (0x00) */
-            0x00,
-            /* [L]_2 = 128 (encoded in 16 bit) */
-            0x00, 0x80,
-            /* [i]_2 = 8-bit counter */
-            0x01
-            /* Context = input */
-    };
