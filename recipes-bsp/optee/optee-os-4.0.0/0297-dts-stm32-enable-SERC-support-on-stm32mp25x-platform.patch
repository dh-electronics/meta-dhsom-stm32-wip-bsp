From 388833d2d554b9936ce9651ffe83357b9628057f Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Mon, 24 Apr 2023 16:58:47 +0200
Subject: [PATCH 0297/1695] dts: stm32: enable SERC support on stm32mp25x
 platforms

Enable SERC support on stm32mp25x platforms.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git fad1ece4642367189f91f6f06eaca13ed18ebb14 dts: stm32: enable SERC support on stm32mp25x platforms]
Signed-off-by: Ludovic Barre <ludovic.barre@foss.st.com>
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Change-Id: I06c232a6602f12580bf3ef470217d827b6e2dc45
---
 core/arch/arm/dts/stm32mp251.dtsi | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/core/arch/arm/dts/stm32mp251.dtsi b/core/arch/arm/dts/stm32mp251.dtsi
index c3b6c2cdf..0e0518729 100644
--- a/core/arch/arm/dts/stm32mp251.dtsi
+++ b/core/arch/arm/dts/stm32mp251.dtsi
@@ -282,8 +282,10 @@
 		};
 
 		serc: serc@44080000 {
+			compatible = "st,stm32mp25-serc";
 			reg = <0x44080000 0x1000>;
-			status = "disabled";
+			interrupts = <GIC_SPI 240 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&rcc CK_BUS_SERC>;
 		};
 
 		rcc: rcc@44200000 {
-- 
2.47.2

