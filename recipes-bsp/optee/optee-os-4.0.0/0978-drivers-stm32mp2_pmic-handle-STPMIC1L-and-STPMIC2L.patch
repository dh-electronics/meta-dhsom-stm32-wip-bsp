+	const char __maybe_unused *regu_name = regu_desc->name;
 
 	cuint = fdt_getprop(fdt, node, "st,regulator-bypass-microvolt", NULL);
 	if (!cuint)
@@ -555,10 +611,11 @@ static void pmic_parse_regu_node(struct regu_dt_desc *regu_desc,
