 core/include/dt-bindings/scmi/scmi-clock.h | 13 +++++++++++++
 1 file changed, 13 insertions(+)
 create mode 100644 core/include/dt-bindings/scmi/scmi-clock.h

diff --git a/core/include/dt-bindings/scmi/scmi-clock.h b/core/include/dt-bindings/scmi/scmi-clock.h
new file mode 100644
index 000000000..2c8fd550a
--- /dev/null
+++ b/core/include/dt-bindings/scmi/scmi-clock.h
@@ -0,0 +1,13 @@
