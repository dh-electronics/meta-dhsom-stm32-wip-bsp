+#ifndef _DT_BINDINGS_SCMI_SCMI_CLOCK_H_
+#define _DT_BINDINGS_SCMI_SCMI_CLOCK_H_
+
+#define SCMI_CLOCK_DEFAULT_ENABLED	0x1
+#define SCMI_CLOCK_ALLOW_SET_RATE	0x2
+#define SCMI_CLOCK_MASK			GENMASK_32(1, 0)
+
+#endif /* _DT_BINDINGS_SCMI_SCMI_CLOCK_H_ */
