From 9f6896e6347437a0c10c263cb5c0412994836fa9 Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@linaro.org>
Date: Tue, 18 Oct 2022 18:03:19 +0200
Subject: [PATCH 0386/1695] drivers: stm32_rng: check clock enable call

Fixes clock enable request that does not check the return value.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git bfc1e0c9446f9161d36bd190d36efde081820ba2 drivers: stm32_rng: check clock enable call]
Change-Id: Ife2abef02f478e8f171644ae9104d9587d6da2e3
Signed-off-by: Etienne Carriere <etienne.carriere@linaro.org>
---
 core/drivers/stm32_rng.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/core/drivers/stm32_rng.c b/core/drivers/stm32_rng.c
index ef0f36278..dde52ca58 100644
--- a/core/drivers/stm32_rng.c
+++ b/core/drivers/stm32_rng.c
@@ -312,7 +312,10 @@ static TEE_Result stm32_rng_read(uint8_t *out, size_t size)
 		return TEE_ERROR_NOT_SUPPORTED;
 	}
 
-	clk_enable(stm32_rng->clock);
+	rc = clk_enable(stm32_rng->clock);
+	if (rc)
+		return rc;
+
 	rng_base = get_base();
 
 	/* Arm timeout */
-- 
2.47.2

