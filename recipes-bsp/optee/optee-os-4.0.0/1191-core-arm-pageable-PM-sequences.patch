 	read_vbar r8
 	read_nsacr r9
 	read_sctlr r10
-	stmia	r0, {r4 - r10}
+	stmia	r0!, {r4 - r10}
+
+#ifdef CFG_PAGED_PSCI_SYSTEM_SUSPEND
