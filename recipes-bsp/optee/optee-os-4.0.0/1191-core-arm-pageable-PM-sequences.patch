 	dsb
 	/* MMU will be enabled here */
@@ -205,4 +246,5 @@ a5_a7_resume:
 	mov	r0, #0
 	b	suspend_return
 END_FUNC sm_pm_cpu_do_resume
+DECLARE_KEEP_PAGER sm_pm_cpu_do_resume
 
