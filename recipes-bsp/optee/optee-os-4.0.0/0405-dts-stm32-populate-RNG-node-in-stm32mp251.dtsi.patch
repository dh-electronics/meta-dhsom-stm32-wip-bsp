From ab6ad037ffcac9348a01617d53e75edbebf14983 Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Wed, 10 Jan 2024 14:05:08 +0100
Subject: [PATCH 0405/1695] dts: stm32: populate RNG node in stm32mp251.dtsi

Populate the RNG node with its device tree resources.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git b337f944d9c46b36e3f4ce9f4ed354a951cea8b6 dts: stm32: populate RNG node in stm32mp251.dtsi]
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Change-Id: I299403358df205111b075a6c987417aeb3987267
---
 core/arch/arm/dts/stm32mp251.dtsi | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/core/arch/arm/dts/stm32mp251.dtsi b/core/arch/arm/dts/stm32mp251.dtsi
index 1a025e3a6..c2887f9a0 100644
--- a/core/arch/arm/dts/stm32mp251.dtsi
+++ b/core/arch/arm/dts/stm32mp251.dtsi
@@ -237,8 +237,11 @@
 			};
 
 			rng: rng@42020000 {
+				compatible = "st,stm32mp25-rng";
 				reg = <0x42020000 0x400>;
-				status = "disabled";
+				clocks = <&clk_rcbsec>, <&rcc CK_BUS_RNG>;
+				clock-names = "rng_clk", "rng_hclk";
+				resets = <&rcc RNG_R>;
 			};
 
 			iwdg1: watchdog@44010000 {
-- 
