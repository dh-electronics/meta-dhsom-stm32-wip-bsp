+/* IO compensation domains IDs for STM32MP13 variants */
+enum stm32mp13_vddsd_comp_id {
+	SYSCFG_IO_COMP_IDX_SD1,
+	SYSCFG_IO_COMP_IDX_SD2,
+	SYSCFG_IO_COMP_COUNT
