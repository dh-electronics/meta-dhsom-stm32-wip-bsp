---
 .../plat-stm32mp1/drivers/stm32mp1_syscfg.c   | 99 ++++++++++++-------
 .../plat-stm32mp1/drivers/stm32mp1_syscfg.h   | 24 +++++
 core/arch/arm/plat-stm32mp1/stm32_util.h      |  7 --
 3 files changed, 89 insertions(+), 41 deletions(-)
