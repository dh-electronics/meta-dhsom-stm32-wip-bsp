 core/drivers/scmi-msg/perf_domain.c | 386 ++++++++++++++++++++++++++++
 core/drivers/scmi-msg/perf_domain.h | 139 ++++++++++
 core/drivers/scmi-msg/sub.mk        |   1 +
 core/include/drivers/scmi-msg.h     |  87 ++++++-
 mk/config.mk                        |   2 +
 6 files changed, 618 insertions(+), 1 deletion(-)
