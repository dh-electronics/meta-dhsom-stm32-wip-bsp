From 8ca68e7b3ce7e2cba64b5813ecc28d34d6f8bfe3 Mon Sep 17 00:00:00 2001
From: Antonio Borneo <antonio.borneo@foss.st.com>
Date: Wed, 5 Feb 2025 15:45:54 +0100
Subject: [PATCH 1597/1695] dts: stm32: use PWR through EXTI on stm32mp13x

The hierarchical stack is:
- GIC
- PWR (only on EXTI lines for wakeup pins)
- EXTI
- irq client

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git a3bc50b30a0e37a85752b663cbf984895e207164 dts: stm32: use PWR through EXTI on stm32mp13x]
Signed-off-by: Antonio Borneo <antonio.borneo@foss.st.com>
Change-Id: I6dc6ce077cc07f8a0b70a65f3b493e5ee9da5bd9
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/434939
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 core/arch/arm/dts/stm32mp131.dtsi    | 14 +++++++-------
 core/arch/arm/dts/stm32mp135f-dk.dts |  6 +++---
 2 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp131.dtsi b/core/arch/arm/dts/stm32mp131.dtsi
index 83ad680db..4e1dbd979 100644
--- a/core/arch/arm/dts/stm32mp131.dtsi
+++ b/core/arch/arm/dts/stm32mp131.dtsi
@@ -293,7 +293,6 @@
 
 		pwr_irq: pwr@50001010 {
 			compatible = "st,stm32mp1-pwr-irq";
-			wakeup-parent = <&exti 0xffff 0>;
 			interrupts = <GIC_SPI 125 IRQ_TYPE_LEVEL_HIGH>;
 			interrupt-controller;
 			#interrupt-cells = <2>;
@@ -303,6 +302,7 @@
 
 		exti: interrupt-controller@5000d000 {
 			compatible = "st,stm32mp1-exti";
+			wakeup-parent = <&pwr_irq>;
 			interrupt-controller;
 			#interrupt-cells = <2>;
 			reg = <0x5000d000 0x400>;
@@ -362,12 +362,12 @@
 				<&intc GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>,
 				<&intc GIC_SPI 119 IRQ_TYPE_LEVEL_HIGH>,
 				<0>,
-				<0>,
-				<0>,
-				<0>,
-				<0>,
-				<0>,
-				<0>,						/* EXTI_60 */
+				<&pwr_irq 0 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr_irq 1 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr_irq 2 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr_irq 3 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr_irq 4 IRQ_TYPE_EDGE_FALLING>,
+				<&pwr_irq 5 IRQ_TYPE_EDGE_FALLING>,		/* EXTI_60 */
 				<0>,
 				<0>,
 				<0>,
diff --git a/core/arch/arm/dts/stm32mp135f-dk.dts b/core/arch/arm/dts/stm32mp135f-dk.dts
index d9542e48b..bf97d9217 100644
--- a/core/arch/arm/dts/stm32mp135f-dk.dts
+++ b/core/arch/arm/dts/stm32mp135f-dk.dts
@@ -35,7 +35,7 @@
 
 	magic_wol: magic_wol {
 		compatible = "st,stm32mp1-pwr-irq-user";
-		interrupts-extended = <&pwr_irq 1 IRQ_TYPE_EDGE_FALLING>;
+		interrupts-extended = <&exti 56 IRQ_TYPE_EDGE_FALLING>;
 		wakeup-source;
 		status = "okay";
 	};
@@ -68,7 +68,7 @@
 
 	typec_wakeup: typec_wakeup {
 		compatible = "st,stm32mp1-pwr-irq-user";
-		interrupts-extended = <&pwr_irq 4 IRQ_TYPE_EDGE_FALLING>;
+		interrupts-extended = <&exti 59 IRQ_TYPE_EDGE_FALLING>;
 		wakeup-source;
 		st,notif-it-id = <1>;
 		status = "okay";
@@ -207,7 +207,7 @@
 		compatible = "st,stpmic1";
 		reg = <0x33>;
 		status = "okay";
-		interrupts-extended = <&pwr_irq 0 IRQ_TYPE_EDGE_FALLING>;
+		interrupts-extended = <&exti 55 IRQ_TYPE_EDGE_FALLING>;
 		wakeup-source;
 		st,pmic-it-id = <IT_PONKEY_F IT_PONKEY_R>;
 		st,notif-it-id = <0 2>;
-- 
2.47.2

