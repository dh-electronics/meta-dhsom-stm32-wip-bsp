index ca32f5b1f..ac58cc704 100644
--- a/core/drivers/clk/clk.c
+++ b/core/drivers/clk/clk.c
@@ -212,59 +212,6 @@ unsigned long clk_get_rate(struct clk *clk)
 	return rate;
 }
 
