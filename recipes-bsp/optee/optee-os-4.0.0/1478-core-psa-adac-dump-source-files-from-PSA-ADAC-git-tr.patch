+
+size_t psa_adac_platform_discovery(uint8_t *reply, size_t reply_size)
+{
+    if (reply_size >= discovery_template_len) {
+        memcpy(reply, discovery_template, discovery_template_len);
+        return discovery_template_len;
+    }
+    return 0;
+}
