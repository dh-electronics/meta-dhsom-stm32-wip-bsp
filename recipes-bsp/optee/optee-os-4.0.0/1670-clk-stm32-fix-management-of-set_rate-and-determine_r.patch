+++ b/core/drivers/clk/clk-stm32mp21.c
@@ -3042,8 +3042,19 @@ static TEE_Result clk_cpu1_determine_rate(struct clk *clk,
 	return TEE_SUCCESS;
 }
 
+static TEE_Result clk_cpu1_set_rate(struct clk *clk __unused,
+				    unsigned long rate,
+				    unsigned long parent_rate)
