From ea041a01d1e1312adbfee18baea3d7877be9d56a Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Fri, 15 Dec 2023 11:47:36 +0100
Subject: [PATCH 0202/1695] drivers: stm32_gpio: add support for stm32mp25

Add support for stm32mp25 compatibles.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git e45f219f1a12634d8ee56e5e2905641f496753e5 drivers: stm32_gpio: add support for stm32mp25]
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Change-Id: I83549ae9bdf7b37063d50ae597c45d9e59f8c957
---
 core/drivers/stm32_gpio.c | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/core/drivers/stm32_gpio.c b/core/drivers/stm32_gpio.c
index 38115f02f..8c49aef51 100644
--- a/core/drivers/stm32_gpio.c
+++ b/core/drivers/stm32_gpio.c
@@ -1035,6 +1035,19 @@ static const struct dt_device_match stm32_pinctrl_match_table[] = {
 			.secure_control = true,
 		},
 	},
+	{
+		.compatible = "st,stm32mp257-pinctrl",
+		.compat_data = &(struct bank_compat){
+			.secure_control = true,
+		},
+	},
+	{
+		.compatible = "st,stm32mp257-z-pinctrl",
+		.compat_data = &(struct bank_compat){
+			.gpioz = true,
+			.secure_control = true,
+		},
+	},
 	{ }
 };
 
-- 
