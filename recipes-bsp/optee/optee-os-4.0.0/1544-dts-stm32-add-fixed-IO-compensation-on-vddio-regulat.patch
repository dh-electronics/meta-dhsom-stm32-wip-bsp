From faf894ba810e8c860bd4e0efa693208fd24c0deb Mon Sep 17 00:00:00 2001
From: Christophe Kerello <christophe.kerello@foss.st.com>
Date: Wed, 19 Feb 2025 18:09:34 +0100
Subject: [PATCH 1544/1695] dts: stm32: add fixed IO compensation on vddio
 regulators for stm32mp231

IO compensation could alter duty cycle of high frequency output signal
on stm32mp23 SoC. To avoid such issue, fixed IO compensation is used.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 7d39ed6b84fb14e52cb755c7e1f36468c5874d4f dts: stm32: add fixed IO compensation on vddio regulators for stm32mp231]
Change-Id: Ia9189d5f51dfc2ce5f96ceb722408a0bd4293076
Signed-off-by: Christophe Kerello <christophe.kerello@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/438579
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Christophe KERELLO <christophe.kerello@st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
Reviewed-by: Christophe KERELLO <christophe.kerello@st.com>
---
 core/arch/arm/dts/stm32mp231.dtsi | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp231.dtsi b/core/arch/arm/dts/stm32mp231.dtsi
index 397e0bd21..a0b40d8e6 100644
--- a/core/arch/arm/dts/stm32mp231.dtsi
+++ b/core/arch/arm/dts/stm32mp231.dtsi
@@ -853,30 +853,35 @@
 			vddio1: vddio1 {
 				compatible = "st,stm32mp25-pwr-regu";
 				regulator-name = "vddio1";
+				st,iocomp = <8 7>;
 				status = "disabled";
 			};
 
 			vddio2: vddio2 {
 				compatible = "st,stm32mp25-pwr-regu";
 				regulator-name = "vddio2";
+				st,iocomp = <8 7>;
 				status = "disabled";
 			};
 
 			vddio3: vddio3 {
 				compatible = "st,stm32mp25-pwr-regu";
 				regulator-name = "vddio3";
+				st,iocomp = <8 7>;
 				status = "disabled";
 			};
 
 			vddio4: vddio4 {
 				compatible = "st,stm32mp25-pwr-regu";
 				regulator-name = "vddio4";
+				st,iocomp = <8 7>;
 				status = "disabled";
 			};
 
 			vddio: vddio {
 				compatible = "st,stm32mp25-pwr-regu";
 				regulator-name = "vddio";
+				st,iocomp = <8 7>;
 				regulator-always-on;
 				status = "disabled";
 			};
