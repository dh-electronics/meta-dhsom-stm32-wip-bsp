 $(call force,CFG_SCPFW_MOD_VOLTAGE_DOMAIN,y)
+$(call force,CFG_SCPFW_SCMI_PERF_PROTOCOL_OPS,y)
 
 # Info level is sufficient for scp-firmware
 CFG_SCPFW_LOG_LEVEL ?= 1
