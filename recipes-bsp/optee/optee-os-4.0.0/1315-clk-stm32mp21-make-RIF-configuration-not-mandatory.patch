From 4e94620fe85ada0107c185587cb516e5b3771413 Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Wed, 9 Oct 2024 14:50:37 +0200
Subject: [PATCH 1315/1695] clk: stm32mp21: make RIF configuration not
 mandatory

The presence of a RIF configuration is not mandatory. Simply put a
trace to inform that RIF will not be configured. While there, refactor
the error handling in the stm32mp2_clk_probe() function to fix memory
leaks.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 97b4d15c5a36505e1eb1a177abb05c0b1bf021f5 clk: stm32mp21: make RIF configuration not mandatory]
Change-Id: I4db06b0c541a1a0c93087374d97692da40705d59
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/410142
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CIBUILD <MDG-smet-aci-builds@list.st.com>
Domain-Review: Yann GAUTIER <yann.gautier@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Tested-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
---
 core/drivers/clk/clk-stm32mp21.c | 38 ++++++++++++++++++++++++--------
 1 file changed, 29 insertions(+), 9 deletions(-)

diff --git a/core/drivers/clk/clk-stm32mp21.c b/core/drivers/clk/clk-stm32mp21.c
index 6b8770b25..534075521 100644
--- a/core/drivers/clk/clk-stm32mp21.c
+++ b/core/drivers/clk/clk-stm32mp21.c
@@ -1259,14 +1259,19 @@ static int stm32_clk_parse_fdt(const void *fdt, int node,
 	pdata->rcc_base = stm32_rcc_base();
 
 	cuint = fdt_getprop(fdt, node, "st,protreg", &lenp);
-	if (!cuint)
-		panic("No RIF configuration");
+	if (lenp < 0) {
+		if (lenp != -FDT_ERR_NOTFOUND)
+			return lenp;
+
+		lenp = 0;
+		DMSG("No RIF configuration available");
+	}
 
 	pdata->nb_res = (unsigned int)(lenp / sizeof(uint32_t));
+
 	assert(pdata->nb_res <= RCC_NB_RIF_RES);
 
-	pdata->conf_data.cid_confs = calloc(RCC_NB_RIF_RES,
-					    sizeof(uint32_t));
+	pdata->conf_data.cid_confs = calloc(RCC_NB_RIF_RES, sizeof(uint32_t));
 	pdata->conf_data.sec_conf = calloc(RCC_NB_CONFS, sizeof(uint32_t));
 	pdata->conf_data.priv_conf = calloc(RCC_NB_CONFS, sizeof(uint32_t));
 	pdata->conf_data.lock_conf = calloc(RCC_NB_CONFS, sizeof(uint32_t));
@@ -4438,6 +4443,9 @@ static TEE_Result stm32_rcc_rif_pm_suspend(void)
 	struct stm32_clk_platdata *pdata = &stm32mp21_clock_pdata;
 	unsigned int i = 0;
 
+	if (!pdata->nb_res)
+		return TEE_SUCCESS;
+
 	for (i = 0; i < RCC_NB_RIF_RES; i++) {
 		pdata->conf_data.cid_confs[i] = io_read32(pdata->rcc_base +
 							  RCC_CIDCFGR(i));
@@ -4564,20 +4572,24 @@ static TEE_Result stm32mp2_clk_probe(const void *fdt, int node,
 		if (res) {
 			EMSG("Failed on node %s with %#"PRIx32,
 			     fdt_get_name(fdt, subnode, NULL), res);
-			return res;
+			goto err;
 		}
 	}
 
 	rc = clk_stm32_init(priv, stm32_rcc_base());
-	if (rc)
-		return TEE_ERROR_GENERIC;
+	if (rc) {
+		res = TEE_ERROR_GENERIC;
+		goto err;
+	}
 
 	if (IS_ENABLED(CFG_STM32_CLK_DEBUG))
 		clk_stm32_debug_display_pdata();
 
 	rc = stm32mp2_init_clock_tree(priv, pdata);
-	if (rc != 0)
-		return rc;
+	if (rc != 0) {
+		res = TEE_ERROR_GENERIC;
+		goto err;
+	}
 
 	clk_stm32_init_oscillators(fdt, node);
 
@@ -4593,6 +4605,14 @@ static TEE_Result stm32mp2_clk_probe(const void *fdt, int node,
 	register_pm_core_service_cb(stm32_rcc_pm, NULL, "stm32-rcc");
 
 	return TEE_SUCCESS;
+err:
+	free(pdata->conf_data.cid_confs);
+	free(pdata->conf_data.sec_conf);
+	free(pdata->conf_data.priv_conf);
+	free(pdata->conf_data.lock_conf);
+	free(pdata->conf_data.access_mask);
+
+	return res;
 }
 
 CLK_DT_DECLARE(stm32mp21_clk, "st,stm32mp21-rcc", stm32mp2_clk_probe);
-- 
