From 7bddd9a2183dc685b77edf63dd3b700c043b8bde Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Thu, 11 Jan 2024 09:32:37 +0100
Subject: [PATCH 0425/1695] plat-stm32mp2: enable watchdog SMC service

Enable Arm watchdog SMC service using function ID 0xbc000000.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git f7d3db1e5865b5d242b47c8d87628647c34b910d plat-stm32mp2: enable watchdog SMC service]
Change-Id: Ibd113356973e0fd2b9faa1a277e30ffe36e0e9b8
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
---
 core/arch/arm/plat-stm32mp2/conf.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp2/conf.mk b/core/arch/arm/plat-stm32mp2/conf.mk
index 4da601994..2aa9028aa 100644
--- a/core/arch/arm/plat-stm32mp2/conf.mk
+++ b/core/arch/arm/plat-stm32mp2/conf.mk
@@ -115,6 +115,11 @@ endif
 # Platform specific configuration
 CFG_STM32MP_PANIC_ON_TZC_PERM_VIOLATION ?= y
 
+# Watchdog SMC service to non-secure world
+CFG_WDT ?= $(CFG_STM32_IWDG)
+CFG_WDT_SM_HANDLER ?= $(CFG_WDT)
+CFG_WDT_SM_HANDLER_ID ?= 0xbc000000
+
 # Enable reset control
 ifeq ($(CFG_STM32MP25_RSTCTRL),y)
 $(call force,CFG_DRIVERS_RSTCTRL,y)
-- 
2.47.2

