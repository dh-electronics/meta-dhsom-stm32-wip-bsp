+		     io_read32(base + _RISAB_IAESR));
 		EMSG("-----------------------------------------------------");
 		EMSG("Faulty address (IADDR): %#x",
-		     io_read32(risab->base + _RISAB_IADDR));
+		     io_read32(base + _RISAB_IADDR));
 
 		EMSG("=====================================================\n");
 
