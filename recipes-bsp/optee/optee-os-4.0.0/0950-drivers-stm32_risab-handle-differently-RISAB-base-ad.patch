-	uintptr_t base;
 	uint32_t pages_configured;
 	bool srwiad;
 
@@ -95,20 +95,27 @@ static SLIST_HEAD(, stm32_risab_pdata) risab_list =
 
 static bool is_tdcid;
 
+static vaddr_t risab_base(struct stm32_risab_pdata *risab)
+{
+	return io_pa_or_va_secure(&risab->base, 1);
+}
