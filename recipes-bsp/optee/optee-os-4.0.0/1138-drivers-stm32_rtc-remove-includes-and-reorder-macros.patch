-#define RTC_SCR_CTSF			BIT(3)
-#define RTC_SR_TSOVF			BIT(4)
-#define RTC_SCR_CTSOVF			BIT(4)
+
+#define RTC_SECCFGR_VALUES		GENMASK_32(3, 0)
