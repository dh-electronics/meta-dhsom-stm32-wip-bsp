+++ b/core/arch/arm/dts/stm32mp15-pinctrl.dtsi
@@ -1828,43 +1828,6 @@
 		};
 	};
 
-	tamp0_in1_pin_a: tamp0-in1-pin-0 {
-		pins {
-			pinmux = <STM32_PINMUX('C', 13, RSVD)>;
-			st,tamp-id = <1>;
-		};
-	};
-	tamp0_in2_pin_a: tamp0-in2-pin-0 {
-		pins {
-			pinmux = <STM32_PINMUX('I', 8, RSVD)>;
-			st,tamp-id = <2>;
-		};
-	};
-	tamp0_in3_pin_a: tamp0-in3-pin-0 {
-		pins {
-			pinmux = <STM32_PINMUX('C', 1, RSVD)>;
-			st,tamp-id = <3>;
-		};
-	};
-	tamp0_out2_pin_a: tamp0-out2-pin-0 {
-		pins {
-			pinmux = <STM32_PINMUX('C', 13, RSVD)>;
-			st,tamp-id = <2>;
-		};
-	};
-	tamp0_out3_pin_a: tamp0-out3-pin-0 {
-		pins {
-			pinmux = <STM32_PINMUX('I', 8, RSVD)>;
-			st,tamp-id = <3>;
-		};
-	};
-	tamp0_out3_pin_b: tamp0-out3-pin-1 {
-		pins {
-			pinmux = <STM32_PINMUX('C', 13, RSVD)>;
-			st,tamp-id = <3>;
-		};
-	};
-
 	uart4_pins_a: uart4-0 {
 		pins1 {
 			pinmux = <STM32_PINMUX('G', 11, AF6)>; /* UART4_TX */
diff --git a/core/arch/arm/dts/stm32mp235f-dk.dts b/core/arch/arm/dts/stm32mp235f-dk.dts
index 8b4150ef1..88a34eef1 100644
--- a/core/arch/arm/dts/stm32mp235f-dk.dts
+++ b/core/arch/arm/dts/stm32mp235f-dk.dts
@@ -449,9 +449,8 @@
 	st,tamp-passive-sample-clk-div = <16384>;
 
 	/* Tamper button */
-	tamp_button: tamp-passive@3 {
+	tamp-button {
 		status = "disabled";
-		reg = <EXT_TAMPER_3 0>;
 		tamper-gpios = <&gpioz 2 0>;
 		st,tamp-mode = <TAMPER_CONFIRMED_MODE>;
 		st,tamp-id = <3>;
diff --git a/core/arch/arm/dts/stm32mp257f-dk.dts b/core/arch/arm/dts/stm32mp257f-dk.dts
index 947805441..fef73e674 100644
--- a/core/arch/arm/dts/stm32mp257f-dk.dts
+++ b/core/arch/arm/dts/stm32mp257f-dk.dts
@@ -437,9 +437,8 @@
 	st,tamp-passive-sample-clk-div = <16384>;
 
 	/* Tamper button */
-	tamp_button: tamp-passive@3 {
+	tamp-button {
 		status = "disabled";
-		reg = <EXT_TAMPER_3 0>;
 		tamper-gpios = <&gpioz 2 0>;
 		st,tamp-mode = <TAMPER_CONFIRMED_MODE>;
 		st,tamp-id = <3>;
diff --git a/core/arch/arm/dts/stm32mp257f-ev1.dts b/core/arch/arm/dts/stm32mp257f-ev1.dts
index 25fcb0455..1a00f0c0d 100644
--- a/core/arch/arm/dts/stm32mp257f-ev1.dts
+++ b/core/arch/arm/dts/stm32mp257f-ev1.dts
@@ -464,9 +464,8 @@
 	st,tamp-passive-sample-clk-div = <16384>;
 
 	/* Tamper button */
-	tamp_button: tamp-passive@1 {
+	tamp-button {
 		status = "disabled";
-		reg = <EXT_TAMPER_1 0>;
 		tamper-gpios = <&gpioi 8 0>;
 		st,tamp-mode = <TAMPER_CONFIRMED_MODE>;
 		st,tamp-id = <1>;
