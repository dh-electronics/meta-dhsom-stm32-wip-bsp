 core/arch/arm/plat-stm32mp1/main.c       | 58 ++++++++++++++++++++++++
 core/arch/arm/plat-stm32mp1/stm32_util.h |  2 +
 core/arch/arm/plat-stm32mp2/main.c       | 55 ++++++++++++++++++++++
 core/arch/arm/plat-stm32mp2/stm32_util.h |  2 +
 core/drivers/stm32_tamp.c                |  8 ++++
