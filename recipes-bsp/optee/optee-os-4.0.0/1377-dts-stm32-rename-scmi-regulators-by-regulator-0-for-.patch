From e1fedec6549a8eea1f240e990e03e6676b0f4155 Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Mon, 18 Nov 2024 15:05:34 +0100
Subject: [PATCH 1377/1695] dts: stm32: rename scmi regulators by regulator@0
 for stm32mp23x boards

Use a scmi regulator node name coherent with scmi binding:
protocol@17{
	regulators {
		regulator@0 {
		};
		[...]
	};
};

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 860e11b2132281289cd0366b59bd934722fcd818 dts: stm32: rename scmi regulators by regulator@0 for stm32mp23x boards]
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: Ia3e2359e2b196b2de8e801837ef589c9db9fac75
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/419310
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
---
 core/arch/arm/dts/stm32mp235f-dk.dts | 73 ++++++++++++++++------------
 1 file changed, 41 insertions(+), 32 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp235f-dk.dts b/core/arch/arm/dts/stm32mp235f-dk.dts
index 63e1419ca..1c5aa27ae 100644
--- a/core/arch/arm/dts/stm32mp235f-dk.dts
+++ b/core/arch/arm/dts/stm32mp235f-dk.dts
@@ -409,38 +409,47 @@
 	status = "okay";
 };
 
-&scmi_regu {
-	voltd-vddcore {
-		reg = <VOLTD_SCMI_STPMIC2_BUCK2>;
-		voltd-supply = <&vddcore>;
-	};
-	voltd-v1v8 {
-		reg = <VOLTD_SCMI_STPMIC2_BUCK5>;
-		voltd-supply = <&v1v8>;
-	};
-	voltd-v3v3 {
-		reg = <VOLTD_SCMI_STPMIC2_BUCK7>;
-		voltd-supply = <&v3v3>;
-	};
-	voltd-v5v-hdmi {
-		reg = <VOLTD_SCMI_STPMIC2_LDO5>;
-		voltd-supply = <&v5v_hdmi>;
-	};
-	voltd-v5v-vconn {
-		reg = <VOLTD_SCMI_STPMIC2_LDO6>;
-		voltd-supply = <&v5v_vconn>;
-	};
-	voltd-vdd-emmc {
-		reg = <VOLTD_SCMI_STPMIC2_LDO2>;
-		voltd-supply = <&vdd_emmc>;
-	};
-	voltd-vdd3v3-usb {
-		reg = <VOLTD_SCMI_STPMIC2_LDO4>;
-		voltd-supply = <&vdd3v3_usb>;
-	};
-	voltd-vdd-sdcard {
-		reg = <VOLTD_SCMI_STPMIC2_LDO7>;
-		voltd-supply = <&vdd_sdcard>;
+&scmi_regulator {
+	regulators {
+		regulator@b {
+			reg = <VOLTD_SCMI_STPMIC2_BUCK2>;
+			voltd-supply = <&vddcore>;
+		};
+
+		regulator@e {
+			reg = <VOLTD_SCMI_STPMIC2_BUCK5>;
+			voltd-supply = <&v1v8>;
+		};
+
+		regulator@10 {
+			reg = <VOLTD_SCMI_STPMIC2_BUCK7>;
+			voltd-supply = <&v3v3>;
+		};
+
+		regulator@15 {
+			reg = <VOLTD_SCMI_STPMIC2_LDO5>;
+			voltd-supply = <&v5v_hdmi>;
+		};
+
+		regulator@16 {
+			reg = <VOLTD_SCMI_STPMIC2_LDO6>;
+			voltd-supply = <&v5v_vconn>;
+		};
+
+		regulator@12 {
+			reg = <VOLTD_SCMI_STPMIC2_LDO2>;
+			voltd-supply = <&vdd_emmc>;
+		};
+
+		regulator@14 {
+			reg = <VOLTD_SCMI_STPMIC2_LDO4>;
+			voltd-supply = <&vdd3v3_usb>;
+		};
+
+		regulator@17 {
+			reg = <VOLTD_SCMI_STPMIC2_LDO7>;
+			voltd-supply = <&vdd_sdcard>;
+		};
 	};
 };
 
-- 
2.47.2

