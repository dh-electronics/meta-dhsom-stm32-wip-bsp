From f0fabfc83183ea4b0ed81037ff9562f4efd496c8 Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Tue, 2 Jan 2024 11:35:59 +0100
Subject: [PATCH 0292/1695] dts: stm32: enable IAC support on stm32mp2

Enable IAC support on stm32mp2 platform.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git eaa8f549f9bbebeb1379212b15bdd50b3d1c99d3 dts: stm32: enable IAC support on stm32mp2]
Signed-off-by: Ludovic Barre <ludovic.barre@foss.st.com>
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
Change-Id: Iace0bcf14c21b20907fbe239340dd850eae4fb44
---
 core/arch/arm/dts/stm32mp251.dtsi | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/core/arch/arm/dts/stm32mp251.dtsi b/core/arch/arm/dts/stm32mp251.dtsi
index a09da0a1b..c3b6c2cdf 100644
--- a/core/arch/arm/dts/stm32mp251.dtsi
+++ b/core/arch/arm/dts/stm32mp251.dtsi
@@ -221,8 +221,9 @@
 		};
 
 		iac: iac@42090000 {
+			compatible = "st,stm32mp25-iac";
 			reg = <0x42090000 0x400>;
-			status = "disabled";
+			interrupts = <GIC_SPI 246 IRQ_TYPE_LEVEL_HIGH>;
 		};
 
 		risaf1: risaf@420a0000 {
-- 
2.47.2

