+static int stm32_clk_bus_configure(struct clk_stm32_priv *priv)
+{
+	struct stm32_clk_platdata *pdata = priv->pdata;
+	uint32_t i;
+
+	for (i = 0; i < pdata->nbusclk; i++) {
+		int ret = 0;
+
+		ret = stm32_clk_configure(priv, pdata->busclk[i]);
+		if (ret != 0)
+			return ret;
+	}
+
+	return 0;
+}
