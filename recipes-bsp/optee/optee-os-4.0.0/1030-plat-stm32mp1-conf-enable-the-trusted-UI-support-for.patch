From 8881675958f06a5d508dd3751527c18a4db55aee Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Thu, 30 May 2024 11:04:20 +0200
Subject: [PATCH 1030/1695] plat-stm32mp1: conf: enable the trusted UI support
 for stm32mp13

This change makes TUI support with the associated drivers and memory
management available on STM32MP13 platform.

CFG_TUI_FRAME_BUFFER_SIZE_MAX defines the TUI framebuffer max size
(default to 16MB) that must be provisioned in OP-TEE virtual memory
for the TUI frame buffer.

The effective framebuffer location (base address and byte size) is read
from the embedded DTB. The address range must be carved out from the
non-secure DDR (DDR non-secure can use as shared memory). The effective
address range is mapped in OP-TEE core at boot time, from display.c.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 4ccbac706d6ad49a235cc9f7701970ce9901d134 plat-stm32mp1: conf: enable the trusted UI support for stm32mp13]
Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
Signed-off-by: Lionel Debieve <lionel.debieve@foss.st.com>
Change-Id: I1699532cce7a45f18eeb13354552b61050a79b03
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/391781
Reviewed-by: Thomas BOURGOIN <thomas.bourgoin@foss.st.com>
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
---
 core/arch/arm/plat-stm32mp1/conf.mk | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/core/arch/arm/plat-stm32mp1/conf.mk b/core/arch/arm/plat-stm32mp1/conf.mk
index ca9d5db77..72ea5351b 100644
--- a/core/arch/arm/plat-stm32mp1/conf.mk
+++ b/core/arch/arm/plat-stm32mp1/conf.mk
@@ -225,6 +225,7 @@ $(call force,CFG_WITH_NSEC_GPIOS,n)
 CFG_STM32MP_OPP_COUNT ?= 3
 CFG_STM32_ADC ?= y
 CFG_WITH_PAGER ?= n
+CFG_WITH_TUI ?= y
 endif # CFG_STM32MP13
 
 ifeq ($(CFG_STM32MP15),y)
@@ -273,6 +274,16 @@ ifneq ($(CFG_WITH_LPAE),y)
 CFG_TEE_RAM_VA_SIZE ?= 0x00200000
 endif
 
+# Trusted User Interface
+ifeq ($(CFG_WITH_TUI),y)
+$(call force,CFG_DISPLAY,y,Mandated by CFG_WITH_TUI)
+$(call force,CFG_FRAME_BUFFER,y,Mandated by CFG_WITH_TUI)
+$(call force,CFG_STM32_LTDC,y,Mandated by CFG_WITH_TUI)
+# Provision virtual space to fit 10MByte plus the TUI frame buffer
+CFG_TUI_FRAME_BUFFER_SIZE_MAX ?= 0x01000000
+CFG_RESERVED_VASPACE_SIZE ?= (10 * 1024 * 1024 + $(CFG_TUI_FRAME_BUFFER_SIZE_MAX))
+endif
+
 ifneq ($(filter $(CFG_EMBED_DTB_SOURCE_FILE),$(flavorlist-512M)),)
 CFG_DRAM_SIZE    ?= 0x20000000
 endif
-- 
