From 5032e526093c44ebd91588c4353deca8b26ad44d Mon Sep 17 00:00:00 2001
From: Valentin Caron <valentin.caron@foss.st.com>
Date: Fri, 31 May 2024 10:25:06 +0200
Subject: [PATCH 0890/1695] dts: st: add scmi-agent-id in scmi_regu node in
 stm32mp131.dtsi

After patch "core: scmi-server: regulator: use agent_id and channel_id
from parent", nodes with compatible "st,scmi-regulator-consumer" should at
least have a scmi-agent-id property and a scmi-channel-id.

Update stm32mp131.dtsi

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git d40c19ffc7bbb2fb807c24f1198786187f0a32ad dts: st: add scmi-agent-id in scmi_regu node in stm32mp131.dtsi]
Co-developed-by: Raphael Gallais-Pou <raphael.gallais-pou@foss.st.com>
Signed-off-by: Raphael Gallais-Pou <raphael.gallais-pou@foss.st.com>
Signed-off-by: Valentin Caron <valentin.caron@foss.st.com>
Change-Id: I7b9e1412d9591a9689844679a189f547f3e49f61
Reviewed-on: https://gerrit.st.com/c/mpu/oe/optee/optee_os/+/384367
ACI: CITOOLS <MDG-smet-aci-reviews@list.st.com>
Reviewed-by: Etienne CARRIERE <etienne.carriere@foss.st.com>
Reviewed-by: Gatien CHEVALLIER <gatien.chevallier@st.com>
Domain-Review: Patrick DELAUNAY <patrick.delaunay@foss.st.com>
---
 core/arch/arm/dts/stm32mp131.dtsi | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/core/arch/arm/dts/stm32mp131.dtsi b/core/arch/arm/dts/stm32mp131.dtsi
index 4d40864a9..7c1145039 100644
--- a/core/arch/arm/dts/stm32mp131.dtsi
+++ b/core/arch/arm/dts/stm32mp131.dtsi
@@ -137,20 +137,20 @@
 		compatible = "st,scmi-regulator-consumer";
 		#address-cells = <1>;
 		#size-cells = <0>;
-
+		scmi-agent-id = <0>;
 		scmi-channel-id = <0>;
 
-		scmi_reg11: voltd-reg11 {
+		voltd-reg11 {
 			reg = <VOLTD_SCMI_REG11>;
 			voltd-supply = <&reg11>;
 		};
 
-		scmi_reg18: voltd-reg18 {
+		voltd-reg18 {
 			reg = <VOLTD_SCMI_REG18>;
 			voltd-supply = <&reg18>;
 		};
 
-		scmi_usb33: voltd-usb33 {
+		voltd-usb33 {
 			reg = <VOLTD_SCMI_USB33>;
 			voltd-supply = <&usb33>;
 		};
-- 
