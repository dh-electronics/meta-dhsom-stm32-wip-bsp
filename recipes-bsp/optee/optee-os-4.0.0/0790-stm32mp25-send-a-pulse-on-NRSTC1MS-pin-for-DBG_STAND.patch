index 40977cb53..72a0676e9 100644
--- a/core/arch/arm/plat-stm32mp2/platform_config.h
+++ b/core/arch/arm/plat-stm32mp2/platform_config.h
@@ -81,6 +81,7 @@
 #define FMC_BASE			0x48200000
 #define PCIE_BASE			0x48400000
 #define A35SSC_BASE			0x48800000
+#define DBGMCU_BASE			0x4a010000
 #define GIC_BASE			0x4ac00000
 #define DDR_BASE			UL(0x80000000)
 
@@ -92,6 +93,9 @@
 #define SRAM1_BASE			0x0e040000
 #endif
 
+/* DBGCMU */
+#define DBGMCU_SIZE			0x10000
+
 /* GIC resources */
 #define GIC_SIZE			0x80000
 #define GICC_OFFSET			0x20000
diff --git a/core/arch/arm/plat-stm32mp2/stm32_util.h b/core/arch/arm/plat-stm32mp2/stm32_util.h
index 8089d1b01..c86091730 100644
--- a/core/arch/arm/plat-stm32mp2/stm32_util.h
+++ b/core/arch/arm/plat-stm32mp2/stm32_util.h
@@ -31,4 +31,16 @@ TEE_Result stm32_activate_internal_tamper(int id);
 #ifdef CFG_STM32_CPU_OPP
 bool stm32mp_supports_cpu_opp(uint32_t opp_id);
 #endif /*CFG_STM32_CPU_OPP*/
+
+#ifdef CFG_STPMIC2
+bool stm32_pmic2_is_present(void);
+#else
+static inline bool stm32_pmic2_is_present(void)
+{
+	return false;
+}
+#endif
+
+void stm32_debug_suspend(unsigned long a0);
+
 #endif /*__STM32_UTIL_H__*/
