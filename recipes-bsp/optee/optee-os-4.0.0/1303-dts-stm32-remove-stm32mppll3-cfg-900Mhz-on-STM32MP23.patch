 		};
-
-		pll3_cfg_900Mhz: pll3-cfg-900Mhz {
-			cfg = <45 2 1 1>;
-			src = <MUX_CFG(MUX_MUXSEL7, MUXSEL_HSE)>;
-		};
 	};
 
