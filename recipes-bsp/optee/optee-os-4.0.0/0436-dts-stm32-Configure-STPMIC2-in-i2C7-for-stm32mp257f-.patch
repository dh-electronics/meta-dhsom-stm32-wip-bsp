From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Thu, 11 Jan 2024 10:46:55 +0100
Subject: [PATCH 0436/1695] dts: stm32: Configure STPMIC2 in i2C7 for
 stm32mp257f-dk|ev1

Configure and enable STPMIC2 device on I2C7 bus on STM32MP25 boards
EV1 and DK.

Define PWR regulators in stm32mp2 SoC DTSI files and board DTS files.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git f2ce769f71405c86827624d8808789e1672ee0c1 dts: stm32: Configure STPMIC2 in i2C7 for stm32mp257f-dk|ev1]
Change-Id: I87873f78f04fdccf89fb889e2cf21c02365adfc7
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
---
 core/arch/arm/dts/stm32mp25-pinctrl.dtsi |  16 +
 core/arch/arm/dts/stm32mp251.dtsi        |  56 ++++
 core/arch/arm/dts/stm32mp257f-dk.dts     | 333 +++++++++++++++++++++
 core/arch/arm/dts/stm32mp257f-ev1.dts    | 353 +++++++++++++++++++++++
 4 files changed, 758 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp25-pinctrl.dtsi b/core/arch/arm/dts/stm32mp25-pinctrl.dtsi
index 193014749..97ad90cfa 100644
--- a/core/arch/arm/dts/stm32mp25-pinctrl.dtsi
+++ b/core/arch/arm/dts/stm32mp25-pinctrl.dtsi
@@ -6,6 +6,22 @@
 #include <dt-bindings/pinctrl/stm32-pinfunc.h>
 
 &pinctrl {
+	i2c7_pins_a: i2c7-0 {
+		pins {
+			pinmux = <STM32_PINMUX('D', 15, AF10)>, /* I2C7_SCL */
+				 <STM32_PINMUX('D', 14, AF10)>; /* I2C7_SDA */
+			bias-disable;
+			drive-open-drain;
+			slew-rate = <0>;
+		};
+	};
+
+	i2c7_sleep_pins_a: i2c7-sleep-0 {
+		pins {
+			pinmux = <STM32_PINMUX('D', 15, ANALOG)>, /* I2C7_SCL */
+				 <STM32_PINMUX('D', 14, ANALOG)>; /* I2C7_SDA */
+		};
+	};
 
 	ospi1_clk_pins_a: ospi1-clk-0 {
 		pins {
diff --git a/core/arch/arm/dts/stm32mp251.dtsi b/core/arch/arm/dts/stm32mp251.dtsi
index c1b7d5155..6fcf5b9f1 100644
--- a/core/arch/arm/dts/stm32mp251.dtsi
+++ b/core/arch/arm/dts/stm32mp251.dtsi
@@ -196,7 +196,13 @@
 			};
 
 			i2c7: i2c@40180000 {
+				compatible = "st,stm32mp25-i2c";
 				reg = <0x40180000 0x400>;
+				clocks = <&rcc CK_KER_I2C7>;
+				resets = <&rcc I2C7_R>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				i2c-analog-filter;
 				status = "disabled";
 			};
 
@@ -408,8 +414,58 @@
 		};
 
 		pwr: pwr@44210000 {
+			compatible = "st,stm32mp25-pwr";
 			reg = <0x44210000 0x400>;
 			status = "disabled";
+
+			vdd33ucpd: vdd33ucpd {
+				compatible = "st,stm32mp25-pwr-regu";
+				regulator-name = "vdd33ucpd";
+				status = "disabled";
+			};
+
+			vdda18adc: vdda18adc {
+				compatible = "st,stm32mp25-pwr-regu";
+				regulator-name = "vdda18adc";
+				status = "disabled";
+			};
+
+			vddgpu: vddgpu {
+				compatible = "st,stm32mp25-pwr-regu";
+				regulator-name = "vddgpu";
+				status = "disabled";
+			};
+
+			vddio1: vddio1 {
+				compatible = "st,stm32mp25-pwr-regu";
+				regulator-name = "vddio1";
+				status = "disabled";
+			};
+
+			vddio2: vddio2 {
+				compatible = "st,stm32mp25-pwr-regu";
+				regulator-name = "vddio2";
+				status = "disabled";
+			};
+
+			vddio3: vddio3 {
+				compatible = "st,stm32mp25-pwr-regu";
+				regulator-name = "vddio3";
+				status = "disabled";
+			};
+
+			vddio4: vddio4 {
+				compatible = "st,stm32mp25-pwr-regu";
+				regulator-name = "vddio4";
+				status = "disabled";
+			};
+
+			vddio: vddio {
+				compatible = "st,stm32mp25-pwr-regu";
+				regulator-name = "vddio";
+				regulator-always-on;
+				status = "disabled";
+			};
 		};
 
 		exti1: interrupt-controller@44220000 {
diff --git a/core/arch/arm/dts/stm32mp257f-dk.dts b/core/arch/arm/dts/stm32mp257f-dk.dts
