+};
+
+struct tui_keyboard {
+	size_t layout_idx;
+	size_t num_layouts;
+	struct keyboard_head *kbh;
+	struct tui_widget tw;
+};
+
+struct keyboard_head {
+	TEE_TUIEntryFieldType type;
+	struct tui_widget_head twh;
+};
+
+struct keyboard_layout {
