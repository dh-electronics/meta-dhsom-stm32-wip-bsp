@@ -30,6 +30,10 @@
 #ifdef CFG_SCPFW_MOD_OPTEE_VOLTD_REGULATOR
 #include <mod_optee_voltd_regulator.h>
 #endif
+#ifdef CFG_SCPFW_MOD_POWER_DOMAIN
