From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Tue, 19 Dec 2023 09:54:51 +0100
Subject: [PATCH 0282/1695] drivers: gic: use GIC_HIGHEST_NS_PRIORITY macro

Use existing macro GIC_HIGHEST_NS_PRIORITY where applicable.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 25b94635ebc5347a7bcb053c18599525a6a5e7d1 drivers: gic: use GIC_HIGHEST_NS_PRIORITY macro]
Change-Id: Ie36f250933c9d3b657ae4ad4c0cd308cc53acb69
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
---
 core/drivers/gic.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/core/drivers/gic.c b/core/drivers/gic.c
index 557558013..9d35922dc 100644
--- a/core/drivers/gic.c
+++ b/core/drivers/gic.c
@@ -232,10 +232,10 @@ void gic_cpu_init(void)
 	 * allow the Non-secure world to adjust the priority mask itself
 	 */
 #if defined(CFG_ARM_GICV3)
-	write_icc_pmr(0x80);
+	write_icc_pmr(GIC_HIGHEST_NS_PRIORITY);
 	write_icc_igrpen1(1);
 #else
-	io_write32(gd->gicc_base + GICC_PMR, 0x80);
+	io_write32(gd->gicc_base + GICC_PMR, GIC_HIGHEST_NS_PRIORITY);
 
 	/* Enable GIC */
 	io_write32(gd->gicc_base + GICC_CTLR,
@@ -345,11 +345,11 @@ static void gic_init_setup(struct gic_data __maybe_unused *gd)
 	 * allow the Non-secure world to adjust the priority mask itself
 	 */
 #if defined(CFG_ARM_GICV3)
-	write_icc_pmr(0x80);
+	write_icc_pmr(GIC_HIGHEST_NS_PRIORITY);
 	write_icc_igrpen1(1);
 	io_setbits32(gd->gicd_base + GICD_CTLR, GICD_CTLR_ENABLEGRP1S);
 #else
-	io_write32(gd->gicc_base + GICC_PMR, 0x80);
+	io_write32(gd->gicc_base + GICC_PMR, GIC_HIGHEST_NS_PRIORITY);
 
 	/* Enable GIC */
 	io_write32(gd->gicc_base + GICC_CTLR, GICC_CTLR_FIQEN |
