From ffc463daa858246c6f359c72d8d4563bde312b32 Mon Sep 17 00:00:00 2001
From: Gatien Chevallier <gatien.chevallier@foss.st.com>
Date: Thu, 15 Feb 2024 17:54:13 +0100
Subject: [PATCH 0598/1695] dts: stm32mp25: add wake-up pin support on stm32mp2

Add wake-up pin support on stm32mp2.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 16469dd1de6ff39248d8170d205b7df245ae7797 dts: stm32mp25: add wake-up pin support on stm32mp2]
Change-Id: I482e819337d62c7970aed54c63d5ff1d96aaa355
Signed-off-by: Pascal Paillet <p.paillet@st.com>dts
Signed-off-by: Gatien Chevallier <gatien.chevallier@foss.st.com>
---
 core/arch/arm/dts/stm32mp251.dtsi     | 4 ++++
 core/arch/arm/dts/stm32mp257f-dk.dts  | 1 +
 core/arch/arm/dts/stm32mp257f-ev1.dts | 1 +
 3 files changed, 6 insertions(+)

diff --git a/core/arch/arm/dts/stm32mp251.dtsi b/core/arch/arm/dts/stm32mp251.dtsi
index 0cb3ce4b6..1c18dabf7 100644
--- a/core/arch/arm/dts/stm32mp251.dtsi
+++ b/core/arch/arm/dts/stm32mp251.dtsi
@@ -6,6 +6,7 @@
 
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/clock/stm32mp25-clks.h>
+#include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/regulator/st,stm32mp25-regulator.h>
 #include <dt-bindings/reset/stm32mp25-resets.h>
 
@@ -496,6 +497,9 @@
 		pwr: pwr@44210000 {
 			compatible = "st,stm32mp25-pwr";
 			reg = <0x44210000 0x400>;
+			wakeup-parent = <&exti1>;
+			interrupts = <GIC_SPI 226 IRQ_TYPE_LEVEL_HIGH>;
+			wakeup-gpios = <0>, <0>, <0>, <0>, <0>, <0>;
 			status = "disabled";
 
 			vdd33ucpd: vdd33ucpd {
diff --git a/core/arch/arm/dts/stm32mp257f-dk.dts b/core/arch/arm/dts/stm32mp257f-dk.dts
index 734377d5a..3c581d26c 100644
--- a/core/arch/arm/dts/stm32mp257f-dk.dts
+++ b/core/arch/arm/dts/stm32mp257f-dk.dts
@@ -312,6 +312,7 @@
 
 &pwr {
 	status = "okay";
+	wakeup-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>, <0>, <0>, <0>, <0>, <0>;
 
 	vdd33ucpd: vdd33ucpd {
 		status = "okay";
diff --git a/core/arch/arm/dts/stm32mp257f-ev1.dts b/core/arch/arm/dts/stm32mp257f-ev1.dts
index 6a73d2dc8..62736d408 100644
--- a/core/arch/arm/dts/stm32mp257f-ev1.dts
+++ b/core/arch/arm/dts/stm32mp257f-ev1.dts
@@ -347,6 +347,7 @@
 
 &pwr {
 	status = "okay";
+	wakeup-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>, <0>, <0>, <0>, <0>, <0>;
 
 	vdd33ucpd: vdd33ucpd {
 		status = "okay";
-- 
2.47.2

