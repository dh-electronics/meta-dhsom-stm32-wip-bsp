diff --git a/core/arch/arm/dts/stm32mp135f-dk.dts b/core/arch/arm/dts/stm32mp135f-dk.dts
index 78ab4944c..920db48b2 100644
--- a/core/arch/arm/dts/stm32mp135f-dk.dts
+++ b/core/arch/arm/dts/stm32mp135f-dk.dts
@@ -279,8 +279,6 @@
 };
 
 &rcc {
-	compatible = "st,stm32mp13-rcc", "syscon";
-
 	st,clksrc = <
 		CLK_MPU_PLL1P
 		CLK_AXI_PLL2P
diff --git a/core/drivers/clk/clk-stm32-rcc.c b/core/drivers/clk/clk-stm32-rcc.c
new file mode 100644
index 000000000..894a1c69e
--- /dev/null
+++ b/core/drivers/clk/clk-stm32-rcc.c
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: (GPL-2.0-or-later OR BSD-3-Clause)
+/*
+ * Copyright (C) 2023, STMicroelectronics - All Rights Reserved
+ */
+
+#include <drivers/clk.h>
+#include <drivers/clk_dt.h>
+#include <drivers/stm32_gpio.h>
+#include <kernel/dt.h>
+#include <stdio.h>
+#include <tee_api_defines_extensions.h>
+
+static TEE_Result stm32mp_rcc_probe(const void *fdt, int node,
+				    const void *compat_data __unused)
+{
+	struct pinctrl_state *pinctrl_cfg = NULL;
+	TEE_Result res = TEE_SUCCESS;
+	struct clk *clk = NULL;
+	int idx = 0;
+
+	/* Apply pinctrl configuration if present */
+	res = pinctrl_get_state_by_idx(fdt, node, 0, &pinctrl_cfg);
+	if (res && res != TEE_ERROR_ITEM_NOT_FOUND) {
+		if (res == TEE_ERROR_DEFER_DRIVER_INIT)
+			return res;
+		panic("Failed to get RCC pinctrl");
+	}
+
+	if (pinctrl_cfg)
+		stm32_pinctrl_set_secure_cfg(pinctrl_cfg, true);
+
+	/* Enable clock(s) if present */
+	while (!clk_dt_get_by_index(fdt, node, idx++, &clk)) {
+		if (clk_enable(clk))
+			panic("Can't enable RCC clock");
+	}
+
+	return TEE_SUCCESS;
+}
+
+static const struct dt_device_match stm32mp_rcc_match_table[] = {
+	{ .compatible = "st,rcc" },
+	{ }
+};
+
+DEFINE_DT_DRIVER(stm32mp_rcc_dt_driver) = {
+	.name = "stm32mp-rcc",
+	.match_table = stm32mp_rcc_match_table,
+	.probe = stm32mp_rcc_probe,
+};
diff --git a/core/drivers/clk/clk-stm32mp13.c b/core/drivers/clk/clk-stm32mp13.c
index fb038cbe2..4166e8249 100644
--- a/core/drivers/clk/clk-stm32mp13.c
+++ b/core/drivers/clk/clk-stm32mp13.c
@@ -3319,6 +3319,7 @@ static TEE_Result stm32mp13_clk_probe(const void *fdt, int node,
 	int rc = 0;
 	struct clk_stm32_priv *priv = &stm32mp13_clock_data;
 	struct stm32_clk_platdata *pdata = &stm32mp13_clock_pdata;
+	int subnode = 0;
 
 	fdt_rc = stm32_clk_parse_fdt(fdt, node, pdata);
 	if (fdt_rc) {
@@ -3326,6 +3327,15 @@ static TEE_Result stm32mp13_clk_probe(const void *fdt, int node,
 		return TEE_ERROR_GENERIC;
 	}
 
+	fdt_for_each_subnode(subnode, fdt, node) {
+		res = dt_driver_maybe_add_probe_node(fdt, subnode);
+		if (res) {
+			EMSG("Failed on node %s with %#"PRIx32,
+			     fdt_get_name(fdt, subnode, NULL), res);
+			return res;
+		}
+	}
+
 	res = clk_stm32_init(priv, stm32_rcc_base());
 	if (res)
 		return res;
diff --git a/core/drivers/clk/clk-stm32mp15.c b/core/drivers/clk/clk-stm32mp15.c
index 01332d702..f1c846795 100644
--- a/core/drivers/clk/clk-stm32mp15.c
+++ b/core/drivers/clk/clk-stm32mp15.c
@@ -3443,6 +3443,7 @@ static TEE_Result stm32mp1_clock_provider_probe(const void *fdt, int offs,
 	struct clk_stm32_priv *priv = &stm32mp15_clock_data;
 	struct stm32_clk_platdata *pdata = &stm32mp15_clock_pdata;
 	int rc = 0;
+	int subnode = 0;
 
 	if (compat_data == &non_secure_rcc)
 		disable_rcc_tzen();
@@ -3455,6 +3456,15 @@ static TEE_Result stm32mp1_clock_provider_probe(const void *fdt, int offs,
 		return TEE_ERROR_GENERIC;
 	}
 
+	fdt_for_each_subnode(subnode, fdt, offs) {
+		res = dt_driver_maybe_add_probe_node(fdt, subnode);
+		if (res) {
+			EMSG("Failed on node %s with %#"PRIx32,
+			     fdt_get_name(fdt, subnode, NULL), res);
+			return res;
+		}
+	}
+
 	res = clk_stm32_init(priv, stm32_rcc_base());
 	if (res)
 		return res;
