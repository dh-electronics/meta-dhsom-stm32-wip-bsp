 core/include/drivers/stm32mp13_rcc.h     |  2 --
 core/include/drivers/stm32mp1_rcc_util.h | 35 ++++++++++++++++++++++++
 5 files changed, 39 insertions(+), 21 deletions(-)
 create mode 100644 core/include/drivers/stm32mp1_rcc_util.h

diff --git a/core/arch/arm/plat-stm32mp1/stm32_util.h b/core/arch/arm/plat-stm32mp1/stm32_util.h
