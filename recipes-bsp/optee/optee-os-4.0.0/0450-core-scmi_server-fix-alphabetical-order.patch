From 929036ca47978da8f4fdbfaa6ab01da6608005cb Mon Sep 17 00:00:00 2001
From: Etienne Carriere <etienne.carriere@foss.st.com>
Date: Tue, 13 Jun 2023 12:38:01 +0200
Subject: [PATCH 0450/1695] core: scmi_server: fix alphabetical order

Fixes alphabetical ordering of CFG_SCPFW_MOD_* configuration switches
in conf.mk and conf-optee-stm32mp1.mk.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/optee_os.git 2bbab8ad06d980e873b7613bc215783618344cf6 core: scmi_server: fix alphabetical order]
Change-Id: I3113c2e06ccc5279eacc2381a8bc03dcadbf4c6d
Signed-off-by: Etienne Carriere <etienne.carriere@foss.st.com>
---
 core/lib/scmi-server/conf-optee-stm32mp1.mk | 4 ++--
 core/lib/scmi-server/conf.mk                | 6 +++---
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/core/lib/scmi-server/conf-optee-stm32mp1.mk b/core/lib/scmi-server/conf-optee-stm32mp1.mk
index 34ae07f91..a5d043836 100644
--- a/core/lib/scmi-server/conf-optee-stm32mp1.mk
+++ b/core/lib/scmi-server/conf-optee-stm32mp1.mk
@@ -1,10 +1,10 @@
-$(call force,CFG_SCPFW_MOD_RESET_DOMAIN,y)
 $(call force,CFG_SCPFW_MOD_CLOCK,y)
+$(call force,CFG_SCPFW_MOD_MSG_SMT,y)
 $(call force,CFG_SCPFW_MOD_OPTEE_CLOCK,y)
 $(call force,CFG_SCPFW_MOD_OPTEE_CONSOLE,y)
 $(call force,CFG_SCPFW_MOD_OPTEE_MBX,y)
 $(call force,CFG_SCPFW_MOD_OPTEE_RESET,y)
-$(call force,CFG_SCPFW_MOD_OPTEE_SMT,y)
+$(call force,CFG_SCPFW_MOD_RESET_DOMAIN,y)
 $(call force,CFG_SCPFW_MOD_SCMI,y)
 $(call force,CFG_SCPFW_MOD_SCMI_CLOCK,y)
 $(call force,CFG_SCPFW_MOD_SCMI_RESET_DOMAIN,y)
diff --git a/core/lib/scmi-server/conf.mk b/core/lib/scmi-server/conf.mk
index ba4974816..f52dbf4ab 100644
--- a/core/lib/scmi-server/conf.mk
+++ b/core/lib/scmi-server/conf.mk
@@ -31,13 +31,12 @@ else
 CFG_SCPFW_LOG_LEVEL ?= 0
 endif
 
-CFG_SCPFW_MOD_DVFS ?= n
-CFG_SCPFW_MOD_RESET_DOMAIN ?= n
 CFG_SCPFW_MOD_CLOCK ?= n
-CFG_SCPFW_MOD_MSG_SMT ?= n
+CFG_SCPFW_MOD_DVFS ?= n
 CFG_SCPFW_MOD_MOCK_CLOCK ?= n
 CFG_SCPFW_MOD_MOCK_PPU ?= n
 CFG_SCPFW_MOD_MOCK_PSU ?= n
+CFG_SCPFW_MOD_MSG_SMT ?= n
 CFG_SCPFW_MOD_OPTEE_CLOCK ?= n
 CFG_SCPFW_MOD_OPTEE_CONSOLE ?= y
 CFG_SCPFW_MOD_OPTEE_MBX ?= n
@@ -46,6 +45,7 @@ CFG_SCPFW_MOD_OPTEE_SMT ?= n
 CFG_SCPFW_MOD_POWER_DOMAIN ?= n
 CFG_SCPFW_MOD_PSU ?= n
 CFG_SCPFW_MOD_REG_SENSOR ?= n
+CFG_SCPFW_MOD_RESET_DOMAIN ?= n
 CFG_SCPFW_MOD_SENSOR ?= n
 CFG_SCPFW_MOD_SCMI ?= y
 CFG_SCPFW_MOD_SCMI_APCORE ?= n
-- 
