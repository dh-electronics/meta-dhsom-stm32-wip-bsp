+static const struct channel_resources scmi_channel[] = {
+	[0] = {
+		.clock = stm32_scmi_clock,
+		.clock_count = ARRAY_SIZE(stm32_scmi_clock),
+		.rd = stm32_scmi_reset,
+		.rd_count = ARRAY_SIZE(stm32_scmi_reset),
+	},
