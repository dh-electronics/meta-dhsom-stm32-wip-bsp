# short-description: Create DH STM32MP25 eMMCcard image with a boot partition
# long-description: Creates a partitioned eMMC card image. Boot files
# are located in the first ext4 partition.

part fip --source rawcopy --part-name=fip-a --sourceparams="file=${DEPLOY_DIR_IMAGE}/fip.bin-stm32mp2" --ondisk mmcblk --align 1 --part-type=19d5df83-11b0-457b-be2c-7559c13142a5 --uuid=4fd84c93-54ef-463f-a7ef-ae25ff887087 --size 4M
part fip --source rawcopy --part-name=fip-b --sourceparams="file=${DEPLOY_DIR_IMAGE}/fip.bin-stm32mp2" --ondisk mmcblk --align 1 --part-type=19d5df83-11b0-457b-be2c-7559c13142a5 --uuid=09c54952-d5bf-45af-acee-335303766fb3 --size 4M
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label root --part-name "rootfs" --align 4096 --use-uuid --active

bootloader --ptable gpt
