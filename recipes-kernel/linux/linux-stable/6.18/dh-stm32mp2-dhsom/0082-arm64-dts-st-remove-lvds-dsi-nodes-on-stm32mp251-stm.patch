From 15f86a3dc169fda54b7c61adcada07d151a43804 Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Wed, 31 Jan 2024 10:36:41 +0100
Subject: [PATCH 82/95] arm64: dts: st: remove lvds & dsi nodes on stm32mp251 &
 stm32mp253

Dsi & lvds are no more supported by SOCs stm32mp251 & stm32mp253

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/linux.git 3a55463f07f752a6b010b25149ca062585701f37 arm64: dts: st: remove lvds & dsi nodes on stm32mp251 & stm32mp253]
Change-Id: I4d7197af4706a9fa60a5ae7814587cff42f5a6f2
Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp251.dtsi | 22 +---------------------
 1 file changed, 1 insertion(+), 21 deletions(-)

diff --git a/arch/arm64/boot/dts/st/stm32mp251.dtsi b/arch/arm64/boot/dts/st/stm32mp251.dtsi
index 339967abd1c55..a5fb0189cd869 100644
--- a/arch/arm64/boot/dts/st/stm32mp251.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp251.dtsi
@@ -44,12 +44,6 @@ arm_wdt: watchdog {
 	};
 
 	clocks {
-		clk_dsi_txbyte: txbyteclk {
-			#clock-cells = <0>;
-			compatible = "fixed-clock";
-			clock-frequency = <0>;
-		};
-
 		clk_rcbsec: clk-rcbsec {
 			#clock-cells = <0>;
 			compatible = "fixed-clock";
@@ -1605,19 +1599,6 @@ trigger@4 {
 				};
 			};
 
-			dsi: dsi@48000000 {
-				compatible = "st,stm32-dsi";
-				reg = <0x48000000 0x800>;
-				#clock-cells = <0>;
-				clocks = <&rcc CK_BUS_DSI>, <&rcc CK_KER_DSIPHY>,
-					 <&rcc CK_KER_LTDC>;
-				clock-names = "pclk", "ref", "px_clk";
-				resets = <&rcc DSI_R>;
-				reset-names = "apb";
-				access-controllers = <&rifsc 81>;
-				status = "disabled";
-			};
-
 			ltdc: display-controller@48010000 {
 				compatible = "st,stm32mp251-ltdc";
 				reg = <0x48010000 0x400>;
@@ -1979,8 +1960,7 @@ rcc: clock-controller@44200000 {
 				<&scmi_clk CK_SCMI_ICN_APBDBG>,
 				<&scmi_clk CK_SCMI_TIMG1>,
 				<&scmi_clk CK_SCMI_TIMG2>,
-				<&scmi_clk CK_SCMI_PLL3>,
-				<&clk_dsi_txbyte>;
+				<&scmi_clk CK_SCMI_PLL3>;
 				access-controllers = <&rifsc 156>;
 		};
 
-- 
2.51.0

