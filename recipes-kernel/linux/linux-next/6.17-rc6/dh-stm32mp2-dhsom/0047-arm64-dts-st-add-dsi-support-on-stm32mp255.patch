From eb5a252791b518f5a8918ed773f3bb6970a23161 Mon Sep 17 00:00:00 2001
From: Yannick Fertre <yannick.fertre@foss.st.com>
Date: Wed, 31 Jan 2024 15:16:59 +0100
Subject: [PATCH 47/82] arm64: dts: st: add dsi support on stm32mp255

This patch adds DSI support on stm32mp255.

Upstream-Status: Inappropriate [ST downstream https://github.com/STMicroelectronics/linux.git 72c410dbeceb16d292dc96e929965d7d5d6cd60c arm64: dts: st: add dsi support on stm32mp255]
Change-Id: Icd182bb0a38553b1e034e2f8179c3a43d223a961
Signed-off-by: Yannick Fertre <yannick.fertre@foss.st.com>
---
 arch/arm64/boot/dts/st/stm32mp255.dtsi | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/st/stm32mp255.dtsi b/arch/arm64/boot/dts/st/stm32mp255.dtsi
index 200adc8625ad2..c444996b7d60d 100644
--- a/arch/arm64/boot/dts/st/stm32mp255.dtsi
+++ b/arch/arm64/boot/dts/st/stm32mp255.dtsi
@@ -12,6 +12,20 @@ &ltdc {
 };
 
 &rifsc {
+	dsi: dsi@48000000 {
+		compatible = "st,stm32mp25-dsi";
+		reg = <0x48000000 0x800>;
+		#clock-cells = <0>;
+		clocks = <&rcc CK_BUS_DSI>, <&rcc CK_KER_DSIPHY>,
+			 <&rcc CK_KER_LTDC>;
+		clock-names = "pclk", "ref", "px_clk";
+		resets = <&rcc DSI_R>;
+		reset-names = "apb";
+		access-controllers = <&rifsc 81>;
+		power-domains = <&CLUSTER_PD>;
+		status = "disabled";
+	};
+
 	lvds: lvds@48060000 {
 		compatible = "st,stm32mp255-lvds", "st,stm32mp25-lvds";
 		reg = <0x48060000 0x2000>;
-- 
2.51.0

